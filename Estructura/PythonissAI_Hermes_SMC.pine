//@version=6
// ██████╗ ██╗   ██╗████████╗██╗  ██╗ ██████╗ ███╗   ██╗██╗███████╗███████╗ █████╗ ██╗
// ██╔══██╗╚██╗ ██╔╝╚══██╔══╝██║  ██║██╔═══██╗████╗  ██║██║██╔════╝██╔════╝██╔══██╗██║
// ██████╔╝ ╚████╔╝    ██║   ███████║██║   ██║██╔██╗ ██║██║███████╗███████╗███████║██║
// ██╔═══╝   ╚██╔╝     ██║   ██╔══██║██║   ██║██║╚██╗██║██║╚════██║╚════██║██╔══██║██║
// ██║        ██║      ██║   ██║  ██║╚██████╔╝██║ ╚████║██║███████║███████║██║  ██║██║
// ╚═╝        ╚═╝      ╚═╝   ╚═╝  ╚═╝ ╚═════╝ ╚═╝  ╚═══╝╚═╝╚══════╝╚══════╝╚═╝  ╚═╝╚═╝
//         C R I P T O   ·   T R A D I N G   C A P I T A L
// ────────────────────────────────────────────────────────────────────────────
//  PythonissAI® - Hermes · SMC
//  Smart Money Concepts limpio: BOS / CHoCH · HH/HL/LH/LL inteligente ·
//  Order Blocks volumétricos (fondo + cuerpo bicolor + volumen y %) · FVG / IFVG
//  recortados con línea 50% · EQH/EQL · Premium/Descuento. Trazos finos.
//  Exporta el sesgo (conn_smc / conn_fvg) para el Cónclave.
//  (c) PythonissAI® — Pine v6 · overlay
// ────────────────────────────────────────────────────────────────────────────
indicator("PythonissAI® - Hermes · SMC", shorttitle="Hermes", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_bars_back=2000)

// ════════════════ GRUPOS ════════════════
G_STR = "① Estructura (BOS / CHoCH)"
G_OB  = "② Order Blocks"
G_FVG = "③ FVG / IFVG"
G_EQ  = "④ Liquidez (EQH / EQL)"
G_PD  = "⑤ Premium / Descuento"
G_VIS = "⑥ Estética"
G_COL = "⑦ Paleta"
G_WM  = "✦ Marca de agua"

// ════════════════ ① ESTRUCTURA ════════════════
swLen     = input.int(10, "Swing (pivote estructura)", minval=2, maxval=50, group=G_STR, tooltip="Más alto = estructura mayor (menos ruido).")
showBOS   = input.bool(true, "Mostrar BOS (rompimiento)", group=G_STR)
showCHoCH = input.bool(true, "Mostrar CHoCH (cambio carácter)", group=G_STR)
showHL    = input.bool(true, "Etiquetas HH/HL/LH/LL", group=G_STR)
maxHL     = input.int(4, "Máx etiquetas por lado (anti-saturación)", minval=1, maxval=20, group=G_STR, tooltip="Sólo mantiene las últimas N por lado para no ensuciar.")

// ════════════════ ② ORDER BLOCKS ════════════════
showOB    = input.bool(true, "Mostrar Order Blocks", group=G_OB)
obMax     = input.int(6, "Máx OB visibles", minval=1, maxval=20, group=G_OB)
showOBVol = input.bool(true, "Volumen + % de fuerza", group=G_OB)

// ════════════════ ③ FVG / IFVG ════════════════
showFVG  = input.bool(true, "Mostrar FVG", group=G_FVG)
showIFVG = input.bool(true, "Mostrar IFVG (gap invertido)", group=G_FVG)
fvgMax   = input.int(8, "Máx FVG visibles", minval=1, maxval=30, group=G_FVG)
fvgMitig = input.bool(true, "Mitigar FVG (si IFVG off)", group=G_FVG)
fvgMin   = input.float(0.0, "Tamaño mínimo ×ATR", minval=0.0, step=0.05, group=G_FVG)
fvgLen   = input.int(6, "Ancho del FVG (recortado, velas)", minval=2, maxval=30, group=G_FVG)

// ════════════════ ④ LIQUIDEZ EQH/EQL ════════════════
showEQ   = input.bool(true, "Mostrar EQH / EQL (liquidez)", group=G_EQ)
eqTol    = input.float(0.1, "Tolerancia (% ATR)", minval=0.01, maxval=1.0, step=0.05, group=G_EQ)

// ════════════════ ⑤ PREMIUM / DESCUENTO ════════════════
showPD   = input.bool(false, "Mostrar zonas Premium/EQ/Descuento", group=G_PD)
pdLen    = input.int(50, "Rango (lookback)", minval=10, maxval=200, group=G_PD)

// ════════════════ ⑥ ESTÉTICA ════════════════
obBgOp   = input.int(82, "Fondo OB (transp.)", minval=70, maxval=95, group=G_VIS, tooltip="Rectángulo de fondo de baja opacidad.")
obBodyOp = input.int(30, "Cuerpo bicolor OB (transp.)", minval=10, maxval=60, group=G_VIS, tooltip="El cuerpo sólido encima. ~30 = pintado al 70-75%.")
fvgFill  = input.int(88, "Relleno FVG (transp.)", minval=80, maxval=97, group=G_VIS)
showDash = input.bool(true, "Dashboard minimalista", group=G_VIS)
dashPos  = input.string("Arriba Derecha", "Posición dashboard", options=["Arriba Derecha","Arriba Izquierda","Abajo Derecha","Abajo Izquierda"], group=G_VIS)

// ════════════════ ⑦ PALETA ════════════════
palette = input.string("Verde Lima vs Naranja", "Paleta Bull/Bear", options=["Cyan vs Magenta","Oro vs Violeta","Verde Lima vs Naranja","Blanco vs Carbón","Menta vs Coral","Eléctrico BudAI","Aqua vs Rubí"], group=G_COL)
cLiq    = input.color(#ffb300, "Liquidez (ámbar)", group=G_COL)
cIfvg   = input.color(#b388ff, "IFVG (violeta)", group=G_COL)
cNeu    = input.color(#90a4ae, "Neutral (gris)", group=G_COL)
cWhite  = input.color(#ffffff, "Núcleo (blanco)", group=G_COL)

color upCol = palette == "Oro vs Violeta" ? #ffe600 : palette == "Verde Lima vs Naranja" ? #39ff14 : palette == "Blanco vs Carbón" ? #ffffff : palette == "Menta vs Coral" ? #00ffc4 : palette == "Eléctrico BudAI" ? #00e5ff : palette == "Aqua vs Rubí" ? #18ffff : palette == "Cyan vs Magenta" ? #00f0ff : #39ff14
color dnCol = palette == "Oro vs Violeta" ? #9d00ff : palette == "Verde Lima vs Naranja" ? #ff4500 : palette == "Blanco vs Carbón" ? #4a4a4a : palette == "Menta vs Coral" ? #ff5757 : palette == "Eléctrico BudAI" ? #ff1e6e : palette == "Aqua vs Rubí" ? #ff1744 : palette == "Cyan vs Magenta" ? #ff007a : #ff4500

// ════════════════ ✦ MARCA DE AGUA ════════════════
showWM = input.bool(true, "Firma PythonissAI", group=G_WM)
wmPos  = input.string("Inferior Derecha", "Posición firma", options=["Inferior Izquierda","Inferior Derecha","Superior Izquierda","Superior Derecha"], group=G_WM)
wmCol  = input.color(color.new(#b6f400, 30), "Color firma", group=G_WM)

// ════════════════════════════════════════════════════════════════════════════
//  BASE
// ════════════════════════════════════════════════════════════════════════════
float atr = ta.atr(14)
bool  conf = barstate.isconfirmed

// ════════════════════════════════════════════════════════════════════════════
//  ① ESTRUCTURA — pivotes, BOS/CHoCH, HH/HL/LH/LL
// ════════════════════════════════════════════════════════════════════════════
float ph = ta.pivothigh(high, swLen, swLen)
float pl = ta.pivotlow(low,  swLen, swLen)

var float lastPH = na
var float lastPL = na
var float prevPH = na
var float prevPL = na
var int   phBar = na
var int   plBar = na
if not na(ph)
    prevPH := lastPH
    lastPH := ph
    phBar  := bar_index - swLen
if not na(pl)
    prevPL := lastPL
    lastPL := pl
    plBar  := bar_index - swLen

var int bias = 0
var float swingHi = na
var float swingLo = na
if not na(ph)
    swingHi := ph
if not na(pl)
    swingLo := pl

bool brokeUp = not na(swingHi) and close > swingHi and close[1] <= swingHi
bool brokeDn = not na(swingLo) and close < swingLo and close[1] >= swingLo

bool bosUp = false
bool bosDn = false
bool chochUp = false
bool chochDn = false
if brokeUp and conf
    if bias < 0
        chochUp := true
    else
        bosUp := true
    bias := 1
    swingHi := na
if brokeDn and conf
    if bias > 0
        chochDn := true
    else
        bosDn := true
    bias := -1
    swingLo := na

var array<line>  brkLines = array.new_line()
var array<label> brkLbls  = array.new_label()
var array<label> hiLbls   = array.new_label()
var array<label> loLbls   = array.new_label()

// BOS/CHoCH = texto simple (sin caja), línea fina del nivel roto
f_drawBreak(string txt, float y, int x1, color col) =>
    if array.size(brkLines) >= 30
        line.delete(array.shift(brkLines))
        label.delete(array.shift(brkLbls))
    array.push(brkLines, line.new(x1, y, bar_index, y, color=color.new(col, 55), style=line.style_dashed, width=1))
    array.push(brkLbls,  label.new(bar_index, y, txt, style=label.style_none, textcolor=col, size=size.tiny))

int phX = na(phBar) ? bar_index - swLen : phBar
int plX = na(plBar) ? bar_index - swLen : plBar
if showBOS and bosUp
    f_drawBreak("BOS", lastPH, phX, upCol)
if showBOS and bosDn
    f_drawBreak("BOS", lastPL, plX, dnCol)
if showCHoCH and chochUp
    f_drawBreak("CHoCH", lastPH, phX, upCol)
if showCHoCH and chochDn
    f_drawBreak("CHoCH", lastPL, plX, dnCol)

// HH/HL/LH/LL inteligente — sólo las últimas N por lado
f_addHL(array<label> arr, string txt, float y, bool isHigh, color col) =>
    if array.size(arr) >= maxHL
        label.delete(array.shift(arr))
    array.push(arr, label.new(bar_index - swLen, y, txt, xloc=xloc.bar_index, style=isHigh ? label.style_label_down : label.style_label_up, color=color.new(col, 90), textcolor=col, size=size.tiny))

if showHL and not na(ph)
    bool hh = not na(prevPH) and ph > prevPH
    f_addHL(hiLbls, hh ? "HH" : "LH", ph, true, hh ? upCol : dnCol)
if showHL and not na(pl)
    bool ll = not na(prevPL) and pl < prevPL
    f_addHL(loLbls, ll ? "LL" : "HL", pl, false, ll ? dnCol : upCol)

// ════════════════════════════════════════════════════════════════════════════
//  ② ORDER BLOCKS volumétricos — fondo faint + cuerpo bicolor + nivel con vol/%
// ════════════════════════════════════════════════════════════════════════════
type OB
    box   bg
    box   body
    line  lvl
    label lb
    float top
    float bot
    float vol
    int   dir
    bool  mit

var array<OB> obs = array.new<OB>()

f_addOB(int dir) =>
    float t  = high[swLen]
    float b  = low[swLen]
    float bt = math.max(open[swLen], close[swLen])
    float bb = math.min(open[swLen], close[swLen])
    float v  = volume[swLen]
    color zc = dir == 1 ? upCol : dnCol     // zona (dirección del OB)
    color bc = dir == 1 ? dnCol : upCol     // cuerpo bicolor (opuesto = vela origen)
    box bg = na
    box bd = na
    line lv = na
    label lb = na
    if showOB
        bg := box.new(bar_index - swLen, t, bar_index + 2, b, bgcolor=color.new(zc, obBgOp), border_color=color.new(zc, 55), border_width=1)
        bd := box.new(bar_index - swLen, bt, bar_index + 2, bb, bgcolor=color.new(bc, obBodyOp), border_color=color.new(bc, 100), border_width=0)
        float prox = dir == 1 ? t : b
        lv := line.new(bar_index, prox, bar_index + 2, prox, color=color.new(zc, 40), style=line.style_dashed, width=1)
        if showOBVol
            lb := label.new(bar_index + 2, prox, "", style=label.style_label_left, color=color.new(#000000, 100), textcolor=zc, size=size.tiny)
    OB o = OB.new(bg, bd, lv, lb, t, b, v, dir, false)
    array.unshift(obs, o)
    int cnt = 0
    int i = 0
    while i < array.size(obs)
        OB x = array.get(obs, i)
        if x.dir == dir and not x.mit
            cnt += 1
            if cnt > obMax
                box.delete(x.bg)
                box.delete(x.body)
                line.delete(x.lvl)
                label.delete(x.lb)
                array.remove(obs, i)
                continue
        i += 1

if showOB and (bosUp or chochUp)
    f_addOB(1)
if showOB and (bosDn or chochDn)
    f_addOB(-1)

// gestión: extender, % de fuerza, mitigación
if array.size(obs) > 0
    float maxVol = 0.0
    for i = 0 to array.size(obs) - 1
        OB o = array.get(obs, i)
        if not o.mit and o.vol > maxVol
            maxVol := o.vol
    for i = array.size(obs) - 1 to 0
        OB o = array.get(obs, i)
        if o.mit
            continue
        bool broken = (o.dir == 1 and close < o.bot) or (o.dir == -1 and close > o.top)
        if broken
            o.mit := true
            box.delete(o.bg)
            box.delete(o.body)
            line.delete(o.lvl)
            label.delete(o.lb)
            continue
        box.set_right(o.bg, bar_index + 2)
        box.set_right(o.body, bar_index + 2)
        line.set_x2(o.lvl, bar_index + 2)
        if not na(o.lb)
            int pct = maxVol > 0 ? int(math.round(o.vol / maxVol * 100)) : 0
            label.set_x(o.lb, bar_index + 2)
            label.set_text(o.lb, str.tostring(o.vol, format.volume) + " (" + str.tostring(pct) + "%)")

// ════════════════════════════════════════════════════════════════════════════
//  ③ FVG / IFVG — recortados (cortos), con trazo + línea 50%
// ════════════════════════════════════════════════════════════════════════════
type FVG
    box   bx
    line  ln
    float top
    float bot
    int   dir
    bool  inv
    bool  dead

var array<FVG> fvgs = array.new<FVG>()

bool fvgUp = low > high[2] and (low - high[2]) >= fvgMin * atr
bool fvgDn = high < low[2] and (low[2] - high) >= fvgMin * atr

f_addFVG(float top, float bot, int dir) =>
    if array.size(fvgs) >= fvgMax
        FVG old = array.shift(fvgs)
        box.delete(old.bx)
        line.delete(old.ln)
    color c = dir > 0 ? upCol : dnCol
    float mid = (top + bot) / 2.0
    // recortado: ancho fijo corto (no se extiende)
    int xl = bar_index - 1
    int xr = bar_index + fvgLen
    box bx = box.new(xl, top, xr, bot, bgcolor=color.new(c, fvgFill), border_color=color.new(c, 50), border_width=1)
    line ln = line.new(xl, mid, xr, mid, color=color.new(c, 25), style=line.style_solid, width=1)
    array.push(fvgs, FVG.new(bx, ln, top, bot, dir, false, false))

if showFVG and conf and fvgUp
    f_addFVG(low, high[2], 1)
if showFVG and conf and fvgDn
    f_addFVG(low[2], high, -1)

int fvgBias = 0
if array.size(fvgs) > 0
    for i = array.size(fvgs) - 1 to 0
        FVG f = array.get(fvgs, i)
        if f.dead
            continue
        if not f.inv
            bool violated = (f.dir == 1 and close < f.bot) or (f.dir == -1 and close > f.top)
            bool touched  = low <= f.top and high >= f.bot
            if violated and showIFVG
                f.inv := true
                box.set_bgcolor(f.bx, color.new(cIfvg, fvgFill - 2))
                box.set_border_color(f.bx, color.new(cIfvg, 45))
                line.set_color(f.ln, color.new(cIfvg, 25))
            else if (violated or touched) and not showIFVG and fvgMitig
                f.dead := true
                box.delete(f.bx)
                line.delete(f.ln)
        else
            bool kill = (f.dir == 1 and close > f.top) or (f.dir == -1 and close < f.bot)
            if kill
                f.dead := true
                box.delete(f.bx)
                line.delete(f.ln)
        if not f.dead and close <= f.top and close >= f.bot
            fvgBias := f.inv ? -f.dir : f.dir

// ════════════════════════════════════════════════════════════════════════════
//  ④ EQH / EQL — liquidez (máximos/mínimos iguales)
// ════════════════════════════════════════════════════════════════════════════
float tol = atr * eqTol
if showEQ and not na(ph) and not na(prevPH) and math.abs(ph - prevPH) <= tol
    line.new(phBar, ph, bar_index, ph, color=color.new(cLiq, 30), style=line.style_dotted, width=1)
    label.new(bar_index, ph, "EQH", xloc=xloc.bar_index, style=label.style_none, textcolor=color.new(cLiq, 0), size=size.tiny)
if showEQ and not na(pl) and not na(prevPL) and math.abs(pl - prevPL) <= tol
    line.new(plBar, pl, bar_index, pl, color=color.new(cLiq, 30), style=line.style_dotted, width=1)
    label.new(bar_index, pl, "EQL", xloc=xloc.bar_index, style=label.style_none, textcolor=color.new(cLiq, 0), size=size.tiny)

// ════════════════════════════════════════════════════════════════════════════
//  ⑤ PREMIUM / DESCUENTO — gradiente que se desvanece hacia el equilibrio
// ════════════════════════════════════════════════════════════════════════════
float drHigh = ta.highest(high, pdLen)
float drLow  = ta.lowest(low,  pdLen)
float eq     = (drHigh + drLow) / 2.0
bool  premium = close > eq

pPrem = plot(showPD ? drHigh : na, "Premium", color=color.new(dnCol, 100))
pEq   = plot(showPD ? eq : na, "Eq", color=showPD ? color.new(cLiq, 35) : na, linewidth=1)
pDisc = plot(showPD ? drLow : na, "Descuento", color=color.new(upCol, 100))
fill(pPrem, pEq, top_value=drHigh, bottom_value=eq, top_color=color.new(dnCol, 88), bottom_color=color.new(dnCol, 100), title="Premium")
fill(pEq, pDisc, top_value=eq, bottom_value=drLow, top_color=color.new(upCol, 100), bottom_color=color.new(upCol, 88), title="Descuento")

// ════════════════════════════════════════════════════════════════════════════
//  CONECTOR (display.none) — para el Cónclave
// ════════════════════════════════════════════════════════════════════════════
plot(bias, "conn_smc", display=display.none)
plot(fvgBias, "conn_fvg", display=display.none)

// ════════════════════════════════════════════════════════════════════════════
//  ⑥ DASHBOARD minimalista
// ════════════════════════════════════════════════════════════════════════════
f_pos(s) => (s == "Arriba Derecha" ? position.top_right : s == "Arriba Izquierda" ? position.top_left : s == "Abajo Derecha" ? position.bottom_right : position.bottom_left)
var table d = table.new(f_pos(dashPos), 2, 5, bgcolor=color.new(#0b0e16, 14), frame_color=color.new(cNeu, 55), frame_width=1, border_width=1)
f_cell(t, r, k, v, vc) =>
    table.cell(t, 0, r, k, text_color=color.new(#90a4ae, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1, r, v, text_color=vc, text_size=size.tiny, text_halign=text.align_right)

var string lastBreak = "—"
var color  lastBreakC = cNeu
if bosUp
    lastBreak := "BOS ▲"
    lastBreakC := upCol
if bosDn
    lastBreak := "BOS ▼"
    lastBreakC := dnCol
if chochUp
    lastBreak := "CHoCH ▲"
    lastBreakC := upCol
if chochDn
    lastBreak := "CHoCH ▼"
    lastBreakC := dnCol

if showDash and barstate.islast
    string biasTxt = bias > 0 ? "ALCISTA" : bias < 0 ? "BAJISTA" : "NEUTRO"
    color  biasCol = bias > 0 ? upCol : bias < 0 ? dnCol : cNeu
    string zoneTxt = premium ? "PREMIUM" : "DESCUENTO"
    color  zoneCol = premium ? dnCol : upCol
    table.cell(d, 0, 0, "Hermes · SMC", text_color=cWhite, bgcolor=color.new(#1b2030, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(d, 1, 0, biasTxt, text_color=biasCol, bgcolor=color.new(#1b2030, 0), text_size=size.tiny, text_halign=text.align_right)
    f_cell(d, 1, "Último evento", lastBreak, lastBreakC)
    f_cell(d, 2, "Zona", zoneTxt, zoneCol)
    f_cell(d, 3, "OB activos", str.tostring(array.size(obs)), cNeu)
    f_cell(d, 4, "FVG/IFVG", str.tostring(array.size(fvgs)), cIfvg)

// ════════════════════════════════════════════════════════════════════════════
//  ✦ MARCA DE AGUA — firma PythonissAI
// ════════════════════════════════════════════════════════════════════════════
f_wmPos(s) => s == "Inferior Izquierda" ? position.bottom_left : s == "Inferior Derecha" ? position.bottom_right : s == "Superior Izquierda" ? position.top_left : position.top_right
var table wm = table.new(f_wmPos(wmPos), 1, 1, bgcolor=color.new(color.black, 100))
if showWM and barstate.islast
    table.cell(wm, 0, 0, "₿ PythonissAI", text_color=wmCol, text_size=size.tiny)

// ════════════════════════════════════════════════════════════════════════════
//  ALERTAS
// ════════════════════════════════════════════════════════════════════════════
alertcondition(bosUp,   "BOS alcista",   "Hermes · BOS alcista {{ticker}}")
alertcondition(bosDn,   "BOS bajista",   "Hermes · BOS bajista {{ticker}}")
alertcondition(chochUp, "CHoCH alcista", "Hermes · CHoCH alcista {{ticker}}")
alertcondition(chochDn, "CHoCH bajista", "Hermes · CHoCH bajista {{ticker}}")
