//@version=6
// ██████╗ ██╗   ██╗██████╗  █████╗ ██╗
// ██╔══██╗██║   ██║██╔══██╗██╔══██╗██║
// ██████╔╝██║   ██║██║  ██║███████║██║
// ██╔══██╗██║   ██║██║  ██║██╔══██║██║
// ██████╔╝╚██████╔╝██████╔╝██║  ██║██║
// ╚═════╝  ╚═════╝ ╚═════╝ ╚═╝  ╚═╝╚═╝
//         C R I P T O   ·   T R A D I N G   C A P I T A L
// ────────────────────────────────────────────────────────────────────────────
//  BudAI Capital® - Tidal Oscillator
//  Doble onda cruzada (rápida/lenta) con glow intenso, fill bicolor, Money Flow
//  de fondo, ribbons de tendencia arriba/abajo y círculos OB/OS. Estética marina neón.
//  (c) BudAI Capital® — Pine v6 · panel inferior
// ────────────────────────────────────────────────────────────────────────────
indicator("BudAI Capital® - Tidal Oscillator", shorttitle="BudAI Capital® - Tidal Oscillator", overlay=false, precision=1, max_labels_count=300, max_lines_count=100)

// ════════════════ GRUPOS ════════════════
G_CORE = "① Núcleo (doble onda)"
G_MF   = "② Money Flow"
G_RIB  = "③ Ribbons de tendencia"
G_SIG  = "④ Señales OB / OS"
G_VIS  = "⑤ Estética"
G_WM   = "✦ Marca de agua"

// ════════════════ ① NÚCLEO ════════════════
src     = input.source(hlc3, "Fuente", group=G_CORE)
chanLen = input.int(9,  "Canal", minval=3, group=G_CORE, tooltip="WaveTrend. 9-10 scalping, 21 swing.")
fastLen = input.int(12, "Onda rápida (azul)", minval=2, group=G_CORE)
slowLen = input.int(21, "Onda lenta (roja)", minval=2, group=G_CORE)

// ════════════════ ② MONEY FLOW ════════════════
showMF = input.bool(true, "Área Money Flow de fondo", group=G_MF)
mfLen  = input.int(35, "Money Flow longitud", minval=2, group=G_MF)

// ════════════════ ③ RIBBONS ════════════════
showRib = input.bool(true, "Ribbons de tendencia (arriba/abajo)", group=G_RIB, tooltip="Filas de guiones: arriba cambia rojo/morado según OB, abajo verde/rojo según OS.")
ribTop  = input.int(105, "Altura ribbon superior", group=G_RIB, inline="r")
ribBot  = input.int(-105, "Altura ribbon inferior", group=G_RIB, inline="r")

// ════════════════ ④ SEÑALES ════════════════
showSig = input.bool(true, "Círculos OB / OS", group=G_SIG)
obLvl   = input.int(60,  "Sobrecompra", minval=20, maxval=99, group=G_SIG, inline="l")
osLvl   = input.int(-60, "Sobreventa",  minval=-99, maxval=-20, group=G_SIG, inline="l")
reqMF   = input.bool(true, "Validar con Money Flow", group=G_SIG)

// ════════════════ ⑤ ESTÉTICA (marina neón) ════════════════
fastCol = input.color(#2196f3, "Onda rápida (azul)", group=G_VIS, inline="c")
slowCol = input.color(#f23645, "Onda lenta (roja)", group=G_VIS, inline="c")
fillUp  = input.color(color.new(#00e676, 70), "Fill alcista", group=G_VIS, inline="f")
fillDn  = input.color(color.new(#e040fb, 70), "Fill bajista", group=G_VIS, inline="f")
sigUp   = input.color(#00e676, "Señal OS (verde)", group=G_VIS, inline="sg")
sigDn   = input.color(#ffeb00, "Señal OB (amarillo)", group=G_VIS, inline="sg")
glow    = input.bool(true, "Glow neón", group=G_VIS)
showDash= input.bool(true, "Dashboard minimalista", group=G_VIS)
dashPos = input.string("Arriba Derecha", "Posición", options=["Arriba Derecha","Arriba Izquierda","Abajo Derecha","Abajo Izquierda"], group=G_VIS)

// ════════════════ ✦ MARCA DE AGUA ════════════════
showWM = input.bool(true, "Mostrar firma BudAI Cripto", group=G_WM)
wmPos  = input.string("Inferior Derecha", "Posición", options=["Inferior Izquierda","Inferior Derecha","Superior Izquierda","Superior Derecha"], group=G_WM)
wmCol  = input.color(color.new(#b6f400, 35), "Color", group=G_WM)

// ════════════════════════════════════════════════════════════════════════════
//  NÚCLEO — doble WaveTrend (rápida + lenta)
// ════════════════════════════════════════════════════════════════════════════
float esa = ta.ema(src, chanLen)
float de  = ta.ema(math.abs(src - esa), chanLen)
float ci  = de == 0 ? 0.0 : (src - esa) / (0.015 * de)
float wtFast = ta.ema(ci, fastLen)
float wtSlow = ta.ema(wtFast, slowLen)
float fast = math.max(-100.0, math.min(100.0, wtFast))
float slow = math.max(-100.0, math.min(100.0, wtSlow))

bool isBull = fast >= slow
bool conf   = barstate.isconfirmed

// Money Flow
float mfm = (high - low) != 0 ? ((close - low) - (high - close)) / (high - low) : 0.0
float vol = nz(volume) == 0 ? 1.0 : volume
float cmf = math.sum(mfm * vol, mfLen) / math.sum(vol, mfLen)

// ════════════════════════════════════════════════════════════════════════════
//  NIVELES
// ════════════════════════════════════════════════════════════════════════════
hline(0,     "Centro",      color.new(color.gray, 70), hline.style_solid)
hline(obLvl, "Sobrecompra", color.new(slowCol, 80), hline.style_dotted)
hline(osLvl, "Sobreventa",  color.new(fastCol, 80), hline.style_dotted)

// ════════════════════════════════════════════════════════════════════════════
//  PLOTS — Money Flow area + glow + doble línea + fill bicolor
// ════════════════════════════════════════════════════════════════════════════
// área Money Flow de fondo (verde acumulación / fucsia distribución)
float mfArea = cmf * 60.0
pMF = plot(showMF ? mfArea : na, "Money Flow", color=cmf >= 0 ? color.new(#00e676, 60) : color.new(#e040fb, 60), style=plot.style_area, histbase=0)

// glow fino de cada línea (capa semitransparente sutil)
plot(glow ? fast : na, "Glow rápida", color.new(fastCol, 82), 3)
plot(glow ? slow : na, "Glow lenta",  color.new(slowCol, 82), 3)

// doble línea principal (finas)
pFast = plot(fast, "Onda rápida", color=color.new(fastCol, 0), linewidth=1)
pSlow = plot(slow, "Onda lenta",  color=color.new(slowCol, 0), linewidth=1)

// fill bicolor entre las dos ondas
fill(pFast, pSlow, color=isBull ? fillUp : fillDn, title="Fill ondas")

// ════════════════════════════════════════════════════════════════════════════
//  ③ RIBBONS de tendencia (guiones arriba/abajo que cambian color)
// ════════════════════════════════════════════════════════════════════════════
// arriba: rojo si OB, morado si no · abajo: verde si OS, rojo si no
// micro-segmentos finos espaciados (cada 2 barras) — no franja sólida
bool ribTick = bar_index % 2 == 0
color ribTopCol = fast >= obLvl ? slowCol : color.new(#e040fb, 35)
color ribBotCol = fast <= osLvl ? sigUp : color.new(slowCol, 45)
plotchar(showRib and ribTick ? ribTop : na, "Ribbon superior", "▬", location.absolute, color=ribTopCol, size=size.tiny)
plotchar(showRib and ribTick ? ribBot : na, "Ribbon inferior", "▬", location.absolute, color=ribBotCol, size=size.tiny)

// ════════════════════════════════════════════════════════════════════════════
//  ④ SEÑALES — círculos OB/OS (fuerte = ○ · simple = ×)
// ════════════════════════════════════════════════════════════════════════════
bool crossUp = ta.crossover(fast, slow)
bool crossDn = ta.crossunder(fast, slow)
bool flowUp  = not reqMF or cmf > 0
bool flowDn  = not reqMF or cmf < 0

// fuerte = cruce en zona extrema · simple = cruce normal en zona
bool strongUp = crossUp and fast <= osLvl and flowUp and conf
bool strongDn = crossDn and fast >= obLvl and flowDn and conf
bool simpleUp = crossUp and fast > osLvl and fast < 0 and flowUp and conf
bool simpleDn = crossDn and fast < obLvl and fast > 0 and flowDn and conf

// nodo blanco con glow en TODO cruce (fino, elegante)
plotchar((crossUp or crossDn) ? fast : na, "Nodo Glow", "•", location.absolute, color=color.new(color.white, 70), size=size.small)
plotchar((crossUp or crossDn) ? fast : na, "Nodo",      "•", location.absolute, color=color.new(color.white, 0), size=size.tiny)

// círculos fuertes (verde abajo / amarillo arriba) con glow
plotchar(showSig and strongUp ? fast : na, "OS Glow", "•", location.absolute, color=color.new(sigUp, 60), size=size.small)
plotchar(showSig and strongUp ? fast : na, "OS",      "•", location.absolute, color=sigUp, size=size.tiny)
plotchar(showSig and strongDn ? fast : na, "OB Glow", "•", location.absolute, color=color.new(sigDn, 60), size=size.small)
plotchar(showSig and strongDn ? fast : na, "OB",      "•", location.absolute, color=sigDn, size=size.tiny)
// simples = ×
plotchar(showSig and simpleUp ? fast : na, "OS x", "×", location.absolute, color=color.new(sigUp, 30), size=size.tiny)
plotchar(showSig and simpleDn ? fast : na, "OB x", "×", location.absolute, color=color.new(sigDn, 30), size=size.tiny)

// ════════════════════════════════════════════════════════════════════════════
//  ⑤ DASHBOARD minimalista (tiny)
// ════════════════════════════════════════════════════════════════════════════
f_pos(s) => (s == "Arriba Derecha" ? position.top_right : s == "Arriba Izquierda" ? position.top_left : s == "Abajo Derecha" ? position.bottom_right : position.bottom_left)
var table d = table.new(f_pos(dashPos), 2, 4, bgcolor=color.new(#0b0e16, 14), frame_color=color.new(fastCol, 45), frame_width=1, border_width=1)
f_cell(t, r, k, v, vc) =>
    table.cell(t, 0, r, k, text_color=color.new(#90a4ae, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1, r, v, text_color=vc, text_size=size.tiny, text_halign=text.align_right)

if showDash and barstate.islast
    string dirTxt = isBull ? "▲ Alcista" : "▼ Bajista"
    color  dirC = isBull ? fastCol : slowCol
    string zona = fast >= obLvl ? "SOBRECOMPRA" : fast <= osLvl ? "SOBREVENTA" : "Neutro"
    color  zCol = fast >= obLvl ? sigDn : fast <= osLvl ? sigUp : color.new(#90a4ae,0)
    string flow = cmf > 0 ? "ACUMULA" : "DISTRIB"
    color  flowC = cmf > 0 ? #00e676 : #e040fb
    table.cell(d, 0, 0, "Tidal", text_color=color.white, bgcolor=color.new(#1b2030,0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(d, 1, 0, str.tostring(fast, "#"), text_color=dirC, bgcolor=color.new(#1b2030,0), text_size=size.tiny, text_halign=text.align_right)
    f_cell(d, 1, "Dirección", dirTxt, dirC)
    f_cell(d, 2, "Zona", zona, zCol)
    f_cell(d, 3, "Money Flow", flow, flowC)

// ════════════════════════════════════════════════════════════════════════════
//  MARCA DE AGUA — firma BudAI Cripto
// ════════════════════════════════════════════════════════════════════════════
f_wmPos(s) => s == "Inferior Izquierda" ? position.bottom_left : s == "Inferior Derecha" ? position.bottom_right : s == "Superior Izquierda" ? position.top_left : position.top_right
var table wm = table.new(f_wmPos(wmPos), 1, 1, bgcolor=color.new(color.black, 100))
if showWM and barstate.islast
    table.cell(wm, 0, 0, "₿ BudAI Capital®", text_color=wmCol, text_size=size.tiny)

// ════════════════════════════════════════════════════════════════════════════
//  ALERTAS
// ════════════════════════════════════════════════════════════════════════════
alertcondition(strongUp, "Tidal OS (compra)", "Tidal · giro fuerte alcista {{ticker}}")
alertcondition(strongDn, "Tidal OB (venta)",  "Tidal · giro fuerte bajista {{ticker}}")
