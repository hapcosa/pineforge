//@version=6
// ██████╗ ██╗   ██╗██████╗  █████╗ ██╗
// ██╔══██╗██║   ██║██╔══██╗██╔══██╗██║
// ██████╔╝██║   ██║██║  ██║███████║██║
// ██╔══██╗██║   ██║██║  ██║██╔══██║██║
// ██████╔╝╚██████╔╝██████╔╝██║  ██║██║
// ╚═════╝  ╚═════╝ ╚═════╝ ╚═╝  ╚═╝╚═╝
//         C R I P T O   ·   T R A D I N G   C A P I T A L
// ────────────────────────────────────────────────────────────────────────────
//  BudAI Capital® - Maya · Hybrid (CRT × SMC)
//  Fusiona Candle Range Theory con Smart Money Concepts en una sola decisión.
//  El barrido del rango (liquidez BSL/SSL) sólo gatilla con confluencia de
//  desplazamiento, sesgo EMA, Fair Value Gap a favor (FVG/IFVG, mínimos) y la
//  zona del Maya Oscillator (discount/premium) leída por input.source.
//  Estética sublime: líneas finísimas, FVG diminutos, entrada como nodo glow.
//  Veredicto con score: LONG / SHORT / NO TRADE.
//  (c) BudAI Capital® — Pine v6 · overlay
// ────────────────────────────────────────────────────────────────────────────
indicator("BudAI Capital® - Maya · Hybrid", shorttitle="Maya Hyb", overlay=true, max_boxes_count=60, max_labels_count=200, max_lines_count=200)

// ════════════════ GRUPOS ════════════════
G_RNG  = "① Rango / Modo"
G_SWP  = "② Barrido (CRT)"
G_CONF = "③ Confluencia (SMC + filtros)"
G_OSC  = "④ Conexión Maya Oscillator"
G_RISK = "⑤ Riesgo / Objetivos"
G_VIS  = "⑥ Estética"
G_DASH = "⑦ Dashboard"
G_COL  = "⑧ Paleta"

// ════════════════ ① RANGO ════════════════
preset    = input.string("Swing (Diario)", "Modo", options=["Swing (Diario)","Position (Semanal)","Intradía (4H)","Manual"], group=G_RNG, tooltip="Vela superior que marca la liquidez. Debe coincidir con el Maya Oscillator.")
manualTf  = input.timeframe("D", "TF manual del rango", group=G_RNG)
sigMode   = input.string("Confirmado", "Modo de señal", options=["Confirmado","Tiempo Real"], group=G_RNG)

// ════════════════ ② BARRIDO ════════════════
atrLen    = input.int(14, "Longitud ATR", minval=1, group=G_SWP)
sweepPen  = input.float(0.05, "Penetración mínima ×ATR", minval=0.0, maxval=1.0, step=0.01, group=G_SWP)
needClose = input.bool(true, "Cierre de vuelta dentro del rango", group=G_SWP)
confMode  = input.string("Displacement", "Confirmación", options=["Displacement","Reclaim 50%","Cierre dentro"], group=G_SWP)
dispMult  = input.float(1.0, "Desplazamiento mínimo ×ATR", minval=0.1, step=0.1, group=G_SWP)
confWin   = input.int(4, "Ventana de confirmación (velas)", minval=1, maxval=30, group=G_SWP)
oneTrade  = input.bool(true, "Una operación por vela de rango", group=G_SWP)

// ════════════════ ③ CONFLUENCIA ════════════════
useEma    = input.bool(true, "Filtro de sesgo EMA", group=G_CONF)
emaLen    = input.int(50, "Longitud EMA", minval=5, group=G_CONF)
fvgFilter = input.string("No oponerse", "Filtro FVG (SMC)", options=["Off","No oponerse","Exigir soporte"], group=G_CONF)
fvgMinAtr = input.float(0.25, "Tamaño mínimo del FVG ×ATR", minval=0.0, step=0.05, group=G_CONF)
showFvg   = input.bool(true, "Dibujar FVG / IFVG (mínimos)", group=G_CONF)
fvgLen    = input.int(6, "Ancho del FVG (velas)", minval=2, maxval=30, group=G_CONF, tooltip="Cajas pequeñas: sólo informan dónde está el desequilibrio, no acaparan el gráfico.")
maxFvg    = input.int(8, "FVG activos máximos", minval=2, maxval=30, group=G_CONF)

// ════════════════ ④ OSCILADOR ════════════════
useOsc    = input.bool(false, "Validar con Maya Oscillator", group=G_OSC, tooltip="Conecta abajo la onda 0-100 del Maya Oscillator. LONG en discount, SHORT en premium.")
oscWave   = input.source(close, "Onda 0-100 del Maya Oscillator", group=G_OSC)
oscDisc   = input.float(55, "Umbral discount (LONG ≤)", minval=0, maxval=100, group=G_OSC)
oscPrem   = input.float(45, "Umbral premium (SHORT ≥)", minval=0, maxval=100, group=G_OSC)

// ════════════════ ⑤ RIESGO ════════════════
slBuf     = input.float(0.2, "Colchón del SL ×ATR", minval=0.0, step=0.05, group=G_RISK)
tpMode    = input.string("Rango Opuesto", "Objetivo (TP)", options=["Rango Opuesto","R Fijo"], group=G_RISK)
rFixed    = input.float(3.0, "R objetivo (R Fijo)", minval=1.0, step=0.5, group=G_RISK)
minR      = input.float(2.0, "R mínimo para validar", minval=0.0, step=0.5, group=G_RISK)

// ════════════════ ⑥ ESTÉTICA ════════════════
showRange = input.bool(true, "Caja del rango activo", group=G_VIS)
keepN     = input.int(2, "Rangos previos a recordar", minval=0, maxval=10, group=G_VIS)
showMid   = input.bool(true, "Línea de equilibrio (50%)", group=G_VIS)
showEmaP  = input.bool(true, "EMA con glow (rayo)", group=G_VIS)
showSig   = input.bool(true, "Nodos de entrada", group=G_VIS)
showLevels= input.bool(true, "Líneas Entrada / SL / TP", group=G_VIS)
lvlBars   = input.int(30, "Largo de líneas (velas)", minval=5, maxval=200, group=G_VIS)

// ════════════════ ⑦ DASHBOARD ════════════════
showDash  = input.bool(true, "Dashboard", group=G_DASH)
dashLoc   = input.string("Arriba Derecha", "Ubicación", options=["Arriba Derecha","Abajo Derecha","Arriba Izquierda","Abajo Izquierda"], group=G_DASH)
dashBg    = input.color(color.new(#0b0e16, 10), "Fondo", group=G_DASH)

// ════════════════ ⑧ PALETA ════════════════
palette = input.string("Oro vs Violeta", "Paleta Bull/Bear", options=["Cyan vs Magenta","Oro vs Violeta","Verde Lima vs Naranja","Blanco vs Carbón","Menta vs Coral","Eléctrico BudAI","Aqua vs Rubí"], group=G_COL)
cEmaU = input.color(#00e5ff, "EMA alcista (cian)", group=G_COL, inline="m")
cEmaD = input.color(#ff6a00, "EMA bajista (naranjo)", group=G_COL, inline="m")
cLiq  = input.color(#ffb300, "Rango / liquidez (ámbar)", group=G_COL)
cIfvg = input.color(#b388ff, "IFVG (violeta)", group=G_COL)
cNeu  = input.color(#90a4ae, "Neutral (gris)", group=G_COL)
cWhite= input.color(#ffffff, "Núcleo (blanco)", group=G_COL)

color cBull = palette == "Oro vs Violeta" ? #ffe600 : palette == "Verde Lima vs Naranja" ? #39ff14 : palette == "Blanco vs Carbón" ? #ffffff : palette == "Menta vs Coral" ? #00ffc4 : palette == "Eléctrico BudAI" ? #00e5ff : palette == "Aqua vs Rubí" ? #18ffff : #00f0ff
color cBear = palette == "Oro vs Violeta" ? #9d00ff : palette == "Verde Lima vs Naranja" ? #ff4500 : palette == "Blanco vs Carbón" ? #4a4a4a : palette == "Menta vs Coral" ? #ff5757 : palette == "Eléctrico BudAI" ? #ff1e6e : palette == "Aqua vs Rubí" ? #ff1744 : #ff007a
color cFvgU = cBull
color cFvgD = cBear

// ════════════════════════════════════════════════════════════════════════════
//  NÚCLEO
// ════════════════════════════════════════════════════════════════════════════
bool  act = sigMode == "Tiempo Real" or barstate.isconfirmed
float atr = ta.atr(atrLen)
float ema = ta.ema(close, emaLen)

string rangeTf = preset == "Swing (Diario)" ? "D" : preset == "Position (Semanal)" ? "W" : preset == "Intradía (4H)" ? "240" : manualTf
[rangeHigh, rangeLow] = request.security(syminfo.tickerid, rangeTf, [high[1], low[1]], lookahead=barmerge.lookahead_off)
bool  newRange = timeframe.change(rangeTf)
bool  validR   = not na(rangeHigh) and not na(rangeLow) and rangeHigh > rangeLow
float rangeMid = (rangeHigh + rangeLow) / 2.0

// ════════════════════════════════════════════════════════════════════════════
//  SMC — FVG / IFVG (cajas mínimas)
// ════════════════════════════════════════════════════════════════════════════
type FVG
    box   bx
    float top
    float bot
    int   dir
    bool  inv
    bool  dead

var array<FVG> fvgs = array.new<FVG>()

f_addFvg(int dir, float top, float bot) =>
    color c = dir == 1 ? cFvgU : cFvgD
    box bx = na
    if showFvg
        bx := box.new(bar_index - 1, top, bar_index + fvgLen, bot, border_color=color.new(c, 72), border_width=1, bgcolor=color.new(c, 90))
    FVG nf = FVG.new(bx, top, bot, dir, false, false)
    array.push(fvgs, nf)
    if array.size(fvgs) > maxFvg
        FVG old = array.shift(fvgs)
        box.delete(old.bx)

bool bullFvg = low > high[2] and (low - high[2]) >= fvgMinAtr * atr
bool bearFvg = high < low[2] and (low[2] - high) >= fvgMinAtr * atr

if barstate.isconfirmed
    if bullFvg
        f_addFvg(1, low, high[2])
    if bearFvg
        f_addFvg(-1, low[2], high)

int fvgBias = 0
if array.size(fvgs) > 0
    for i = array.size(fvgs) - 1 to 0
        FVG f = array.get(fvgs, i)
        if f.dead
            continue
        if not f.inv
            bool flip = (f.dir == 1 and close < f.bot) or (f.dir == -1 and close > f.top)
            if flip
                f.inv := true
                if not na(f.bx)
                    box.set_bgcolor(f.bx, color.new(cIfvg, 88))
                    box.set_border_color(f.bx, color.new(cIfvg, 58))
        else
            bool kill = (f.dir == 1 and close > f.top) or (f.dir == -1 and close < f.bot)
            if kill
                f.dead := true
                box.delete(f.bx)
        if not f.dead and close <= f.top and close >= f.bot
            fvgBias := f.inv ? -f.dir : f.dir

// ════════════════════════════════════════════════════════════════════════════
//  ESTADO DEL MODELO CRT
// ════════════════════════════════════════════════════════════════════════════
var int   st         = 0
var float swExt      = na
var float armConf    = na
var int   armBar     = na
var bool  tradedThis = false
var int   phase      = 0
var int   tDir   = 0
var float tEntry = na
var float tSL    = na
var float tTP    = na
var float tR     = na

if newRange and act
    st := 0
    swExt := na
    armConf := na
    tradedThis := false
    phase := 0

bool penUp   = (rangeLow - low)  >= sweepPen * atr
bool penDn   = (high - rangeHigh) >= sweepPen * atr
bool bullSwp = validR and not tradedThis and low  < rangeLow  and penUp and (needClose ? close > rangeLow  : true)
bool bearSwp = validR and not tradedThis and high > rangeHigh and penDn and (needClose ? close < rangeHigh : true)

bool emaLongOk  = not useEma or close > ema
bool emaShortOk = not useEma or close < ema
bool fvgLongOk  = fvgFilter == "Off" or (fvgFilter == "Exigir soporte" ? fvgBias == 1 : fvgBias >= 0)
bool fvgShortOk = fvgFilter == "Off" or (fvgFilter == "Exigir soporte" ? fvgBias == -1 : fvgBias <= 0)
bool oscLongOk  = not useOsc or oscWave <= oscDisc
bool oscShortOk = not useOsc or oscWave >= oscPrem

bool bullEntry = false
bool bearEntry = false

if act
    if st != 0 and not na(armBar) and (bar_index - armBar) > confWin
        st := 0
        armConf := na
    if bullSwp and st <= 0
        st := 1
        swExt := low
        armBar := bar_index
        armConf := confMode == "Displacement" ? high + dispMult * atr : confMode == "Reclaim 50%" ? rangeMid : rangeLow
        phase := 1
    if bearSwp and st >= 0
        st := -1
        swExt := high
        armBar := bar_index
        armConf := confMode == "Displacement" ? low - dispMult * atr : confMode == "Reclaim 50%" ? rangeMid : rangeHigh
        phase := 1
    if st == 1 and validR
        bool trig = confMode == "Cierre dentro" ? close > rangeLow : (bar_index > armBar and close >= armConf)
        if trig and emaLongOk and fvgLongOk and oscLongOk
            float entry = close
            float sl    = swExt - slBuf * atr
            float risk  = entry - sl
            float tp    = tpMode == "Rango Opuesto" ? rangeHigh : entry + rFixed * risk
            float rr    = risk > 0 ? (tp - entry) / risk : 0.0
            if risk > 0 and rr >= minR
                bullEntry := true
                tDir := 1
                tEntry := entry
                tSL := sl
                tTP := tp
                tR := rr
                tradedThis := oneTrade
                phase := 2
                st := 0
        else if trig
            st := 0
    if st == -1 and validR
        bool trig = confMode == "Cierre dentro" ? close < rangeHigh : (bar_index > armBar and close <= armConf)
        if trig and emaShortOk and fvgShortOk and oscShortOk
            float entry = close
            float sl    = swExt + slBuf * atr
            float risk  = sl - entry
            float tp    = tpMode == "Rango Opuesto" ? rangeLow : entry - rFixed * risk
            float rr    = risk > 0 ? (entry - tp) / risk : 0.0
            if risk > 0 and rr >= minR
                bearEntry := true
                tDir := -1
                tEntry := entry
                tSL := sl
                tTP := tp
                tR := rr
                tradedThis := oneTrade
                phase := 2
                st := 0
        else if trig
            st := 0

// ════════════════════════════════════════════════════════════════════════════
//  CAJA DEL RANGO (fina)
// ════════════════════════════════════════════════════════════════════════════
var box curBox = na
var line midLn = na
var array<box> oldBoxes = array.new_box()

if newRange and act
    if not na(curBox)
        box.set_bgcolor(curBox, color.new(cLiq, 98))
        box.set_border_color(curBox, color.new(cLiq, 85))
        array.push(oldBoxes, curBox)
        if array.size(oldBoxes) > keepN
            box.delete(array.shift(oldBoxes))
    curBox := na

if showRange and validR
    if na(curBox)
        curBox := box.new(bar_index, rangeHigh, bar_index + 2, rangeLow, border_color=color.new(cLiq, 50), border_width=1, bgcolor=color.new(cLiq, 95))
    else
        box.set_top(curBox, rangeHigh)
        box.set_bottom(curBox, rangeLow)
        box.set_right(curBox, bar_index + 2)

if showMid and validR and barstate.islast
    if not na(midLn)
        line.delete(midLn)
    midLn := line.new(bar_index - 1, rangeMid, bar_index + 2, rangeMid, color=color.new(cLiq, 58), width=1, style=line.style_dotted)

// ════════════════════════════════════════════════════════════════════════════
//  EMA estilo rayo
// ════════════════════════════════════════════════════════════════════════════
color emaCol = close > ema ? cEmaU : cEmaD
plot(showEmaP ? ema : na, "EMA halo",  color=color.new(emaCol, 82), linewidth=3)
plot(showEmaP ? ema : na, "EMA línea", color=color.new(emaCol, 0),  linewidth=1)
plot(showEmaP ? ema : na, "EMA núcleo",color=color.new(cWhite, 40), linewidth=1)

// ════════════════════════════════════════════════════════════════════════════
//  NODOS DE ENTRADA (el único elemento destacado, con glow)
// ════════════════════════════════════════════════════════════════════════════
float bullY = showSig and bullEntry ? low  - 0.6 * atr : na
float bearY = showSig and bearEntry ? high + 0.6 * atr : na
plotshape(bullY, "LONG glow", shape.circle, location.absolute, color.new(cBull, 60), size=size.large)
plotshape(bullY, "LONG core", shape.circle, location.absolute, color.new(cBull, 0),  size=size.small)
plotshape(bearY, "SHORT glow",shape.circle, location.absolute, color.new(cBear, 60), size=size.large)
plotshape(bearY, "SHORT core",shape.circle, location.absolute, color.new(cBear, 0),  size=size.small)

if (bullEntry or bearEntry) and showSig
    color sc = bullEntry ? cBull : cBear
    float ly = bullEntry ? bullY : bearY
    label.new(bar_index, ly, (bullEntry ? "LONG " : "SHORT ") + str.tostring(tR, "#.#") + "R", style=bullEntry ? label.style_label_up : label.style_label_down, color=color.new(sc, 10), textcolor=cWhite, size=size.small)

// ════════════════════════════════════════════════════════════════════════════
//  LÍNEAS ENTRADA / SL / TP (finísimas, rayo)
// ════════════════════════════════════════════════════════════════════════════
var line lnEh = na
var line lnE  = na
var line lnS  = na
var line lnT  = na
var label lbS = na
var label lbT = na

if showLevels and (bullEntry or bearEntry)
    line.delete(lnEh)
    line.delete(lnE)
    line.delete(lnS)
    line.delete(lnT)
    label.delete(lbS)
    label.delete(lbT)
    color dc = tDir == 1 ? cBull : cBear
    int x2 = bar_index + lvlBars
    lnEh := line.new(bar_index, tEntry, x2, tEntry, color=color.new(dc, 72),  width=2)
    lnE  := line.new(bar_index, tEntry, x2, tEntry, color=color.new(cWhite, 20), width=1)
    lnS  := line.new(bar_index, tSL,    x2, tSL,    color=color.new(cBear, 40), width=1, style=line.style_dashed)
    lnT  := line.new(bar_index, tTP,    x2, tTP,    color=color.new(cBull, 40), width=1, style=line.style_dashed)
    lbS  := label.new(x2, tSL, "SL", style=label.style_label_left, color=color.new(cBear, 90), textcolor=cBear, size=size.tiny)
    lbT  := label.new(x2, tTP, "TP " + str.tostring(tR, "#.#") + "R", style=label.style_label_left, color=color.new(cBull, 90), textcolor=cBull, size=size.tiny)

// ════════════════════════════════════════════════════════════════════════════
//  DASHBOARD — confluencia con score
// ════════════════════════════════════════════════════════════════════════════
int  dirNow = st == 1 ? 1 : st == -1 ? -1 : tDir != 0 and phase == 2 ? tDir : 0
bool eOk = dirNow == 1 ? emaLongOk  : dirNow == -1 ? emaShortOk : false
bool fOk = dirNow == 1 ? fvgLongOk  : dirNow == -1 ? fvgShortOk : false
bool oOk = dirNow == 1 ? oscLongOk  : dirNow == -1 ? oscShortOk : false
int  score = (dirNow != 0 ? 1 : 0) + (eOk ? 1 : 0) + (fOk ? 1 : 0) + (oOk ? 1 : 0)

string verdict = na(rangeHigh) ? "NO TRADE" : phase == 2 and tDir == 1 ? "LONG" : phase == 2 and tDir == -1 ? "SHORT" : st == 1 ? "ARMANDO LONG" : st == -1 ? "ARMANDO SHORT" : "NO TRADE"
color  vCol    = verdict == "LONG" or verdict == "ARMANDO LONG" ? cBull : verdict == "SHORT" or verdict == "ARMANDO SHORT" ? cBear : cNeu
string fvgTxt  = fvgBias == 1 ? "Soporte" : fvgBias == -1 ? "Resistencia" : "—"

f_chip(bool ok, bool active) =>
    not active ? "·" : ok ? "✓" : "✗"

if showDash and barstate.islast
    string pos = dashLoc == "Arriba Derecha" ? position.top_right : dashLoc == "Abajo Derecha" ? position.bottom_right : dashLoc == "Arriba Izquierda" ? position.top_left : position.bottom_left
    var table tb = table.new(pos, 2, 6, bgcolor=dashBg, frame_color=color.new(cNeu, 62), frame_width=1, border_color=color.new(cNeu, 82), border_width=1)
    table.cell(tb, 0, 0, "Maya · " + rangeTf, text_color=cIfvg, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 1, 0, verdict, text_color=vCol, text_size=size.small, text_halign=text.align_right)
    table.cell(tb, 0, 1, "Confluencia", text_color=cNeu, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tb, 1, 1, str.tostring(score) + " / 4", text_color=score >= 3 ? cBull : score == 2 ? cLiq : cNeu, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tb, 0, 2, "EMA", text_color=cNeu, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tb, 1, 2, f_chip(eOk, useEma and dirNow != 0), text_color=eOk ? cBull : cBear, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tb, 0, 3, "FVG (" + fvgTxt + ")", text_color=cNeu, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tb, 1, 3, f_chip(fOk, fvgFilter != "Off" and dirNow != 0), text_color=fOk ? cBull : cBear, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tb, 0, 4, "Oscilador", text_color=cNeu, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tb, 1, 4, f_chip(oOk, useOsc and dirNow != 0), text_color=oOk ? cBull : cBear, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tb, 0, 5, "Último R", text_color=cNeu, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tb, 1, 5, na(tR) ? "—" : str.tostring(tR, "#.#") + "R", text_color=cWhite, text_size=size.tiny, text_halign=text.align_right)

// ════════════════════════════════════════════════════════════════════════════
//  ALERTAS
// ════════════════════════════════════════════════════════════════════════════
alertcondition(bullEntry, title="Maya Hybrid LONG",  message="Maya LONG · {{ticker}} — barrido SSL + confluencia")
alertcondition(bearEntry, title="Maya Hybrid SHORT", message="Maya SHORT · {{ticker}} — barrido BSL + confluencia")
