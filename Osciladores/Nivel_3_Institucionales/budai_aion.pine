//@version=6
// ██████╗ ██╗   ██╗██████╗  █████╗ ██╗
// ██╔══██╗██║   ██║██╔══██╗██╔══██╗██║
// ██████╔╝██║   ██║██║  ██║███████║██║
// ██╔══██╗██║   ██║██║  ██║██╔══██║██║
// ██████╔╝╚██████╔╝██████╔╝██║  ██║██║
// ╚═════╝  ╚═════╝ ╚═════╝ ╚═╝  ╚═╝╚═╝
//         C R I P T O   ·   T R A D I N G   C A P I T A L
// ────────────────────────────────────────────────────────────────────────────
//  BudAI Capital® - Aion · MTF Confluence Grid
//  Corre el motor de confluencia (momentum + money flow + tendencia + center of
//  gravity + calidad) en tres temporalidades y las resume en una tabla semáforo.
//  Responde de un vistazo: ¿están alineadas las temporalidades para operar?
//  (c) BudAI Capital® — Pine v6 · panel sobre precio
// ────────────────────────────────────────────────────────────────────────────
indicator("BudAI Capital® - Aion", shorttitle="BudAI · Aion", overlay=true, max_labels_count=50, max_lines_count=50)

// ════════════════════════════════════════════════════════════════════════════
//  GRUPOS
// ════════════════════════════════════════════════════════════════════════════
G_PROF = "① Perfil del Motor"
G_TF   = "② Temporalidades"
G_W    = "③ Pesos de Confluencia"
G_VIS  = "④ Visual"
G_COL  = "⑤ Colores"
G_WM   = "✦ Marca de agua"

// ════════════════ ① PERFIL ════════════════
profile = input.string("Day Trader", "Perfil", options=["Scalper","Day Trader","Swing Trader"], group=G_PROF, tooltip="Ajusta longitudes y umbral del motor en cada temporalidad.")
src     = input.source(hlc3, "Fuente", group=G_PROF)

bool isScalp = profile == "Scalper"
bool isDay   = profile == "Day Trader"

int chanLen  = isScalp ? 7  : isDay ? 9  : 13
int avgLen   = isScalp ? 9  : isDay ? 12 : 21
int volLen   = isScalp ? 14 : isDay ? 20 : 34
int trendLen = isScalp ? 21 : isDay ? 34 : 55
int cogLen   = isScalp ? 9  : isDay ? 14 : 21
int erLen    = isScalp ? 10 : isDay ? 14 : 20
int volWin   = 50
float threshold = isScalp ? 56.0 : isDay ? 64.0 : 72.0
float erMin     = isScalp ? 0.20 : isDay ? 0.28 : 0.36
float neutBand  = isScalp ? 6.0  : isDay ? 8.0  : 10.0
int   minAgree  = isScalp ? 2    : 3
int   cogOB = 85
int   cogOS = 15

// ════════════════ ② TEMPORALIDADES ════════════════
tf1 = input.timeframe("15",  "TF 1 (rápida)", group=G_TF)
tf2 = input.timeframe("60",  "TF 2 (media)", group=G_TF)
tf3 = input.timeframe("240", "TF 3 (alta)", group=G_TF)

// ════════════════ ③ PESOS ════════════════
wMom   = input.float(25, "Peso Momentum %", minval=0, maxval=100, group=G_W, inline="w1")
wVol   = input.float(20, "Peso Money Flow %", minval=0, maxval=100, group=G_W, inline="w1")
wTrend = input.float(20, "Peso Tendencia %", minval=0, maxval=100, group=G_W, inline="w2")
wCog   = input.float(15, "Peso Center of Gravity %", minval=0, maxval=100, group=G_W, inline="w2")

// ════════════════ ④ VISUAL ════════════════
gridPos = input.string("Arriba Derecha", "Posición tabla", options=["Arriba Derecha","Arriba Izquierda","Abajo Derecha","Abajo Izquierda"], group=G_VIS)
txtSize = input.string("Pequeño", "Tamaño texto", options=["Diminuto","Pequeño","Normal"], group=G_VIS)
showScore = input.bool(true, "Mostrar columna Score", group=G_VIS)

// ════════════════ ⑤ COLORES ════════════════
upCol  = input.color(#00e5ff, "Bull (cian neón)", group=G_COL, inline="c")
dnCol  = input.color(#ff6a00, "Bear (naranjo neón)", group=G_COL, inline="c")
neutCol= input.color(#90a4ae, "No Trade (gris)", group=G_COL)
strongCol = input.color(#ffffff, "Alineación total (blanco)", group=G_COL)

// ════════════════ ✦ MARCA DE AGUA ════════════════
showWM = input.bool(true, "Mostrar firma BudAI Cripto", group=G_WM)
wmPos  = input.string("Inferior Derecha", "Posición", options=["Inferior Izquierda","Inferior Derecha","Superior Izquierda","Superior Derecha"], group=G_WM)
wmCol  = input.color(color.new(#b6f400, 35), "Color", group=G_WM)


// ════════════════════════════════════════════════════════════════════════════
//  FUNCIONES BASE
// ════════════════════════════════════════════════════════════════════════════
f_norm(float s, simple int len) =>
    float lo = ta.lowest(s, len)
    float hi = ta.highest(s, len)
    hi - lo != 0 ? 100.0 * (s - lo) / (hi - lo) : 50.0

f_clamp(float v, float lo, float hi) => math.max(lo, math.min(hi, v))

f_gridPos(s) => (s == "Arriba Derecha" ? position.top_right : s == "Arriba Izquierda" ? position.top_left : s == "Abajo Derecha" ? position.bottom_right : position.bottom_left)
f_wmPos(s) => s == "Inferior Izquierda" ? position.bottom_left : s == "Inferior Derecha" ? position.bottom_right : s == "Superior Izquierda" ? position.top_left : position.top_right
f_size(s) => s == "Diminuto" ? size.tiny : s == "Normal" ? size.normal : size.small


// ════════════════════════════════════════════════════════════════════════════
//  MOTOR DE CONFLUENCIA (núcleo Siddharta condensado) — devuelve [estado, score]
//  Se evalúa en el contexto de cada temporalidad vía request.security.
// ════════════════════════════════════════════════════════════════════════════
f_engine() =>
    // A · Momentum (WaveTrend)
    float esa = ta.ema(src, chanLen)
    float de  = ta.ema(math.abs(src - esa), chanLen)
    float ci  = de == 0 ? 0.0 : (src - esa) / (0.015 * de)
    float wt  = ta.ema(ci, avgLen)
    float momS = f_clamp((f_norm(wt, 100) - 50) / 50, -1, 1)
    // B · Money Flow
    float vol = nz(volume) == 0 ? 1.0 : volume
    float mfm = (high - low) != 0 ? ((close - low) - (high - close)) / (high - low) : 0.0
    float cmf = math.sum(mfm * vol, volLen) / math.sum(vol, volLen)
    float volN = f_clamp(50 + cmf * 50, 0, 100) * 0.5 + ta.mfi(hlc3, volLen) * 0.5
    float volS = f_clamp((volN - 50) / 50, -1, 1)
    // C · Tendencia
    float atr = ta.atr(14)
    float ma  = ta.hma(src, trendLen)
    float trendS = f_clamp(atr != 0 ? (ma - ma[2]) / (atr * 0.9) : 0, -1, 1)
    // D · Center of Gravity
    float cgNum = 0.0
    float cgDen = 0.0
    for i = 0 to cogLen - 1
        float p = src[i]
        cgNum := cgNum + (1 + i) * p
        cgDen := cgDen + p
    float cg = cgDen != 0 ? -cgNum / cgDen + (cogLen + 1) / 2.0 : 0.0
    float cogN = f_norm(ta.sma(cg, 3), 100)
    float cogS = f_clamp((cogN - 50) / 50, -1, 1)
    // Calidad
    float natr = close != 0 ? atr / close : 0.0
    float volQ = f_norm(natr, volWin) / 100.0
    float change = math.abs(close - close[erLen])
    float noise  = math.sum(math.abs(close - close[1]), erLen)
    float er = noise != 0 ? change / noise : 0.0
    float qual = (volQ + er) / 2.0
    // Confluencia
    float wSum = wMom + wVol + wTrend + wCog
    float net = wSum > 0 ? (wMom * momS + wVol * volS + wTrend * trendS + wCog * cogS) / wSum : 0.0
    int dir = net > 0 ? 1 : net < 0 ? -1 : 0
    float score = math.round(100 * (0.8 * math.abs(net) + 0.2 * qual))
    float comp = 50 + net * 50
    int agUp = (momS > 0 ? 1 : 0) + (volS > 0 ? 1 : 0) + (trendS > 0 ? 1 : 0) + (cogS > 0 ? 1 : 0)
    int agDn = (momS < 0 ? 1 : 0) + (volS < 0 ? 1 : 0) + (trendS < 0 ? 1 : 0) + (cogS < 0 ? 1 : 0)
    int agree = dir > 0 ? agUp : dir < 0 ? agDn : 0
    bool lateral = er < erMin or math.abs(comp - 50) <= neutBand
    bool blocked = lateral or volQ < 0.15 or agree < minAgree
    bool vetoL = cogN >= cogOB or trendS < -0.5
    bool vetoS = cogN <= cogOS or trendS > 0.5
    int st = (dir > 0 and score >= threshold and not blocked and not vetoL) ? 1 : (dir < 0 and score >= threshold and not blocked and not vetoS) ? -1 : 0
    [st, score]

// Evaluación por temporalidad (lookahead_off → sin futuro; los valores HTF cierran en su barra)
[st1, sc1] = request.security(syminfo.tickerid, tf1, f_engine(), lookahead = barmerge.lookahead_off)
[st2, sc2] = request.security(syminfo.tickerid, tf2, f_engine(), lookahead = barmerge.lookahead_off)
[st3, sc3] = request.security(syminfo.tickerid, tf3, f_engine(), lookahead = barmerge.lookahead_off)


// ════════════════════════════════════════════════════════════════════════════
//  CONSENSO
// ════════════════════════════════════════════════════════════════════════════
int longs  = (st1 == 1 ? 1 : 0) + (st2 == 1 ? 1 : 0) + (st3 == 1 ? 1 : 0)
int shorts = (st1 == -1 ? 1 : 0) + (st2 == -1 ? 1 : 0) + (st3 == -1 ? 1 : 0)
int consensus = longs == 3 ? 1 : shorts == 3 ? -1 : 0
bool fullLong  = consensus == 1
bool fullShort = consensus == -1
bool majLong   = longs >= 2 and shorts == 0
bool majShort  = shorts >= 2 and longs == 0

string consTxt = fullLong ? "ALINEADO LONG" : fullShort ? "ALINEADO SHORT" : majLong ? "Sesgo LONG" : majShort ? "Sesgo SHORT" : "MIXTO · NO TRADE"
color  consCol = fullLong ? upCol : fullShort ? dnCol : majLong ? color.new(upCol, 40) : majShort ? color.new(dnCol, 40) : neutCol

// Transiciones (alertas)
bool toFullLong  = fullLong and not fullLong[1]
bool toFullShort = fullShort and not fullShort[1]


// ════════════════════════════════════════════════════════════════════════════
//  TABLA SEMÁFORO
// ════════════════════════════════════════════════════════════════════════════
f_stTxt(int s) => s == 1 ? "LONG" : s == -1 ? "SHORT" : "NO TRADE"
f_stCol(int s) => s == 1 ? upCol : s == -1 ? dnCol : neutCol

var table g = table.new(f_gridPos(gridPos), 3, 6, bgcolor=color.new(#0b0e16, 8), frame_color=color.new(upCol, 50), frame_width=1, border_color=color.new(#1b2030, 30), border_width=1)

f_row(int r, string tf, int st, float sc) =>
    color c = f_stCol(st)
    table.cell(g, 0, r, tf, text_color=color.new(#cfd8dc, 0), text_size=f_size(txtSize), text_halign=text.align_left)
    table.cell(g, 1, r, f_stTxt(st), text_color=c, bgcolor=color.new(c, 82), text_size=f_size(txtSize), text_halign=text.align_center)
    if showScore
        table.cell(g, 2, r, str.tostring(sc, "#"), text_color=sc >= threshold ? c : color.new(#90a4ae, 0), text_size=f_size(txtSize), text_halign=text.align_right)

if barstate.islast
    // Encabezado
    table.cell(g, 0, 0, "AION", text_color=color.white, bgcolor=color.new(#1b2030, 0), text_size=f_size(txtSize), text_halign=text.align_left)
    table.cell(g, 1, 0, profile, text_color=color.new(#cfd8dc, 0), bgcolor=color.new(#1b2030, 0), text_size=f_size(txtSize), text_halign=text.align_center)
    table.cell(g, 2, 0, showScore ? "Sc" : "", text_color=color.new(#90a4ae, 0), bgcolor=color.new(#1b2030, 0), text_size=f_size(txtSize), text_halign=text.align_right)
    // Filas por temporalidad
    f_row(1, tf1, st1, sc1)
    f_row(2, tf2, st2, sc2)
    f_row(3, tf3, st3, sc3)
    // Consenso (resaltado)
    table.cell(g, 0, 4, "Consenso", text_color=color.new(#cfd8dc, 0), bgcolor=color.new(#11151f, 0), text_size=f_size(txtSize), text_halign=text.align_left)
    table.cell(g, 1, 4, consTxt, text_color=fullLong or fullShort ? strongCol : consCol, bgcolor=color.new(consCol, fullLong or fullShort ? 55 : 80), text_size=f_size(txtSize), text_halign=text.align_center)
    table.cell(g, 2, 4, str.tostring(longs) + "↑" + str.tostring(shorts) + "↓", text_color=consCol, bgcolor=color.new(#11151f, 0), text_size=f_size(txtSize), text_halign=text.align_right)
    // Lectura operativa
    string read = fullLong or fullShort ? "Confluencia total" : majLong or majShort ? "Confluencia parcial" : "Esperar alineación"
    table.cell(g, 0, 5, "Lectura", text_color=color.new(#90a4ae, 0), text_size=f_size(txtSize), text_halign=text.align_left)
    table.cell(g, 1, 5, read, text_color=consCol, text_size=f_size(txtSize), text_halign=text.align_center)
    table.cell(g, 2, 5, "", text_color=neutCol, text_size=f_size(txtSize))


// ════════════════ ✦ MARCA DE AGUA ════════════════
var table wm = table.new(f_wmPos(wmPos), 1, 1, bgcolor=color.new(color.black, 100))
if showWM and barstate.islast
    table.cell(wm, 0, 0, "₿ BudAI Cripto", text_color=wmCol, text_size=size.tiny)


// ════════════════════════════════════════════════════════════════════════════
//  ALERTAS
// ════════════════════════════════════════════════════════════════════════════
alertcondition(toFullLong,  "Aion · Alineación LONG total",  "Aion · 3 temporalidades alineadas LONG {{ticker}}")
alertcondition(toFullShort, "Aion · Alineación SHORT total", "Aion · 3 temporalidades alineadas SHORT {{ticker}}")
alertcondition(majLong and not majLong[1],  "Aion · Sesgo LONG (2 de 3)",  "Aion · Sesgo LONG mayoritario {{ticker}}")
alertcondition(majShort and not majShort[1], "Aion · Sesgo SHORT (2 de 3)", "Aion · Sesgo SHORT mayoritario {{ticker}}")
