//@version=6
// ██████╗ ██╗   ██╗██████╗  █████╗ ██╗
// ██╔══██╗██║   ██║██╔══██╗██╔══██╗██║
// ██████╔╝██║   ██║██║  ██║███████║██║
// ██╔══██╗██║   ██║██║  ██║██╔══██║██║
// ██████╔╝╚██████╔╝██████╔╝██║  ██║██║
// ╚═════╝  ╚═════╝ ╚═════╝ ╚═╝  ╚═╝╚═╝
//         C R I P T O   ·   T R A D I N G   C A P I T A L
// ────────────────────────────────────────────────────────────────────────────
//  BudAI Capital® - Coil
//  Squeeze de volatilidad (BB dentro de Keltner) + momentum con glow neón.
//  Compresión = resorte cargando energía → disparo al liberarse.
//  (c) BudAI Capital® — Pine v6 · estética futurista limpia
// ────────────────────────────────────────────────────────────────────────────
indicator("BudAI Capital® - Coil", shorttitle="BudAI Capital® - Coil", overlay=false, precision=2, max_labels_count=200)

// ════════════════ GRUPOS ════════════════
G_CORE = "① Squeeze (BB / KC)"
G_MOM  = "② Momentum"
G_SIG  = "④ Señales"
G_VIS  = "⑤ Estética"
G_WM   = "✦ Marca de agua"

// ════════════════ ① SQUEEZE ════════════════
bbLen  = input.int(20, "BB Longitud", group=G_CORE, inline="bb")
bbMult = input.float(2.0, "Mult", step=0.1, group=G_CORE, inline="bb")
kcLen  = input.int(20, "KC Longitud", group=G_CORE, inline="kc")
kcMult = input.float(1.5, "Mult", step=0.1, group=G_CORE, inline="kc")
useTR  = input.bool(true, "Usar True Range", group=G_CORE)

// ════════════════ ② MOMENTUM ════════════════
momLen   = input.int(20, "Momentum Longitud", group=G_MOM)
srcInput = input.source(close, "Fuente", group=G_MOM)

// ════════════════ ④ SEÑALES ════════════════
showFire = input.bool(true, "Disparo al liberar squeeze", group=G_SIG)

// ════════════════ ⑤ ESTÉTICA ════════════════
upStrong = input.color(#00c853, "Mom + creciente", group=G_VIS, inline="m1")
upWeak   = input.color(#1b5e20, "Mom + decreciente", group=G_VIS, inline="m1")
dnStrong = input.color(#ff1744, "Mom − cayendo", group=G_VIS, inline="m2")
dnWeak   = input.color(#7f0000, "Mom − recuperando", group=G_VIS, inline="m2")
sqzOnCol = input.color(#ffea00, "Squeeze ON", group=G_VIS, inline="s")
sqzNoCol = input.color(#607d8b, "Squeeze OFF", group=G_VIS, inline="s")
sigUpCol = input.color(#ffea00, "Señal alcista (arriba)", group=G_VIS, inline="sg")
sigDnCol = input.color(#9e9e9e, "Señal bajista (arriba)", group=G_VIS, inline="sg")
neon     = input.bool(true, "Glow neón", group=G_VIS)
showDash = input.bool(true, "Dashboard minimalista", group=G_VIS)
dashPos  = input.string("Arriba Derecha", "Posición", options=["Arriba Derecha","Arriba Izquierda","Abajo Derecha","Abajo Izquierda"], group=G_VIS)

// ════════════════ ✦ MARCA DE AGUA ════════════════
showWM = input.bool(true, "Mostrar firma BudAI Cripto", group=G_WM)
wmPos  = input.string("Inferior Derecha", "Posición", options=["Inferior Izquierda","Inferior Derecha","Superior Izquierda","Superior Derecha"], group=G_WM)
wmCol  = input.color(color.new(#b6f400, 35), "Color", group=G_WM)

// ════════════════════════════════════════════════════════════════════════════
//  SQUEEZE — BB dentro de Keltner = compresión
// ════════════════════════════════════════════════════════════════════════════
float basis = ta.sma(srcInput, bbLen)
float dev   = bbMult * ta.stdev(srcInput, bbLen)
float bbUpper = basis + dev
float bbLower = basis - dev

float kcMa = ta.sma(srcInput, kcLen)
float kcRange = useTR ? ta.tr(true) : (high - low)
float kcRangeMa = ta.sma(kcRange, kcLen)
float kcUpper = kcMa + kcRangeMa * kcMult
float kcLower = kcMa - kcRangeMa * kcMult

bool sqzOn  = bbLower > kcLower and bbUpper < kcUpper
bool sqzOff = bbLower < kcLower and bbUpper > kcUpper

// ════════════════════════════════════════════════════════════════════════════
//  MOMENTUM — regresión lineal
// ════════════════════════════════════════════════════════════════════════════
float hh = ta.highest(high, momLen)
float ll = ta.lowest(low, momLen)
float avgHL = ((hh + ll) / 2.0 + ta.sma(close, momLen)) / 2.0
float mom = ta.linreg(srcInput - avgHL, momLen, 0)
color momColor = mom > 0 ? (mom > nz(mom[1]) ? upStrong : upWeak) : (mom < nz(mom[1]) ? dnStrong : dnWeak)

// ════════════════════════════════════════════════════════════════════════════
//  PLOTS
// ════════════════════════════════════════════════════════════════════════════
plot(mom, "Momentum", momColor, style=plot.style_columns, histbase=0)
plot(neon ? mom : na, "Glow", color.new(momColor, 80), style=plot.style_columns, histbase=0)
hline(0, "Cero", color.new(color.gray, 60), hline.style_solid)
color dotCol = sqzOn ? sqzOnCol : sqzOff ? sqzNoCol : color.new(#90a4ae, 45)
plot(0, "Squeeze", color=dotCol, style=plot.style_circles, linewidth=2)

// ════════════════════════════════════════════════════════════════════════════
//  SEÑALES — disparo al liberar (con momentum a favor)
// ════════════════════════════════════════════════════════════════════════════
bool released = sqzOn[1] and not sqzOn
bool fireUp = showFire and released and mom > 0 and barstate.isconfirmed
bool fireDn = showFire and released and mom < 0 and barstate.isconfirmed
plotchar(fireUp, "Disparo ↑", "•", location.top, color=sigUpCol, size=size.tiny)
plotchar(fireDn, "Disparo ↓", "•", location.top, color=sigDnCol, size=size.tiny)

var int sqzBars = 0
sqzBars := sqzOn ? sqzBars + 1 : 0

// ════════════════════════════════════════════════════════════════════════════
//  DASHBOARD minimalista (tiny)
// ════════════════════════════════════════════════════════════════════════════
f_pos(s) => (s == "Arriba Derecha" ? position.top_right : s == "Arriba Izquierda" ? position.top_left : s == "Abajo Derecha" ? position.bottom_right : position.bottom_left)
var table d = table.new(f_pos(dashPos), 2, 4, bgcolor=color.new(#0b0e16, 14), frame_color=color.new(#546e7a, 40), frame_width=1, border_width=1)
f_cell(t, r, k, v, vc) =>
    table.cell(t, 0, r, k, text_color=color.new(#90a4ae, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1, r, v, text_color=vc, text_size=size.tiny, text_halign=text.align_right)
if showDash and barstate.islast
    string sqState = sqzOn ? "COMPRIMIDO (" + str.tostring(sqzBars) + ")" : sqzOff ? "LIBERADO" : "neutro"
    color  sqCol = sqzOn ? sqzOnCol : sqzOff ? upStrong : color.new(#90a4ae, 0)
    string momTxt = mom > 0 ? "▲ Alcista" : "▼ Bajista"
    color  momTxtC = mom > 0 ? upStrong : dnStrong
    string sesgo = mom > 0 and mom > nz(mom[1]) ? "Comprando fuerte" : mom > 0 ? "Comprando débil" : mom < 0 and mom < nz(mom[1]) ? "Vendiendo fuerte" : "Vendiendo débil"
    table.cell(d, 0, 0, "Coil", text_color=color.white, bgcolor=color.new(#1b2030,0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(d, 1, 0, str.tostring(mom, "#.##"), text_color=momColor, bgcolor=color.new(#1b2030,0), text_size=size.tiny, text_halign=text.align_right)
    f_cell(d, 1, "Squeeze",  sqState, sqCol)
    f_cell(d, 2, "Momentum", momTxt,  momTxtC)
    f_cell(d, 3, "Presión",  sesgo,   momColor)

// ════════════════════════════════════════════════════════════════════════════
//  MARCA DE AGUA — firma BudAI Cripto
// ════════════════════════════════════════════════════════════════════════════
f_wmPos(s) => s == "Inferior Izquierda" ? position.bottom_left : s == "Inferior Derecha" ? position.bottom_right : s == "Superior Izquierda" ? position.top_left : position.top_right
var table wm = table.new(f_wmPos(wmPos), 1, 1, bgcolor=color.new(color.black, 100))
if showWM and barstate.islast
    table.cell(wm, 0, 0, "₿ BudAI Cripto", text_color=wmCol, text_size=size.tiny)

// ════════════════════════════════════════════════════════════════════════════
//  ALERTAS
// ════════════════════════════════════════════════════════════════════════════
alertcondition(fireUp, "Coil libera ↑", "Coil · breakout alcista {{ticker}}")
alertcondition(fireDn, "Coil libera ↓", "Coil · breakout bajista {{ticker}}")
alertcondition(sqzOn and not sqzOn[1], "Entra en compresión", "Coil · squeeze ON {{ticker}}")
