simple bool alrtSqzLoose  = input.bool(false, "Loose Squeeze",
     group   = GRP_ALRT,
     tooltip = "Fires when stdev drops below ATR × 1.0 — mild compression. OFF by default.")

simple bool alrtDivReg    = input.bool(true,  "Regular Divergence",
