//@version=6
// ██████╗ ██╗   ██╗██████╗  █████╗ ██╗
// ██╔══██╗██║   ██║██╔══██╗██╔══██╗██║
// ██████╔╝██║   ██║██║  ██║███████║██║
// ██╔══██╗██║   ██║██║  ██║██╔══██║██║
// ██████╔╝╚██████╔╝██████╔╝██║  ██║██║
// ╚═════╝  ╚═════╝ ╚═════╝ ╚═╝  ╚═╝╚═╝
//         C R I P T O   ·   T R A D I N G   C A P I T A L
// ────────────────────────────────────────────────────────────────────────────
//  BudAI Capital® - Abyss Oscillator  (Paso 2 · Fase 1 Osciladores)
//  WaveTrend con círculos OB/OS estilo institucional (fuerte = círculo · simple = ×).
//  Glow futurista, Money Flow, divergencias. Inspirado en Nautilus (recreado).
//  (c) BudAI Capital - Pine v6 - estetica futurista limpia
// ────────────────────────────────────────────────────────────────────────────
indicator("BudAI Capital® - Abyss Oscillator", shorttitle="BudAI Capital® - Abyss Oscillator", overlay=false, precision=1, max_labels_count=300, max_lines_count=100)

// ════════════════ GRUPOS ════════════════
G_CORE = "① Núcleo (WaveTrend)"
G_MF   = "② Money Flow"
G_LVL  = "③ Niveles OB / OS"
G_SIG  = "④ Señales"
G_VIS  = "⑤ Estética"
G_WM   = "✦ Marca de agua"

// ════════════════ ① NÚCLEO ════════════════
chanLen = input.int(9,  "Canal", minval=3, maxval=50, group=G_CORE, tooltip="WaveTrend. 9-10 scalping, 21 swing.")
avgLen  = input.int(12, "Promedio", minval=2, maxval=50, group=G_CORE)
trigLen = input.int(3,  "Trigger (señal)", minval=1, maxval=20, group=G_CORE)
src     = input.source(hlc3, "Fuente", group=G_CORE)

// ════════════════ ② MONEY FLOW ════════════════
showMF = input.bool(true, "Histograma Money Flow", group=G_MF)
mfLen  = input.int(14, "Money Flow len", minval=2, maxval=50, group=G_MF)

// ════════════════ ③ NIVELES ════════════════
obLvl  = input.int(60,  "Sobrecompra",  minval=20, maxval=98, group=G_LVL, inline="l")
osLvl  = input.int(-60, "Sobreventa",   minval=-98, maxval=-20, group=G_LVL, inline="l")
obX    = input.int(53,  "Sobrecompra extrema",  minval=20, maxval=98, group=G_LVL, inline="x")
osX    = input.int(-53, "Sobreventa extrema",   minval=-98, maxval=-20, group=G_LVL, inline="x")

// ════════════════ ④ SEÑALES ════════════════
showDots = input.bool(true, "Círculos OB/OS (giros)", group=G_SIG, tooltip="Círculo = señal fuerte (cruce en zona extrema). × = señal simple (cruce normal en zona).")
showX    = input.bool(true, "× señales simples", group=G_SIG)
reqMF    = input.bool(true, "Validar con Money Flow a favor", group=G_SIG)
showDiv  = input.bool(true, "Divergencias", group=G_SIG)
divLen   = input.int(5, "Pivote divergencia", minval=2, maxval=20, group=G_SIG)

// ════════════════ ⑤ ESTÉTICA (paleta BudAI) ════════════════
upCol   = input.color(#00c853, "Línea alcista", group=G_VIS, inline="ln")
dnCol   = input.color(#ff1744, "Línea bajista", group=G_VIS, inline="ln")
sigUp   = input.color(#00e5ff, "Señal alcista (cian)", group=G_VIS, inline="sg")
sigDn   = input.color(#b388ff, "Señal bajista (púrpura)", group=G_VIS, inline="sg")
divUpCol = input.color(#ffea00, "Divergencia alcista (amarillo)", group=G_VIS, inline="dv")
divDnCol = input.color(#9e9e9e, "Divergencia bajista (gris)", group=G_VIS, inline="dv")
glow    = input.bool(true, "Glow futurista", group=G_VIS)
showDash= input.bool(true, "Dashboard minimalista", group=G_VIS)
dashPos = input.string("Arriba Derecha", "Posición", options=["Arriba Derecha","Arriba Izquierda","Abajo Derecha","Abajo Izquierda"], group=G_VIS)

// ════════════════ ✦ MARCA DE AGUA ════════════════
showWM = input.bool(true, "Mostrar firma BudAI Cripto", group=G_WM)
wmPos  = input.string("Inferior Derecha", "Posición", options=["Inferior Izquierda","Inferior Derecha","Superior Izquierda","Superior Derecha"], group=G_WM)
wmCol  = input.color(color.new(#b6f400, 35), "Color", group=G_WM)

// ════════════════════════════════════════════════════════════════════════════
//  NÚCLEO — WaveTrend (escala ±100)
// ════════════════════════════════════════════════════════════════════════════
float esa = ta.ema(src, chanLen)
float de  = ta.ema(math.abs(src - esa), chanLen)
float ci  = de == 0 ? 0.0 : (src - esa) / (0.015 * de)
float wt1 = ta.ema(ci, avgLen)
float wt2 = ta.sma(wt1, trigLen)
float wtClamp = math.max(-100.0, math.min(100.0, wt1))
float wtTrig  = math.max(-100.0, math.min(100.0, wt2))

bool isBull = wt1 >= wt2
bool isBear = wt1 < wt2

// Money Flow (CMF) para validar señales
float mfm = (high - low) != 0 ? ((close - low) - (high - close)) / (high - low) : 0.0
float vol = nz(volume) == 0 ? 1.0 : volume
float cmf = math.sum(mfm * vol, mfLen) / math.sum(vol, mfLen)
float mfiHist = ta.mfi(hlc3, mfLen) - 50.0   // -50..+50 centrado

// ════════════════════════════════════════════════════════════════════════════
//  NIVELES — líneas finas, sin background
// ════════════════════════════════════════════════════════════════════════════
hline(0,     "Centro",       color.new(color.gray, 70), hline.style_solid)
hline(obLvl, "Sobrecompra",  color.new(dnCol, 70), hline.style_dotted)
hline(osLvl, "Sobreventa",   color.new(upCol, 70), hline.style_dotted)
hline(obX,   "OB extrema",   color.new(dnCol, 88), hline.style_dotted)
hline(osX,   "OS extrema",   color.new(upCol, 88), hline.style_dotted)

// ════════════════════════════════════════════════════════════════════════════
//  PLOTS — línea + glow futurista (capas semitransparentes)
// ════════════════════════════════════════════════════════════════════════════
color oscCol = isBull ? upCol : dnCol
plot(showMF ? mfiHist : na, "Money Flow", color=cmf >= 0 ? color.new(upCol, 75) : color.new(dnCol, 75), style=plot.style_columns, histbase=0)

pTrig = plot(wtTrig, "Trigger", color=color.new(color.gray, 55), linewidth=1)
pOsc  = plot(wtClamp, "Abyss", color=oscCol, linewidth=2)
// glow: 2 capas finas alrededor de la línea
pG1u = plot(glow ? wtClamp + 4 : na, "g1u", color=color.new(color.white,100), display=display.none)
pG1d = plot(glow ? wtClamp - 4 : na, "g1d", color=color.new(color.white,100), display=display.none)
pG2u = plot(glow ? wtClamp + 9 : na, "g2u", color=color.new(color.white,100), display=display.none)
pG2d = plot(glow ? wtClamp - 9 : na, "g2d", color=color.new(color.white,100), display=display.none)
color gIn  = isBull ? color.new(upCol, 80) : color.new(dnCol, 80)
color gOut = isBull ? color.new(upCol, 92) : color.new(dnCol, 92)
fill(pOsc, pG1u, top_color=color.new(color.white,100), bottom_color=glow ? gIn : color.new(color.white,100), title="glow in up")
fill(pG1d, pOsc, top_color=glow ? gIn : color.new(color.white,100), bottom_color=color.new(color.white,100), title="glow in dn")
fill(pG1u, pG2u, top_color=color.new(color.white,100), bottom_color=glow ? gOut : color.new(color.white,100), title="glow out up")
fill(pG2d, pG1d, top_color=glow ? gOut : color.new(color.white,100), bottom_color=color.new(color.white,100), title="glow out dn")
// cuerpo fino entre osc y trigger
fill(pOsc, pTrig, color=isBull ? color.new(upCol, 86) : color.new(dnCol, 86), title="cuerpo")

// ════════════════════════════════════════════════════════════════════════════
//  SEÑALES — círculos (fuerte) y × (simple), estilo Nautilus
// ════════════════════════════════════════════════════════════════════════════
bool crossUp = ta.crossover(wt1, wt2)
bool crossDn = ta.crossunder(wt1, wt2)
bool flowUp  = not reqMF or cmf > 0
bool flowDn  = not reqMF or cmf < 0
bool conf    = barstate.isconfirmed

// fuerte = cruce en zona EXTREMA · simple = cruce en zona normal (no extrema)
bool strongUp = crossUp and wt1 <= osX and flowUp and conf
bool strongDn = crossDn and wt1 >= obX and flowDn and conf
bool simpleUp = crossUp and wt1 <= osLvl and wt1 > osX and flowUp and conf
bool simpleDn = crossDn and wt1 >= obLvl and wt1 < obX and flowDn and conf

// círculos fuertes pegados a la línea
plotshape(showDots and strongUp ? wtClamp : na, "Giro fuerte ↑", shape.circle, location.absolute, color=sigUp, size=size.tiny)
plotshape(showDots and strongDn ? wtClamp : na, "Giro fuerte ↓", shape.circle, location.absolute, color=sigDn, size=size.tiny)
// × simples
plotchar(showX and simpleUp ? wtClamp : na, "Simple ↑", "×", location.absolute, color=color.new(sigUp, 25), size=size.tiny)
plotchar(showX and simpleDn ? wtClamp : na, "Simple ↓", "×", location.absolute, color=color.new(sigDn, 25), size=size.tiny)

// ── divergencias ──
float dpl = ta.pivotlow(low,  divLen, divLen)
float dph = ta.pivothigh(high, divLen, divLen)
var float pLo1 = na
var float pLo2 = na
var float oLo1 = na
var float oLo2 = na
var float pHi1 = na
var float pHi2 = na
var float oHi1 = na
var float oHi2 = na
if not na(dpl)
    pLo2 := pLo1
    pLo1 := dpl
    oLo2 := oLo1
    oLo1 := wtClamp[divLen]
if not na(dph)
    pHi2 := pHi1
    pHi1 := dph
    oHi2 := oHi1
    oHi1 := wtClamp[divLen]
bool bullDiv = showDiv and not na(dpl) and not na(pLo2) and pLo1 < pLo2 and oLo1 > oLo2 and conf
bool bearDiv = showDiv and not na(dph) and not na(pHi2) and pHi1 > pHi2 and oHi1 < oHi2 and conf
// divergencias = círculos diminutos · amarillo bullish · gris bearish
plotshape(bullDiv ? wtClamp : na, "Div+", shape.circle, location.absolute, color=divUpCol, size=size.tiny)
plotshape(bearDiv ? wtClamp : na, "Div−", shape.circle, location.absolute, color=divDnCol, size=size.tiny)

// ════════════════════════════════════════════════════════════════════════════
//  DASHBOARD minimalista (tiny)
// ════════════════════════════════════════════════════════════════════════════
f_pos(s) => (s == "Arriba Derecha" ? position.top_right : s == "Arriba Izquierda" ? position.top_left : s == "Abajo Derecha" ? position.bottom_right : position.bottom_left)
var table d = table.new(f_pos(dashPos), 2, 4, bgcolor=color.new(#0b0e16, 14), frame_color=color.new(#546e7a, 40), frame_width=1, border_width=1)
f_cell(t, r, k, v, vc) =>
    table.cell(t, 0, r, k, text_color=color.new(#90a4ae, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1, r, v, text_color=vc, text_size=size.tiny, text_halign=text.align_right)

if showDash and barstate.islast
    string zona = wt1 >= obX ? "OB EXTREMA" : wt1 >= obLvl ? "Sobrecompra" : wt1 <= osX ? "OS EXTREMA" : wt1 <= osLvl ? "Sobreventa" : "Neutro"
    color  zCol = wt1 >= obLvl ? dnCol : wt1 <= osLvl ? upCol : color.new(#90a4ae,0)
    string dir = isBull ? "▲ Alcista" : "▼ Bajista"
    color  dirC = isBull ? upCol : dnCol
    string flow = cmf > 0 ? "ACUMULA" : "DISTRIB"
    color  flowC = cmf > 0 ? upCol : dnCol
    table.cell(d, 0, 0, "Abyss", text_color=color.white, bgcolor=color.new(#1b2030,0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(d, 1, 0, str.tostring(wt1, "#.#"), text_color=oscCol, bgcolor=color.new(#1b2030,0), text_size=size.tiny, text_halign=text.align_right)
    f_cell(d, 1, "Zona",       zona, zCol)
    f_cell(d, 2, "Dirección",  dir,  dirC)
    f_cell(d, 3, "Money Flow", flow, flowC)

// ════════════════════════════════════════════════════════════════════════════
//  MARCA DE AGUA — firma BudAI Cripto
// ════════════════════════════════════════════════════════════════════════════
f_wmPos(s) => s == "Inferior Izquierda" ? position.bottom_left : s == "Inferior Derecha" ? position.bottom_right : s == "Superior Izquierda" ? position.top_left : position.top_right
var table wm = table.new(f_wmPos(wmPos), 1, 1, bgcolor=color.new(color.black, 100))
if showWM and barstate.islast
    table.cell(wm, 0, 0, "₿ BudAI Cripto", text_color=wmCol, text_size=size.tiny)

// ════════════════════════════════════════════════════════════════════════════
//  ALERTAS
// ════════════════════════════════════════════════════════════════════════════
alertcondition(strongUp, "Giro fuerte alcista", "Abyss · giro fuerte ↑ {{ticker}}")
alertcondition(strongDn, "Giro fuerte bajista", "Abyss · giro fuerte ↓ {{ticker}}")
alertcondition(bullDiv,  "Divergencia alcista", "Abyss · divergencia ▲ {{ticker}}")
alertcondition(bearDiv,  "Divergencia bajista", "Abyss · divergencia ▼ {{ticker}}")
