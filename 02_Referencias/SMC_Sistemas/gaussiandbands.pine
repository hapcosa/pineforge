// 🛠️  HELPERS (funciones puras — NO mutan variables globales)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
f_fmtPrice(float p) =>
    p >= 1000.0 ? str.tostring(p, "#.#") : p >= 1.0 ? str.tostring(p, "#.###") : str.tostring(p, "#.######")

f_lbl(string nm, float price, float pctClose) =>
    string pctTxt = pctClose > 0 ? " (" + str.tostring(pctClose, "#") + "%)" : ""
    nm + ": " + f_fmtPrice(price) + pctTxt

f_slLbl(string nm, float price) =>
    nm + ": " + f_fmtPrice(price)

f_clamp01(float x) =>
    math.max(0.0, math.min(1.0, x))

f_nearestAbove(array<float> lvls, float price) =>
    float best = na
    float bestDist = 1e10
    int n = array.size(lvls)
    if n > 0
        for i = 0 to n - 1
            float v = array.get(lvls, i)
            if v >= price
                float d = v - price
                if d < bestDist
                    bestDist := d
                    best := v
    best

f_nearestBelow(array<float> lvls, float price) =>
    float best = na
    float bestDist = 1e10
    int n = array.size(lvls)
    if n > 0
        for i = 0 to n - 1
            float v = array.get(lvls, i)
            if v <= price
                float d = price - v
                if d < bestDist
                    bestDist := d
                    best := v
    best

f_recentBearSweep(float lvl, int lb) =>
    bool ok = false
    if not na(lvl)
        for k = 0 to lb - 1
            if high[k] > lvl and close[k] < lvl
                ok := true
    ok

f_recentBullSweep(float lvl, int lb) =>
    bool ok = false
    if not na(lvl)
        for k = 0 to lb - 1
            if low[k] < lvl and close[k] > lvl
                ok := true
    ok

f_adaptiveHTF(bool isBull, int tpNum, int tfSec, float h1h, float h1l, float h4h, float h4l, float pdh, float pdl, float pwh, float pwl) =>
    float result = na
    if tfSec <= 900
        result := tpNum == 1 ? (isBull ? h1h : h1l) : tpNum == 2 ? (isBull ? h4h : h4l) : tpNum == 3 ? (isBull ? pdh : pdl) : (isBull ? pwh : pwl)
    else if tfSec <= 3600
        result := tpNum == 1 ? (isBull ? h4h : h4l) : tpNum == 2 ? (isBull ? pdh : pdl) : (isBull ? pwh : pwl)
    else
        result := tpNum == 1 ? (isBull ? pdh : pdl) : (isBull ? pwh : pwl)
    result

f_snap(float base, float rTarget, bool isBull, float htfLvl, float structLvl) =>
    if targetModeCfg == "R Multiples"
        rTarget
    else
        float snap = rTarget
        float tol = math.abs(rTarget - base) * (snapPctCfg / 100.0)
        bool validHTF    = not na(htfLvl)    and (isBull ? htfLvl    > base : htfLvl    < base) and math.abs(htfLvl    - rTarget) < tol
        bool validStruct = not na(structLvl) and (isBull ? structLvl > base : structLvl < base) and math.abs(structLvl - rTarget) < tol
        if targetModeCfg == "Liquidez/HTF"
            if validHTF
                snap := htfLvl
            else if validStruct
                snap := structLvl
        else
            if validStruct
                snap := structLvl
            else if validHTF
                snap := htfLvl
        snap

f_trackSigLabel(label lbl) =>
    if array.size(sigLabels) >= maxSigLabels
        label.delete(array.shift(sigLabels))
    array.push(sigLabels, lbl)
    lbl

f_sigLabel(int x, float y, string txt, color bgCol, color txtCol, string stl, string sz) =>
    label lbl = na
    bool szNormal = sz == "normal"
    bool szSmall  = sz == "small"
    if stl == "down"
        lbl := label.new(x, y, txt, color=bgCol, textcolor=txtCol, size=szNormal ? size.normal : szSmall ? size.small : size.tiny, style=label.style_label_down)
    else if stl == "upper_right"
        lbl := label.new(x, y, txt, color=bgCol, textcolor=txtCol, size=szNormal ? size.normal : szSmall ? size.small : size.tiny, style=label.style_label_upper_right)
    else if stl == "lower_right"
        lbl := label.new(x, y, txt, color=bgCol, textcolor=txtCol, size=szNormal ? size.normal : szSmall ? size.small : size.tiny, style=label.style_label_lower_right)
    else if stl == "right"
        lbl := label.new(x, y, txt, color=bgCol, textcolor=txtCol, size=szNormal ? size.normal : szSmall ? size.small : size.tiny, style=label.style_label_right)
    else
        lbl := label.new(x, y, txt, color=bgCol, textcolor=txtCol, size=szNormal ? size.normal : szSmall ? size.small : size.tiny, style=label.style_label_up)
    f_trackSigLabel(lbl)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 📈  BASE SERIES & MTF
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
float atrSL     = ta.atr(atrLen)
float atr200    = ta.atr(200)
float volSma20  = ta.sma(volume, 20)
float atrSma50  = ta.sma(atrSL, 50)
float atrStable = nz(ta.sma(atr200, 200), nz(atrSL, close * 0.01)) * 0.8
int   tfSec     = timeframe.in_seconds()

float h1h = request.security(syminfo.tickerid, "60",  high[1], lookahead=barmerge.lookahead_off)
float h1l = request.security(syminfo.tickerid, "60",  low[1],  lookahead=barmerge.lookahead_off)
