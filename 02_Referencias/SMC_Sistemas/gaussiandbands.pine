float pwl = request.security(syminfo.tickerid, "W",   low[1],  lookahead=barmerge.lookahead_off)

bool htfBull = request.security(syminfo.tickerid, autoHTF, close > ta.ema(close, 200), lookahead=barmerge.lookahead_off)
bool m5Bull  = request.security(syminfo.tickerid, "5",   close > ta.ema(close, 200), lookahead=barmerge.lookahead_off)
bool m15Bull = request.security(syminfo.tickerid, "15",  close > ta.ema(close, 200), lookahead=barmerge.lookahead_off)
