//@version=6
indicator("Gaussian Trend IA Pro Fusion v6.3 [Indicator]", overlay=true, max_labels_count=500, max_lines_count=500)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🧭  PRESETS OPERATIVOS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
string opProfile = input.string("Base TV", "Perfil operativo", options=["Base TV", "Memecoins", "Majors", "Manual"], group="🧭  PRESETS", tooltip="Base TV replica el setup general. Memecoins es mas agresivo. Majors es mas conservador. Manual usa tus inputs.")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🌊  GAUSSIAN KERNEL
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
int    len       = input.int(20, "Length", minval=5, inline="g1", group="🌊  GAUSSIAN KERNEL")
string mode      = input.string("AVG", "Mode", options=["AVG","MEDIAN","TRIMMED"], inline="g1", group="🌊  GAUSSIAN KERNEL")
float  distance  = input.float(1.0, "Dist", step=0.1, inline="g1", group="🌊  GAUSSIAN KERNEL")
color  up        = input.color(color.rgb(40,218,150), "Up", inline="g2", group="🌊  GAUSSIAN KERNEL")
color  dn        = input.color(#287bda, "Down", inline="g2", group="🌊  GAUSSIAN KERNEL")
bool   useDashed = input.bool(false, "Línea discontinua", group="🌊  GAUSSIAN KERNEL")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🖼  VISUAL V3.2
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
bool showAiTags  = input.bool(true,  "Mostrar Etiquetas AI",  group="🖼  VISUAL V3.2")
bool showVidya   = input.bool(false, "Mostrar Bandas VIDYA",  group="🖼  VISUAL V3.2")
bool showLiqGrab = input.bool(false, "Trampas de Liquidez",   group="🖼  VISUAL V3.2")
bool showHama    = input.bool(false, "Filtro Visual HAMA",    group="🖼  VISUAL V3.2")
bool showWarnM15 = input.bool(true,  "Warning Panel M15",     group="🖼  VISUAL V3.2")
bool show_long   = input.bool(true,  "Long",     inline="sig1", group="🖼  SEÑALES VISUALES")
bool show_short  = input.bool(true,  "Short",    inline="sig1", group="🖼  SEÑALES VISUALES")
bool show_retest = input.bool(true,  "Retest",   inline="sig1", group="🖼  SEÑALES VISUALES")
bool show_entry2 = input.bool(true,  "Entry 2",  inline="sig2", group="🖼  SEÑALES VISUALES")
bool show_strong = input.bool(true,  "Strong",   inline="sig2", group="🖼  SEÑALES VISUALES")
bool showReentry = input.bool(true,  "Re-entry", inline="sig2", group="🖼  SEÑALES VISUALES")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🧠  V6 EXTREME ENGINE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
bool   useAdaptiveSigma = input.bool(true, "Sigma Dinámico Cuántico", group="🧠  V6 EXTREME ENGINE")
float  sigmaBase        = input.float(10.0, "Sigma Base", minval=3.0, maxval=20.0, step=0.5, group="🧠  V6 EXTREME ENGINE")
float  sigmaMin         = input.float(5.0,  "Sigma Mín",  minval=2.0, maxval=10.0, step=0.5, group="🧠  V6 EXTREME ENGINE")
float  sigmaMax         = input.float(18.0, "Sigma Máx",  minval=10.0, maxval=30.0, step=1.0, group="🧠  V6 EXTREME ENGINE")

bool   useADXFilter  = input.bool(false, "Filtro ADX Institucional", group="📊  ADX TREND STRENGTH")
int    adxLen        = input.int(14, "ADX Length", minval=7, maxval=50, group="📊  ADX TREND STRENGTH")
float  adxThreshold  = input.float(25.0, "ADX Umbral Mínimo", minval=15.0, maxval=40.0, step=1.0, group="📊  ADX TREND STRENGTH")
bool   useDMIConfirm = input.bool(false, "Confirmar con DI+/DI-", group="📊  ADX TREND STRENGTH")

bool   useSMCFilter    = input.bool(false, "Smart Money Structure v2", group="🏴️  MARKET STRUCTURE")
bool   showBOS         = input.bool(true,  "Mostrar BOS/CHoCH", group="🏴️  MARKET STRUCTURE")
int    swingStrength   = input.int(5, "Swing Strength", minval=2, maxval=15, group="🏴️  MARKET STRUCTURE")
float  smcBreakAtrMult = input.float(0.10, "Buffer BOS (xATR)", minval=0.0, maxval=1.0, step=0.05, group="🏴️  MARKET STRUCTURE")
int    smcFreshBars    = input.int(12, "Ventana fresca", minval=1, maxval=50, group="🏴️  MARKET STRUCTURE")

bool   useVolumeAbsorption = input.bool(true, "Detección de Absorción", group="📈  VOLUME DELTA")
float  absorptionThreshold = input.float(1.5, "Umbral Absorción", minval=1.0, maxval=3.0, step=0.1, group="📈  VOLUME DELTA")
bool   showAbsorptionMarks = input.bool(true, "Mostrar Marcas Absorción", group="📈  VOLUME DELTA")

bool   useMultiOsc = input.bool(true,  "Multi-Oscillator Confluence", group="🖼  OSCILLATOR CONFLUENCE")
bool   useRSI      = input.bool(false, "Usar RSI",        group="🖼  OSCILLATOR CONFLUENCE")
bool   useStoch    = input.bool(false, "Usar Stochastic", group="🖼  OSCILLATOR CONFLUENCE")
bool   useCCI      = input.bool(false, "Usar CCI",        group="🖼  OSCILLATOR CONFLUENCE")
int    rsiLen      = input.int(14, "RSI Length", minval=5, maxval=30, group="🖼  OSCILLATOR CONFLUENCE")
int    stochLen    = input.int(14, "Stochastic Length", minval=5, maxval=30, group="🖼  OSCILLATOR CONFLUENCE")
int    cciLen      = input.int(20, "CCI Length", minval=10, maxval=50, group="🖼  OSCILLATOR CONFLUENCE")
float  rsiOversold   = input.float(35, "RSI Oversold",  minval=20, maxval=45, group="🖼  OSCILLATOR CONFLUENCE")
float  rsiOverbought = input.float(65, "RSI Overbought", minval=55, maxval=80, group="🖼  OSCILLATOR CONFLUENCE")

bool   useKillZones  = input.bool(true,  "Kill Zones Institucionales", group="⏰  KILL ZONES")
bool   kzLondonOpen  = input.bool(true,  "London Open (07-10 UTC)",    group="⏰  KILL ZONES")
bool   kzNYOpen      = input.bool(true,  "NY Open (12-15 UTC)",        group="⏰  KILL ZONES")
bool   kzLondonClose = input.bool(false, "London Close (15-17 UTC)",   group="⏰  KILL ZONES")
bool   kzAsiaSession = input.bool(false, "Asia Session (00-03 UTC)",   group="⏰  KILL ZONES")

bool   useHTFAlignment     = input.bool(true,  "Alineación HTF",         group="🧭  REGIME FILTERS")
bool   requireDualHTF      = input.bool(true,  "Requerir 2 HTF",         group="🧭  REGIME FILTERS")
bool   useTrendSlopeFilter = input.bool(true,  "Filtro de pendiente",    group="🧭  REGIME FILTERS")
float  minTrendSlopeATR    = input.float(0.12, "Pendiente mínima (ATR)", minval=0.0, maxval=2.0, step=0.01, group="🧭  REGIME FILTERS")
bool   useBandWidthFilter  = input.bool(true,  "Filtro de expansión",    group="🧭  REGIME FILTERS")
float  minBandWidthATR     = input.float(1.10, "Ancho mínimo (ATR)",     minval=0.1, maxval=10.0, step=0.05, group="🧭  REGIME FILTERS")

string slMode             = input.string("Hibrido", "Modo Stop Loss", options=["Trend Line", "Estructura (Swing)", "Hibrido"], group="💧  LIQUIDEZ & TARGETS")
string targetMode         = input.string("Hibrido", "Modo Targets",   options=["R Multiples", "Liquidez/HTF", "Hibrido"],      group="💧  LIQUIDEZ & TARGETS")
bool   useLiquidityFilter = input.bool(true,  "Filtro de liquidez contraria", group="💧  LIQUIDEZ & TARGETS")
bool   requireSweepReject = input.bool(true,  "Bloquear sweep+rechazo",       group="💧  LIQUIDEZ & TARGETS")
int    sweepLookback      = input.int(30,  "Sweep lookback",          minval=5,   maxval=200,  group="💧  LIQUIDEZ & TARGETS")
int    pivotLen           = input.int(3,   "Pivot strength",          minval=2,   maxval=10,   group="💧  LIQUIDEZ & TARGETS")
int    pivHoldBars        = input.int(200, "Vida pivots",             minval=20,  maxval=1000, group="💧  LIQUIDEZ & TARGETS")
float  proxATR            = input.float(1.0,  "Proximidad opuesta (ATR)", minval=0.1, maxval=5.0, step=0.1, group="💧  LIQUIDEZ & TARGETS")
float  breakStrengthMin   = input.float(0.55, "Fuerza mínima de ruptura", minval=0.0, maxval=1.0, step=0.05, group="💧  LIQUIDEZ & TARGETS")
float  snapPct            = input.float(18.0, "Tolerancia snap %",        minval=1.0, maxval=50.0, step=1.0, group="💧  LIQUIDEZ & TARGETS")

bool   useDivergence    = input.bool(true, "Divergencia RSI Avanzada", group="📉  DIVERGENCE ENGINE")
int    divPivotStrength = input.int(5,    "Pivot Strength Div", minval=2, maxval=10, group="📉  DIVERGENCE ENGINE")
bool   showDivergence   = input.bool(true, "Mostrar Divergencias",     group="📉  DIVERGENCE ENGINE")

bool   useChopFilter  = input.bool(true, "Choppiness Index Filter",    group="📐  CHOPPINESS INDEX")
int    chopLen        = input.int(20,    "CI Length", minval=7, maxval=50, group="📐  CHOPPINESS INDEX")
float  chopThreshold  = input.float(50.0,"CI Max (Trend < esto)", minval=35.0, maxval=65.0, step=1.0, group="📐  CHOPPINESS INDEX")

bool   useSqueeze  = input.bool(false, "Squeeze Momentum Filter", group="📅  SQUEEZE MOMENTUM")
int    sqzBBLen    = input.int(20,  "BB Length", minval=10, maxval=50, group="📅  SQUEEZE MOMENTUM")
float  sqzBBMult   = input.float(2.0,"BB Mult",  step=0.1, minval=1.0, maxval=3.0, group="📅  SQUEEZE MOMENTUM")
int    sqzKCLen    = input.int(20,  "KC Length", minval=10, maxval=50, group="📅  SQUEEZE MOMENTUM")
float  sqzKCMult   = input.float(1.5,"KC Mult",  step=0.1, minval=1.0, maxval=3.0, group="📅  SQUEEZE MOMENTUM")
int    sqzLookback = input.int(8,   "Squeeze Lookback", minval=3, maxval=20, group="📅  SQUEEZE MOMENTUM")

bool   useWAE      = input.bool(true, "Waddah Attar Explosion", group="📡  WAE EXPLOSION")
int    waeSens     = input.int(150,  "Sensibilidad", minval=50, maxval=300, step=10, group="📡  WAE EXPLOSION")
int    waeFastLen  = input.int(20,   "MACD Fast", minval=5,  maxval=50,  group="📡  WAE EXPLOSION")
int    waeSlowLen  = input.int(40,   "MACD Slow", minval=20, maxval=100, group="📡  WAE EXPLOSION")
int    waeBBLen    = input.int(20,   "BB Length", minval=10, maxval=50,  group="📡  WAE EXPLOSION")
float  waeBBMult   = input.float(2.0,"BB Mult",   step=0.1, minval=1.0, maxval=3.0, group="📡  WAE EXPLOSION")
float  waeDeadZone = input.float(3.7,"Dead Zone (ATR mult)", step=0.1, minval=0.5, maxval=10.0, group="📡  WAE EXPLOSION")

bool   useFisher     = input.bool(false, "Fisher Transform Filter", group="🎯  FISHER TRANSFORM")
int    fisherLen     = input.int(10,  "Fisher Length",  minval=5, maxval=30, group="🎯  FISHER TRANSFORM")
float  fisherExtreme = input.float(1.5,"Nivel Extremo", step=0.1, minval=0.5, maxval=3.0, group="🎯  FISHER TRANSFORM")

bool   useFrost     = input.bool(true, "IA Frost Engine", group="🤖  IA FROST ENGINE")
int    minFrostConf = input.int(2,    "Min Frost ★ ",    minval=1, maxval=5, group="🤖  IA FROST ENGINE")
string frostMode    = input.string("Intraday", "Modo", options=["Scalping", "Intraday", "Swing"], group="🤖  IA FROST ENGINE")

float  minScoreRatio = input.float(0.35, "Min Score Ratio", minval=0.10, maxval=1.00, step=0.05, group="🧮  V6.2 SCORE ENGINE")

bool   useReEntry  = input.bool(true, "Re-Entry 50/50 Split",    group="🔴  RE-ENTRY SYSTEM")
int    reEntryBars = input.int(6,    "Max Barras Espera", minval=2, maxval=15, group="🔴  RE-ENTRY SYSTEM")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 💸  TARGETS & STOP LOSS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
int    atrLen     = input.int(14,   "ATR",          inline="t1", group="💸  TARGETS & STOP LOSS")
float  maxSLPct   = input.float(6.0,"SL Cap %",     step=0.5, minval=1.0, inline="t1", group="💸  TARGETS & STOP LOSS") / 100.0
float  slBuf      = input.float(0.20,"SL Buf %",    step=0.05, minval=0.05, maxval=1.0, inline="t1", group="💸  TARGETS & STOP LOSS") / 100.0
int    lineExt    = input.int(25,   "Ext Bars",     minval=5, maxval=100, inline="t2", group="💸  TARGETS & STOP LOSS")
bool   showTgts   = input.bool(true, "Targets",     inline="t2", group="💸  TARGETS & STOP LOSS")
bool   showPanel  = input.bool(true, "Panel",       inline="t2", group="💸  TARGETS & STOP LOSS")
string panelPos   = input.string("Sup. Derecha", "Posicion", options=["Sup. Derecha", "Med. Derecha", "Inf. Derecha", "Inf. Centro", "Centro"], inline="t4", group="💸  TARGETS & STOP LOSS")
string panelSize  = input.string("Minimo", "Tamano", options=["Minimo", "Mediano", "Grande"], inline="t4", group="💸  TARGETS & STOP LOSS")
bool   shortLines = input.bool(true, "Lineas cortas", inline="t3", group="💸  TARGETS & STOP LOSS")
float  tp1R = input.float(1.0,   "TP1 (R)",        group="💸  TARGETS & STOP LOSS")
float  tp2R = input.float(2.0,   "TP2 (R)",        group="💸  TARGETS & STOP LOSS")
float  tp3R = input.float(3.0,   "TP3 (R)",        group="💸  TARGETS & STOP LOSS")
float  tp4R = input.float(4.236, "TP4 Runner (R)", group="💸  TARGETS & STOP LOSS")
string tpProfile    = input.string("Conservador", "Perfil TPs", options=["Manual", "Conservador", "Balanceado", "Tendencial"], group="💸  TARGETS & STOP LOSS")
float  pct_tp1_input = input.float(30.0, "% TP1 Manual", group="💸  TARGETS & STOP LOSS")
float  pct_tp2_input = input.float(30.0, "% TP2 Manual", group="💸  TARGETS & STOP LOSS")
float  pct_tp3_input = input.float(20.0, "% TP3 Manual", group="💸  TARGETS & STOP LOSS")
float  feePct = input.float(0.15, "BE Fee % (open+close)", step=0.01, minval=0.05, maxval=1.0, group="🛡️  BREAK EVEN (Risk Free)") / 100.0

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🧭  PRESETS EFECTIVOS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
bool isManualProfile = opProfile == "Manual"
bool isMemeProfile   = opProfile == "Memecoins"
bool isMajorProfile  = opProfile == "Majors"

int    lenCfg  = isManualProfile ? len      : isMemeProfile ? 28   : isMajorProfile ? 42   : 35
string modeCfg = isManualProfile ? mode     : "AVG"
float  distCfg = isManualProfile ? distance : isMemeProfile ? 2.2  : isMajorProfile ? 1.8  : 2.0

bool  useAdaptiveSigmaCfg = isManualProfile ? useAdaptiveSigma : true
float sigmaBaseCfg = isManualProfile ? sigmaBase : isMemeProfile ? 2.5  : isMajorProfile ? 4.0  : 3.0
float sigmaMinCfg  = isManualProfile ? sigmaMin  : isMemeProfile ? 4.5  : isMajorProfile ? 6.0  : 5.0
float sigmaMaxCfg  = isManualProfile ? sigmaMax  : isMemeProfile ? 16.0 : isMajorProfile ? 20.0 : 18.0

bool useADXFilterCfg        = isManualProfile ? useADXFilter        : false
bool useDMIConfirmCfg       = isManualProfile ? useDMIConfirm       : false
bool useSMCFilterCfg        = isManualProfile ? useSMCFilter        : false
bool useMultiOscCfg         = isManualProfile ? useMultiOsc         : true
bool useRSICfg              = isManualProfile ? useRSI              : false
bool useStochCfg            = isManualProfile ? useStoch            : false
bool useCCICfg              = isManualProfile ? useCCI              : false
bool useVolumeAbsorptionCfg = isManualProfile ? useVolumeAbsorption : true
bool useDivergenceCfg       = isManualProfile ? useDivergence       : true
bool useKillZonesCfg        = isManualProfile ? useKillZones  : isMemeProfile ? false : true
bool kzLondonOpenCfg        = isManualProfile ? kzLondonOpen  : true
bool kzNYOpenCfg            = isManualProfile ? kzNYOpen      : true
bool kzLondonCloseCfg       = isManualProfile ? kzLondonClose : false
bool kzAsiaSessionCfg       = isManualProfile ? kzAsiaSession : false
bool useHTFAlignmentCfg     = isManualProfile ? useHTFAlignment     : true
bool requireDualHTFCfg      = isManualProfile ? requireDualHTF : isMemeProfile ? false : true
bool useTrendSlopeFilterCfg = isManualProfile ? useTrendSlopeFilter : true
float minTrendSlopeATRCfg   = isManualProfile ? minTrendSlopeATR : isMemeProfile ? 0.08 : isMajorProfile ? 0.18 : 0.12
bool useBandWidthFilterCfg  = isManualProfile ? useBandWidthFilter  : true
float minBandWidthATRCfg    = isManualProfile ? minBandWidthATR  : isMemeProfile ? 0.90 : isMajorProfile ? 1.25 : 1.10
bool useLiquidityFilterCfg  = isManualProfile ? useLiquidityFilter  : true
bool requireSweepRejectCfg  = isManualProfile ? requireSweepReject  : true
float proxATRCfg            = isManualProfile ? proxATR          : isMemeProfile ? 1.4  : isMajorProfile ? 0.8  : 1.0
float breakStrengthMinCfg   = isManualProfile ? breakStrengthMin : isMemeProfile ? 0.45 : isMajorProfile ? 0.65 : 0.55
float snapPctCfg            = isManualProfile ? snapPct          : isMemeProfile ? 24.0 : isMajorProfile ? 14.0 : 18.0
string slModeCfg            = isManualProfile ? slMode      : "Hibrido"
string targetModeCfg        = isManualProfile ? targetMode  : "Hibrido"
bool useChopFilterCfg       = isManualProfile ? useChopFilter : true
int  chopLenCfg             = isManualProfile ? chopLen       : 20
float chopThresholdCfg      = isManualProfile ? chopThreshold : isMemeProfile ? 52.0 : isMajorProfile ? 48.0 : 50.0
bool useSqueezeCfg          = isManualProfile ? useSqueeze    : false
bool useWAECfg              = isManualProfile ? useWAE        : true
int  waeSensCfg             = isManualProfile ? waeSens    : isMemeProfile ? 130 : isMajorProfile ? 170 : 150
int  waeFastLenCfg          = isManualProfile ? waeFastLen : isMemeProfile ? 16  : isMajorProfile ? 24  : 20
int  waeSlowLenCfg          = isManualProfile ? waeSlowLen : isMemeProfile ? 32  : isMajorProfile ? 48  : 40
float waeDeadZoneCfg        = isManualProfile ? waeDeadZone : isMemeProfile ? 3.2 : isMajorProfile ? 4.0 : 3.7
bool useFisherCfg           = isManualProfile ? useFisher     : false
bool useFrostCfg            = isManualProfile ? useFrost      : true
int  minFrostConfCfg        = isManualProfile ? minFrostConf : isMemeProfile ? 1 : isMajorProfile ? 3 : 2
string frostModeCfg         = isManualProfile ? frostMode : isMemeProfile ? "Scalping" : isMajorProfile ? "Swing" : "Intraday"
float minScoreRatioCfg      = isManualProfile ? minScoreRatio : isMemeProfile ? 0.25 : isMajorProfile ? 0.45 : 0.35
string tpProfileCfg         = isManualProfile ? tpProfile : isMemeProfile ? "Tendencial" : "Conservador"

float pct_tp1 = switch tpProfileCfg
    "Conservador" => 30.0
    "Balanceado"  => 25.0
    "Tendencial"  => 20.0
    => pct_tp1_input
float pct_tp2 = switch tpProfileCfg
    "Conservador" => 30.0
