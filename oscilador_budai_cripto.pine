//@version=6
// ██████╗ ██╗   ██╗██████╗  █████╗ ██╗
// ██╔══██╗██║   ██║██╔══██╗██╔══██╗██║
// ██████╔╝██║   ██║██║  ██║███████║██║
// ██╔══██╗██║   ██║██║  ██║██╔══██║██║
// ██████╔╝╚██████╔╝██████╔╝██║  ██║██║
// ╚═════╝  ╚═════╝ ╚═════╝ ╚═╝  ╚═╝╚═╝
//         C R I P T O   ·   T R A D I N G   C A P I T A L
// ────────────────────────────────────────────────────────────────────────────
//  OSCILADOR - BUDAI CRIPTO  ·  WaveTrend + COG + Money Flow + Momentum
//  Círculos en extremos · cruces · divergencias · estrategia · Trend MTF
//  © BudAI Cripto — Pine v6
// ────────────────────────────────────────────────────────────────────────────
indicator("OSCILADOR - BUDAI CRIPTO", shorttitle="BUDAI", overlay=false, precision=1, max_labels_count=300, max_lines_count=200)

// ════════════════ MARCA DE AGUA ════════════════
G_WM    = "✦ Marca de agua"
showWM  = input.bool(true, "Mostrar firma BudAI Cripto", group=G_WM)
wmPos   = input.string("Inferior Izquierda", "Posición", options=["Inferior Izquierda","Inferior Derecha","Superior Izquierda","Superior Derecha"], group=G_WM)
wmCol   = input.color(color.new(#b6f400, 35), "Color", group=G_WM)

// ════════════════ GRUPOS ════════════════
G_CORE = "① Núcleo"
G_MF   = "② Money Flow"
G_MA   = "③ Medias del oscilador"
G_LVL  = "④ Niveles (OB/OS · Fibo)"
G_SIG  = "⑤ Señales"
G_STR  = "⑥ Estrategia"
G_MTF  = "⑦ Trend MTF"
G_VIS  = "⑧ Estética"

// ════════════════ ① NÚCLEO ════════════════
chanLen = input.int(9,  "WaveTrend canal", minval=3, maxval=50, group=G_CORE, tooltip="Centro de gravedad cíclico. 9-10 scalping, 21 swing.")
avgLen  = input.int(12, "WaveTrend promedio", minval=2, maxval=50, group=G_CORE)
trigLen = input.int(3,  "Trigger (señal)", minval=1, maxval=20, group=G_CORE)
useCOG  = input.bool(true, "Mezclar COG (Ehlers)", group=G_CORE)
cogLen  = input.int(9,  "COG len", minval=3, maxval=50, group=G_CORE)
momLen  = input.int(10, "Momentum len", minval=2, maxval=50, group=G_CORE)

// ════════════════ ② MONEY FLOW ════════════════
showMF  = input.bool(true, "Histograma Money Flow", group=G_MF)
mfLen   = input.int(14, "Money Flow len", minval=2, maxval=50, group=G_MF)

// ════════════════ ③ MEDIAS ════════════════
showSMA = input.bool(true,  "SMA del oscilador (señal)", group=G_MA, inline="s")
smaLen  = input.int(21, "len", minval=2, maxval=100, group=G_MA, inline="s")
showEMA = input.bool(false, "EMA del oscilador (rápida)", group=G_MA, inline="e")
emaLen  = input.int(9,  "len", minval=2, maxval=100, group=G_MA, inline="e")

// ════════════════ ④ NIVELES ════════════════
obLvl   = input.int(80, "Sobrecompra", minval=55, maxval=95, group=G_LVL, inline="ob")
osLvl   = input.int(20, "Sobreventa",  minval=5,  maxval=45, group=G_LVL, inline="ob")
showFib = input.bool(true, "Niveles Fibo (0.382 / 0.5 / 0.618)", group=G_LVL)

// ════════════════ ⑤ SEÑALES ════════════════
showDots   = input.bool(true, "Círculos en extremos (top/bottom)", group=G_SIG, tooltip="Verde = giro desde sobreventa · Rojo = giro desde sobrecompra. Estilo Neptune.")
showCross  = input.bool(false, "Mini-puntos en cada cruce", group=G_SIG)
reqFlow    = input.bool(true, "Señal válida solo con Money Flow a favor", group=G_SIG)
showDiv    = input.bool(true, "Divergencias", group=G_SIG)
divLen     = input.int(5, "Pivote divergencia", minval=2, maxval=20, group=G_SIG)
showSR     = input.bool(true, "Marcar en S/R importante (precio)", group=G_SIG, tooltip="Resalta el círculo si coincide con un soporte/resistencia del precio.")
srLen      = input.int(20, "Pivote S/R precio", minval=5, maxval=80, group=G_SIG)

// ════════════════ ⑥ ESTRATEGIA ════════════════
showStrat  = input.bool(true, "Activar estrategia (entradas A+)", group=G_STR, tooltip="Entrada = círculo de extremo + Money Flow a favor + (opcional) en S/R + filtro de tendencia.")
stratTrend = input.bool(true, "Filtrar por Trend MTF (1H/4H)", group=G_STR)
showStratLbl = input.bool(true, "Etiqueta LONG/SHORT de estrategia", group=G_STR)

// ════════════════ ⑦ TREND MTF ════════════════
showMTF = input.bool(true, "Mini panel Trend MTF", group=G_MTF)

// ════════════════ ⑧ ESTÉTICA ════════════════
upCol  = input.color(#00e676, "Alcista / giro arriba", group=G_VIS, inline="c")
dnCol  = input.color(#ff1744, "Bajista / giro abajo", group=G_VIS, inline="c")
lineUp = input.color(#00e5ff, "Línea alcista", group=G_VIS, inline="l")
lineDn = input.color(#e040fb, "Línea bajista", group=G_VIS, inline="l")
glow   = input.bool(true, "Relleno degradado (glow)", group=G_VIS)
showDash = input.bool(true, "Dashboard minimalista", group=G_VIS)
dashPos  = input.string("Arriba Derecha", "Posición", options=["Arriba Derecha","Arriba Izquierda","Abajo Derecha","Abajo Izquierda"], group=G_VIS)

// ════════════════════════════════════════════════════════════════════════════
//  NÚCLEO
// ════════════════════════════════════════════════════════════════════════════
float src = hlc3
float esa = ta.ema(src, chanLen)
float de  = ta.ema(math.abs(src - esa), chanLen)
float ci  = de == 0 ? 0.0 : (src - esa) / (0.015 * de)
float wt1 = ta.ema(ci, avgLen)
float wt2 = ta.sma(wt1, trigLen)

float cogNum = 0.0
float cogDen = 0.0
for i = 0 to cogLen - 1
    float p = nz(src[i])
    cogNum := cogNum + (1 + i) * p
    cogDen := cogDen + p
float cogRaw = cogDen != 0 ? -cogNum / cogDen + (cogLen + 1) / 2.0 : 0.0

float mfi = ta.mfi(hlc3, mfLen)
float mfm = (high - low) != 0 ? ((close - low) - (high - close)) / (high - low) : 0.0
float vol = nz(volume) == 0 ? 1.0 : volume
float cmf = math.sum(mfm * vol, mfLen) / math.sum(vol, mfLen)
float momRaw = close - close[momLen]

f_norm(float s, simple int len) =>
    float lo = ta.lowest(s, len)
    float hi = ta.highest(s, len)
    hi - lo != 0 ? 100.0 * (s - lo) / (hi - lo) : 50.0

float wtN  = f_norm(wt1, 100)
float cogN = f_norm(cogRaw, 100)
float momN = f_norm(momRaw, 100)
float osc  = useCOG ? (wtN * 0.6 + cogN * 0.25 + momN * 0.15) : (wtN * 0.8 + momN * 0.2)
float trig = f_norm(wt2, 100)
float smaO = ta.sma(osc, smaLen)
float emaO = ta.ema(osc, emaLen)

bool isBull = osc >= trig
bool isBear = osc < trig

// volatilidad (expansión/compresión del spread osc-trigger)
float spread = math.abs(osc - trig)
float avgSpread = ta.sma(spread, 20)
float volRatio = avgSpread > 0 ? spread / avgSpread : 1.0
string volState = volRatio > 1.6 ? "Expansión" : volRatio < 0.5 ? "Compresión" : "Normal"
color  volStateC = volRatio > 1.6 ? color.new(#ffb300, 0) : volRatio < 0.5 ? color.new(color.gray, 20) : color.new(#40c4ff, 0)

// ════════════════════════════════════════════════════════════════════════════
//  NIVELES
// ════════════════════════════════════════════════════════════════════════════
hline(100, "Tope", color.new(color.gray, 88), hline.style_dotted)
hline(obLvl, "Sobrecompra", color.new(dnCol, 60), hline.style_dashed)
hline(50, "Centro", color.new(color.gray, 72), hline.style_solid)
hline(osLvl, "Sobreventa", color.new(upCol, 60), hline.style_dashed)
hline(0, "Piso", color.new(color.gray, 88), hline.style_dotted)
hline(showFib ? 61.8 : na, "0.618", color.new(#9d6cff, 62), hline.style_dotted)
hline(showFib ? 38.2 : na, "0.382", color.new(#9d6cff, 62), hline.style_dotted)

// ════════════════════════════════════════════════════════════════════════════
//  PLOTS — limpio
// ════════════════════════════════════════════════════════════════════════════
plot(showMF ? 50 + cmf * 50 : na, "Money Flow", color=cmf >= 0 ? color.new(upCol, 72) : color.new(dnCol, 72), style=plot.style_columns, histbase=50)
plot(showSMA ? smaO : na, "SMA", color=color.new(#ffd54f, 0), linewidth=1)
plot(showEMA ? emaO : na, "EMA", color=color.new(#9d6cff, 0), linewidth=1)

color oscCol = isBull ? lineUp : lineDn
pTrig = plot(trig, "Trigger", color=color.new(color.gray, 58), linewidth=1)
pOsc  = plot(osc,  "Oscilador", color=oscCol, linewidth=2)
pMid  = plot(50, "Mid", color=color.new(color.gray, 100), display=display.none)
fill(pOsc, pMid, top_value=100, bottom_value=50, top_color=glow ? color.new(lineUp, 64) : na, bottom_color=glow ? color.new(lineUp, 97) : na, title="Glow up")
fill(pOsc, pMid, top_value=50, bottom_value=0,  top_color=glow ? color.new(lineDn, 97) : na, bottom_color=glow ? color.new(lineDn, 64) : na, title="Glow dn")

// ════════════════════════════════════════════════════════════════════════════
//  S/R del PRECIO (para resaltar señales en niveles importantes)
// ════════════════════════════════════════════════════════════════════════════
float srHi = ta.pivothigh(high, srLen, srLen)
float srLo = ta.pivotlow(low,  srLen, srLen)
var float lastResist = na
var float lastSupport = na
if not na(srHi)
    lastResist := srHi
if not na(srLo)
    lastSupport := srLo
float srTol = ta.atr(14) * 0.5
bool atResist = showSR and not na(lastResist) and math.abs(high - lastResist) <= srTol
bool atSupport= showSR and not na(lastSupport) and math.abs(low - lastSupport) <= srTol

// ════════════════════════════════════════════════════════════════════════════
//  SEÑALES — círculos en extremos (estilo Neptune) + cruces + divergencias
// ════════════════════════════════════════════════════════════════════════════
bool flowUp = not reqFlow or cmf > 0
bool flowDn = not reqFlow or cmf < 0
bool crossUp = ta.crossover(osc, trig)  and barstate.isconfirmed
bool crossDn = ta.crossunder(osc, trig) and barstate.isconfirmed

// "top/bottom": cruce que ocurre en zona extrema = giro de alta probabilidad
bool botDot = showDots and crossUp and osc < osLvl + 10 and flowUp
bool topDot = showDots and crossDn and osc > obLvl - 10 and flowDn

// círculos pegados a la línea (verde abajo, rojo arriba) — como Neptune
plotshape(botDot ? osc : na, title="Giro ↑", style=shape.circle, location=location.absolute, color=upCol, size=size.small)
plotshape(topDot ? osc : na, title="Giro ↓", style=shape.circle, location=location.absolute, color=dnCol, size=size.small)
// resalte S/R: anillo extra si el giro coincide con soporte/resistencia del precio
plotshape(botDot and atSupport ? osc : na, title="Giro ↑ en Soporte", style=shape.circle, location=location.absolute, color=color.new(upCol, 70), size=size.normal)
plotshape(topDot and atResist  ? osc : na, title="Giro ↓ en Resistencia", style=shape.circle, location=location.absolute, color=color.new(dnCol, 70), size=size.normal)
// mini-puntos opcionales en cualquier cruce
plotshape(showCross and crossUp ? osc : na, title="Cruce ↑", style=shape.circle, location=location.absolute, color=color.new(upCol, 40), size=size.tiny)
plotshape(showCross and crossDn ? osc : na, title="Cruce ↓", style=shape.circle, location=location.absolute, color=color.new(dnCol, 40), size=size.tiny)

// divergencias (precio vs oscilador)
float dpl = ta.pivotlow(low,  divLen, divLen)
float dph = ta.pivothigh(high, divLen, divLen)
var float pLo1 = na
var float pLo2 = na
var float oLo1 = na
var float oLo2 = na
var float pHi1 = na
var float pHi2 = na
var float oHi1 = na
var float oHi2 = na
if not na(dpl)
    pLo2 := pLo1
    pLo1 := dpl
    oLo2 := oLo1
    oLo1 := osc[divLen]
if not na(dph)
    pHi2 := pHi1
    pHi1 := dph
    oHi2 := oHi1
    oHi1 := osc[divLen]
bool bullDiv = showDiv and not na(dpl) and not na(pLo2) and pLo1 < pLo2 and oLo1 > oLo2 and barstate.isconfirmed
bool bearDiv = showDiv and not na(dph) and not na(pHi2) and pHi1 > pHi2 and oHi1 < oHi2 and barstate.isconfirmed
plotchar(bullDiv ? osc : na, title="Div+", char="▲", location=location.absolute, color=color.new(upCol, 0), size=size.tiny)
plotchar(bearDiv ? osc : na, title="Div−", char="▼", location=location.absolute, color=color.new(dnCol, 0), size=size.tiny)

// ════════════════════════════════════════════════════════════════════════════
//  TREND MTF
// ════════════════════════════════════════════════════════════════════════════
f_mtf() =>
    float e  = ta.ema(hlc3, chanLen)
    float dd = ta.ema(math.abs(hlc3 - e), chanLen)
    float c  = dd == 0 ? 0.0 : (hlc3 - e) / (0.015 * dd)
    float w1 = ta.ema(c, avgLen)
    float w2 = ta.sma(w1, trigLen)
    w1 > w2 ? 1.0 : w1 < w2 ? -1.0 : 0.0
float m15 = request.security(syminfo.tickerid, "15",  f_mtf(), lookahead=barmerge.lookahead_off)
float m1h = request.security(syminfo.tickerid, "60",  f_mtf(), lookahead=barmerge.lookahead_off)
float m4h = request.security(syminfo.tickerid, "240", f_mtf(), lookahead=barmerge.lookahead_off)
float m1d = request.security(syminfo.tickerid, "D",   f_mtf(), lookahead=barmerge.lookahead_off)
int   mtfScore = int(nz(m15) + nz(m1h) + nz(m4h) + nz(m1d))

// ════════════════════════════════════════════════════════════════════════════
//  ⑥ ESTRATEGIA — entrada A+ (círculo extremo + flujo + S/R + trend)
// ════════════════════════════════════════════════════════════════════════════
bool trendOkL = not stratTrend or (nz(m1h) >= 0 and nz(m4h) >= 0)
bool trendOkS = not stratTrend or (nz(m1h) <= 0 and nz(m4h) <= 0)
bool srOkL = not showSR or atSupport
bool srOkS = not showSR or atResist
bool stratLong  = showStrat and botDot and trendOkL and (srOkL or bullDiv)
bool stratShort = showStrat and topDot and trendOkS and (srOkS or bearDiv)

plotshape(showStratLbl and stratLong  ? osc : na, title="LONG",  style=shape.labelup,   location=location.absolute, color=upCol, text="LONG",  textcolor=color.white, size=size.tiny)
plotshape(showStratLbl and stratShort ? osc : na, title="SHORT", style=shape.labeldown, location=location.absolute, color=dnCol, text="SHORT", textcolor=color.white, size=size.tiny)

// ════════════════════════════════════════════════════════════════════════════
//  DASHBOARD minimalista
// ════════════════════════════════════════════════════════════════════════════
f_pos(s) => (s == "Arriba Derecha" ? position.top_right : s == "Arriba Izquierda" ? position.top_left : s == "Abajo Derecha" ? position.bottom_right : position.bottom_left)
var table d = table.new(f_pos(dashPos), 2, 7, bgcolor=color.new(#0b0e16, 10), frame_color=color.new(lineUp, 60), frame_width=1, border_color=color.new(#1b2030, 0), border_width=1)
f_cell(t, r, k, v, vc) =>
    table.cell(t, 0, r, k, text_color=color.new(#90a4ae, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, r, v, text_color=vc, text_size=size.small, text_halign=text.align_right)

var string lastStrat = "—"
var color  lastStratC = color.gray
if stratLong
    lastStrat := "LONG @ " + str.tostring(close, format.mintick)
    lastStratC := upCol
if stratShort
    lastStrat := "SHORT @ " + str.tostring(close, format.mintick)
    lastStratC := dnCol

if showDash and barstate.islast
    string estado = osc >= obLvl ? "SOBRECOMPRA" : osc <= osLvl ? "SOBREVENTA" : isBull ? "Alcista" : "Bajista"
    color  estadoC = osc >= obLvl ? dnCol : osc <= osLvl ? upCol : isBull ? upCol : dnCol
    string flowTxt = cmf > 0 ? "ACUMULA" : "DISTRIB"
    color  flowC   = cmf > 0 ? upCol : dnCol
    string mtfTxt  = (mtfScore > 0 ? "+" : "") + str.tostring(mtfScore) + " / 4"
    color  mtfC    = mtfScore >= 2 ? upCol : mtfScore <= -2 ? dnCol : color.new(#ffb300, 0)
    table.cell(d, 0, 0, "⚡ BUDAI", text_color=color.white, bgcolor=color.new(#1b2030,0), text_size=size.normal, text_halign=text.align_left)
    table.cell(d, 1, 0, str.tostring(osc, "#") + " / 100", text_color=oscCol, bgcolor=color.new(#1b2030,0), text_size=size.small, text_halign=text.align_right)
    f_cell(d, 1, "Estado",     estado,  estadoC)
    f_cell(d, 2, "Money Flow", flowTxt, flowC)
    f_cell(d, 3, "Volatilidad",volState, volStateC)
    f_cell(d, 4, "Trend MTF",  mtfTxt,  mtfC)
    f_cell(d, 5, "Estrategia", lastStrat, lastStratC)
    f_cell(d, 6, "Trigger",    str.tostring(trig, "#"), color.new(color.gray, 0))

// mini fila MTF visual
var table mt = table.new(position.bottom_right, 4, 1, bgcolor=color.new(#0b0e16, 20), frame_color=color.new(lineUp, 70), frame_width=1, border_color=color.new(#1b2030,0), border_width=1)
f_mc(v) => v > 0 ? color.new(upCol, 25) : v < 0 ? color.new(dnCol, 25) : color.new(color.gray, 50)
if showMTF and barstate.islast
    table.cell(mt, 0, 0, "15m", bgcolor=f_mc(m15), text_color=color.white, text_size=size.tiny, text_halign=text.align_center)
    table.cell(mt, 1, 0, "1H",  bgcolor=f_mc(m1h), text_color=color.white, text_size=size.tiny, text_halign=text.align_center)
    table.cell(mt, 2, 0, "4H",  bgcolor=f_mc(m4h), text_color=color.white, text_size=size.tiny, text_halign=text.align_center)
    table.cell(mt, 3, 0, "1D",  bgcolor=f_mc(m1d), text_color=color.white, text_size=size.tiny, text_halign=text.align_center)

// ════════════════════════════════════════════════════════════════════════════
//  MARCA DE AGUA — firma BudAI Cripto
// ════════════════════════════════════════════════════════════════════════════
f_wmPos(s) => s == "Inferior Izquierda" ? position.bottom_left : s == "Inferior Derecha" ? position.bottom_right : s == "Superior Izquierda" ? position.top_left : position.top_right
var table wm = table.new(f_wmPos(wmPos), 1, 1, bgcolor=color.new(color.black, 100))
if showWM and barstate.islast
    table.cell(wm, 0, 0, "₿ BudAI Cripto", text_color=wmCol, text_size=size.small)

// ════════════════════════════════════════════════════════════════════════════
//  ALERTAS
// ════════════════════════════════════════════════════════════════════════════
alertcondition(stratLong,  "BUDAI LONG",  "OSCILADOR BUDAI · LONG {{ticker}}")
alertcondition(stratShort, "BUDAI SHORT", "OSCILADOR BUDAI · SHORT {{ticker}}")
alertcondition(botDot, "Giro alcista", "BUDAI · giro desde sobreventa {{ticker}}")
alertcondition(topDot, "Giro bajista", "BUDAI · giro desde sobrecompra {{ticker}}")
