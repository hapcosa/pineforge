//@version=6
// ════════════════════════════════════════════════════════════════════════════
//  ICT NYC SCALPER MODE  ·  cualquier activo  ·  exclusivo apertura New York
//  Liquidez de sesión (Asia/London) → NY barre (manipulación) → MSS + FVG
//  → entrada en descuento/premium → SL bajo liquidez · TP1/2/3 · "FATALITY" al liquidar
//  Estética LuxAlgo futurista · Pine v6
// ════════════════════════════════════════════════════════════════════════════
indicator("ICT NYC SCALPER MODE", shorttitle="ICT NYC", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_bars_back=3000)

// ════════════════ GRUPOS ════════════════
G_SES = "① Sesiones"
G_KZ  = "② Killzone NY + Campana"
G_RNG = "③ Dealing Range / Imán"
G_LIQ = "④ Liquidez + FVG"
G_HTF = "④b FVG Timeframe Superior"
G_ENT = "⑤ Entrada & Riesgo"
G_VIS = "⑥ Dashboard"

// ════════════════ ① SESIONES (cada una en su TZ local · auto-DST) ════════════════
const string TZ_TT = "Zona IANA del país (ej. Asia/Tokyo, Europe/London, America/New_York). Auto-ajusta horario de verano."
showSes  = input.bool(true, "Mostrar sesiones", group=G_SES)
boxTrans = input.int(90, "Transparencia cajas", minval=70, maxval=99, group=G_SES)
showSesHL= input.bool(true, "Etiqueta H (arriba) / L (abajo)", group=G_SES)
useAsia  = input.bool(true, "ASIA",   group=G_SES, inline="a")
asiaSess = input.session("0900-1500", "", group=G_SES, inline="a")
asiaTZ   = input.string("Asia/Tokyo", "", group=G_SES, inline="a", tooltip=TZ_TT)
asiaCol  = input.color(#3d5afe, "", group=G_SES, inline="a")
useLon   = input.bool(true, "LONDON", group=G_SES, inline="l")
lonSess  = input.session("0800-1630", "", group=G_SES, inline="l")
lonTZ    = input.string("Europe/London", "", group=G_SES, inline="l", tooltip=TZ_TT)
lonCol   = input.color(#ff9100, "", group=G_SES, inline="l")
useNY    = input.bool(true, "NYC",    group=G_SES, inline="n")
nySess   = input.session("0930-1600", "", group=G_SES, inline="n")
nyTZ     = input.string("America/New_York", "", group=G_SES, inline="n", tooltip=TZ_TT)
nyCol    = input.color(#00e676, "", group=G_SES, inline="n")

// ════════════════ ② KILLZONE NY + CAMPANA ════════════════
kzSess  = input.session("0930-1100", "Killzone NY (apertura)", group=G_KZ, tooltip="09:30→11:00 ET (hora New York, auto-DST). Solo se generan señales aquí, Lun-Vie.")
kzTZ    = input.string("America/New_York", "Timezone (IANA)", group=G_KZ)
showKZ  = input.bool(true, "Sombrear killzone", group=G_KZ, inline="kz")
kzCol   = input.color(color.new(#5b6b8c, 92), "", group=G_KZ, inline="kz")
showBell= input.bool(true, "🔔 Campana apertura Wall Street", group=G_KZ)
wsSess  = input.session("0930-0935", "Ventana apertura WS", group=G_KZ, tooltip="09:30 ET = inicio Wall Street. Aquí se estudia el oscilador y se busca la entrada.")
wsCol   = input.color(color.new(#ffd54f, 80), "Fondo apertura WS", group=G_KZ)

// ════════════════ ③ DEALING RANGE / IMÁN ════════════════
rngLen   = input.int(40, "Lookback dealing range", minval=10, maxval=200, group=G_RNG)
showZones= input.bool(true, "Zonas Premium / Descuento", group=G_RNG)
showFib  = input.bool(true, "Fib 0 / 0.5 / 1", group=G_RNG)
showMag  = input.bool(true, "🧲 Imán direccional (objetivo)", group=G_RNG)
premCol  = input.color(color.new(#ff1e6e, 92), "Premium", group=G_RNG, inline="z")
discCol  = input.color(color.new(#00e5ff, 92), "Descuento", group=G_RNG, inline="z")

// ════════════════ ④ LIQUIDEZ + FVG ════════════════
showLiq    = input.bool(true, "Liquidez de sesión (BSL/SSL)", group=G_LIQ)
usePDHL    = input.bool(true, "Incluir PDH / PDL", group=G_LIQ)
maxLiq     = input.int(8, "Máx niveles de liquidez", minval=2, maxval=30, group=G_LIQ)
bslCol     = input.color(#ff5252, "BSL", group=G_LIQ, inline="bs")
sslCol     = input.color(#00e5ff, "SSL", group=G_LIQ, inline="bs")
showFvgBox = input.bool(true, "Cajas FVG (en vivo)", group=G_LIQ)
keepFvgMit = input.bool(true, "Mantener FVG mitigados (atenuados)", group=G_LIQ)
fvgMax     = input.int(10, "Máx cajas FVG", minval=2, maxval=40, group=G_LIQ)
fvgUpCol   = input.color(color.new(#00e676, 80), "FVG alcista", group=G_LIQ, inline="fc")
fvgDnCol   = input.color(color.new(#ff1e6e, 80), "FVG bajista", group=G_LIQ, inline="fc")
fvgMitCol  = input.color(color.new(#607d8b, 90), "FVG mitigado", group=G_LIQ)

// ════════════════ ④b FVG TIMEFRAME SUPERIOR ════════════════
useHtfFvg = input.bool(true, "Mostrar 1 FVG de TF superior", group=G_HTF)
htfFvgTf  = input.timeframe("60", "Timeframe", group=G_HTF, inline="h")
htfFvgCol = input.color(color.new(#9d6cff, 78), "Color", group=G_HTF, inline="h")

// ════════════════ ⑤ ENTRADA & RIESGO ════════════════
asset    = input.string("Auto", "Activo (buffer SL)", options=["Auto","BTC","NASDAQ","EURUSD","Manual"], group=G_ENT, tooltip="Auto = ATR, sirve para CUALQUIER activo.")
minConf  = input.int(2, "Mín. confluencias (de 3)", minval=1, maxval=3, group=G_ENT, tooltip="Confluencias: zona (disc/prem) + bias estructura + FVG. Sweep+MSS siempre obligatorios.")
mLen     = input.int(2, "MSS · micro pivote (confirmación)", minval=1, maxval=10, group=G_ENT)
rr1      = input.float(2.0, "TP1 (R)", minval=0.5, step=0.5, group=G_ENT, inline="rr")
rr2      = input.float(3.0, "TP2 (R)", minval=0.5, step=0.5, group=G_ENT, inline="rr")
rr3      = input.float(4.0, "TP3 (R)", minval=0.5, step=0.5, group=G_ENT, inline="rr")
slBufIn  = input.float(0.20, "SL buffer (ATR x) · Manual", minval=0.0, step=0.05, group=G_ENT)
oncePer  = input.bool(true, "Máx 1 setup por killzone", group=G_ENT)
showFatal= input.bool(true, "Mostrar 'FATALITY' al liquidar (SL/TP)", group=G_ENT)
tradeExt = input.int(28, "Largo líneas SL/TP (velas)", minval=5, maxval=200, group=G_ENT)

// ════════════════ ⑥ DASHBOARD ════════════════
showSig  = input.bool(true, "Mostrar señales en chart", group=G_VIS)
buyCol   = input.color(#00e5ff, "BULL", group=G_VIS, inline="sg")
sellCol  = input.color(#ff1e6e, "BEAR", group=G_VIS, inline="sg")
showDash = input.bool(true, "Dashboard", group=G_VIS)
dashPos  = input.string("Arriba Derecha", "Posición", options=["Arriba Derecha","Arriba Izquierda","Abajo Derecha","Abajo Izquierda"], group=G_VIS)

// ════════════════════════════════════════════════════════════════════════════
//  BASE
// ════════════════════════════════════════════════════════════════════════════
float slBufMult = asset == "Manual" ? slBufIn : asset == "BTC" ? 0.30 : asset == "NASDAQ" ? 0.18 : asset == "EURUSD" ? 0.12 : 0.20
float atr  = ta.atr(14)
bool  conf = barstate.isconfirmed
bool  intraday = not timeframe.isdwm
int  dowNY     = dayofweek(time, kzTZ)
bool noWeekend = not (dowNY == dayofweek.saturday or dowNY == dayofweek.sunday)
bool friAfter  = dowNY == dayofweek.friday and hour(time, kzTZ) >= 16
bool isWeekday = noWeekend and not friAfter

// ════════════════════════════════════════════════════════════════════════════
//  TIPOS
// ════════════════════════════════════════════════════════════════════════════
type Sess
    string name
    string sess
    string tz
    color  col
    bool   use
    box    bx = na
    label  lbHi = na
    label  lbLo = na
    float  hi = na
    float  lo = na
    bool   active = false

type Liq
    float price
    bool  isBSL
    line  ln
    label lb
    bool  taken = false
    string src = ""

// ════════════════════════════════════════════════════════════════════════════
//  ① SESIONES — cajas + máx/mín · liquidez al cerrar
// ════════════════════════════════════════════════════════════════════════════
f_initSess() =>
    a = array.new<Sess>()
    a.push(Sess.new(name="ASIA",   sess=asiaSess, tz=asiaTZ, col=asiaCol, use=useAsia))
    a.push(Sess.new(name="LONDON", sess=lonSess,  tz=lonTZ,  col=lonCol,  use=useLon))
    a.push(Sess.new(name="NYC",    sess=nySess,   tz=nyTZ,   col=nyCol,   use=useNY))
    a
var array<Sess> sessArr = f_initSess()

var array<Liq> liqArr = array.new<Liq>()
f_addLiq(price, isBSL, src) =>
    if array.size(liqArr) >= maxLiq
        Liq old = array.shift(liqArr)
        line.delete(old.ln)
        label.delete(old.lb)
    color c = isBSL ? bslCol : sslCol
    line  nl = line.new(bar_index, price, bar_index + 2, price, extend=extend.right, color=color.new(c, 35), style=line.style_solid, width=1)
    label nb = label.new(bar_index + 2, price, src + (isBSL ? " BSL" : " SSL"), xloc=xloc.bar_index, style=label.style_none, textcolor=color.new(c, 0), size=size.tiny)
    array.push(liqArr, Liq.new(price, isBSL, nl, nb, false, src))

if showSes and intraday
    for s in sessArr
        bool nowIn = s.use and isWeekday and not na(time(timeframe.period, s.sess, s.tz))
        if nowIn and not s.active
            s.active := true
            s.hi := high
            s.lo := low
            s.bx := box.new(bar_index, high, bar_index, low, bgcolor=color.new(s.col, boxTrans), border_color=color.new(s.col, 78), border_width=1)
            s.lbHi := label.new(bar_index, high, s.name, xloc=xloc.bar_index, style=label.style_label_down, textcolor=color.new(s.col, 0), color=color.new(s.col, 90), size=size.tiny)
            s.lbLo := label.new(bar_index, low,  "",     xloc=xloc.bar_index, style=label.style_label_up,   textcolor=color.new(s.col, 0), color=color.new(s.col, 90), size=size.tiny)
        else if nowIn
            s.hi := math.max(s.hi, high)
            s.lo := math.min(s.lo, low)
            box.set_top(s.bx, s.hi)
            box.set_bottom(s.bx, s.lo)
            box.set_right(s.bx, bar_index)
            int xmid = int((box.get_left(s.bx) + bar_index) / 2)
            label.set_xy(s.lbHi, xmid, s.hi)
            label.set_xy(s.lbLo, xmid, s.lo)
            label.set_text(s.lbHi, showSesHL ? s.name + " H " + str.tostring(s.hi, format.mintick) : s.name)
            label.set_text(s.lbLo, showSesHL ? s.name + " L " + str.tostring(s.lo, format.mintick) : "")
        else if s.active
            s.active := false
            if showLiq
                f_addLiq(s.hi, true,  s.name)
                f_addLiq(s.lo, false, s.name)

string curSes = "—"
for s in sessArr
    if s.active
        curSes := s.name

// ════════════════════════════════════════════════════════════════════════════
//  ② KILLZONE + CAMPANA WS
// ════════════════════════════════════════════════════════════════════════════
bool inKZ     = not na(time(timeframe.period, kzSess, kzTZ))
bool kzActive = inKZ and isWeekday and intraday
bool inWS     = not na(time(timeframe.period, wsSess, kzTZ)) and isWeekday and intraday
bool wsBell   = inWS and not inWS[1]
// fondo: apertura WS resaltada por encima de la killzone normal
bgcolor(showKZ and inWS ? wsCol : (showKZ and kzActive ? kzCol : na), title="Killzone / WS Open")
// campana 🔔 + "WS OPEN" debajo
plotshape(showBell and wsBell, title="🔔 WS", style=shape.labeldown, location=location.top, color=color.new(#ffd54f, 0), text="🔔\nWS OPEN", textcolor=#0d1117, size=size.small)

// ════════════════════════════════════════════════════════════════════════════
//  ③ ESTRUCTURA (bias interno, sin saturar el chart)
// ════════════════════════════════════════════════════════════════════════════
float ph = ta.pivothigh(high, 5, 5)
float pl = ta.pivotlow(low,  5, 5)
var float lastPH = na
var float lastPL = na
if not na(ph)
    lastPH := ph
if not na(pl)
    lastPL := pl
var int bias = 0
if not na(lastPH) and close > lastPH
    bias := 1
if not na(lastPL) and close < lastPL
    bias := -1
color biasCol = bias > 0 ? buyCol : bias < 0 ? sellCol : color.gray

// ════════════════════════════════════════════════════════════════════════════
//  DEALING RANGE · PREMIUM / EQ / DESCUENTO · FIB 0 / 0.5 / 1
// ════════════════════════════════════════════════════════════════════════════
float drHigh = ta.highest(high, rngLen)
float drLow  = ta.lowest(low,  rngLen)
float eq     = (drHigh + drLow) / 2.0
bool  discount = close < eq
bool  premium  = close > eq

var box  premBox = na
var box  discBox = na
var line fib0 = na
var line fib5 = na
var line fib1 = na
var label fibEqLb = na
var label fib0Lb = na
var label fib1Lb = na
if intraday
    int xr = bar_index + 3
    if showZones
        if na(premBox)
            premBox := box.new(bar_index, drHigh, xr, eq, bgcolor=premCol, border_color=na)
            discBox := box.new(bar_index, eq, xr, drLow, bgcolor=discCol, border_color=na)
        else
            box.set_lefttop(premBox, bar_index, drHigh)
            box.set_rightbottom(premBox, xr, eq)
            box.set_lefttop(discBox, bar_index, eq)
            box.set_rightbottom(discBox, xr, drLow)
    if showFib
        if na(fib0)
            fib0 := line.new(bar_index, drLow,  xr, drLow,  extend=extend.right, color=color.new(#787b86,45), style=line.style_dotted)
            fib5 := line.new(bar_index, eq,     xr, eq,     extend=extend.right, color=color.new(#ffb300,0),  style=line.style_solid, width=1)
            fib1 := line.new(bar_index, drHigh, xr, drHigh, extend=extend.right, color=color.new(#787b86,45), style=line.style_dotted)
            fib0Lb  := label.new(xr, drLow,  "0",   xloc=xloc.bar_index, style=label.style_none, textcolor=color.new(#787b86,0), size=size.tiny)
            fibEqLb := label.new(xr, eq,     "0.5", xloc=xloc.bar_index, style=label.style_none, textcolor=color.new(#ffb300,0), size=size.tiny)
            fib1Lb  := label.new(xr, drHigh, "1",   xloc=xloc.bar_index, style=label.style_none, textcolor=color.new(#787b86,0), size=size.tiny)
        else
            line.set_xy1(fib0, bar_index, drLow)
            line.set_xy2(fib0, xr, drLow)
            line.set_xy1(fib5, bar_index, eq)
            line.set_xy2(fib5, xr, eq)
            line.set_xy1(fib1, bar_index, drHigh)
            line.set_xy2(fib1, xr, drHigh)
            label.set_xy(fib0Lb, xr, drLow)
            label.set_xy(fibEqLb, xr, eq)
            label.set_xy(fib1Lb, xr, drHigh)

// ════════════════════════════════════════════════════════════════════════════
//  ④ LIQUIDEZ: PDH/PDL + barrido (manipulación) + IMÁN direccional
// ════════════════════════════════════════════════════════════════════════════
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_off)
if usePDHL and showLiq and timeframe.change("D") and not na(pdh)
    f_addLiq(pdh, true,  "PDH")
    f_addLiq(pdl, false, "PDL")

bool sweepBSL = false   // barrió arriba → buscar SHORT
bool sweepSSL = false   // barrió abajo  → buscar LONG
float magUp = na
float magDn = na
var string lastSweep = "—"
if array.size(liqArr) > 0
    int i = array.size(liqArr) - 1
    while i >= 0
        Liq L = array.get(liqArr, i)
        line.set_x2(L.ln, bar_index + 2)
        label.set_x(L.lb, bar_index + 2)
        if not L.taken
            if L.isBSL and high > L.price and close < L.price
                L.taken := true
                line.set_style(L.ln, line.style_dashed)
                line.set_color(L.ln, color.new(bslCol, 65))
                label.set_text(L.lb, L.src + " BSL ✗")
                sweepBSL := true
            if (not L.isBSL) and low < L.price and close > L.price
                L.taken := true
                line.set_style(L.ln, line.style_dashed)
                line.set_color(L.ln, color.new(sslCol, 65))
                label.set_text(L.lb, L.src + " SSL ✗")
                sweepSSL := true
            if L.price > close and (na(magUp) or L.price < magUp)
                magUp := L.price
            if L.price < close and (na(magDn) or L.price > magDn)
                magDn := L.price
        i := i - 1
if sweepBSL
    lastSweep := "BSL (stops SHORT)"
if sweepSSL
    lastSweep := "SSL (stops LONG)"

// imán DIRECCIONAL según bias (no ambos lados = no azar)
float magTarget = bias > 0 ? magUp : bias < 0 ? magDn : na
color magC = bias > 0 ? bslCol : sslCol
var label magLb = na
if showMag and intraday
    if na(magLb)
        magLb := label.new(bar_index + 3, close, "🧲", xloc=xloc.bar_index, style=label.style_label_left, textcolor=color.white, color=color.new(magC, 30), size=size.small)
    if not na(magTarget)
        label.set_xy(magLb, bar_index + 3, magTarget)
        label.set_text(magLb, "🧲 " + str.tostring(magTarget, format.mintick))
        label.set_color(magLb, color.new(magC, 30))
    else
        label.set_xy(magLb, bar_index + 3, close)
        label.set_text(magLb, "🧲 —")

// ════════════════════════════════════════════════════════════════════════════
//  ④b FVG de Timeframe Superior (1, opcional) — útil en zonas premium/descuento
// ════════════════════════════════════════════════════════════════════════════
f_htfFvg() =>
    bool up = low > high[2]
    bool dn = high < low[2]
    [up ? 1.0 : 0.0, high[2], low, dn ? 1.0 : 0.0, low[2], high]
[hUp, hUpB, hUpT, hDn, hDnB, hDnT] = request.security(syminfo.tickerid, htfFvgTf, f_htfFvg(), lookahead=barmerge.lookahead_off)
var box htfBx = na
var label htfLb = na
if useHtfFvg and intraday
    if hUp == 1.0 and conf
        if not na(htfBx)
            box.delete(htfBx)
            label.delete(htfLb)
        htfBx := box.new(bar_index - 2, hUpT, bar_index + 6, hUpB, bgcolor=htfFvgCol, border_color=color.new(htfFvgCol, 30), border_width=1)
        htfLb := label.new(bar_index + 6, hUpT, htfFvgTf + " FVG ▲", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(htfFvgCol, 25), textcolor=color.white, size=size.tiny)
    if hDn == 1.0 and conf
        if not na(htfBx)
            box.delete(htfBx)
            label.delete(htfLb)
        htfBx := box.new(bar_index - 2, hDnT, bar_index + 6, hDnB, bgcolor=htfFvgCol, border_color=color.new(htfFvgCol, 30), border_width=1)
        htfLb := label.new(bar_index + 6, hDnT, htfFvgTf + " FVG ▼", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(htfFvgCol, 25), textcolor=color.white, size=size.tiny)
    if not na(htfBx)
        box.set_right(htfBx, bar_index + 6)
        label.set_x(htfLb, bar_index + 6)

// ════════════════════════════════════════════════════════════════════════════
//  ⑤ FVG en vivo (entradas) + MSS + ENTRADA NY
// ════════════════════════════════════════════════════════════════════════════
bool fvgUp = low > high[2]
bool fvgDn = high < low[2]

var array<box>  fvgBx  = array.new_box()
var array<bool> fvgMit = array.new_bool()
if showFvgBox and conf and fvgUp
    if array.size(fvgBx) >= fvgMax
        box.delete(array.shift(fvgBx))
        array.shift(fvgMit)
    array.push(fvgBx, box.new(bar_index - 2, low, bar_index + 3, high[2], bgcolor=fvgUpCol, border_color=color.new(fvgUpCol, 25), border_width=1))
    array.push(fvgMit, false)
if showFvgBox and conf and fvgDn
    if array.size(fvgBx) >= fvgMax
        box.delete(array.shift(fvgBx))
        array.shift(fvgMit)
    array.push(fvgBx, box.new(bar_index - 2, low[2], bar_index + 3, high, bgcolor=fvgDnCol, border_color=color.new(fvgDnCol, 25), border_width=1))
    array.push(fvgMit, false)
if array.size(fvgBx) > 0
    int fi = array.size(fvgBx) - 1
    while fi >= 0
        box  fb = array.get(fvgBx, fi)
        bool mit = array.get(fvgMit, fi)
        if not mit
            if low <= box.get_top(fb) and high >= box.get_bottom(fb)
                if keepFvgMit
                    array.set(fvgMit, fi, true)
                    box.set_bgcolor(fb, fvgMitCol)
                    box.set_border_color(fb, color.new(fvgMitCol, 55))
                    box.set_border_style(fb, line.style_dotted)
                else
                    box.delete(fb)
                    array.remove(fvgBx, fi)
                    array.remove(fvgMit, fi)
            else
                box.set_right(fb, bar_index + 3)
        fi := fi - 1

float mph = ta.pivothigh(high, mLen, mLen)
float mpl = ta.pivotlow(low,  mLen, mLen)
var float microPH = na
var float microPL = na
if not na(mph)
    microPH := mph
if not na(mpl)
    microPL := mpl
bool mssUp = not na(microPH) and close > microPH
bool mssDn = not na(microPL) and close < microPL

var int   pend     = 0
var float sweepLvl = na
var bool  fired    = false
bool kzStart = kzActive and not kzActive[1]
if kzStart or timeframe.change("D")
    pend := 0
    fired := false
if kzActive
    if sweepSSL
        pend := 1
        sweepLvl := low
    if sweepBSL
        pend := -1
        sweepLvl := high
if pend == 1 and low < sweepLvl
    sweepLvl := low
if pend == -1 and high > sweepLvl
    sweepLvl := high

// CONFLUENCIAS (3): zona · bias estructura · FVG
int scoreL = (discount ? 1 : 0) + (bias >= 0 ? 1 : 0) + ((fvgUp or fvgUp[1]) ? 1 : 0)
int scoreS = (premium  ? 1 : 0) + (bias <= 0 ? 1 : 0) + ((fvgDn or fvgDn[1]) ? 1 : 0)
bool okOnce = not oncePer or not fired

// solo en killzone NY · gatillo obligatorio sweep+MSS · confluencias >= mínimo
bool entryLong  = kzActive and conf and pend == 1  and mssUp and scoreL >= minConf and okOnce
bool entryShort = kzActive and conf and pend == -1 and mssDn and scoreS >= minConf and okOnce

// ── estado del trade activo (para FATALITY al liquidar) ──
var bool  inTrade  = false
var bool  tradeLong= false
var float tEntry   = na
var float tSL      = na
var float tTP3     = na

// dibujo del trade
var line  ln_e  = na
var line  ln_sl = na
var line  ln_t1 = na
var line  ln_t2 = na
var line  ln_t3 = na
var label lb_e  = na
var label lb_sig= na
float buf = atr * slBufMult
bool newTrade = entryLong or entryShort
if newTrade
    bool  isLong = entryLong
    float entry  = close
    float sl     = isLong ? sweepLvl - buf : sweepLvl + buf
    float rsk    = math.abs(entry - sl)
    float tp1    = isLong ? entry + rsk * rr1 : entry - rsk * rr1
    float tp2    = isLong ? entry + rsk * rr2 : entry - rsk * rr2
    float tp3    = isLong ? entry + rsk * rr3 : entry - rsk * rr3
    if not na(ln_e)
        line.delete(ln_e)
        line.delete(ln_sl)
        line.delete(ln_t1)
        line.delete(ln_t2)
        line.delete(ln_t3)
        label.delete(lb_e)
        label.delete(lb_sig)
    int   xL = bar_index
    int   xR = bar_index + tradeExt
    color cE = isLong ? buyCol : sellCol
    int   sc = isLong ? scoreL : scoreS
    ln_e  := line.new(xL, entry, xR, entry, color=color.new(#ffffff, 0), width=1, style=line.style_solid)
    ln_sl := line.new(xL, sl,    xR, sl,    color=color.new(sellCol, 0), width=2, style=line.style_solid)
    ln_t1 := line.new(xL, tp1,   xR, tp1,   color=color.new(buyCol, 35), width=1, style=line.style_dashed)
    ln_t2 := line.new(xL, tp2,   xR, tp2,   color=color.new(buyCol, 20), width=1, style=line.style_dashed)
    ln_t3 := line.new(xL, tp3,   xR, tp3,   color=color.new(buyCol, 0),  width=1, style=line.style_dashed)
    lb_e  := label.new(xR, entry, "@" + str.tostring(entry, format.mintick) + "  SL " + str.tostring(sl, format.mintick) + "\nTP1 " + str.tostring(tp1, format.mintick) + " · TP2 " + str.tostring(tp2, format.mintick) + " · TP3 " + str.tostring(tp3, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(#0d1117, 12), textcolor=color.white, size=size.tiny)
    lb_sig := label.new(xL, isLong ? low : high, (isLong ? "▲ BULL " : "▼ BEAR ") + str.tostring(sc) + "/3 · ENTRY", xloc=xloc.bar_index, style=(isLong ? label.style_label_up : label.style_label_down), color=cE, textcolor=color.white, size=size.normal)
    fired   := true
    pend    := 0
    inTrade := true
    tradeLong := isLong
    tEntry  := entry
    tSL     := sl
    tTP3    := tp3

// ── liquidación: SL o TP3 tocados → "FATALITY" ──
bool hitSL  = inTrade and (tradeLong ? low <= tSL : high >= tSL)
bool hitTP  = inTrade and (tradeLong ? high >= tTP3 : low <= tTP3)
if inTrade and (hitSL or hitTP)
    if showFatal
        label.new(bar_index, tradeLong ? high : low, "💀 FATALITY", xloc=xloc.bar_index, style=(tradeLong ? label.style_label_down : label.style_label_up), color=color.new(hitTP ? buyCol : sellCol, 10), textcolor=color.white, size=size.normal)
    inTrade := false

// marcador de barrido (manipulación) en killzone — único elemento de evento en el chart
plotshape(showSig and kzActive and sweepSSL and pend == 1,  title="Sweep SSL", style=shape.xcross, location=location.belowbar, color=color.new(sslCol, 10), size=size.tiny)
plotshape(showSig and kzActive and sweepBSL and pend == -1, title="Sweep BSL", style=shape.xcross, location=location.abovebar, color=color.new(bslCol, 10), size=size.tiny)

string amd = not kzActive ? "Espera NY" : fired ? "DISTRIBUCION" : pend != 0 ? "MANIPULACION" : "ACUMULACION"

// ════════════════════════════════════════════════════════════════════════════
//  ⑥ DASHBOARD (estilo TradingView · sofisticado)
// ════════════════════════════════════════════════════════════════════════════
f_pos(s) => (s == "Arriba Derecha" ? position.top_right : s == "Arriba Izquierda" ? position.top_left : s == "Abajo Derecha" ? position.bottom_right : position.bottom_left)
var table dash = table.new(f_pos(dashPos), 2, 12, bgcolor=color.new(#0b0e16, 6), border_color=color.new(#1b2030, 0), border_width=1, frame_color=color.new(buyCol, 55), frame_width=1)

var string lastSig = "—"
var color  lastSigCol = color.gray
if entryLong
    lastSig := "▲ BULL " + str.tostring(scoreL) + "/3 @ " + str.tostring(close, format.mintick)
    lastSigCol := buyCol
if entryShort
    lastSig := "▼ BEAR " + str.tostring(scoreS) + "/3 @ " + str.tostring(close, format.mintick)
    lastSigCol := sellCol

f_row(t, r, k, v, vc) =>
    table.cell(t, 0, r, k, text_color=color.new(#90a4ae, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, r, v, text_color=vc, text_size=size.small, text_halign=text.align_right)

if showDash and barstate.islast
    string biasTxt = bias > 0 ? "ALCISTA" : bias < 0 ? "BAJISTA" : "NEUTRO"
    string zoneTxt = premium ? "PREMIUM (vende)" : "DESCUENTO (compra)"
    color  zoneCol = premium ? sellCol : buyCol
    color  amdCol  = amd == "MANIPULACION" ? color.new(#ffd54f,0) : amd == "DISTRIBUCION" ? buyCol : amd == "ACUMULACION" ? color.new(#90a4ae,0) : color.gray
    string magTxt  = na(magTarget) ? "—" : (bias > 0 ? "↑ " : "↓ ") + str.tostring(magTarget, format.mintick)
    string fvgNow  = (fvgUp or fvgUp[1]) ? "▲ alcista" : (fvgDn or fvgDn[1]) ? "▼ bajista" : "—"
    color  fvgNowC = (fvgUp or fvgUp[1]) ? buyCol : (fvgDn or fvgDn[1]) ? sellCol : color.gray
    string bslTxt  = na(magUp) ? "—" : str.tostring(magUp, format.mintick)
    string sslTxt  = na(magDn) ? "—" : str.tostring(magDn, format.mintick)
    // título
    table.cell(dash, 0, 0, "⚡ ICT NYC", text_color=color.white, bgcolor=color.new(#1b2030, 0), text_size=size.normal, text_halign=text.align_left)
    table.cell(dash, 1, 0, timeframe.period + (kzActive ? " 🟢" : " ⚪"), text_color=(kzActive ? buyCol : color.gray), bgcolor=color.new(#1b2030, 0), text_size=size.small, text_halign=text.align_right)
    f_row(dash, 1, "Sesión",        curSes,  color.white)
    f_row(dash, 2, "Bias",          biasTxt, biasCol)
    f_row(dash, 3, "Zona",          zoneTxt, zoneCol)
    f_row(dash, 4, "Fase AMD",      amd,     amdCol)
    f_row(dash, 5, "FVG actual",    fvgNow,  fvgNowC)
    f_row(dash, 6, "🧲 Objetivo",   magTxt,  color.new(#b0bec5,0))
    f_row(dash, 7, "BSL (arriba)",  bslTxt,  bslCol)
    f_row(dash, 8, "SSL (abajo)",   sslTxt,  sslCol)
    f_row(dash, 9, "Último barrido",lastSweep, color.new(#ffd54f,0))
    f_row(dash, 10,"Confluencias",  "L " + str.tostring(scoreL) + " · S " + str.tostring(scoreS), color.new(#00e5ff,0))
    table.cell(dash, 0, 11, "Señal", text_color=color.new(#90a4ae,0), text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 11, lastSig, text_color=color.white, bgcolor=color.new(lastSigCol, 55), text_size=size.small, text_halign=text.align_right)

// ════════════════════════════════════════════════════════════════════════════
//  ALERTAS
// ════════════════════════════════════════════════════════════════════════════
alertcondition(entryLong,  title="ICT NYC BUY",  message="ICT NYC LONG {{ticker}} @ {{close}}")
alertcondition(entryShort, title="ICT NYC SELL", message="ICT NYC SHORT {{ticker}} @ {{close}}")
alertcondition(wsBell,     title="🔔 WS Open",   message="🔔 Apertura Wall Street {{ticker}}")
