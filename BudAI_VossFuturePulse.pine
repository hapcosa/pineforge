//@version=6
// ██████╗ ██╗   ██╗██████╗  █████╗ ██╗
// ██╔══██╗██║   ██║██╔══██╗██╔══██╗██║
// ██████╔╝██║   ██║██║  ██║███████║██║
// ██╔══██╗██║   ██║██║  ██║██╔══██║██║
// ██████╔╝╚██████╔╝██████╔╝██║  ██║██║
// ╚═════╝  ╚═════╝ ╚═════╝ ╚═╝  ╚═╝╚═╝
//         C R I P T O   ·   T R A D I N G   C A P I T A L
// ────────────────────────────────────────────────────────────────────────────
//  BudAI Capital® - Voss Future Pulse
//  Pulso predictivo · ciclo filtrado · correlación dinámica.
//  (c) BudAI Capital® — Pine v6 · panel
// ────────────────────────────────────────────────────────────────────────────
indicator("BudAI Capital® - Voss Future Pulse", shorttitle="BudAI Capital® - Voss Future Pulse", overlay=false, precision=3)

// ════════════════════════════════════════════════════════════════════════════
//  GRUPOS
// ════════════════════════════════════════════════════════════════════════════
G_CORE = "① Motor predictivo"
G_CORR = "② Correlación"
G_VIS  = "③ Estética"
G_WM   = "✦ Marca de agua"

// ════════════════════════════════════════════════════════════════════════════
//  INPUTS
// ════════════════════════════════════════════════════════════════════════════
source         = input.source(close, "Fuente", group=G_CORE)
periodBandpass = input.int(20, "Período BandPass", minval=2, maxval=200, group=G_CORE, inline="bp")
bandWidth      = input.float(0.25, "Ancho", minval=0.05, maxval=1.0, step=0.05, group=G_CORE, inline="bp")
barsPrediction = input.float(3.0, "Barras de predicción", minval=0.5, maxval=3.0, step=0.5, group=G_CORE)

showCorrColor  = input.bool(true, "Pulso de correlación", group=G_CORR)
syncCorrPeriod = input.string("Sincronizado", "Control", options=["Independiente", "Sincronizado"], group=G_CORR, inline="corr")
periodCorr     = input.int(40, "Período", minval=2, maxval=300, group=G_CORR, inline="corr")

showArea       = input.bool(true, "Área BandPass", group=G_VIS)
showGradient   = input.bool(true, "Gradiente VPF/BPF", group=G_VIS)
showGlow       = input.bool(true, "Efecto rayo neón", group=G_VIS)
showSignals    = input.bool(true, "Señales halo", group=G_VIS)
showDash       = input.bool(true, "Dashboard", group=G_VIS)
dashPos        = input.string("Arriba Derecha", "Posición dashboard", options=["Arriba Derecha", "Arriba Izquierda", "Abajo Derecha", "Abajo Izquierda"], group=G_VIS)

showWM = input.bool(true, "Mostrar firma", group=G_WM)

color bullColor = #00FF00
color bearColor = #FF0000
color areaColor = #AAFFFF
color neutralColor = #90A4AE
color panelColor = #0B0E16
color brandColor = #B6F400

// ════════════════════════════════════════════════════════════════════════════
//  MOTOR
// ════════════════════════════════════════════════════════════════════════════
f_whiten(float seriesValue) =>
    0.5 * (seriesValue - nz(seriesValue[2], nz(seriesValue[1], seriesValue)))

f_bandpass(float seriesValue, simple int periodValue, simple float bandwidthValue) =>
    float alpha = 2.0 * math.pi / periodValue
    float gamma = math.cos(alpha * bandwidthValue)
    float delta = 1.0 / gamma - math.sqrt(1.0 / math.pow(gamma, 2.0) - 1.0)
    float bandPass = na
    bandPass := (1.0 - delta) * f_whiten(seriesValue) + math.cos(alpha) * (1.0 + delta) * nz(bandPass[1]) - delta * nz(bandPass[2])
    bandPass

f_voss(float seriesValue, simple float predictionBars) =>
    int order = int(3.0 * math.min(3.0, predictionBars))
    float voss = na
    float energy = 0.0
    for i = 0 to order - 1
        energy := energy + nz(voss[order - i]) * (1.0 + i) / order
    voss := 0.5 * (3.0 + order) * seriesValue - energy
    voss

float bpfValue = f_bandpass(source, periodBandpass, bandWidth)
float vpfValue = f_voss(bpfValue, barsPrediction)
int corrPeriod = syncCorrPeriod == "Sincronizado" ? periodBandpass : periodCorr
float corrValue = ta.correlation(source, bar_index, corrPeriod)
float corrSafe = nz(corrValue, 0.0)

bool bullState = bpfValue > 0.0 and vpfValue > bpfValue
bool bearState = bpfValue < 0.0 and vpfValue < bpfValue
bool bullSignal = ta.crossover(vpfValue, bpfValue) and vpfValue < 0.0 and barstate.isconfirmed
bool bearSignal = ta.crossunder(vpfValue, bpfValue) and vpfValue > 0.0 and barstate.isconfirmed

color pulseColor = vpfValue >= 0.0 ? bullColor : bearColor
color stateColor = bullState ? bullColor : bearState ? bearColor : neutralColor
color corrColor = (corrSafe > 0.75 ? #00FF00 : corrSafe > 0.50 ? #00C000 : corrSafe > 0.25 ? #008000 : corrSafe > 0.0 ? #004000 : corrSafe > -0.25 ? #400000 : corrSafe > -0.50 ? #800000 : corrSafe > -0.75 ? #C00000 : #FF0000)

// ════════════════════════════════════════════════════════════════════════════
//  VISUAL
// ════════════════════════════════════════════════════════════════════════════
plot(showArea ? bpfValue : na, "BandPass Area", color=color.new(areaColor, 50), style=plot.style_area, histbase=0)

plot(showGlow ? vpfValue : na, "VPF Glow Ext", color=color.new(pulseColor, 90), linewidth=7)
plot(showGlow ? vpfValue : na, "VPF Glow", color=color.new(pulseColor, 68), linewidth=3)
pVPF = plot(vpfValue, "Future Pulse", color=color.new(pulseColor, 0), linewidth=1)
plot(showGlow ? vpfValue : na, "VPF Core", color=color.new(color.white, 38), linewidth=1)

plot(showGlow ? bpfValue : na, "BPF Glow", color=color.new(color.white, 90), linewidth=3)
pBPF = plot(bpfValue, "BandPass", color=color.new(color.white, 18), linewidth=1)

float bandHigh = math.max(vpfValue, bpfValue)
float bandLow = math.min(vpfValue, bpfValue)
color gradTop = (vpfValue >= bpfValue ? color.new(stateColor, 74) : color.new(stateColor, 100))
color gradBottom = (vpfValue >= bpfValue ? color.new(stateColor, 100) : color.new(stateColor, 74))
fill(pVPF, pBPF, top_value=bandHigh, bottom_value=bandLow, top_color=(showGradient ? gradTop : na), bottom_color=(showGradient ? gradBottom : na), title="Pulse Gradient")

plot(0.0, "Zero", color=color.new(neutralColor, 84), linewidth=1)
bool corrTick = showCorrColor and bar_index % 2 == 0
plotchar(corrTick ? 0.0 : na, "Correlation Pulse", "·", location.absolute, corrColor, size=size.tiny)

// Señales alineadas al cruce exacto: halo coloreado + núcleo blanco, ambos tiny.
plotchar(showSignals and bullSignal ? vpfValue : na, "Bull Halo", "●", location.absolute, color.new(bullColor, 68), size=size.tiny)
plotchar(showSignals and bearSignal ? vpfValue : na, "Bear Halo", "●", location.absolute, color.new(bearColor, 68), size=size.tiny)
plotchar(showSignals and bullSignal ? vpfValue : na, "Bull Signal", "•", location.absolute, color.new(color.white, 3), size=size.tiny)
plotchar(showSignals and bearSignal ? vpfValue : na, "Bear Signal", "•", location.absolute, color.new(color.white, 3), size=size.tiny)

// ════════════════════════════════════════════════════════════════════════════
//  DASHBOARD
// ════════════════════════════════════════════════════════════════════════════
f_pos(string posValue) =>
    posValue == "Arriba Derecha" ? position.top_right : posValue == "Arriba Izquierda" ? position.top_left : posValue == "Abajo Derecha" ? position.bottom_right : position.bottom_left

f_cell(table tableId, int row, string key, string value, color valueColor) =>
    table.cell(tableId, 0, row, key, text_color=color.new(neutralColor, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(tableId, 1, row, value, text_color=valueColor, text_size=size.tiny, text_halign=text.align_right)

var table dash = table.new(f_pos(dashPos), 2, 4, bgcolor=color.new(panelColor, 12), frame_color=color.new(bullColor, 52), frame_width=1, border_width=1)
if showDash and barstate.islast
    string stateText = bullState ? "IMPULSO +" : bearState ? "IMPULSO −" : "TRANSICIÓN"
    table.cell(dash, 0, 0, "VOSS FUTURE", text_color=color.white, bgcolor=color.new(#1B2030, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 0, stateText, text_color=stateColor, bgcolor=color.new(#1B2030, 0), text_size=size.tiny, text_halign=text.align_right)
    f_cell(dash, 1, "VPF", str.tostring(vpfValue, "#.###"), pulseColor)
    f_cell(dash, 2, "BPF", str.tostring(bpfValue, "#.###"), color.white)
    f_cell(dash, 3, "Correlación", str.tostring(corrValue, "#.##"), corrColor)

// ════════════════════════════════════════════════════════════════════════════
//  FIRMA + ALERTAS
// ════════════════════════════════════════════════════════════════════════════
var table watermark = table.new(position.bottom_right, 1, 1, bgcolor=color.new(color.black, 100))
if showWM and barstate.islast
    table.cell(watermark, 0, 0, "₿ BudAI", text_color=color.new(brandColor, 30), text_size=size.tiny)

alertcondition(bullSignal, "Voss Bull Pulse", "Voss Future Pulse · impulso alcista {{ticker}}")
alertcondition(bearSignal, "Voss Bear Pulse", "Voss Future Pulse · impulso bajista {{ticker}}")
