//@version=6
// ██████╗ ██╗   ██╗██████╗  █████╗ ██╗
// ██╔══██╗██║   ██║██╔══██╗██╔══██╗██║
// ██████╔╝██║   ██║██║  ██║███████║██║
// ██╔══██╗██║   ██║██║  ██║██╔══██║██║
// ██████╔╝╚██████╔╝██████╔╝██║  ██║██║
// ╚═════╝  ╚═════╝ ╚═════╝ ╚═╝  ╚═╝╚═╝
//         C R I P T O   ·   T R A D I N G   C A P I T A L
// ────────────────────────────────────────────────────────────────────────────
//  BudAI Capital® - ICT NYC Oscilator
//  COG (Ehlers) + Momentum + Money Flow SMC, normalizado 0–100.
//  Killzone NY 09:30–11:00 ET · Fibos 0.382 / 0.5 / 0.618 · divergencias.
//  (c) BudAI Capital® — Pine v6 · estetica futurista limpia
// ────────────────────────────────────────────────────────────────────────────
indicator("BudAI Capital® - ICT NYC Oscillator · Minimal", shorttitle="ICT NYC", overlay=false, max_labels_count=300)

// ════════════════ GRUPOS ════════════════
G_OSC = "① Nucleo del oscilador"
G_KZ  = "② Killzone NY (ICT)"
G_MF  = "③ Money Flow SMC"
G_FIB = "④ Niveles Fibo"
G_SIG = "⑤ Senales"
G_VIS = "⑥ Estetica"
G_RM  = "⑦ Risk plan (alertas)"

// ════════════════ ① NUCLEO ════════════════
cogLen  = input.int(9,  "COG (centro de gravedad)", minval=3, maxval=50, group=G_OSC, tooltip="Ciclo Ehlers. 9 ≈ scalping 1-5m en el NY open. Subir para TF altos.")
momLen  = input.int(10, "Momentum", minval=2, maxval=50, group=G_OSC)
normLen = input.int(34, "Ventana normalizacion", minval=10, maxval=200, group=G_OSC, tooltip="Escala el oscilador a 0-100 segun el rango reciente.")
smooth  = input.int(2,  "Suavizado", minval=1, maxval=10, group=G_OSC)
wCog    = input.float(0.4, "Peso COG (ciclo)", minval=0, maxval=1, step=0.1, group=G_OSC, inline="w")
wMom    = input.float(0.3, "Momentum", minval=0, maxval=1, step=0.1, group=G_OSC, inline="w")
wMfi    = input.float(0.3, "Money Flow", minval=0, maxval=1, step=0.1, group=G_OSC, inline="w")
maLen   = input.int(9, "Media de senal", minval=2, maxval=50, group=G_OSC)

// ════════════════ ② KILLZONE NY ════════════════
useKZ   = input.bool(true, "Solo operar en killzone NY", group=G_KZ, tooltip="Fuera de la ventana el oscilador sigue dibujando pero no emite entradas.")
string kzSession = input.session("0930-1100", "Ventana killzone", group=G_KZ, tooltip="09:30 → 11:00 ET (hora New York, con DST automatico).")
string kzTZ      = input.string("America/New_York", "Zona horaria", options=["America/New_York","UTC","Europe/London","America/Argentina/Buenos_Aires"], group=G_KZ)
kzWeek  = input.bool(true, "Solo dias habiles (Lun-Vie)", group=G_KZ)
showKZ  = input.bool(true, "Sombrear killzone", group=G_KZ)

// ════════════════ ③ MONEY FLOW SMC ════════════════
mfLen   = input.int(14, "Money Flow len", minval=2, maxval=50, group=G_MF)
showMF  = input.bool(true, "Histograma Money Flow (acum/dist)", group=G_MF)

// ════════════════ ④ FIBO ════════════════
showFib = input.bool(true, "Niveles Fibo (0.382 · 0.5 · 0.618)", group=G_FIB)

// ════════════════ ⑤ SENALES ════════════════
showSig = input.bool(true, "Entradas", group=G_SIG)
reqFlow = input.bool(true, "Exigir Money Flow a favor", group=G_SIG, tooltip="LONG solo con acumulacion (CMF>0); SHORT solo con distribucion.")
useDiv  = input.bool(true, "Marcar divergencias", group=G_SIG)
divLen  = input.int(5, "Pivote divergencia", minval=2, maxval=20, group=G_SIG)
minBars = input.int(6, "Barras minimas entre senales", minval=1, maxval=50, group=G_SIG)

// ════════════════ ⑥ ESTETICA ════════════════
showGlow = input.bool(true, "Efecto rayo (glow neon)", group=G_VIS)
showBody = input.bool(true, "Relleno degradado", group=G_VIS)
showMA   = input.bool(true, "Media de senal", group=G_VIS)
showDash = input.bool(true, "Dashboard", group=G_VIS)
dashPos  = input.string("Arriba Derecha", "Posicion dashboard", options=["Arriba Derecha","Arriba Izquierda","Abajo Derecha","Abajo Izquierda"], group=G_VIS)

color bullColor = #00FFC2
color bearColor = #FF1053
color warnColor = #FFD166


// ════════════════════════════════════════════════════════════════════════════
//  KILLZONE NY
// ════════════════════════════════════════════════════════════════════════════

bool isWeekday = not kzWeek or (dayofweek != dayofweek.saturday and dayofweek != dayofweek.sunday)
bool inKZraw   = not na(time(timeframe.period, kzSession, kzTZ))
bool inKZ      = inKZraw and isWeekday
bool kzGate    = not useKZ or inKZ


// ════════════════════════════════════════════════════════════════════════════
//  CENTER OF GRAVITY (Ehlers) + MOMENTUM + MONEY FLOW
// ════════════════════════════════════════════════════════════════════════════

float src = hlc3
float num = 0.0
float den = 0.0
for i = 0 to cogLen - 1
    float p = nz(src[i])
    num := num + (1 + i) * p
    den := den + p
float cogRaw = den != 0 ? -num / den + (cogLen + 1) / 2.0 : 0.0

float momRaw = close - close[momLen]

float mfi = ta.mfi(hlc3, mfLen)
float mfm = (high - low) != 0 ? ((close - low) - (high - close)) / (high - low) : 0.0
float volFix = nz(volume) == 0 ? 1.0 : volume
float cmf = math.sum(mfm * volFix, mfLen) / math.sum(volFix, mfLen)


// ════════════════════════════════════════════════════════════════════════════
//  COMPOSITE NORMALIZADO 0-100
// ════════════════════════════════════════════════════════════════════════════

f_norm(float s, simple int len) =>
    float lo = ta.lowest(s, len)
    float hi = ta.highest(s, len)
    hi - lo != 0 ? 100.0 * (s - lo) / (hi - lo) : 50.0

float wSum  = wCog + wMom + wMfi
float wN    = wSum == 0 ? 1.0 : wSum
float cogN  = f_norm(cogRaw, normLen)
float momN  = f_norm(momRaw, normLen)
float comp  = (cogN * wCog + momN * wMom + mfi * wMfi) / wN
float osc   = ta.ema(comp, smooth)
float oscMA = ta.ema(osc, maLen)


// ════════════════════════════════════════════════════════════════════════════
//  SENALES
// ════════════════════════════════════════════════════════════════════════════

bool flowUp = not reqFlow or cmf > 0
bool flowDn = not reqFlow or cmf < 0

bool buyTrig  = ta.crossover(osc, oscMA)  and osc < 50 and flowUp
bool sellTrig = ta.crossunder(osc, oscMA) and osc > 50 and flowDn

// Divergencias precio vs oscilador
float dpl = ta.pivotlow(low,   divLen, divLen)
float dph = ta.pivothigh(high, divLen, divLen)

var float pLo1 = na
var float pLo2 = na
var float oLo1 = na
var float oLo2 = na
var float pHi1 = na
var float pHi2 = na
var float oHi1 = na
var float oHi2 = na

if not na(dpl)
    pLo2 := pLo1
    pLo1 := dpl
    oLo2 := oLo1
    oLo1 := osc[divLen]

if not na(dph)
    pHi2 := pHi1
    pHi1 := dph
    oHi2 := oHi1
    oHi1 := osc[divLen]

bool bullDiv = useDiv and not na(dpl) and not na(pLo2) and pLo1 < pLo2 and oLo1 > oLo2
bool bearDiv = useDiv and not na(dph) and not na(pHi2) and pHi1 > pHi2 and oHi1 < oHi2

var int lastSigBar = 0
bool barFilter = bar_index - lastSigBar >= minBars

bool buySig  = showSig and (buyTrig  or bullDiv) and kzGate and barFilter and barstate.isconfirmed
bool sellSig = showSig and (sellTrig or bearDiv) and kzGate and barFilter and barstate.isconfirmed

if buySig or sellSig
    lastSigBar := bar_index


// ════════════════════════════════════════════════════════════════════════════
//  PLOTS
// ════════════════════════════════════════════════════════════════════════════

color oscCol = osc >= 50 ? bullColor : bearColor

plot(showGlow ? osc : na, "Osc Glow Ext", color=color.new(oscCol, 88), linewidth=8, display=display.pane)
plot(showGlow ? osc : na, "Osc Glow",     color=color.new(oscCol, 62), linewidth=4, display=display.pane)
pOsc = plot(osc, "Oscilador",             color=color.new(oscCol, 0),  linewidth=1, display=display.pane)
plot(showGlow ? osc : na, "Osc Nucleo",   color=color.new(color.white, 35), linewidth=1, display=display.pane)

pMid = plot(50, "Mid", color=color.new(#546e7a, 75), display=display.pane)

fill(pOsc, pMid, top_value=100, bottom_value=50, top_color=showBody ? color.new(bullColor, 60) : na, bottom_color=showBody ? color.new(bullColor, 96) : na, title="Acumulacion")
fill(pOsc, pMid, top_value=50,  bottom_value=0,  top_color=showBody ? color.new(bearColor, 96) : na, bottom_color=showBody ? color.new(bearColor, 60) : na, title="Distribucion")

plot(showMA ? oscMA : na, "Media de senal", color=color.new(#90a4ae, 25), linewidth=1, display=display.pane)

plot(showMF ? 50 + cmf * 50 : na, "Money Flow", color=cmf >= 0 ? color.new(bullColor, 62) : color.new(bearColor, 62), style=plot.style_columns, histbase=50, display=display.pane)

bgcolor(showKZ and inKZ ? color.new(warnColor, 93) : na, title="Killzone NY")

hline(100, "100", color=color.new(#546e7a, 82), linestyle=hline.style_dotted)
hline(0,   "0",   color=color.new(#546e7a, 82), linestyle=hline.style_dotted)

bool fibTick = showFib and barstate.islast
plotchar(fibTick ? 61.8 : na, "Fibo 0.618", "-", location.absolute, color.new(bearColor, 25), size=size.tiny, display=display.pane)
plotchar(fibTick ? 50.0 : na, "Fibo 0.5",   "-", location.absolute, color.new(#90a4ae, 20),   size=size.tiny, display=display.pane)
plotchar(fibTick ? 38.2 : na, "Fibo 0.382", "-", location.absolute, color.new(bullColor, 25), size=size.tiny, display=display.pane)

// Señal BudAI: círculo neón compacto. Una señal por evento; divergencias ya
// alimentan buySig/sellSig, por eso no se dibuja triángulo adicional encima.
plotshape(showGlow and buySig ? osc : na, "LONG Halo", shape.circle, location.absolute, color.new(bullColor, 82), size=size.small, display=display.pane)
plotshape(buySig ? osc : na, "LONG", shape.circle, location.absolute, color.new(bullColor, 5), size=size.tiny, display=display.pane)
plotchar(buySig ? osc : na, "LONG Core", "·", location.absolute, color.new(color.white, 8), size=size.tiny, display=display.pane)

plotshape(showGlow and sellSig ? osc : na, "SHORT Halo", shape.circle, location.absolute, color.new(bearColor, 82), size=size.small, display=display.pane)
plotshape(sellSig ? osc : na, "SHORT", shape.circle, location.absolute, color.new(bearColor, 5), size=size.tiny, display=display.pane)
plotchar(sellSig ? osc : na, "SHORT Core", "·", location.absolute, color.new(color.white, 8), size=size.tiny, display=display.pane)


// ════════════════════════════════════════════════════════════════════════════
//  DASHBOARD
// ════════════════════════════════════════════════════════════════════════════

f_pos(s) => (s == "Arriba Derecha" ? position.top_right : s == "Arriba Izquierda" ? position.top_left : s == "Abajo Derecha" ? position.bottom_right : position.bottom_left)

f_cell(t, r, k, v, vc) =>
    table.cell(t, 0, r, k, text_color=color.new(#90a4ae, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1, r, v, text_color=vc, text_size=size.tiny, text_halign=text.align_right)

var table d = table.new(f_pos(dashPos), 2, 6, bgcolor=color.new(#0b0e16, 14), frame_color=color.new(bullColor, 50), frame_width=1, border_width=1)

if showDash and barstate.islast
    color dimCol = color.new(#90a4ae, 35)

    table.cell(d, 0, 0, "ICT NYC", text_color=color.white, bgcolor=color.new(#1b2030, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(d, 1, 0, str.tostring(osc, "#.#"), text_color=oscCol, bgcolor=color.new(#1b2030, 0), text_size=size.tiny, text_halign=text.align_right)

    f_cell(d, 1, "Killzone", not useKZ ? "Libre" : inKZ ? "ACTIVA" : "Fuera", not useKZ ? dimCol : inKZ ? bullColor : dimCol)

    f_cell(d, 2, "Flujo", cmf > 0 ? "Acumulacion" : "Distribucion", cmf > 0 ? bullColor : bearColor)

    string fibZ = osc >= 61.8 ? "> .618" : osc >= 50 ? ".5–.618" : osc >= 38.2 ? ".382–.5" : "< .382"
    color  fibC = osc >= 61.8 ? bearColor : osc < 38.2 ? bullColor : dimCol
    f_cell(d, 3, "Fibo", fibZ, fibC)

    f_cell(d, 4, "Divergencia", bullDiv ? "Alcista" : bearDiv ? "Bajista" : "—", bullDiv ? bullColor : bearDiv ? bearColor : dimCol)

    string ver = buySig ? "LONG" : sellSig ? "SHORT" : (osc >= 50 and cmf > 0) ? "Sesgo alcista" : (osc < 50 and cmf < 0) ? "Sesgo bajista" : "Espera"
    color  verC = buySig ? bullColor : sellSig ? bearColor : (osc >= 50 and cmf > 0) ? bullColor : (osc < 50 and cmf < 0) ? bearColor : dimCol
    f_cell(d, 5, "Veredicto", ver, verC)


// ════════════════════════════════════════════════════════════════════════════
//  ALERTAS
// ════════════════════════════════════════════════════════════════════════════

alertSym  = input.symbol("", "Simbolo alerta (vacio = basecurrency+USDT)", group=G_RM, tooltip="Forzar p.ej. BTCUSDT. Vacio -> syminfo.basecurrency + USDT.")
sl_pct    = input.float(1.0, "SL %", minval=0, step=0.1, group=G_RM)
tp_pct    = input.float(3.0, "TP %  (R:R sugerido 1:3, rango 1:2 a 1:4)", minval=0, step=0.1, group=G_RM, inline="tp")
tp_q      = input.float(100, "qty%", minval=0, maxval=100, group=G_RM, inline="tp")
trail_act = input.float(1.5, "Trailing activacion %", minval=0, step=0.1, group=G_RM, inline="tr")
trail_cb  = input.float(0.6, "callback %", minval=0, step=0.1, group=G_RM, inline="tr")
be_trig   = input.float(0.8, "Break-even trigger %", minval=0, step=0.1, group=G_RM, inline="be")
be_off    = input.float(0.1, "offset %", minval=0, step=0.1, group=G_RM, inline="be")

f_sym() => alertSym != "" ? alertSym : syminfo.basecurrency + "USDT"

f_alertJson(string side) =>
    string tpJson = '[{"pct":' + str.tostring(tp_pct) + ',"qty_pct":' + str.tostring(tp_q) + '}]'
    string riskJson = '{"sl_pct":' + str.tostring(sl_pct) + ',"tp":' + tpJson +
         ',"trailing":{"activation_pct":' + str.tostring(trail_act) + ',"callback_pct":' + str.tostring(trail_cb) + '}' +
         ',"breakeven":{"trigger_pct":' + str.tostring(be_trig) + ',"offset_pct":' + str.tostring(be_off) + '}}'
    '{"side":"' + side + '","symbol":"' + f_sym() + '"' +
         ',"timeframe":"' + timeframe.period + '"' +
         ',"price":' + str.tostring(close) +
         ',"risk":' + riskJson + '}'

if buySig
    alert(f_alertJson("buy"),  alert.freq_once_per_bar_close)
if sellSig
    alert(f_alertJson("sell"), alert.freq_once_per_bar_close)

alertcondition(buySig,  "OSC LONG",    "ICT NYC Osc: LONG")
alertcondition(sellSig, "OSC SHORT",   "ICT NYC Osc: SHORT")
alertcondition(bullDiv, "Div alcista", "ICT NYC Osc: divergencia alcista")
alertcondition(bearDiv, "Div bajista", "ICT NYC Osc: divergencia bajista")
