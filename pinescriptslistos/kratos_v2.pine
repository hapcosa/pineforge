//@version=6
// ██████╗ ██╗   ██╗██████╗  █████╗ ██╗
// ██╔══██╗██║   ██║██╔══██╗██╔══██╗██║
// ██████╔╝██║   ██║██║  ██║███████║██║
// ██╔══██╗██║   ██║██║  ██║██╔══██║██║
// ██████╔╝╚██████╔╝██████╔╝██║  ██║██║
// ╚═════╝  ╚═════╝ ╚═════╝ ╚═╝  ╚═╝╚═╝
//         C R I P T O   ·   T R A D I N G   C A P I T A L
// ────────────────────────────────────────────────────────────────────────────
//  BudAI Capital® - Kratos V.2
//  Kratos = la fuerza que sostiene la tendencia.
//
//  MOTOR — kernel rational-quadratic (Nadaraya-Watson, endpoint) + banda ATR.
//  El kernel filtra ruido sin el retardo de una media móvil: el trail se pega a
//  la tendencia real y solo gira cuando el precio la rompe de verdad.
//
//  QUÉ TRAE
//    ① Trail      · soporte/resistencia dinámico con nube de profundidad
//    ② Reversión  · 3 zonas de agotamiento graduado sobre el mismo kernel
//    ③ Señales    · MOTOR PROPIO: flip del kernel + clasificador de fuerza 1-4
//                   + confirmación de tendencia EMA 50/200  (▲+ / ▼-)
//    ⑤ FVG/IFVG   · imbalance de 3 velas, con inversión de polaridad al romperse
//    ⑥ Sesiones   · Asia / Londres / NY con su rango high-low
//
//  POR QUÉ FUNCIONA — un solo motor alimenta todo. Trail, zonas de reversión y
//  fuerza de señal salen del mismo kernel, así que nunca se contradicen entre sí.
//  Sin repaint: MTF con lookahead_off y señales al cierre de vela confirmada.
//
//  Arranque limpio: por defecto solo se dibuja el Trail. El resto se enciende
//  desde el panel de configuración.
//  (c) BudAI Capital® — Pine v6
// ────────────────────────────────────────────────────────────────────────────
indicator("BudAI Capital® - Kratos V.2", shorttitle="KratosV2", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ════════════════ GRUPOS ════════════════
G_T   = "① Kratos Trail"
G_R   = "② Bandas de Reversión"
G_SIG = "③ Señales"
G_S   = "④ Estética"
G_FVG = "⑤ FVG · Imbalance"
G_KZ  = "⑥ Sesiones (killzones)"
G_WM  = "✦ Marca de agua"

// ════════════════ ① KRATOS TRAIL (kernel RQ + banda ATR) ════════════════
string resStr = input.string("", "Resolución (vacío = gráfico)", options=["", "1", "5", "15", "60", "240", "D"], group=G_T, tooltip="Resolución MTF del trail. Vacío = timeframe del gráfico.")
float  h      = input.float(8.0, "Sensitivity (bandwidth)", minval=1.0, maxval=100.0, step=0.5, group=G_T, tooltip="↑ = curva más suave / tendencia más larga (igual que la Sensitivity de referencia: 'higher = longer-term'). KNOB PRINCIPAL a igualar.")
float  rWt    = input.float(1.0, "Peso relativo (r)", minval=0.1, maxval=25.0, step=0.1, group=G_T, tooltip="Forma del kernel rational-quadratic. Bajo = más reactivo a barras recientes.")
int    winLen = input.int(50, "Ventana (barras)", minval=10, maxval=300, group=G_T, tooltip="Cuántas barras pesa el kernel hacia atrás.")
int    atrLen = input.int(14, "ATR length", minval=1, maxval=100, group=G_T)
float  bMult  = input.float(2.0, "Distancia banda (mult ATR)", minval=0.1, maxval=10.0, step=0.1, group=G_T, tooltip="Despegue del trail respecto al precio. Ajústalo DESPUÉS del bandwidth.")
float  cloudW = input.float(1.5, "Grosor de la nube (mult ATR)", minval=0.0, maxval=5.0, step=0.1, group=G_T)

// ════════════════ ② BANDAS DE REVERSIÓN (agotamiento graduado) ════════════════
bool  showRev  = input.bool(false, "Mostrar bandas de reversión", group=G_R, tooltip="Zonas de agotamiento más allá de la banda del trail, calculadas sobre el mismo kernel.")
float revStep  = input.float(0.8, "Paso de zona (mult ATR)", minval=0.1, maxval=5.0, step=0.1, group=G_R, tooltip="Ancho de cada escalón débil/normal/fuerte, en múltiplos de ATR más allá de la banda del trail.")
bool  markRev  = input.bool(true, "Marcar agotamiento extremo", group=G_R)
color C_REV_HI = input.color(#ff2d55, "Zona superior (rojo)", group=G_R, inline="rc", tooltip="Color propio de las bandas de reversión — independiente de la paleta del trail.")
color C_REV_LO = input.color(#00e676, "Zona inferior (verde)", group=G_R, inline="rc")

// ════════════════ ③ SEÑALES (motor propio sobre el kernel) ════════════════
bool  showSig    = input.bool(true, "Etiquetas de señal (flip + fuerza)", group=G_SIG, tooltip="Etiqueta ▲/▼ en cada flip del kernel, con clasificador de fuerza 1-4 y confirmación EMA 50/200.")
bool  useEmaConf = input.bool(true, "Confirmar con EMA 50/200", group=G_SIG, tooltip="Agrega un '+' a la etiqueta cuando la EMA 50/200 confirma la dirección del flip.")
int   minStrength= input.int(1, "Fuerza mínima para mostrar", minval=1, maxval=4, group=G_SIG, tooltip="1 = mostrar todas. 4 = solo flips con mayor extensión respecto al kernel.")

// ════════════════ ④ ESTÉTICA ════════════════
color C_BULL   = input.color(#00e5ff, "Alcista (celeste)", group=G_S, inline="c")
color C_BEAR   = input.color(#ff1e6e, "Bajista (fucsia)", group=G_S, inline="c")
bool  glow     = input.bool(true, "Glow (capa de brillo)", group=G_S)
int   fillT    = input.int(55, "Opacidad nube (núcleo)", minval=0, maxval=100, group=G_S)
int   fadeT    = input.int(90, "Opacidad nube (fade)", minval=0, maxval=100, group=G_S)
bool  cloudPx  = input.bool(true, "Nube hacia el precio", group=G_S, tooltip="ON = nube entre la línea y el precio (como la referencia). OFF = hacia afuera.")
bool  showFlip = input.bool(false, "Marcar flips", group=G_S, tooltip="Triángulos de flip. Redundante con las etiquetas ▲/▼ del grupo ③ — por eso viene apagado.")

// ════════════════ ⑤ FVG · IMBALANCE (hueco de 3 velas) ════════════════
bool  fvgSH   = input.bool(false, "Mostrar FVG", group=G_FVG, tooltip="Fair Value Gap: hueco entre el máximo de la vela 1 y el mínimo de la vela 3 (o inverso). Se dibuja al cierre de la vela 3 — sin repaint.")
float fvgMin  = input.float(0.25, "Ancho mínimo (mult ATR)", minval=0.0, maxval=5.0, step=0.05, group=G_FVG, tooltip="0 = sin filtro. Descarta imbalances más finos que ATR(14) × este valor.")
bool  fvgIFV  = input.bool(true, "Invertir a IFVG al invalidarse", group=G_FVG, tooltip="Inverse FVG: si el precio CIERRA al otro lado del hueco, la zona invierte polaridad y pasa a actuar como resistencia/soporte contrario. Recién en la SEGUNDA ruptura se considera mitigada.")
int    fvgMax = input.int(5, "Cantidad en pantalla", minval=1, maxval=60, group=G_FVG, tooltip="Cuántas zonas FVG/IFVG se mantienen dibujadas a la vez. Al superar el tope se borra la más vieja. Bajo = gráfico limpio.")
string fvgMit = input.string("Ocultar", "Zonas mitigadas", options=["Ocultar", "Atenuar", "Mantener"], group=G_FVG, tooltip="Qué hacer cuando la zona muere. Ocultar = se borra y libera cupo. Atenuar = queda como huella tenue. Mantener = queda con su color, congelada.")
bool  fvgCE   = input.bool(true, "Línea 50% (consequent encroachment)", group=G_FVG, tooltip="Mitad del hueco — el nivel donde el precio suele reaccionar al volver a testear el imbalance.")
color C_FVG_UP = input.color(color.new(#39ff14, 82), "FVG alcista (verde neón)", group=G_FVG, inline="fc")
color C_FVG_DN = input.color(color.new(#a855f7, 78), "bajista (morado)", group=G_FVG, inline="fc")

// ════════════════ ⑥ SESIONES / KILLZONES (Asia · Londres · NY) ════════════════
bool   kzSH    = input.bool(false, "Mostrar sesiones", group=G_KZ)
int    kzMaxTf = input.int(60, "Mostrar hasta TF (min)", options=[1, 3, 5, 15, 30, 45, 60], group=G_KZ, tooltip="Sobre este múltiplo intradía las cajas se ocultan. 60 = hasta 1H.")
string kzTz    = input.string("UTC-5", "Zona horaria", options=["UTC-5", "UTC-4", "UTC", "UTC+1", "UTC+2", "UTC+8", "UTC+9"], group=G_KZ, tooltip="UTC-5 = hora de Nueva York (estándar ICT).")
bool   kzBox   = input.bool(true, "Caja high/low", inline="kzv", group=G_KZ)
bool   kzLbl   = input.bool(true, "Etiqueta", inline="kzv", group=G_KZ)
bool   asOn    = input.bool(true, "", inline="as", group=G_KZ)
string asSes   = input.session("2000-0000", "Asia", inline="as", group=G_KZ)
color  asCol   = input.color(color.new(#b388ff, 90), "", inline="as", group=G_KZ)
bool   loOn    = input.bool(true, "", inline="lo", group=G_KZ)
string loSes   = input.session("0200-0500", "Londres", inline="lo", group=G_KZ)
color  loCol   = input.color(color.new(#ffab40, 90), "", inline="lo", group=G_KZ)
bool   nyOn    = input.bool(true, "", inline="ny", group=G_KZ)
string nySes   = input.session("0830-1100", "Nueva York", inline="ny", group=G_KZ)
color  nyCol   = input.color(color.new(#40c4ff, 90), "", inline="ny", group=G_KZ)

// ════════════════ ✦ MARCA DE AGUA ════════════════
bool   showWM = input.bool(true, "Mostrar firma BudAI Cripto", group=G_WM)
string wmPos  = input.string("Inferior Derecha", "Posición", options=["Inferior Izquierda", "Inferior Derecha", "Superior Izquierda", "Superior Derecha"], group=G_WM)
color  wmCol  = input.color(color.new(#b6f400, 35), "Color", group=G_WM)

// ════════════════ TIPOS (FVG / sesiones) ════════════════
type Gap
    box   bx
    box   hl
    line  ce
    float top
    float btm
    bool  bull
    bool  inv  = false
    bool  live = true

type Sess
    box   bx = na
    label lb = na
    float hi = na
    float lo = na
    bool  on = false

// Dibuja/actualiza una sesión. Mutar campos de un objeto UDT sí está permitido
// (son referencias); lo prohibido es asignar a una var global desde la función.
method kzDraw(Sess s, bool active, color col, string txt) =>
    if active and not s.on
        s.on := true
        s.hi := high
        s.lo := low
        if kzBox
            s.bx := box.new(bar_index, high, bar_index, low, border_color=color.new(col, 55), border_width=1, bgcolor=col)
        if kzLbl
            s.lb := label.new(bar_index, high, txt, style=label.style_label_down, color=color.new(color.black, 100), textcolor=color.new(col, 25), size=size.tiny)
    else if active
        s.hi := math.max(s.hi, high)
        s.lo := math.min(s.lo, low)
        if kzBox and not na(s.bx)
            box.set_top(s.bx, s.hi)
            box.set_bottom(s.bx, s.lo)
            box.set_right(s.bx, bar_index)
        if kzLbl and not na(s.lb)
            label.set_y(s.lb, s.hi)
    else if s.on
        s.on := false
    int(na)

// ════════════════ KERNEL RATIONAL-QUADRATIC (Nadaraya-Watson, endpoint) ════════════════
f_rq(float src, float bw, float r, int win) =>
    float num = 0.0
    float den = 0.0
    for i = 0 to win - 1
        float w = math.pow(1.0 + (i * i) / (bw * bw * 2.0 * r), -r)
        num += src[i] * w
        den += w
    den == 0.0 ? src : num / den

// ════════════════ TRAIL (en la resolución elegida, sin repaint) ════════════════
f_trail() =>
    float center = f_rq(close, h, rWt, winLen)
    float a      = ta.atr(atrLen)
    float up     = center + bMult * a
    float dn     = center - bMult * a
    var int d    = 1
    d := na(up[1]) ? d : (close > up[1] ? 1 : (close < dn[1] ? -1 : d))
    float tr     = d == 1 ? dn : up
    [tr, d, a, center]

string res = resStr == "" ? timeframe.period : resStr
[trailLine, trailDir, trailAtr, kernelCenter] = request.security(syminfo.tickerid, res, f_trail(), lookahead = barmerge.lookahead_off)

bool  isBull     = trailDir == 1
color trailCol   = isBull ? C_BULL : C_BEAR
float cwS        = cloudPx ? cloudW : -cloudW
float cloudEdge  = isBull ? trailLine + cwS * trailAtr : trailLine - cwS * trailAtr

// ════════════════ PLOTS (glow multicapa + onda + nube en degradado) ════════════════
float hiE    = math.max(trailLine, cloudEdge)
float loE    = math.min(trailLine, cloudEdge)
bool  lineHi = trailLine >= cloudEdge
plot(glow ? trailLine : na, "Glow ext", color=color.new(trailCol, 92), linewidth=6)
plot(glow ? trailLine : na, "Glow",     color=color.new(trailCol, 80), linewidth=3)
pMain  = plot(trailLine, "Trail", color=trailCol, linewidth=2)
pCloud = plot(cloudEdge, "Nube (borde)", color=color.new(trailCol, 100))
fill(pMain, pCloud, top_value=hiE, bottom_value=loE, top_color=color.new(trailCol, lineHi ? fillT : fadeT), bottom_color=color.new(trailCol, lineHi ? fadeT : fillT), title="Nube Trail")

// ════════════════ FLIPS ════════════════
bool flipUp   = isBull and not isBull[1]
bool flipDown = not isBull and isBull[1]
plotshape(showFlip and flipUp,   title="Flip alcista", style=shape.triangleup,   location=location.belowbar, color=C_BULL, size=size.tiny)
plotshape(showFlip and flipDown, title="Flip bajista", style=shape.triangledown, location=location.abovebar, color=C_BEAR, size=size.tiny)

// ════════════════ BANDAS DE REVERSIÓN (agotamiento graduado, sobre el kernel) ════════════════
float outerUp = kernelCenter + bMult * trailAtr
float outerDn = kernelCenter - bMult * trailAtr
float revUp1  = outerUp + revStep * trailAtr * 1
float revUp2  = outerUp + revStep * trailAtr * 2
float revUp3  = outerUp + revStep * trailAtr * 3
float revDn1  = outerDn - revStep * trailAtr * 1
float revDn2  = outerDn - revStep * trailAtr * 2
float revDn3  = outerDn - revStep * trailAtr * 3

// ── Render: geometría original (3 zonas por lado, escalones 92/85/75) con la
//    paleta clásica propia. C_REV_HI (rojo) arriba / C_REV_LO (verde) abajo. Solo estética. ──
// Anclas de fill invisibles, igual que la versión ámbar original.
pRevUp0 = plot(showRev ? outerUp : na, "Reversión Sup base",   color=na, display=display.none)
pRevUp1 = plot(showRev ? revUp1  : na, "Reversión Sup débil",  color=color.new(C_REV_HI, 100))
pRevUp2 = plot(showRev ? revUp2  : na, "Reversión Sup normal", color=color.new(C_REV_HI, 100))
plot(glow and showRev ? revUp3 : na,   "Reversión Sup halo",   color=color.new(C_REV_HI, 88), linewidth=6)
pRevUp3 = plot(showRev ? revUp3  : na, "Reversión Sup fuerte", color=color.new(C_REV_HI, 15), linewidth=2)

pRevDn0 = plot(showRev ? outerDn : na, "Reversión Inf base",   color=na, display=display.none)
pRevDn1 = plot(showRev ? revDn1  : na, "Reversión Inf débil",  color=color.new(C_REV_LO, 100))
pRevDn2 = plot(showRev ? revDn2  : na, "Reversión Inf normal", color=color.new(C_REV_LO, 100))
plot(glow and showRev ? revDn3 : na,   "Reversión Inf halo",   color=color.new(C_REV_LO, 88), linewidth=6)
pRevDn3 = plot(showRev ? revDn3  : na, "Reversión Inf fuerte", color=color.new(C_REV_LO, 15), linewidth=2)

// Zonas: mismos escalones de la versión original, ahora en rojo / verde clásico.
fill(pRevUp0, pRevUp1, color=showRev ? color.new(C_REV_HI, 92) : na, title="Zona Sup débil")
fill(pRevUp1, pRevUp2, color=showRev ? color.new(C_REV_HI, 85) : na, title="Zona Sup normal")
fill(pRevUp2, pRevUp3, color=showRev ? color.new(C_REV_HI, 75) : na, title="Zona Sup fuerte")
fill(pRevDn0, pRevDn1, color=showRev ? color.new(C_REV_LO, 92) : na, title="Zona Inf débil")
fill(pRevDn1, pRevDn2, color=showRev ? color.new(C_REV_LO, 85) : na, title="Zona Inf normal")
fill(pRevDn2, pRevDn3, color=showRev ? color.new(C_REV_LO, 75) : na, title="Zona Inf fuerte")

// LED terminal sobre el último valor de revUp3 / revDn3 (2 capas: halo + núcleo).
bool ledOn = glow and showRev and barstate.islast
plot(ledOn ? revUp3 : na, "LED Sup halo",   color=color.new(C_REV_HI, 88), style=plot.style_circles, linewidth=9)
plot(ledOn ? revUp3 : na, "LED Sup núcleo", color=color.new(C_REV_HI, 8),  style=plot.style_circles, linewidth=3)
plot(ledOn ? revDn3 : na, "LED Inf halo",   color=color.new(C_REV_LO, 88), style=plot.style_circles, linewidth=9)
plot(ledOn ? revDn3 : na, "LED Inf núcleo", color=color.new(C_REV_LO, 8),  style=plot.style_circles, linewidth=3)

// Marca de agotamiento extremo — primer pinchazo de la zona "fuerte"
bool revTop = showRev and markRev and high >= revUp3 and high[1] < revUp3[1]
bool revBot = showRev and markRev and low  <= revDn3 and low[1]  > revDn3[1]
plotchar(revTop ? high : na, "Kratos Agotamiento Sup", "•", location.absolute, color=C_REV_HI, size=size.tiny)
plotchar(revBot ? low  : na, "Kratos Agotamiento Inf", "•", location.absolute, color=C_REV_LO, size=size.tiny)

// ════════════════ MOTOR DE SEÑALES — flip + fuerza 1-4 + confirmación EMA ════════════════
float ema50  = ta.ema(close, 50)
float ema200 = ta.ema(close, 200)
bool  emaBull = ema50 > ema200
bool  emaBear = ema50 < ema200

// Fuerza = extensión del precio respecto al kernel, en múltiplos de ATR.
float extAtr    = math.abs(close - kernelCenter) / math.max(trailAtr, syminfo.mintick)
int   strength  = extAtr < 1.0 ? 1 : extAtr < 2.0 ? 2 : extAtr < 3.0 ? 3 : 4
bool  passStr   = strength >= minStrength

var array<label> sigLabels = array.new_label()
const int MAX_SIG_LABELS = 200

f_addSigLabel(txt, y, styleUp, col) =>
    if array.size(sigLabels) >= MAX_SIG_LABELS
        label.delete(array.shift(sigLabels))
    lbl = label.new(bar_index, y, txt, style=styleUp ? label.style_label_up : label.style_label_down, color=col, textcolor=color.black, size=size.small)
    array.push(sigLabels, lbl)

if showSig and passStr and barstate.isconfirmed and flipUp
    string txt = "▲" + (useEmaConf ? (emaBull ? "+" : "-") : "")
    f_addSigLabel(txt, low - trailAtr * 0.5, true, C_BULL)
if showSig and passStr and barstate.isconfirmed and flipDown
    string txt = "▼" + (useEmaConf ? (emaBear ? "+" : "-") : "")
    f_addSigLabel(txt, high + trailAtr * 0.5, false, C_BEAR)

// ════════════════ FVG / IFVG (cajas — no consumen presupuesto de plots) ════════════════
float fvgAtr = ta.atr(14)
var array<Gap> gaps = array.new<Gap>()

// El hueco vive entre la vela 1 y la vela 3; la vela 2 es la que lo deja abierto.
// Alcista: low(vela3) por encima de high(vela1).  Bajista: high(vela3) por debajo de low(vela1).
if fvgSH and barstate.isconfirmed
    bool bullGap = low > high[2] and (low - high[2]) >= fvgMin * fvgAtr
    bool bearGap = high < low[2] and (low[2] - high) >= fvgMin * fvgAtr
    if bullGap or bearGap
        float gTop = bullGap ? low : low[2]
        float gBtm = bullGap ? high[2] : high
        color gCol = bullGap ? C_FVG_UP : C_FVG_DN
        // Glow del trazo: caja halo (borde grueso, muy transparente, sin relleno)
        // dibujada ANTES que el core para que el borde nítido quede encima.
        box gHl = na
        if glow
            gHl := box.new(bar_index - 2, gTop, bar_index, gBtm, border_color=color.new(gCol, 72), border_width=4, bgcolor=na)
        box  gBx = box.new(bar_index - 2, gTop, bar_index, gBtm, border_color=color.new(gCol, 22), border_width=1, bgcolor=gCol)
        line gCe = na
        if fvgCE
            gCe := line.new(bar_index - 2, math.avg(gTop, gBtm), bar_index, math.avg(gTop, gBtm), color=color.new(gCol, 35), style=line.style_dashed, width=1)
        array.unshift(gaps, Gap.new(gBx, gHl, gCe, gTop, gBtm, bullGap))
    while array.size(gaps) > fvgMax
        Gap oldG = array.pop(gaps)
        box.delete(oldG.bx)
        box.delete(oldG.hl)
        line.delete(oldG.ce)

// Extensión + invalidación. Cierre al otro lado del hueco = IFVG (invierte polaridad).
if fvgSH and array.size(gaps) > 0
    for i = array.size(gaps) - 1 to 0
        Gap g = array.get(gaps, i)
        if g.live
            box.set_right(g.bx, bar_index)
            if not na(g.hl)
                box.set_right(g.hl, bar_index)
            if not na(g.ce)
                line.set_x2(g.ce, bar_index)
            bool broken = g.bull ? close < g.btm : close > g.top
            if broken
                if fvgIFV and not g.inv
                    g.inv  := true
                    g.bull := not g.bull
                    color icol = g.bull ? C_FVG_UP : C_FVG_DN
                    box.set_bgcolor(g.bx, icol)
                    box.set_border_color(g.bx, color.new(icol, 30))
                    box.set_border_style(g.bx, line.style_dashed)
                    if not na(g.hl)
                        box.set_border_color(g.hl, color.new(icol, 74))
                    if not na(g.ce)
                        line.set_color(g.ce, color.new(icol, 35))
                else
                    g.live := false
                    color mcol = g.bull ? C_FVG_UP : C_FVG_DN
                    if fvgMit == "Ocultar"
                        box.delete(g.bx)
                        box.delete(g.hl)
                        line.delete(g.ce)
                        array.remove(gaps, i)
                    else if fvgMit == "Atenuar"
                        box.set_bgcolor(g.bx, color.new(mcol, 94))
                        box.set_border_color(g.bx, color.new(mcol, 84))
                        box.delete(g.hl)
                        g.hl := na
                        line.delete(g.ce)
                        g.ce := na

// ════════════════ SESIONES (Asia · Londres · NY) ════════════════
bool kzOk = kzSH and timeframe.isintraday and timeframe.multiplier <= kzMaxTf
bool inAs = kzOk and asOn and not na(time(timeframe.period, asSes, kzTz))
bool inLo = kzOk and loOn and not na(time(timeframe.period, loSes, kzTz))
bool inNy = kzOk and nyOn and not na(time(timeframe.period, nySes, kzTz))

var Sess szAs = Sess.new()
var Sess szLo = Sess.new()
var Sess szNy = Sess.new()
szAs.kzDraw(inAs, asCol, "ASIA")
szLo.kzDraw(inLo, loCol, "LONDRES")
szNy.kzDraw(inNy, nyCol, "NY")

// ════════════════ MARCA DE AGUA (tabla 1×1) ════════════════
f_wmPos(p) =>
    p == "Inferior Izquierda" ? position.bottom_left : p == "Inferior Derecha" ? position.bottom_right : p == "Superior Izquierda" ? position.top_left : position.top_right
var table wm = table.new(f_wmPos(wmPos), 1, 1)
if showWM and barstate.islast
    table.cell(wm, 0, 0, "₿ BudAI Cripto", text_color=wmCol, text_size=size.normal, bgcolor=color.new(#0b0e16, 100))

// ════════════════ ALERTAS ════════════════
alertcondition(flipUp,   title="Kratos Trail · flip alcista", message="Kratos Trail flip BULL")
alertcondition(flipDown, title="Kratos Trail · flip bajista", message="Kratos Trail flip BEAR")
alertcondition(flipUp   and strength >= 3, title="Kratos · señal fuerte alcista", message="Kratos Señal BULL (fuerza ≥3)")
alertcondition(flipDown and strength >= 3, title="Kratos · señal fuerte bajista", message="Kratos Señal BEAR (fuerza ≥3)")
alertcondition(revTop,   title="Kratos · agotamiento superior", message="Kratos Reversión: zona fuerte SUP")
alertcondition(revBot,   title="Kratos · agotamiento inferior", message="Kratos Reversión: zona fuerte INF")

