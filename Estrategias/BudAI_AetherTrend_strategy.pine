//@version=6
// ██████╗ ██╗   ██╗██████╗  █████╗ ██╗
// ██╔══██╗██║   ██║██╔══██╗██╔══██╗██║
// ██████╔╝██║   ██║██║  ██║███████║██║
// ██╔══██╗██║   ██║██║  ██║██╔══██║██║
// ██████╔╝╚██████╔╝██████╔╝██║  ██║██║
// ╚═════╝  ╚═════╝ ╚═════╝ ╚═╝  ╚═╝╚═╝
//         C R I P T O   ·   T R A D I N G   C A P I T A L
// ────────────────────────────────────────────────────────────────────────────
//  BudAI Capital® - Aether Trend [STRATEGY]
//  Gatillo: flip de dirección AlphaTrend. Filtros opcionales: régimen ER,
//  lado VWAP, RVOL. Bar-close, entrada = close.
//  Defaults NO optimizados.
//  (c) BudAI Capital® — Pine v6 · strategy
// ────────────────────────────────────────────────────────────────────────────
strategy("BudAI Capital® - Aether Trend [STRAT]", shorttitle="BudAI · Aether STRAT", overlay=true,
     initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     commission_type=strategy.commission.percent, commission_value=0.05, slippage=2,
     pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false, max_labels_count=300)

G_AET = "① Aether"
G_FLU = "② Ancla (VWAP + volumen)"
G_RISK= "③ Gestión (TP/SL)"

atCoeff = input.float(1.0, "AlphaTrend factor", minval=0.3, step=0.1, group=G_AET, inline="at")
atLen   = input.int(14, "ATR/RSI", minval=2, group=G_AET, inline="at")
erLen   = input.int(20, "Efficiency Ratio", minval=5, group=G_AET, inline="er")
erThr   = input.float(0.30, "umbral ER", minval=0.1, maxval=0.9, step=0.05, group=G_AET, inline="er")
useReg  = input.bool(true, "Exigir régimen de tendencia (ER)", group=G_AET)
confirmBars = input.int(1, "Barras de confirmación del flip", minval=1, maxval=5, step=1, group=G_AET)
useVwap = input.bool(false, "Filtrar por lado del VWAP", group=G_FLU)
volThr  = input.float(1.0, "Volumen mínimo (RVOL ×)", minval=1.0, maxval=5.0, step=0.1, group=G_FLU)
allowLong  = input.bool(true,  "Largos", group=G_RISK, inline="d")
allowShort = input.bool(true,  "Cortos", group=G_RISK, inline="d")
tp1Pct = input.float(1.0, "TP1 %", minval=0.1, step=0.1, group=G_RISK, inline="tp")
tp2Pct = input.float(2.0, "TP2 %", minval=0.1, step=0.1, group=G_RISK, inline="tp")
tp3Pct = input.float(3.0, "TP3 %", minval=0.1, step=0.1, group=G_RISK, inline="tp")
slPct  = input.float(2.0, "SL %",  minval=0.1, step=0.1, group=G_RISK)
upCol = input.color(#00e676, "Alcista", group=G_RISK, inline="c")
dnCol = input.color(#ff1744, "Bajista", group=G_RISK, inline="c")

bool conf = barstate.isconfirmed

// ── AETHER ────────────────────────────────────────────────────
float atrA = ta.sma(ta.tr(true), atLen)
float rsiA = ta.rsi(close, atLen)
float upT  = low - atrA * atCoeff
float dnT  = high + atrA * atCoeff
var float alpha = 0.0
alpha := rsiA >= 50 ? (upT < nz(alpha[1]) ? nz(alpha[1]) : upT) : (dnT > nz(alpha[1]) ? nz(alpha[1]) : dnT)
int trendDir = alpha > alpha[2] ? 1 : alpha < alpha[2] ? -1 : 0
float erChg = math.abs(close - close[erLen])
float erVol = math.sum(math.abs(close - close[1]), erLen)
float er    = erVol != 0 ? erChg / erVol : 0.0
bool trending = er >= erThr

// ── FLIP + CONFIRMATION ───────────────────────────────────────
bool flipUp = trendDir == 1 and trendDir[1] != 1
bool flipDn = trendDir == -1 and trendDir[1] != -1
bool confUp = flipUp
bool confDn = flipDn
if confirmBars > 1
    for i = 0 to confirmBars - 1
        confUp := confUp and trendDir[i] == 1
    for i = 0 to confirmBars - 1
        confDn := confDn and trendDir[i] == -1

// ── ANCLA ─────────────────────────────────────────────────────
float vwap = ta.vwap(hlc3)
bool above = close >= vwap
bool below = close <= vwap
float rvol = ta.sma(volume, 20) != 0 ? volume / ta.sma(volume, 20) : 1.0
bool volOk = rvol >= volThr

// ── SIGNAL ────────────────────────────────────────────────────
bool regUpOk = not useReg or trending
bool regDnOk = not useReg or trending
bool aboveEff = not useVwap or above
bool belowEff = not useVwap or below
bool longSig  = confUp and regUpOk and aboveEff and volOk and conf and allowLong
bool shortSig = confDn and regDnOk and belowEff and volOk and conf and allowShort

if longSig
    strategy.entry("L", strategy.long)
if shortSig
    strategy.entry("S", strategy.short)
if strategy.position_size > 0
    float e = strategy.position_avg_price
    strategy.exit("L1", "L", qty_percent=33, limit=e * (1 + tp1Pct / 100), stop=e * (1 - slPct / 100))
    strategy.exit("L2", "L", qty_percent=33, limit=e * (1 + tp2Pct / 100), stop=e * (1 - slPct / 100))
    strategy.exit("L3", "L",                 limit=e * (1 + tp3Pct / 100), stop=e * (1 - slPct / 100))
if strategy.position_size < 0
    float e = strategy.position_avg_price
    strategy.exit("S1", "S", qty_percent=33, limit=e * (1 - tp1Pct / 100), stop=e * (1 + slPct / 100))
    strategy.exit("S2", "S", qty_percent=33, limit=e * (1 - tp2Pct / 100), stop=e * (1 + slPct / 100))
    strategy.exit("S3", "S",                 limit=e * (1 - tp3Pct / 100), stop=e * (1 + slPct / 100))

color atCol = trendDir == 1 ? upCol : trendDir == -1 ? dnCol : color.new(color.gray, 40)
plot(alpha, "AlphaTrend", color=atCol, linewidth=1)
plot(vwap, "VWAP", color=color.new(color.gray, 50), linewidth=1)
plotshape(longSig,  "LONG",  shape.triangleup,   location.belowbar, upCol, size=size.tiny)
plotshape(shortSig, "SHORT", shape.triangledown, location.abovebar, dnCol, size=size.tiny)
var table wm = table.new(position.bottom_right, 1, 1, bgcolor=color.new(color.black, 100))
if barstate.islast
    table.cell(wm, 0, 0, "₿ BudAI Capital®", text_color=color.new(#b6f400, 30), text_size=size.tiny)
