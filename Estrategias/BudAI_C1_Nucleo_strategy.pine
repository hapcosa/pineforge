//@version=6
// ██████╗ ██╗   ██╗██████╗  █████╗ ██╗
// ██╔══██╗██║   ██║██╔══██╗██╔══██╗██║
// ██████╔╝██║   ██║██║  ██║███████║██║
// ██╔══██╗██║   ██║██║  ██║██╔══██║██║
// ██████╔╝╚██████╔╝██████╔╝██║  ██║██║
// ╚═════╝  ╚═════╝ ╚═════╝ ╚═╝  ╚═╝╚═╝
//         C R I P T O   ·   T R A D I N G   C A P I T A L
// ────────────────────────────────────────────────────────────────────────────
//  BudAI Capital® - C1 · Núcleo [STRATEGY]
//  Versión BACKTESTEABLE de la combinación C1 (Aether + Athenea + Ancla).
//  MISMA lógica que best combinations/BudAI_C1_Nucleo.pine, con entradas/salidas,
//  TP1/TP2/TP3 parciales y SL. Defaults NO optimizados: el backtest dice la verdad.
//  (c) BudAI Capital® — Pine v6 · strategy
// ────────────────────────────────────────────────────────────────────────────
strategy("BudAI Capital® - C1 Núcleo [STRAT]", shorttitle="BudAI · C1 STRAT", overlay=true,
     initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     commission_type=strategy.commission.percent, commission_value=0.05, slippage=2,
     pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false, max_labels_count=300)

// ════════════════ GRUPOS ════════════════
G_REG = "① Filtro · Aether"
G_TRG = "② Gatillo · Athenea"
G_FLU = "③ Confirmación · Ancla"
G_RISK= "④ Gestión (TP/SL)"
G_DATE= "⑤ Rango de backtest"
G_VIS = "⑥ Estética"

// ① Aether
atCoeff = input.float(1.0, "AlphaTrend factor", minval=0.3, step=0.1, group=G_REG, inline="at")
atLen   = input.int(14, "ATR/RSI", minval=2, group=G_REG, inline="at")
erLen   = input.int(20, "Efficiency Ratio", minval=5, group=G_REG, inline="er")
erThr   = input.float(0.30, "umbral", minval=0.1, maxval=0.9, step=0.05, group=G_REG, inline="er")
useReg  = input.bool(true, "Exigir TENDENCIA", group=G_REG)
// ② Athenea
src     = input.source(hlc3, "Fuente", group=G_TRG)
chanLen = input.int(9,  "WaveTrend canal", minval=3, group=G_TRG)
avgLen  = input.int(12, "WaveTrend promedio", minval=2, group=G_TRG)
slopeLen= input.int(20, "Slope regresión", minval=3, group=G_TRG)
cogLen  = input.int(9,  "COG", minval=3, group=G_TRG)
cuspLen = input.int(2,  "Confirmar cúspide", minval=1, maxval=6, group=G_TRG)
obLvl   = input.int(70, "Sobrecompra", minval=55, maxval=95, group=G_TRG, inline="z")
osLvl   = input.int(30, "Sobreventa", minval=5, maxval=45, group=G_TRG, inline="z")
// ③ Ancla
useVwap = input.bool(true, "Lado correcto del VWAP", group=G_FLU)
volThr  = input.float(1.2, "Volumen mínimo (RVOL ×)", minval=1.0, maxval=5.0, step=0.1, group=G_FLU)
// ④ Riesgo
allowLong  = input.bool(true,  "Operar largos", group=G_RISK, inline="d")
allowShort = input.bool(true,  "Operar cortos", group=G_RISK, inline="d")
tp1Pct = input.float(1.0, "TP1 %", minval=0.1, step=0.1, group=G_RISK, inline="tp")
tp2Pct = input.float(2.0, "TP2 %", minval=0.1, step=0.1, group=G_RISK, inline="tp")
tp3Pct = input.float(3.0, "TP3 %", minval=0.1, step=0.1, group=G_RISK, inline="tp")
slPct  = input.float(2.0, "SL %",  minval=0.1, step=0.1, group=G_RISK)
// ⑤ Fechas
useDate = input.bool(false, "Limitar rango", group=G_DATE)
dFrom   = input.time(timestamp("2023-01-01"), "Desde", group=G_DATE)
dTo     = input.time(timestamp("2026-12-31"), "Hasta", group=G_DATE)
// ⑥ Estética
upCol = input.color(#00e676, "Alcista", group=G_VIS, inline="c")
dnCol = input.color(#ff1744, "Bajista", group=G_VIS, inline="c")
amber = input.color(#ffb300, "VWAP", group=G_VIS)

// ════════════════════════════════════════════════════════════════════════════
//  ① AETHER
// ════════════════════════════════════════════════════════════════════════════
bool conf = barstate.isconfirmed
float atr = ta.sma(ta.tr, atLen)
float rsi = ta.rsi(close, atLen)
float upT = low  - atr * atCoeff
float dnT = high + atr * atCoeff
var float alpha = 0.0
alpha := rsi >= 50 ? (upT < nz(alpha[1]) ? nz(alpha[1]) : upT) : (dnT > nz(alpha[1]) ? nz(alpha[1]) : dnT)
int trendDir = alpha > alpha[2] ? 1 : alpha < alpha[2] ? -1 : 0
float erChg = math.abs(close - close[erLen])
float erVol = math.sum(math.abs(close - close[1]), erLen)
float er = erVol != 0 ? erChg / erVol : 0.0
bool trending = not useReg or er >= erThr

// ════════════════════════════════════════════════════════════════════════════
//  ② ATHENEA
// ════════════════════════════════════════════════════════════════════════════
f_norm(float s, simple int len) =>
    float lo = ta.lowest(s, len)
    float hi = ta.highest(s, len)
    hi - lo != 0 ? 100.0 * (s - lo) / (hi - lo) : 50.0
float esa = ta.ema(src, chanLen)
float de  = ta.ema(math.abs(src - esa), chanLen)
float ci  = de == 0 ? 0.0 : (src - esa) / (0.015 * de)
float wt1 = ta.ema(ci, avgLen)
float lr0 = ta.linreg(src, slopeLen, 0)
float lr1 = ta.linreg(src, slopeLen, 1)
float slopeRaw = lr0 - lr1
float cogNum = 0.0
float cogDen = 0.0
for i = 0 to cogLen - 1
    float p = nz(src[i])
    cogNum += (1 + i) * p
    cogDen += p
float cogRaw = cogDen != 0 ? -cogNum / cogDen + (cogLen + 1) / 2.0 : 0.0
float osc = f_norm(wt1, 100) * 0.5 + f_norm(slopeRaw, 100) * 0.3 + f_norm(cogRaw, 100) * 0.2
float pvH = ta.pivothigh(osc, cuspLen, cuspLen)
float pvL = ta.pivotlow(osc,  cuspLen, cuspLen)
bool cuspBull = not na(pvL) and pvL < osLvl
bool cuspBear = not na(pvH) and pvH > obLvl

// ════════════════════════════════════════════════════════════════════════════
//  ③ ANCLA
// ════════════════════════════════════════════════════════════════════════════
float vwap = ta.vwap(hlc3)
bool aboveVwap = not useVwap or close >= vwap
bool belowVwap = not useVwap or close <= vwap
float rvol = ta.sma(volume, 20) != 0 ? volume / ta.sma(volume, 20) : 1.0
bool volOk = rvol >= volThr

// ════════════════════════════════════════════════════════════════════════════
//  CONFLUENCIA + EJECUCIÓN
// ════════════════════════════════════════════════════════════════════════════
bool inWindow = not useDate or (time >= dFrom and time <= dTo)
bool longSig  = trending and trendDir == 1  and cuspBull and aboveVwap and volOk and conf and inWindow and allowLong
bool shortSig = trending and trendDir == -1 and cuspBear and belowVwap and volOk and conf and inWindow and allowShort

if longSig
    strategy.entry("L", strategy.long)
if shortSig
    strategy.entry("S", strategy.short)

// Salidas: TP1/TP2/TP3 parciales (33/33/resto) + SL común
if strategy.position_size > 0
    float e = strategy.position_avg_price
    strategy.exit("L1", "L", qty_percent=33, limit=e * (1 + tp1Pct / 100), stop=e * (1 - slPct / 100))
    strategy.exit("L2", "L", qty_percent=33, limit=e * (1 + tp2Pct / 100), stop=e * (1 - slPct / 100))
    strategy.exit("L3", "L",                 limit=e * (1 + tp3Pct / 100), stop=e * (1 - slPct / 100))
if strategy.position_size < 0
    float e = strategy.position_avg_price
    strategy.exit("S1", "S", qty_percent=33, limit=e * (1 - tp1Pct / 100), stop=e * (1 + slPct / 100))
    strategy.exit("S2", "S", qty_percent=33, limit=e * (1 - tp2Pct / 100), stop=e * (1 + slPct / 100))
    strategy.exit("S3", "S",                 limit=e * (1 - tp3Pct / 100), stop=e * (1 + slPct / 100))

// ════════════════════════════════════════════════════════════════════════════
//  VISUAL (mínimo, para ver el contexto)
// ════════════════════════════════════════════════════════════════════════════
color atCol = trendDir == 1 ? upCol : trendDir == -1 ? dnCol : color.new(color.gray, 40)
plot(alpha, "AlphaTrend halo", color=color.new(atCol, 80), linewidth=4)
plot(alpha, "AlphaTrend", color=atCol, linewidth=1)
plot(vwap, "VWAP", color=color.new(amber, 0), linewidth=1)
plotchar(longSig  ? low  - 0.6 * ta.atr(14) : na, "LONG",  "▲", location.absolute, color=upCol, size=size.tiny)
plotchar(shortSig ? high + 0.6 * ta.atr(14) : na, "SHORT", "▼", location.absolute, color=dnCol, size=size.tiny)

// ════════════════ ✦ MARCA DE AGUA ════════════════
var table wm = table.new(position.bottom_right, 1, 1, bgcolor=color.new(color.black, 100))
if barstate.islast
    table.cell(wm, 0, 0, "₿ BudAI Capital®", text_color=color.new(#b6f400, 30), text_size=size.tiny)
