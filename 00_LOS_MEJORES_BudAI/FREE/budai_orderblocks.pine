//@version=6
// ██████╗ ██╗   ██╗██████╗  █████╗ ██╗
// ██╔══██╗██║   ██║██╔══██╗██╔══██╗██║
// ██████╔╝██║   ██║██║  ██║███████║██║
// ██╔══██╗██║   ██║██║  ██║██╔══██║██║
// ██████╔╝╚██████╔╝██████╔╝██║  ██║██║
// ╚═════╝  ╚═════╝ ╚═════╝ ╚═╝  ╚═╝╚═╝
//         C R I P T O   ·   T R A D I N G   C A P I T A L
// ────────────────────────────────────────────────────────────────────────────
//  BudAI Capital® - Volumetric Order Blocks
//  Order Blocks atados a ruptura de estructura (BOS/CHoCH) — la vela extrema del
//  impulso. Volumen institucional, mitigación Close/Wick/Avg, breakers, overlap.
//  (c) BudAI Capital® — Pine v6 · overlay · cyberpunk
// ────────────────────────────────────────────────────────────────────────────
indicator("BudAI Capital® - Volumetric Order Blocks", shorttitle="BudAI Capital® - Volumetric Order Blocks", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500, max_bars_back=3000)

// ════════════════ GRUPOS ════════════════
G_STR = "① Estructura"
G_OB  = "② Order Blocks"
G_MIT = "③ Mitigación"
G_VIS = "④ Estética"
G_WM  = "✦ Marca de agua"

// ════════════════ ① ESTRUCTURA ════════════════
swLen   = input.int(5, "Swing (pivote estructura)", minval=2, maxval=50, group=G_STR, tooltip="Pivote para detectar swings y rupturas. 5 = reactivo, 10 = mayor.")
showStr = input.bool(true, "Mostrar líneas BOS / CHoCH", group=G_STR)

// ════════════════ ② ORDER BLOCKS ════════════════
obLast   = input.int(5, "Mostrar últimos N OB (por lado)", minval=1, maxval=20, group=G_OB)
obMode   = input.string("Length", "Construcción", options=["Length","Full"], group=G_OB, tooltip="Length = caja ajustada por ATR (institucional) · Full = cuerpo completo de la vela.")
obLen    = input.float(1.0, "Length · factor ATR", minval=0.1, maxval=3.0, step=0.1, group=G_OB)
showVol  = input.bool(true, "Mostrar volumen del OB", group=G_OB)
hideOvlp = input.bool(true, "Ocultar OB solapados", group=G_OB)

// ════════════════ ③ MITIGACIÓN ════════════════
mitMethod = input.string("Close", "Método de mitigación", options=["Close","Wick","Avg"], group=G_MIT, tooltip="Close = cierre del cuerpo · Wick = mecha · Avg = punto medio del OB.")
showBB    = input.bool(false, "Mostrar Breakers (OB roto)", group=G_MIT, tooltip="Conserva el OB como 'breaker' invertido tras mitigarse.")

// ════════════════ ④ ESTÉTICA (cyberpunk neón) ════════════════
bullCol  = input.color(color.new(#00e676, 84), "OB demanda (fill)", group=G_VIS, inline="c")
bearCol  = input.color(color.new(#ff1744, 84), "OB oferta (fill)",  group=G_VIS, inline="c")
bullBord = input.color(#00e676, "Borde demanda", group=G_VIS, inline="b")
bearBord = input.color(#ff1744, "Borde oferta",  group=G_VIS, inline="b")
bbUpCol  = input.color(color.new(#00e676, 70), "Breaker alcista", group=G_VIS, inline="bb")
bbDnCol  = input.color(color.new(#ff1744, 70), "Breaker bajista", group=G_VIS, inline="bb")
showMid  = input.bool(true, "Línea media del OB", group=G_VIS)
showDash = input.bool(true, "Dashboard minimalista", group=G_VIS)
dashPos  = input.string("Arriba Derecha", "Posición", options=["Arriba Derecha","Arriba Izquierda","Abajo Derecha","Abajo Izquierda"], group=G_VIS)

// ════════════════ ✦ MARCA DE AGUA ════════════════
showWM = input.bool(true, "Mostrar firma BudAI Cripto", group=G_WM)
wmPos  = input.string("Inferior Derecha", "Posición", options=["Inferior Izquierda","Inferior Derecha","Superior Izquierda","Superior Derecha"], group=G_WM)
wmCol  = input.color(color.new(#b6f400, 35), "Color", group=G_WM)

// ════════════════════════════════════════════════════════════════════════════
//  TIPOS
// ════════════════════════════════════════════════════════════════════════════
type OB
    box   bx
    box   bxBB
    line  mid
    label lb
    float top
    float bot
    float avg
    int   dir          // 1 demanda / -1 oferta
    float vol
    bool  broken = false

// ════════════════════════════════════════════════════════════════════════════
//  BASE
// ════════════════════════════════════════════════════════════════════════════
float atr  = ta.atr(200)
bool  conf = barstate.isconfirmed
float ph   = ta.pivothigh(high, swLen, swLen)
float pl   = ta.pivotlow(low,  swLen, swLen)

// ════════════════════════════════════════════════════════════════════════════
//  ESTRUCTURA — máquina de estados (trend / BOS / CHoCH)
// ════════════════════════════════════════════════════════════════════════════
var float lastHigh = na   // último swing high registrado
var float lastLow  = na   // último swing low registrado
var int   trend    = 0    // 1 alcista / -1 bajista

if not na(ph)
    lastHigh := ph
if not na(pl)
    lastLow  := pl

bool brokeUp = not na(lastHigh) and close > lastHigh and close[1] <= lastHigh and conf
bool brokeDn = not na(lastLow)  and close < lastLow  and close[1] >= lastLow  and conf

bool bosUp = false
bool bosDn = false
bool chochUp = false
bool chochDn = false

if brokeUp
    if trend < 0
        chochUp := true
    else
        bosUp := true
    trend := 1
    lastHigh := na
if brokeDn
    if trend > 0
        chochDn := true
    else
        bosDn := true
    trend := -1
    lastLow := na

// ════════════════════════════════════════════════════════════════════════════
//  BÚSQUEDA DE LA VELA EXTREMA DEL IMPULSO (clave para ubicar el OB)
//  Al romper al alza → buscar el MÍNIMO más bajo del tramo previo = Bull OB.
//  Al romper a la baja → buscar el MÁXIMO más alto del tramo previo = Bear OB.
// ════════════════════════════════════════════════════════════════════════════
f_findExtreme(bool findLow, int lookback) =>
    float ext = findLow ? 99999999.0 : 0.0
    int   idx = 0
    int   lb  = math.min(lookback, 300)
    for i = 0 to lb
        if findLow
            if low[i] < ext
                ext := low[i]
                idx := i
        else
            if high[i] > ext
                ext := high[i]
                idx := i
    idx

// ════════════════════════════════════════════════════════════════════════════
//  ORDER BLOCKS
// ════════════════════════════════════════════════════════════════════════════
var array<OB> bullOBs = array.new<OB>()
var array<OB> bearOBs = array.new<OB>()

f_makeOB(arr, dir) =>
    // ubicar la vela extrema del impulso (hasta ~swing*6 barras atrás)
    int  ext = f_findExtreme(dir > 0, swLen * 6)
    float candleHi = high[ext]
    float candleLo = low[ext]
    float top = na
    float bot = na
    if dir > 0
        // demanda: desde el mínimo de la vela hacia arriba
        bot := candleLo
        top := obMode == "Length" ? math.min(candleLo + atr * obLen, candleHi) : candleHi
    else
        // oferta: desde el máximo hacia abajo
        top := candleHi
        bot := obMode == "Length" ? math.max(candleHi - atr * obLen, candleLo) : candleLo
    float avg = math.avg(top, bot)
    color fillC = dir > 0 ? bullCol : bearCol
    color bordC = dir > 0 ? bullBord : bearBord
    int   x1 = bar_index - ext
    box   bx = box.new(x1, top, bar_index, bot, bgcolor=fillC, border_color=color.new(bordC, 30), border_width=1)
    line  md = showMid ? line.new(x1, avg, bar_index, avg, color=color.new(bordC, 35), style=line.style_dashed, width=1) : na
    label lb = showVol ? label.new(bar_index, avg, str.tostring(volume[ext], format.volume), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(bordC, 80), textcolor=bordC, size=size.tiny) : na
    OB nob = OB.new(bx, na, md, lb, top, bot, avg, dir, volume[ext], false)
    if array.size(arr) >= obLast
        OB old = array.shift(arr)
        box.delete(old.bx)
        box.delete(old.bxBB)
        line.delete(old.mid)
        label.delete(old.lb)
    array.push(arr, nob)

if (bosUp or chochUp)
    f_makeOB(bullOBs, 1)
if (bosDn or chochDn)
    f_makeOB(bearOBs, -1)

// ── mitigación + extensión ──
f_mitTouch(top, bot, avg, dir) =>
    float refHi = mitMethod == "Close" ? math.max(close, open) : mitMethod == "Wick" ? high : math.max(close, open)
    float refLo = mitMethod == "Close" ? math.min(close, open) : mitMethod == "Wick" ? low  : math.min(close, open)
    bool result = false
    if dir > 0
        result := mitMethod == "Avg" ? low <= avg : refLo < bot
    else
        result := mitMethod == "Avg" ? high >= avg : refHi > top
    result

f_process(arr) =>
    int i = array.size(arr) - 1
    while i >= 0
        OB ob = array.get(arr, i)
        if not ob.broken
            box.set_right(ob.bx, bar_index)
            if not na(ob.mid)
                line.set_x2(ob.mid, bar_index)
            if not na(ob.lb)
                label.set_x(ob.lb, bar_index)
            if f_mitTouch(ob.top, ob.bot, ob.avg, ob.dir)
                ob.broken := true
                if showBB
                    // breaker: caja invertida de color contrario
                    color bbc = ob.dir > 0 ? bbDnCol : bbUpCol
                    box.set_bgcolor(ob.bx, bbc)
                    box.set_border_color(ob.bx, color.new(ob.dir > 0 ? bearBord : bullBord, 40))
                else
                    box.delete(ob.bx)
                    line.delete(ob.mid)
                    label.delete(ob.lb)
                    array.remove(arr, i)
        else
            // breaker activo: extender hasta romperse del todo
            box.set_right(ob.bx, bar_index)
            bool fullBreak = ob.dir > 0 ? close > ob.top : close < ob.bot
            if fullBreak
                box.delete(ob.bx)
                line.delete(ob.mid)
                label.delete(ob.lb)
                array.remove(arr, i)
        i := i - 1

f_process(bullOBs)
f_process(bearOBs)

// ── ocultar solapados (deja el más reciente) ──
f_dedupe(arr) =>
    if hideOvlp and array.size(arr) > 1
        int i = array.size(arr) - 2
        while i >= 0
            OB older = array.get(arr, i)
            OB newer = array.get(arr, array.size(arr) - 1)
            bool overlap = older.bot <= newer.top and older.top >= newer.bot
            if overlap and not older.broken
                box.delete(older.bx)
                line.delete(older.mid)
                label.delete(older.lb)
                array.remove(arr, i)
            i := i - 1

f_dedupe(bullOBs)
f_dedupe(bearOBs)

// ════════════════════════════════════════════════════════════════════════════
//  ESTRUCTURA — líneas BOS / CHoCH
// ════════════════════════════════════════════════════════════════════════════
var array<line>  strLines = array.new_line()
var array<label> strLbls  = array.new_label()
f_strLine(txt, y, col) =>
    if array.size(strLines) >= 20
        line.delete(array.shift(strLines))
        label.delete(array.shift(strLbls))
    array.push(strLines, line.new(bar_index - swLen, y, bar_index, y, color=color.new(col, 30), style=line.style_dashed, width=1))
    array.push(strLbls, label.new(bar_index, y, txt, xloc=xloc.bar_index, style=label.style_none, textcolor=col, size=size.tiny))

if showStr and bosUp
    f_strLine("BOS", close, bullBord)
if showStr and bosDn
    f_strLine("BOS", close, bearBord)
if showStr and chochUp
    f_strLine("CHoCH", close, bullBord)
if showStr and chochDn
    f_strLine("CHoCH", close, bearBord)

// ════════════════════════════════════════════════════════════════════════════
//  DASHBOARD minimalista (tiny)
// ════════════════════════════════════════════════════════════════════════════
f_pos(s) => (s == "Arriba Derecha" ? position.top_right : s == "Arriba Izquierda" ? position.top_left : s == "Abajo Derecha" ? position.bottom_right : position.bottom_left)
var table d = table.new(f_pos(dashPos), 2, 4, bgcolor=color.new(#0b0e16, 14), frame_color=color.new(#00e676, 40), frame_width=1, border_width=1)
f_cell(t, r, k, v, vc) =>
    table.cell(t, 0, r, k, text_color=color.new(#90a4ae, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1, r, v, text_color=vc, text_size=size.tiny, text_halign=text.align_right)

var string lastEvt = "—"
var color  lastEvtC = color.gray
if bosUp
    lastEvt := "BOS ▲"
    lastEvtC := bullBord
if bosDn
    lastEvt := "BOS ▼"
    lastEvtC := bearBord
if chochUp
    lastEvt := "CHoCH ▲"
    lastEvtC := bullBord
if chochDn
    lastEvt := "CHoCH ▼"
    lastEvtC := bearBord

if showDash and barstate.islast
    string trendTxt = trend > 0 ? "ALCISTA" : trend < 0 ? "BAJISTA" : "NEUTRO"
    color  trendC = trend > 0 ? bullBord : trend < 0 ? bearBord : color.new(#90a4ae, 0)
    table.cell(d, 0, 0, "Order Blocks", text_color=color.white, bgcolor=color.new(#1b2030,0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(d, 1, 0, trendTxt, text_color=trendC, bgcolor=color.new(#1b2030,0), text_size=size.tiny, text_halign=text.align_right)
    f_cell(d, 1, "Último evento", lastEvt, lastEvtC)
    f_cell(d, 2, "OB demanda", str.tostring(array.size(bullOBs)), bullBord)
    f_cell(d, 3, "OB oferta",  str.tostring(array.size(bearOBs)), bearBord)

// ════════════════════════════════════════════════════════════════════════════
//  MARCA DE AGUA — firma BudAI Cripto
// ════════════════════════════════════════════════════════════════════════════
f_wmPos(s) => s == "Inferior Izquierda" ? position.bottom_left : s == "Inferior Derecha" ? position.bottom_right : s == "Superior Izquierda" ? position.top_left : position.top_right
var table wm = table.new(f_wmPos(wmPos), 1, 1, bgcolor=color.new(color.black, 100))
if showWM and barstate.islast
    table.cell(wm, 0, 0, "₿ BudAI Capital®", text_color=wmCol, text_size=size.tiny)

// ════════════════════════════════════════════════════════════════════════════
//  ALERTAS
// ════════════════════════════════════════════════════════════════════════════
alertcondition(bosUp,   "BOS alcista",   "OB · BOS alcista {{ticker}}")
alertcondition(bosDn,   "BOS bajista",   "OB · BOS bajista {{ticker}}")
alertcondition(chochUp, "CHoCH alcista", "OB · CHoCH alcista {{ticker}}")
alertcondition(chochDn, "CHoCH bajista", "OB · CHoCH bajista {{ticker}}")
