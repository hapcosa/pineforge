//@version=6
// ██████╗ ██╗   ██╗██████╗  █████╗ ██╗
// ██╔══██╗██║   ██║██╔══██╗██╔══██╗██║
// ██████╔╝██║   ██║██║  ██║███████║██║
// ██╔══██╗██║   ██║██║  ██║██╔══██║██║
// ██████╔╝╚██████╔╝██████╔╝██║  ██║██║
// ╚═════╝  ╚═════╝ ╚═════╝ ╚═╝  ╚═╝╚═╝
//         C R I P T O   ·   T R A D I N G   C A P I T A L
// ────────────────────────────────────────────────────────────────────────────
//  BudAI Capital® - Siddharta · Master Confluence Oscillator
//  Oscilador maestro reducido. Funde 4 módulos direccionales (Momentum WaveTrend,
//  Money Flow, Tendencia y Center of Gravity de Ehlers) más 2 filtros de calidad
//  (Volatilidad y Anti-Ruido por Efficiency Ratio) en UN solo veredicto:
//      LONG · SHORT · NO TRADE.
//  Si no hay confluencia y calidad suficientes, dice NO TRADE. No fuerza entradas.
//  (c) BudAI Capital® — Pine v6 · panel inferior
// ────────────────────────────────────────────────────────────────────────────
indicator("BudAI Capital® - Siddharta", shorttitle="BudAI Capital® - Siddharta", overlay=false, precision=1, max_labels_count=200, max_lines_count=100)

// ════════════════════════════════════════════════════════════════════════════
//  GRUPOS DE INPUTS
// ════════════════════════════════════════════════════════════════════════════
G_PROF = "① Perfil de Trading"
G_W    = "② Pesos de Confluencia"
G_FILT = "③ Filtros de Calidad"
G_COG  = "④ Center of Gravity"
G_SIG  = "⑤ Señal Final"
G_VIS  = "⑥ Visual"
G_COL  = "⑦ Colores"
G_WM   = "✦ Marca de agua"

// ════════════════ ① PERFIL ════════════════
// El perfil ajusta automáticamente longitudes, suavizado, umbral y filtros.
profile = input.string("Day Trader", "Perfil", options=["Scalper","Day Trader","Swing Trader"], group=G_PROF, tooltip="Scalper: 1-5m, más sensible (anti-ruido activo). Day: 5m-1H, balanceado. Swing: 4H-1D-1W, más estricto.")
src     = input.source(hlc3, "Fuente", group=G_PROF)

bool isScalp = profile == "Scalper"
bool isDay   = profile == "Day Trader"

// Longitudes derivadas del perfil (simple int → válidas para funciones ta.*)
int chanLen  = isScalp ? 7  : isDay ? 9  : 13     // canal WaveTrend (momentum)
int avgLen   = isScalp ? 9  : isDay ? 12 : 21     // promedio WaveTrend
int volLen   = isScalp ? 14 : isDay ? 20 : 34     // money flow
int trendLen = isScalp ? 21 : isDay ? 34 : 55     // tendencia
int cogLen   = isScalp ? 9  : isDay ? 14 : 21     // center of gravity
int sigLen   = isScalp ? 3  : isDay ? 5  : 8      // suavizado de la línea de señal
int erLen    = isScalp ? 10 : isDay ? 14 : 20     // ventana efficiency ratio

// Umbral / filtros derivados del perfil
float threshold = isScalp ? 56.0 : isDay ? 64.0 : 72.0   // score mínimo para señal
float erMin     = isScalp ? 0.20 : isDay ? 0.28 : 0.36   // trending mínimo (anti-lateral)
float neutBand  = isScalp ? 6.0  : isDay ? 8.0  : 10.0   // banda neutral alrededor de 50
int   minAgree  = isScalp ? 2    : 3                     // módulos que deben coincidir (de 4)

// ════════════════ ② PESOS ════════════════
// Suman 80% direccional; Volatilidad (10) + Anti-ruido (10) forman el 20% de calidad.
wMom   = input.float(25, "Peso Momentum %", minval=0, maxval=100, step=1, group=G_W, inline="w1")
wVol   = input.float(20, "Peso Money Flow %", minval=0, maxval=100, step=1, group=G_W, inline="w1")
wTrend = input.float(20, "Peso Tendencia %", minval=0, maxval=100, step=1, group=G_W, inline="w2")
wCog   = input.float(15, "Peso Center of Gravity %", minval=0, maxval=100, step=1, group=G_W, inline="w2")

// ════════════════ ③ FILTROS DE CALIDAD ════════════════
useVolF   = input.bool(true, "Filtro de volatilidad (evita rango muerto)", group=G_FILT)
useNoiseF = input.bool(true, "Filtro anti-ruido (Efficiency Ratio)", group=G_FILT)
volWin    = input.int(50, "Ventana de volatilidad", minval=10, group=G_FILT)

// ════════════════ ④ CENTER OF GRAVITY ════════════════
cogOB = input.int(85, "COG sobreextensión alta (veta LONG nuevos)", minval=60, maxval=99, group=G_COG, tooltip="Si el precio está muy por encima de su centro de gravedad, no se persigue: bloquea LONG nuevos.")
cogOS = input.int(15, "COG sobreextensión baja (veta SHORT nuevos)", minval=1, maxval=40, group=G_COG)

// ════════════════ ⑤ SEÑAL FINAL ════════════════
showSig    = input.bool(true, "Mostrar marcadores LONG / SHORT", group=G_SIG)
showNoTrade= input.bool(true, "Sombrear fondo en NO TRADE", group=G_SIG)
showHist   = input.bool(true, "Histograma de score (sutil)", group=G_SIG)
holdGap    = input.int(15, "Histéresis de salida (score)", minval=0, maxval=40, group=G_SIG, tooltip="Cuánto debe caer el score por debajo del umbral para cancelar el estado (evita parpadeo).")

// ════════════════ ⑥ VISUAL ════════════════
showDash = input.bool(true, "Dashboard", group=G_VIS)
dashPos  = input.string("Arriba Derecha", "Posición", options=["Arriba Derecha","Arriba Izquierda","Abajo Derecha","Abajo Izquierda"], group=G_VIS)
glow     = input.bool(true, "Relleno degradado (nube)", group=G_VIS)
shadeInt = input.int(62, "Opacidad nube", minval=30, maxval=92, group=G_VIS)

// ════════════════ ⑦ COLORES ════════════════
upCol  = input.color(#00e5ff, "Bull (cian neón)", group=G_COL, inline="c")
dnCol  = input.color(#ff6a00, "Bear (naranjo neón)", group=G_COL, inline="c")
neutCol= input.color(#90a4ae, "Neutral / No Trade (gris)", group=G_COL)
strongCol = input.color(#ffffff, "Confirmación fuerte (blanco)", group=G_COL)

// ════════════════ ✦ MARCA DE AGUA ════════════════
showWM = input.bool(true, "Mostrar firma BudAI Cripto", group=G_WM)
wmPos  = input.string("Inferior Derecha", "Posición", options=["Inferior Izquierda","Inferior Derecha","Superior Izquierda","Superior Derecha"], group=G_WM)
wmCol  = input.color(color.new(#b6f400, 35), "Color", group=G_WM)


// ════════════════════════════════════════════════════════════════════════════
//  FUNCIONES
// ════════════════════════════════════════════════════════════════════════════
// Normaliza una serie a 0..100 según su rango reciente
f_norm(float s, simple int len) =>
    float lo = ta.lowest(s, len)
    float hi = ta.highest(s, len)
    hi - lo != 0 ? 100.0 * (s - lo) / (hi - lo) : 50.0

f_clamp(float v, float lo, float hi) => math.max(lo, math.min(hi, v))


// ════════════════════════════════════════════════════════════════════════════
//  MÓDULO A — MOMENTUM (WaveTrend normalizado)
//  Mide aceleración real del impulso, robusto entre activos y timeframes.
// ════════════════════════════════════════════════════════════════════════════
float esa  = ta.ema(src, chanLen)
float de   = ta.ema(math.abs(src - esa), chanLen)
float ci   = de == 0 ? 0.0 : (src - esa) / (0.015 * de)
float wt   = ta.ema(ci, avgLen)
float momN = f_norm(wt, 100)
float momS = f_clamp((momN - 50) / 50, -1, 1)          // sesgo direccional -1..+1

// ════════════════════════════════════════════════════════════════════════════
//  MÓDULO B — MONEY FLOW (CMF + MFI: presión real de volumen)
// ════════════════════════════════════════════════════════════════════════════
float vol = nz(volume) == 0 ? 1.0 : volume
float mfm = (high - low) != 0 ? ((close - low) - (high - close)) / (high - low) : 0.0
float cmf = math.sum(mfm * vol, volLen) / math.sum(vol, volLen)        // -1..+1
float mfi = ta.mfi(hlc3, volLen)                                        // 0..100
float volN = f_clamp(50 + cmf * 50, 0, 100) * 0.5 + mfi * 0.5          // fusión 0..100
float volS = f_clamp((volN - 50) / 50, -1, 1)

// ════════════════════════════════════════════════════════════════════════════
//  MÓDULO C — TENDENCIA (pendiente de HMA suavizada, escalada por ATR)
// ════════════════════════════════════════════════════════════════════════════
float atr   = ta.atr(14)
float ma    = ta.hma(src, trendLen)
float slope = ma - ma[2]
float trendS = f_clamp(atr != 0 ? slope / (atr * 0.9) : 0, -1, 1)
float trendN = 50 + trendS * 50

// ════════════════════════════════════════════════════════════════════════════
//  MÓDULO D — CENTER OF GRAVITY (Ehlers) — equilibrio / desviación
//  No genera señales por sí solo: actúa como confirmación y como veto de
//  sobreextensión (no perseguir precio alejado de su gravedad).
// ════════════════════════════════════════════════════════════════════════════
float cgNum = 0.0
float cgDen = 0.0
for i = 0 to cogLen - 1
    float p = src[i]
    cgNum := cgNum + (1 + i) * p
    cgDen := cgDen + p
float cg   = cgDen != 0 ? -cgNum / cgDen + (cogLen + 1) / 2.0 : 0.0
float cgSm = ta.sma(cg, 3)
float cogN = f_norm(cgSm, 100)                          // 0..100 (posición vs gravedad)
float cogS = f_clamp((cogN - 50) / 50, -1, 1)


// ════════════════════════════════════════════════════════════════════════════
//  FILTROS DE CALIDAD (no direccionales)
// ════════════════════════════════════════════════════════════════════════════
// E1 — Volatilidad: ATR normalizado vs su propio rango (0..1)
float natr = close != 0 ? atr / close : 0.0
float volQ = useVolF ? f_norm(natr, volWin) / 100.0 : 1.0

// E2 — Anti-ruido: Efficiency Ratio de Kaufman (0 ruido / 1 tendencia limpia)
float change = math.abs(close - close[erLen])
float noise  = math.sum(math.abs(close - close[1]), erLen)
float er     = noise != 0 ? change / noise : 0.0
float erQ    = useNoiseF ? er : 1.0


// ════════════════════════════════════════════════════════════════════════════
//  MÓDULO F — CONFLUENCIA Y SCORE (0..100)
// ════════════════════════════════════════════════════════════════════════════
float wSum = wMom + wVol + wTrend + wCog
float net  = wSum > 0 ? (wMom * momS + wVol * volS + wTrend * trendS + wCog * cogS) / wSum : 0.0  // -1..+1

float dirStrength = math.abs(net)                       // 0..1
int   direction   = net > 0 ? 1 : net < 0 ? -1 : 0

// Calidad combinada (volatilidad + anti-ruido) 0..1
float qual = (volQ + erQ) / 2.0

// Score final: 80% confluencia direccional + 20% calidad de contexto
float score = math.round(100 * (0.8 * dirStrength + 0.2 * qual))

// Oscilador compuesto (línea principal) y señal suavizada
float comp = 50 + net * 50                              // 0..100, centrado en 50
float sig  = ta.sma(comp, sigLen)

// Conteo de módulos alineados con la dirección neta
int agUp = (momS > 0 ? 1 : 0) + (volS > 0 ? 1 : 0) + (trendS > 0 ? 1 : 0) + (cogS > 0 ? 1 : 0)
int agDn = (momS < 0 ? 1 : 0) + (volS < 0 ? 1 : 0) + (trendS < 0 ? 1 : 0) + (cogS < 0 ? 1 : 0)
int agree = direction > 0 ? agUp : direction < 0 ? agDn : 0

// ── Condiciones de bloqueo (NO TRADE) ──────────────────────────────────────
bool lateral   = (useNoiseF and er < erMin) or math.abs(comp - 50) <= neutBand
bool lowVol    = useVolF and volQ < 0.15
bool conflict  = agree < minAgree
bool vetoLong  = cogN >= cogOB                          // sobreextensión: no perseguir arriba
bool vetoShort = cogN <= cogOS                          // sobreextensión: no perseguir abajo
bool trendBlkL = trendS < -0.5                          // tendencia claramente contraria a un LONG
bool trendBlkS = trendS > 0.5                           // tendencia claramente contraria a un SHORT
bool blocked   = lateral or lowVol or conflict

// ── Señal cruda con todos los requisitos ────────────────────────────────────
bool conf = barstate.isconfirmed
bool rawLong  = direction > 0 and score >= threshold and not blocked and not vetoLong  and not trendBlkL and conf
bool rawShort = direction < 0 and score >= threshold and not blocked and not vetoShort and not trendBlkS and conf

// Diagnóstico de bloqueo (para dashboard y alertas)
bool blkOverext = direction > 0 and vetoLong or direction < 0 and vetoShort
bool blkTrend   = direction > 0 and trendBlkL or direction < 0 and trendBlkS
bool blkNoise   = direction != 0 and (lateral or lowVol)

// ── Máquina de estados con histéresis (evita parpadeo) ──────────────────────
var int state = 0                                        // 1 LONG · -1 SHORT · 0 NO TRADE
float exitTh = threshold - holdGap
if rawLong
    state := 1
else if rawShort
    state := -1
else if blocked or score < exitTh or (state == 1 and direction <= 0) or (state == -1 and direction >= 0)
    state := 0

bool isLong  = state == 1
bool isShort = state == -1
bool noTrade = state == 0

// Transiciones (para marcadores y alertas)
bool enterLong  = isLong  and state[1] != 1
bool enterShort = isShort and state[1] != -1
bool exitLong   = state[1] == 1 and not isLong
bool exitShort  = state[1] == -1 and not isShort
bool toNoTrade  = noTrade and state[1] != 0

// Confirmación fuerte: 4/4 módulos alineados, fuera de zona neutral y con calidad alta
bool strongLong  = enterLong  and agUp == 4 and qual >= 0.5
bool strongShort = enterShort and agDn == 4 and qual >= 0.5

// Confluencia fuerte (independiente del estado, para alerta)
bool strongConfUp = agUp == 4 and score >= threshold and not blocked
bool strongConfDn = agDn == 4 and score >= threshold and not blocked


// ════════════════════════════════════════════════════════════════════════════
//  NIVELES
// ════════════════════════════════════════════════════════════════════════════
hline(100, "Tope", color.new(color.gray, 92), hline.style_dotted)
hline(50 + neutBand, "Neutral +", color.new(neutCol, 80), hline.style_dotted)
hline(50, "Equilibrio", color.new(neutCol, 55), hline.style_solid)
hline(50 - neutBand, "Neutral -", color.new(neutCol, 80), hline.style_dotted)
hline(0, "Piso", color.new(color.gray, 92), hline.style_dotted)


// ════════════════════════════════════════════════════════════════════════════
//  VISUAL — UNA línea principal + señal + histograma sutil
// ════════════════════════════════════════════════════════════════════════════
color stateCol = isLong ? upCol : isShort ? dnCol : neutCol

// Histograma de score (sutil, en la base), tinta según dirección
plot(showHist ? comp : na, "Score Hist", color=color.new(direction > 0 ? upCol : direction < 0 ? dnCol : neutCol, 86), style=plot.style_columns, histbase=50)

// NO TRADE: punto gris diminuto sobre el eje 50 (sin fondo)
plotchar(showNoTrade and noTrade ? 50 : na, "No Trade", "•", location.absolute, color=color.new(neutCol, 35), size=size.tiny)

// Línea de señal (referencia suave) y línea principal compuesta
pSig = plot(sig, "Señal", color=color.new(strongCol, 55), linewidth=1)
// Efecto RAYO: doble halo difuso + línea finísima + núcleo blanco-eléctrico
plot(glow ? comp : na, "Resplandor", color=color.new(stateCol, 88), linewidth=6)
plot(glow ? comp : na, "Halo", color=color.new(stateCol, 70), linewidth=3)
pComp = plot(comp, "Siddharta", color=color.new(stateCol, 0), linewidth=1)
plot(comp, "Núcleo rayo", color=color.new(strongCol, 18), linewidth=1)
pMid = plot(50, "Mid", color=color.new(color.white, 100), display=display.none)

// Nube degradada hacia el centro
fill(pComp, pMid, top_value=100, bottom_value=50, top_color=glow ? color.new(upCol, shadeInt) : na, bottom_color=glow ? color.new(upCol, 100) : na, title="Nube Superior")
fill(pComp, pMid, top_value=50, bottom_value=0, top_color=glow ? color.new(dnCol, 100) : na, bottom_color=glow ? color.new(dnCol, shadeInt) : na, title="Nube Inferior")

// Nodo de cruce de línea media (cambio de sesgo neto): círculo diminuto con glow
bool midCross = ta.cross(comp, 50)
plotchar(midCross ? comp : na, "Cruce 50 glow", "•", location.absolute, color=color.new(strongCol, 55), size=size.small)
plotchar(midCross ? comp : na, "Cruce 50", "•", location.absolute, color=color.new(stateCol, 0), size=size.tiny)

// ── Marcadores de señal única: círculo con glow (anclado al valor de la onda) ──
plotchar(showSig and enterLong ? comp : na, "LONG glow", "•", location.absolute, color=color.new(upCol, 55), size=size.small)
plotchar(showSig and enterLong ? comp : na, "LONG", "•", location.absolute, color=upCol, size=size.tiny)
plotchar(showSig and enterShort ? comp : na, "SHORT glow", "•", location.absolute, color=color.new(dnCol, 55), size=size.small)
plotchar(showSig and enterShort ? comp : na, "SHORT", "•", location.absolute, color=dnCol, size=size.tiny)
// Glow blanco solo en confirmación fuerte (4/4)
plotchar(showSig and (strongLong or strongShort) ? comp : na, "Confirmación fuerte", "•", location.absolute, color=color.new(strongCol, 35), size=size.tiny)


// ════════════════════════════════════════════════════════════════════════════
//  DASHBOARD COMPACTO
// ════════════════════════════════════════════════════════════════════════════
f_pos(s) => (s == "Arriba Derecha" ? position.top_right : s == "Arriba Izquierda" ? position.top_left : s == "Abajo Derecha" ? position.bottom_right : position.bottom_left)
var table d = table.new(f_pos(dashPos), 2, 6, bgcolor=color.new(#0b0e16, 10), frame_color=color.new(upCol, 55), frame_width=1, border_width=1)
f_cell(t, r, k, v, vc) =>
    table.cell(t, 0, r, k, text_color=color.new(#90a4ae, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1, r, v, text_color=vc, text_size=size.tiny, text_halign=text.align_right)

if showDash and barstate.islast
    string stTxt  = isLong ? "LONG" : isShort ? "SHORT" : "NO TRADE"
    color  stCol  = isLong ? upCol : isShort ? dnCol : neutCol
    string modTxt = (momS >= 0 ? "M+" : "M−") + " " + (volS >= 0 ? "V+" : "V−") + " " + (trendS >= 0 ? "T+" : "T−") + " " + (cogS >= 0 ? "C+" : "C−")
    color  modCol = agree >= 3 ? stCol : neutCol
    string reason = lateral ? "Lateral / ruido" : lowVol ? "Volatilidad baja" : conflict ? "Módulos en conflicto" : blkOverext ? "Sobreextensión (COG)" : blkTrend ? "Tendencia contraria" : score < threshold and direction != 0 ? "Score insuficiente" : isLong ? "Confluencia alcista" : isShort ? "Confluencia bajista" : "Esperando confluencia"

    table.cell(d, 0, 0, "SIDDHARTA · " + profile, text_color=color.white, bgcolor=color.new(#1b2030, 0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(d, 1, 0, str.tostring(comp, "#") + "/100", text_color=stateCol, bgcolor=color.new(#1b2030, 0), text_size=size.tiny, text_halign=text.align_right)
    f_cell(d, 1, "Estado", stTxt, stCol)
    f_cell(d, 2, "Score", str.tostring(score, "#") + " / " + str.tostring(threshold, "#"), score >= threshold ? stCol : neutCol)
    f_cell(d, 3, "Módulos", modTxt, modCol)
    f_cell(d, 4, "Calidad", str.tostring(math.round(qual * 100)) + "%", qual >= 0.5 ? upCol : qual >= 0.3 ? neutCol : dnCol)
    f_cell(d, 5, "Motivo", reason, stCol)


// ════════════════ ✦ MARCA DE AGUA ════════════════
f_wmPos(s) => s == "Inferior Izquierda" ? position.bottom_left : s == "Inferior Derecha" ? position.bottom_right : s == "Superior Izquierda" ? position.top_left : position.top_right
var table wm = table.new(f_wmPos(wmPos), 1, 1, bgcolor=color.new(color.black, 100))
if showWM and barstate.islast
    table.cell(wm, 0, 0, "₿ BudAI Capital®", text_color=wmCol, text_size=size.tiny)


// ════════════════════════════════════════════════════════════════════════════
//  ALERTAS (útiles, no excesivas)
// ════════════════════════════════════════════════════════════════════════════
alertcondition(isLong,  "Siddharta LONG",  "Siddharta · Estado LONG {{ticker}}")
alertcondition(isShort, "Siddharta SHORT", "Siddharta · Estado SHORT {{ticker}}")
alertcondition(noTrade, "Siddharta NO TRADE", "Siddharta · NO TRADE {{ticker}}")
alertcondition(enterLong,  "Cambio a LONG",  "Siddharta · Entrada LONG (confluencia alcista) {{ticker}}")
alertcondition(enterShort, "Cambio a SHORT", "Siddharta · Entrada SHORT (confluencia bajista) {{ticker}}")
alertcondition(exitLong,  "Salida de LONG",  "Siddharta · Salida de LONG {{ticker}}")
alertcondition(exitShort, "Salida de SHORT", "Siddharta · Salida de SHORT {{ticker}}")
alertcondition(strongConfUp, "Confluencia alcista fuerte", "Siddharta · Confluencia alcista 4/4 {{ticker}}")
alertcondition(strongConfDn, "Confluencia bajista fuerte", "Siddharta · Confluencia bajista 4/4 {{ticker}}")
alertcondition(blkNoise and conf, "Bloqueada por ruido", "Siddharta · Señal bloqueada por ruido/volatilidad {{ticker}}")
alertcondition(blkOverext and conf, "Bloqueada por sobreextensión", "Siddharta · Señal bloqueada por sobreextensión (COG) {{ticker}}")
alertcondition(blkTrend and conf, "Bloqueada por tendencia contraria", "Siddharta · Señal bloqueada por tendencia contraria {{ticker}}")
