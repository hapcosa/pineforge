// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Based on BigBeluga - Smart Money Concepts [1.0.0]
// Refactored & Enhanced: SMC Elite v6.1 — Signal S + CyberCycle Precision
// ─────────────────────────────────────────────────────────────────────────────
// MEJORAS v6.1 / KEY ENHANCEMENTS:
//   1. SEÑAL TIPO S ELITE: CHoCH + Sweep + OB/FVG + HTF + filtros cuantitativos
//   2. PRECISION ENTRY: Fisher Transform o CyberCycle (seleccionable)
//   3. CyberCycle con alpha Manual o Kalman adaptativo
//   4. Filtros CyberCycle: iTrend, Volume, HTF 4H (desactivados por defecto)
//   5. Frost Engine (dirección IA institucional) del Gaussian Trend IA Pro
//   6. WAE Explosion (filtro de momentum MACD+BB)
//   7. Choppiness Index (filtro anti-rango lateral)
//   8. Score Engine de confluencia 0-10 con visualización ★
//   9. Dashboard con oscilador activo, filtros y estado Watch
//  10. FVG + OB Proximity Filters (multi-timeframe)
// ─────────────────────────────────────────────────────────────────────────────
//@version=6
indicator("SMC Elite v6 — Precision S", "SMC Elite v6 ◆S",
     overlay = true,
     max_bars_back = 5000,
     max_boxes_count = 500,
     max_labels_count = 500,
     max_lines_count = 500,
     max_polylines_count = 100)

plot(na)

// ═══════════════════════════════════════════════════════════════════════════════
// ─── TOOLTIP STRINGS ────────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════
MSG = "MARKET STRUCTURE"
VBG = "VOLUMETRIC ORDER BLOCKS"
MTF_GRP = "MULTI-TIMEFRAME SETTINGS"
SIG_GRP = "SIGNAL GENERATOR"
FLT_GRP = "🧠 QUANTITATIVE FILTERS"
DSH_GRP = "DASHBOARD"
MST = "Limit market structure calculation to improve memory speed time"
SLT = "[INPUT] Limit swing structure to tot bars back"
CST = "Color candle based on trend detection system"
OBT = "Display internal buy and sell activity"
OBD = "Show Last number of orderblock"
OBMT = "[Length] Use Length to adjust coordinate of the orderblocks\n[Full] Use whole candle body"

// ═══════════════════════════════════════════════════════════════════════════════
// ─── INPUTS: MARKET STRUCTURE ───────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════
bool windowsis      = input.bool(true, "Window", inline="kla", group=MSG)
int mswindow        = input.int(5000, "", tooltip=MST, group=MSG, inline="kla", minval=1000)

bool showSwing      = input.bool(true, "Swing", inline="scss", group=MSG)
int swingLimit      = input.int(100, "", tooltip=SLT, inline="scss", group=MSG, minval=10, maxval=200)

color swingcssup    = input.color(#089981, "", inline="scss", group=MSG)
color swingcssdn    = input.color(#f23645, "", inline="scss", group=MSG)

bool showMapping    = input.bool(false, "Mapping Structure", inline="mapping", group=MSG)
string mappingStyle = input.string("----", "", options=["⎯⎯⎯⎯", "----"], inline="mapping", group=MSG)
color mappingcss    = input.color(color.silver, "", tooltip="Display Mapping Structure", inline="mapping", group=MSG)
bool candlecss      = input.bool(false, "Color Candles", tooltip=CST, group=MSG, inline="txt")
string mstext       = input.string("Tiny", "", options=["Tiny", "Small", "Normal", "Large", "Huge"], inline="txt", group=MSG)
string msmode       = input.string("Adjusted Points", "Algorithmic Logic", options=["Extreme Points", "Adjusted Points"], inline="node", group=MSG)
int mslen           = input.int(5, "", inline="node", group=MSG, minval=2)
bool buildsweep     = input.bool(true, "Build Sweep (x)", "Build sweep on market structure", "znc", MSG)
bool msbubble       = input.bool(true, "Bubbles", tooltip="Display Circle Bubbles", inline="bubbles", group=MSG)

// ─── INPUTS: ORDER BLOCKS ───────────────────────────────────────────────────
bool obshow         = input.bool(true, "Show Last", tooltip=OBD, group=VBG, inline="obshow")
int oblast          = input.int(5, "", group=VBG, inline="obshow", minval=0)
color obupcs        = input.color(color.new(#089981, 90), "", inline="obshow", group=VBG)
color obdncs        = input.color(color.new(#f23645, 90), "", inline="obshow", group=VBG)
bool obshowactivity = input.bool(true, "Show Buy/Sell Activity", inline="act", group=VBG, tooltip=OBT)
color obactup       = input.color(color.new(#089981, 50), "", inline="act", group=VBG)
color obactdn       = input.color(color.new(#f23645, 50), "", inline="act", group=VBG)
obshowbb            = input.bool(false, "Show Breakers", inline="bb", group=VBG, tooltip="Display Breakers")
color bbup          = input.color(color.new(#089981, 100), "", inline="bb", group=VBG)
color bbdn          = input.color(color.new(#f23645, 100), "", inline="bb", group=VBG)
obmode              = input.string("Length", "Construction", options=["Length", "Full"], tooltip=OBMT, inline="atr", group=VBG)
len                 = input.int(5, "", inline="atr", group=VBG, minval=1)
obmiti              = input.string("Close", "Mitigation Method", options=["Close", "Wick", "Avg"], tooltip="Mitigation method for when to trigger order blocks", group=VBG)
obtxt               = input.string("Normal", "Metric Size", options=["Tiny", "Small", "Normal", "Large", "Huge", "Auto"], tooltip="Order block Metrics text size", inline="txt", group=VBG)
showmetric          = input.bool(true, "Show Metrics", group=VBG)
showline            = input.bool(true, "Show Mid-Line", group=VBG)
overlap             = input.bool(true, "Hide Overlap", group=VBG, inline="ov")
wichlap             = input.string("Recent", "", options=["Recent", "Old"], inline="ov", group=VBG)

// ─── INPUTS: FAIR VALUE GAPS ────────────────────────────────────────────────
fvg_enable          = input.bool(false, "", inline="1", group="FAIR VALUE GAP", tooltip="Display fair value gap")
what_fvg            = input.string("FVG", "", inline="1", group="FAIR VALUE GAP", options=["FVG", "Breakers"])
fvg_num             = input.int(5, "Show Last", inline="1a", group="FAIR VALUE GAP", minval=0)
fvg_upcss           = input.color(color.new(#089981, 80), "", inline="1", group="FAIR VALUE GAP")
fvg_dncss           = input.color(color.new(#f23645, 80), "", inline="1", group="FAIR VALUE GAP")
fvgbbup             = input.color(color.new(#089981, 100), "", inline="1", group="FAIR VALUE GAP")
fvgbbdn             = input.color(color.new(#f23645, 100), "", inline="1", group="FAIR VALUE GAP")
fvg_src             = input.string("Close", "Mitigation", inline="3", group="FAIR VALUE GAP", tooltip="[Close] Use the close of the body as trigger\n\n[Wick] Use the extreme point of the body as trigger", options=["Close", "Wick", "Avg"])
fvgthresh           = input.float(0, "Threshold", tooltip="Filter out non significative FVG", group="FAIR VALUE GAP", inline="asd", minval=0, maxval=2, step=0.1)
fvgoverlap          = input.bool(true, "Hide Overlap", "Hide overlapping FVG", group="FAIR VALUE GAP")
fvgline             = input.bool(true, "Show Mid-Line", group="FAIR VALUE GAP")
fvgextend           = input.bool(false, "Extend FVG", group="FAIR VALUE GAP")
dispraid            = input.bool(false, "Display Raids", inline="raid", group="FAIR VALUE GAP")

// ─── INPUTS: OPPOSITE FVG PROXIMITY FILTER ─────────────────────────────────
FVG_PROX_GRP = "🛡️ OPPOSITE FVG PROXIMITY FILTER"
bool useFvgProx         = input.bool(true, "Enable FVG Proximity Filter", group=FVG_PROX_GRP, tooltip="Block signals if an OPPOSITE-direction FVG is too close. E.g. blocks a LONG signal when a bearish FVG sits just above current price, since that FVG is likely to reject the move.")
string fvgProxMode      = input.string("Percent", "Distance Mode", options=["Percent", "ATR"], group=FVG_PROX_GRP, tooltip="Percent: distance as % of current price. ATR: distance as multiple of ATR(14).")
float fvgProxPct        = input.float(0.5, "Min Distance (%)", minval=0.05, maxval=10.0, step=0.05, group=FVG_PROX_GRP, tooltip="Minimum distance to opposite FVG as percentage of price. Signal blocked if opposite FVG is closer than this.")
float fvgProxATR        = input.float(1.5, "Min Distance (ATR×)", minval=0.25, maxval=10.0, step=0.25, group=FVG_PROX_GRP, tooltip="Minimum distance to opposite FVG as ATR multiplier. Only used when Mode = ATR.")
bool fvgProxUseCTF      = input.bool(true, "Check Current Timeframe FVGs", group=FVG_PROX_GRP, tooltip="Include current chart timeframe FVGs in proximity check (requires FVG engine enabled).")
bool fvgProxUseMTF      = input.bool(true, "Check Higher Timeframe FVGs", group=FVG_PROX_GRP, tooltip="Scan FVGs on higher timeframes (1H/4H/1D configurable below). Only HIGHER TFs than the chart are checked — lower TFs are always ignored.")
bool fvgProxUse1H       = input.bool(true, "Use 1H FVGs", inline="htf_fvg", group=FVG_PROX_GRP)
bool fvgProxUse4H       = input.bool(true, "Use 4H FVGs", inline="htf_fvg", group=FVG_PROX_GRP)
bool fvgProxUse1D       = input.bool(true, "Use 1D FVGs", inline="htf_fvg", group=FVG_PROX_GRP)


// ─── INPUTS: OPPOSITE OB PROXIMITY FILTER ──────────────────────────────────
OB_PROX_GRP = "🛡️ OPPOSITE OB PROXIMITY FILTER"
bool useObProx          = input.bool(true, "Enable OB Proximity Filter", group=OB_PROX_GRP, tooltip="Block signals if an OPPOSITE-direction Order Block is too close. E.g. blocks a LONG signal when a bearish OB sits just above current price, since that OB is likely to reject the move.")
string obProxMode       = input.string("Percent", "Distance Mode", options=["Percent", "ATR"], group=OB_PROX_GRP, tooltip="Percent: distance as % of current price. ATR: distance as multiple of ATR(14).")
float obProxPct         = input.float(0.5, "Min Distance (%)", minval=0.05, maxval=10.0, step=0.05, group=OB_PROX_GRP, tooltip="Minimum distance to opposite OB as percentage of price. Signal blocked if opposite OB is closer than this.")
float obProxATR         = input.float(1.5, "Min Distance (ATR×)", minval=0.25, maxval=10.0, step=0.25, group=OB_PROX_GRP, tooltip="Minimum distance to opposite OB as ATR multiplier. Only used when Mode = ATR.")
bool obProxUseCTF       = input.bool(true, "Check Current Timeframe OBs", group=OB_PROX_GRP, tooltip="Include current chart timeframe OBs in proximity check (requires OB engine enabled).")
bool obProxUseMTF       = input.bool(true, "Check Higher Timeframe OBs", group=OB_PROX_GRP, tooltip="Scan OBs on higher timeframes (1H/4H/1D configurable below). Only HIGHER TFs than the chart are checked.")
bool obProxUse1H        = input.bool(true, "Use 1H OBs", inline="htf_ob", group=OB_PROX_GRP)
bool obProxUse4H        = input.bool(true, "Use 4H OBs", inline="htf_ob", group=OB_PROX_GRP)
bool obProxUse1D        = input.bool(true, "Use 1D OBs", inline="htf_ob", group=OB_PROX_GRP)


// ─── INPUTS: MULTI-TIMEFRAME ────────────────────────────────────────────────
bool useMTF         = input.bool(true, "Enable MTF Analysis", group=MTF_GRP, tooltip="Enable multi-timeframe confirmation for signals")
string mtfTimeframe = input.timeframe("60", "HTF Timeframe", group=MTF_GRP, tooltip="Higher timeframe for trend confirmation")
bool mtfConfirmOB   = input.bool(true, "Confirm OB with HTF", group=MTF_GRP, tooltip="Require HTF trend alignment for Order Block signals")
bool mtfConfirmFVG  = input.bool(true, "Confirm FVG with HTF", group=MTF_GRP, tooltip="Require HTF trend alignment for FVG signals")
bool mtfTrendFilter = input.bool(true, "HTF Trend Filter", group=MTF_GRP, tooltip="Only allow trades in the direction of HTF trend")

// ─── INPUTS: QUANTITATIVE FILTERS (from Gaussian Trend IA Pro) ──────────────
bool useFrost       = input.bool(true, "Frost Engine (IA Direction)", group=FLT_GRP, tooltip="Range filter-based directional engine from Gaussian Trend IA Pro")
string frostMode    = input.string("Intraday", "Frost Mode", options=["Scalping", "Intraday", "Swing"], group=FLT_GRP)
int minFrostConf    = input.int(2, "Min Frost Confidence", minval=1, maxval=5, group=FLT_GRP)

bool useWAE         = input.bool(true, "WAE Explosion (Momentum)", group=FLT_GRP, tooltip="Waddah Attar Explosion: MACD + Bollinger momentum filter")
int waeFastLen      = input.int(20, "WAE MACD Fast", minval=5, maxval=50, inline="wae1", group=FLT_GRP)
int waeSlowLen      = input.int(40, "Slow", minval=20, maxval=100, inline="wae1", group=FLT_GRP)
int waeSens         = input.int(150, "Sensitivity", minval=50, maxval=300, step=10, inline="wae2", group=FLT_GRP)
int waeBBLen        = input.int(20, "BB Len", minval=10, maxval=50, inline="wae2", group=FLT_GRP)
float waeBBMult     = input.float(2.0, "BB Mult", step=0.1, minval=1.0, maxval=3.0, inline="wae3", group=FLT_GRP)
float waeDeadZone   = input.float(3.7, "Dead Zone (ATR×)", step=0.1, minval=0.5, maxval=10.0, inline="wae3", group=FLT_GRP)

bool useChop        = input.bool(true, "Choppiness Index (Anti-Range)", group=FLT_GRP, tooltip="Blocks signals when market is choppy/ranging")
int chopLen         = input.int(20, "CI Length", minval=7, maxval=50, inline="chop1", group=FLT_GRP)
float chopThreshold = input.float(50.0, "CI Max", minval=35.0, maxval=65.0, step=1.0, inline="chop1", group=FLT_GRP, tooltip="Signals only when CI < this value")

bool useAbsorption  = input.bool(true, "Volume Absorption (scoring only)", group=FLT_GRP, tooltip="Detects institutional rejection candles with high volume. Contributes to Signal S score but no visual labels.")
float absThreshold  = input.float(1.5, "Vol Ratio Threshold", minval=1.0, maxval=3.0, step=0.1, inline="abs1", group=FLT_GRP)

// ─── INPUTS: SIGNAL GENERATOR ───────────────────────────────────────────────
bool showSignalS    = input.bool(true, "Show Signal S (Elite)", group=SIG_GRP, inline="sig2", tooltip="Highest confluence signal based on SMC + filters")
color sigLongColor  = input.color(#00e676, "Long", group=SIG_GRP, inline="sig3")
color sigShortColor = input.color(#ff1744, "Short", group=SIG_GRP, inline="sig3")
color sigSColor     = input.color(#FFD700, "Signal S", group=SIG_GRP, inline="sig3b")
bool showSLTP       = input.bool(true, "Show SL/TP Levels (on Signal S)", group=SIG_GRP, tooltip="Display stop loss and take profit projections")
float riskReward    = input.float(2.0, "Risk:Reward Ratio", group=SIG_GRP, minval=0.5, maxval=5.0, step=0.5)
int minScoreS       = input.int(5, "Min Score for Signal S", minval=2, maxval=10, group=SIG_GRP, tooltip="Minimum confluence score (0-10) to trigger Signal S")
int maxHistSignals  = input.int(50, "Max Historical Signals", minval=10, maxval=200, group=SIG_GRP, tooltip="Maximum A/B/C/D/S signal labels kept on chart (oldest removed first)")
bool alertSignals   = input.bool(true, "Enable Signal Alerts", group=SIG_GRP)

// ─── INPUTS: SIGNAL S PILLARS (configurable) ────────────────────────────────
SIG_S_GRP = "◆ SIGNAL S CONFIG"
int sLookback       = input.int(20, "Event Lookback (bars)", minval=3, maxval=100, group=SIG_S_GRP, tooltip="How many bars back to look for CHoCH/Sweep events. Higher = more signals, lower = stricter timing.")
bool sRequireCHoCH  = input.bool(true, "Require CHoCH", group=SIG_S_GRP, tooltip="Require a recent Change of Character. Disable to allow BOS-based signals too.")
bool sRequireSweep  = input.bool(false, "Require Sweep", group=SIG_S_GRP, tooltip="Require a recent liquidity sweep. Disable for more signals.")
bool sRequireZone   = input.bool(true, "Require OB or FVG zone", group=SIG_S_GRP, tooltip="Price must be inside an active Order Block or FVG")
bool sRequireHTF    = input.bool(false, "Require HTF alignment", group=SIG_S_GRP, tooltip="Require higher timeframe trend confirmation")
bool sRequireChop   = input.bool(true, "Require CI < threshold", group=SIG_S_GRP, tooltip="Block signals in choppy/ranging markets")

// ─── INPUTS: SIGNAL PRECISION CONFIG (integrated for S) ─────────────────────
SIG_PREC_GRP = "◈ PRECISION ENTRY CONFIG (for Signal S)"
string  precOscillator      = input.string("Fisher Transform", "Precision Oscillator", options=["Fisher Transform", "CyberCycle"], group=SIG_PREC_GRP, tooltip="Select which oscillator drives precision entry timing")
bool    showEntry           = input.bool(true, "Show Precision Entry Labels", group=SIG_PREC_GRP)
int     watchWindow         = input.int(10, "Watch Window (bars)", minval=3, maxval=30, group=SIG_PREC_GRP)
bool    requireDiv          = input.bool(true, "Require Divergence Confirmation", group=SIG_PREC_GRP)
bool    showPrecPanel       = input.bool(false, "Show Oscillator Panel (Plots)", group=SIG_PREC_GRP)
color   entryLongColor      = input.color(#00e676, "Entry Long Color", group=SIG_PREC_GRP)
color   entryShortColor     = input.color(#ff1744, "Entry Short Color", group=SIG_PREC_GRP)
bool    showWindow          = input.bool(true, "Show Watch Window Background", group=SIG_PREC_GRP)
color   windowColor         = input.color(color.new(color.blue, 90), "Window Color", group=SIG_PREC_GRP)

// ─── INPUTS: FISHER TRANSFORM ────────────────────────────────────────────────
FISH_GRP = "◈ Fisher Transform Config"
int     fisherPeriod        = input.int(14, "Fisher Period", group=FISH_GRP, minval=5, maxval=50)
float   fisherExtreme       = input.float(2.5, "Fisher Extreme Level", group=FISH_GRP, minval=1.0, maxval=5.0, step=0.1)

// ─── INPUTS: CYBERCYCLE CONFIG ───────────────────────────────────────────────
CC_GRP = "◈ CyberCycle Config"
string  ccAlphaMethod       = input.string("Manual", "Alpha Method", options=["Manual", "Kalman"], group=CC_GRP, tooltip="Manual = fixed alpha, Kalman = innovation-adaptive alpha")
float   ccManualAlpha       = input.float(0.07, "Manual Alpha", minval=0.01, maxval=0.80, step=0.01, group=CC_GRP)
int     ccTrigEma           = input.int(5, "Trigger EMA Length", minval=3, maxval=30, group=CC_GRP)
float   ccOBLevel           = input.float(1.5, "Overbought Level", minval=0.3, maxval=3.0, step=0.1, group=CC_GRP)
float   ccOSLevel           = input.float(-1.5, "Oversold Level", minval=-3.0, maxval=-0.3, step=0.1, group=CC_GRP)

// ─── INPUTS: CYBERCYCLE KALMAN ───────────────────────────────────────────────
CC_KAL_GRP = "◈ CyberCycle Kalman Params"
float   ccKalQ              = input.float(0.01, "Process Noise (Q)", minval=0.001, maxval=0.1, step=0.001, group=CC_KAL_GRP)
float   ccKalR              = input.float(0.5, "Measurement Noise (R)", minval=0.01, maxval=2.0, step=0.01, group=CC_KAL_GRP)
float   ccKalFast           = input.float(0.5, "Alpha Fast", minval=0.1, maxval=0.9, step=0.05, group=CC_KAL_GRP)
float   ccKalSlow           = input.float(0.05, "Alpha Slow", minval=0.01, maxval=0.3, step=0.01, group=CC_KAL_GRP)
float   ccKalSens           = input.float(2.0, "Sensitivity", minval=0.5, maxval=5.0, step=0.1, group=CC_KAL_GRP)

// ─── INPUTS: CYBERCYCLE FILTERS ──────────────────────────────────────────────
CC_FILT_GRP = "◈ CyberCycle Filters"
bool    ccUseTrend          = input.bool(false, "Use iTrend Filter", group=CC_FILT_GRP, tooltip="Require iTrend direction alignment for entry")
float   ccITrendAlpha       = input.float(0.07, "iTrend Alpha", minval=0.01, maxval=0.30, step=0.01, group=CC_FILT_GRP)
bool    ccUseVolume         = input.bool(false, "Use Volume Filter", group=CC_FILT_GRP, tooltip="Require volume surge for entry")
float   ccVolMult           = input.float(1.5, "Volume Multiplier", minval=0.5, maxval=5.0, step=0.1, group=CC_FILT_GRP)
bool    ccUseHTF            = input.bool(false, "Use HTF Filter (4H)", group=CC_FILT_GRP, tooltip="Require 4H trend alignment for entry")

// ─── INPUTS: DASHBOARD ─────────────────────────────────────────────────────
bool showDashboard  = input.bool(true, "Show Dashboard", group=DSH_GRP)
string dashPos      = input.string("Bottom Right", "Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group=DSH_GRP)
string dashSize     = input.string("Small", "Size", options=["Tiny", "Small", "Normal"], group=DSH_GRP)

// ═══════════════════════════════════════════════════════════════════════════════
// ─── USER DEFINED TYPES (UDTs) ──────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

type hqlzone
    box pbx
    box ebx
    box lbx
    label plb
    label elb
    label lbl

type Zphl
    line top
    line bottom
    label top_label
    label bottom_label
    bool stopcross
    bool sbottomcross
    bool itopcross
    bool ibottomcross
    string txtup
    string txtdn
    float topy
    float bottomy
    float topx
    float bottomx
    float tup
    float tdn
    int tupx
    int tdnx
    float itopy
    float itopx
    float ibottomy
    float ibottomx
    float uV
    float dV

type entered
    bool normal  = false
    bool breaker = false

type store
    line[] ln
    label[] lb
    box[] bx
    linefill[] lf

type structure
    int zn
    float zz
    float bos
    float choch
    int loc
    int temp
    int trend
    int start
    float main
    int xloc
    bool upsweep
    bool dnsweep
    string txt = na

type drawms
    int x1
    int x2
    float y
    string txt
    color css
    string style

type ob
    bool bull
    float top
    float btm
    float avg
    int loc
    color css
    float vol
    int dir
    int move
    int blPOS
    int brPOS
    int xlocbl
    int xlocbr
    bool isbb = false
    int bbloc

type FVG
    float top = na
    float btm = na
    int loc = bar_index
    bool isbb = false
    int bbloc = na
    bool israid = false
    float raidy = na
    int raidloc = na
    int raidx2 = na
    bool active = false
    color raidcs = na

type SFP
    float y
    int loc
    float ancor

type sfpbuildlbl
    int x
    float y
    string style
    color css
    string txt

type sfpbuildline
    int x1
    int x2
    float y
    color css
    float ancor
    int loc

type equalbuild
    int x1
    float y1
    int x2
    float y2
    color css
    string style

type equalname
    int x
    float y
    string txt
    color css
    string style

type ehl
    float pt
    int t
    float pb
    int b

type sellbuyside
    float top
    float btm
    int loc
    color css
    string txt
    float vol

type timer
    bool start = false
    int count = 0

// ─── NEW UDTs: MTF & SIGNALS ───────────────────────────────────────────────
type MTFState
    int   trend
    float bosLevel
    float chochLevel
    bool  hasBullOB
    bool  hasBearOB
    bool  hasBullFVG
    bool  hasBearFVG

type TradeSignal
    bool   isLong
    string signalType
    float  entry
    float  stopLoss
    float  takeProfit
    int    barIdx
    int    confluence
    string reason

type EntrySignal
    bool isLong
    bool confirmed
    int  triggerBar
    float triggerEntry
    int  entryBar
    float fisher
    bool hasDiv
    bool inZone

// ═══════════════════════════════════════════════════════════════════════════════
// ─── SETUP & INITIALIZATION ─────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

var store bin = store.new(array.new<line>(), array.new<label>(), array.new<box>(), array.new<linefill>())

var entered blobenter  = entered.new()
var entered brobenter  = entered.new()
var entered blfvgenter = entered.new()
var entered brfvgenter = entered.new()
var entered blarea     = entered.new()
var entered brarea     = entered.new()
var timer   lc         = timer.new()

var TradeSignal lastLongSignal  = na
var TradeSignal lastShortSignal = na
var TradeSignal lastSignalS     = na
var EntrySignal lastEntry       = na
var int signalCooldown  = 0
var int signalSCooldown = 0

// ─── HISTORICAL SIGNAL LABEL ARRAYS (persistent across bars) ────────────────
// These arrays hold signal labels so they remain visible as history.
// Oldest labels are removed when we exceed maxHistSignals to respect
// TradingView's max_labels_count limit.
var array<label> histSignalLabelsS   = array.new<label>()

// ─── SIGNAL S MEMORY: track recent events across bars ───────────────────────
var int   recentCHoCHBullBar  = na
var int   recentCHoCHBearBar  = na
var int   recentSweepDnBar    = na
var int   recentSweepUpBar    = na
var int   recentBOSBullBar    = na
var int   recentBOSBearBar    = na
var int   lastSSignalBar      = 0

// ─── WATCH STATE MACHINE VARIABLES ──────────────────────────────────────────
var bool watchActive      = false
var bool watchIsLong      = false
var int  watchStartBar    = 0
var float watchSigEntry   = 0.0
var int   watchSigScore   = 0
var bool precWasExtreme = false
var array<label> entryLabels = array.new<label>()

if barstate.islast
    for obj in bin.ln
        obj.delete()
    for obj in bin.lb
        obj.delete()
    for obj in bin.bx
        obj.delete()
    for obj in bin.lf
        obj.delete()
    bin.ln.clear()
    bin.lb.clear()
    bin.bx.clear()
    bin.lf.clear()

invcol = #ffffff00
float atr = ta.atr(200) / (5 / len)

// ─── Helper: add a signal label with history management ─────────────────────
f_pushSignalLabel(array<label> arr, label lbl) =>
    array.push(arr, lbl)
    if array.size(arr) > maxHistSignals
        label oldLbl = array.shift(arr)
        label.delete(oldLbl)

// ═══════════════════════════════════════════════════════════════════════════════
// ─── UTILITY FUNCTIONS ──────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

method txSz(string s) =>
    out = switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        "Auto"   => size.auto
    out

method lstyle(string style) =>
    out = switch style
        '⎯⎯⎯⎯' => line.style_solid
        '----' => line.style_dashed
        '····' => line.style_dotted

ghl() => [high[2], low[2], close[1], open[1], close, open, high, low, high[1], low[1], ta.atr(200)]

method IDMIDX(bool use_max, int loc) =>
    min = 99999999.
    max = 0.
    idx = 0
    if use_max
        for i = 0 to (bar_index - loc)
            max := math.max(high[i], max)
            min := max == high[i] ? low[i] : min
            idx := max == high[i] ? i : idx
    else
        for i = 0 to (bar_index - loc)
            min := math.min(low[i], min)
            max := min == low[i] ? high[i] : max
            idx := min == low[i] ? i : idx
    idx

method darkcss(color css, float factor) =>
    blue  = color.b(css) * (1 - factor)
    red   = color.r(css) * (1 - factor)
    green = color.g(css) * (1 - factor)
    color.rgb(red, green, blue, 0)

method find(structure ms, bool use_max, bool sweep, bool useob) =>
    min = 99999999.
    max = 0.
    idx = 0
    int refLoc = sweep ? ms.xloc : ms.loc
    int loopEnd = math.max(0, (bar_index - refLoc) - (not sweep ? 1 : 1))
    if ((bar_index - refLoc) - 1) > 0
        if use_max
            for i = 0 to (bar_index - refLoc) - 1
                max := math.max(high[i], max)
                min := max == high[i] ? low[i] : min
                idx := max == high[i] ? i : idx
            if useob and high[idx + 1] > high[idx]
                max := high[idx + 1]
                min := low[idx + 1]
                idx := idx + 1
        else
            for i = 0 to (bar_index - refLoc) - 1
                min := math.min(low[i], min)
                max := min == low[i] ? high[i] : max
                idx := min == low[i] ? i : idx
            if useob and low[idx + 1] < low[idx]
                max := high[idx + 1]
                min := low[idx + 1]
                idx := idx + 1
    else
        if use_max
            for i = 0 to (bar_index - refLoc)
                max := math.max(high[i], max)
                min := max == high[i] ? low[i] : min
                idx := max == high[i] ? i : idx
            if useob and high[idx + 1] > high[idx]
                max := high[idx + 1]
                min := low[idx + 1]
                idx := idx + 1
        else
            for i = 0 to (bar_index - refLoc)
                min := math.min(low[i], min)
                max := min == low[i] ? high[i] : max
                idx := min == low[i] ? i : idx
            if useob and low[idx + 1] < low[idx]
                max := high[idx + 1]
                min := low[idx + 1]
                idx := idx + 1
    idx

// ═══════════════════════════════════════════════════════════════════════════════
// ─── ORDER BLOCK FUNCTIONS ──────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

method fnOB(ob[] block, bool bull, float cords, int idx) =>
    switch bull
        true =>
            blobenter.normal  := false
            blobenter.breaker := false
            block.unshift(ob.new(true, cords, low[idx], math.avg(cords, low[idx]), time[idx], obupcs, volume[idx], close[idx] > open[idx] ? 1 : -1, 1, 1, 1, time[idx]))
        false =>
            brobenter.normal  := false
            brobenter.breaker := false
            block.unshift(ob.new(false, high[idx], cords, math.avg(cords, high[idx]), time[idx], obdncs, volume[idx], close[idx] > open[idx] ? 1 : -1, 1, 1, 1, time[idx]))

method mitigated(ob[] block) =>
    if barstate.isconfirmed
        for [i, stuff] in block
            if not stuff.isbb
                switch stuff.bull
                    true =>
                        if (obmiti == "Close" ? math.min(close, open) < stuff.btm : obmiti == "Wick" ? low < stuff.btm : obmiti == "Avg" ? low < stuff.avg : false)
                            stuff.isbb  := true
                            stuff.bbloc := time
                            if not obshowbb
                                block.remove(i)
                    false =>
                        if (obmiti == "Close" ? math.max(close, open) > stuff.top : obmiti == "Wick" ? high > stuff.top : obmiti == "Avg" ? high > stuff.avg : false)
                            stuff.isbb  := true
                            stuff.bbloc := time
                            if not obshowbb
                                block.remove(i)
            else
                switch stuff.bull
                    true =>
                        if (obmiti == "Close" ? math.max(close, open) > stuff.top : obmiti == "Wick" ? high > stuff.top : obmiti == "Avg" ? high > stuff.avg : false)
                            block.remove(i)
                    false =>
                        if (obmiti == "Close" ? math.min(close, open) < stuff.btm : obmiti == "Wick" ? low < stuff.btm : obmiti == "Avg" ? low < stuff.avg : false)
                            block.remove(i)

overlap(ob[] bull, ob[] bear) =>
    if bull.size() > 1
        for i = bull.size() - 1 to 1
            stuff   = bull.get(i)
            current = bull.get(0)
            v       = wichlap == "Recent" ? i : 0
            switch
                stuff.btm > current.btm and stuff.btm < current.top => bull.remove(v)
                stuff.top < current.top and stuff.btm > current.btm => bull.remove(v)
                stuff.top > current.top and stuff.btm < current.btm => bull.remove(v)
                stuff.top < current.top and stuff.top > current.btm => bull.remove(v)
    if bear.size() > 1
        for i = bear.size() - 1 to 1
            stuff   = bear.get(i)
            current = bear.get(0)
            v       = wichlap == "Recent" ? i : 0
            switch
                stuff.btm > current.btm and stuff.btm < current.top => bear.remove(v)
                stuff.top < current.top and stuff.btm > current.btm => bear.remove(v)
                stuff.top > current.top and stuff.btm < current.btm => bear.remove(v)
                stuff.top < current.top and stuff.top > current.btm => bear.remove(v)
    if bull.size() > 0 and bear.size() > 0
        for i = bull.size() - 1 to 0
            stuff   = bull.get(i)
            current = bear.get(0)
            v       = wichlap == "Recent" ? 0 : i
            switch
                stuff.btm > current.btm and stuff.btm < current.top => bull.remove(v)
                stuff.top < current.top and stuff.btm > current.btm => bull.remove(v)
                stuff.top > current.top and stuff.btm < current.btm => bull.remove(v)
                stuff.top < current.top and stuff.top > current.btm => bull.remove(v)
    if bull.size() > 0 and bear.size() > 0
        for i = bear.size() - 1 to 0
            stuff   = bear.get(i)
            current = bull.get(0)
            v       = wichlap == "Recent" ? 0 : i
            switch
                stuff.btm > current.btm and stuff.btm < current.top => bear.remove(v)
                stuff.top < current.top and stuff.btm > current.btm => bear.remove(v)
                stuff.top > current.top and stuff.btm < current.btm => bear.remove(v)
                stuff.top < current.top and stuff.top > current.btm => bear.remove(v)

overlapFVG(FVG[] blFVG, FVG[] brFVG) =>
    if blFVG.size() > 1
        for i = blFVG.size() - 1 to 1
            stuff = blFVG.get(i)
            current = blFVG.get(0)
            switch
                stuff.btm > current.btm and stuff.btm < current.top => blFVG.remove(i)
                stuff.top < current.top and stuff.btm > current.btm => blFVG.remove(i)
                stuff.top > current.top and stuff.btm < current.btm => blFVG.remove(i)
                stuff.top < current.top and stuff.top > current.btm => blFVG.remove(i)
    if brFVG.size() > 1
        for i = brFVG.size() - 1 to 1
            stuff = brFVG.get(i)
            current = brFVG.get(0)
            switch
                stuff.btm > current.btm and stuff.btm < current.top => brFVG.remove(i)
                stuff.top < current.top and stuff.btm > current.btm => brFVG.remove(i)
                stuff.top > current.top and stuff.btm < current.btm => brFVG.remove(i)
                stuff.top < current.top and stuff.top > current.btm => brFVG.remove(i)
    if blFVG.size() > 0 and brFVG.size() > 0
        for i = blFVG.size() - 1 to 0
            stuff = blFVG.get(i)
            current = brFVG.get(0)
            switch
                stuff.btm > current.btm and stuff.btm < current.top => blFVG.remove(i)
                stuff.top < current.top and stuff.btm > current.btm => blFVG.remove(i)
                stuff.top > current.top and stuff.btm < current.btm => blFVG.remove(i)
                stuff.top < current.top and stuff.top > current.btm => blFVG.remove(i)
    if blFVG.size() > 0 and brFVG.size() > 0
        for i = brFVG.size() - 1 to 0
            stuff = brFVG.get(i)
            current = blFVG.get(0)
            switch
                stuff.btm > current.btm and stuff.btm < current.top => brFVG.remove(i)
                stuff.top < current.top and stuff.btm > current.btm => brFVG.remove(i)
                stuff.top > current.top and stuff.btm < current.btm => brFVG.remove(i)
                stuff.top < current.top and stuff.top > current.btm => brFVG.remove(i)

method umt(ob metric) =>
    switch metric.dir
        1 =>
            switch metric.move
                1 => 
                    metric.blPOS := metric.blPOS + 1
                    metric.move := 2
                2 => 
                    metric.blPOS := metric.blPOS + 1
                    metric.move := 3
                3 => 
                    metric.brPOS := metric.brPOS + 1
                    metric.move := 1
        -1 =>
            switch metric.move
                1 => 
                    metric.brPOS := metric.brPOS + 1
                    metric.move := 2
                2 => 
                    metric.brPOS := metric.brPOS + 1
                    metric.move := 3
                3 => 
                    metric.blPOS := metric.blPOS + 1
                    metric.move := 1
    if (time - time[1]) == (time[1] - time[2])
        metric.xlocbl := metric.loc + (time - time[1]) * metric.blPOS
        metric.xlocbr := metric.loc + (time - time[1]) * metric.brPOS

method display(ob id, ob[] full, int i) =>
    if not id.isbb
        bin.bx.unshift(box.new(top = id.top, bottom = id.btm, left = id.loc, right = time, border_color = na, bgcolor = id.css, xloc = xloc.bar_time))
        bin.bx.unshift(box.new(top = id.top, bottom = id.btm, left = time, right = time + 1, border_color = na, bgcolor = id.css, xloc = xloc.bar_time, extend = extend.right))
    else
        bin.bx.unshift(box.new(top = id.top, bottom = id.btm, left = id.loc, right = id.bbloc, border_color = na, bgcolor = id.css, xloc = xloc.bar_time))
        bin.bx.unshift(box.new(top = id.top, bottom = id.btm, left = id.bbloc, right = time, border_color = id.css, bgcolor = id.bull ? bbup : bbdn, xloc = xloc.bar_time, border_width = 2))
        bin.bx.unshift(box.new(top = id.top, bottom = id.btm, left = time, right = time + 1, border_color = id.css, bgcolor = id.bull ? bbup : bbdn, xloc = xloc.bar_time, extend = extend.right))
    if obshowactivity
        bin.bx.unshift(box.new(top = id.top, bottom = id.avg, left = id.loc, right = id.xlocbl, border_color = na, bgcolor = obactup, xloc = xloc.bar_time))
        bin.bx.unshift(box.new(top = id.avg, bottom = id.btm, left = id.loc, right = id.xlocbr, border_color = na, bgcolor = obactdn, xloc = xloc.bar_time))
    if showline
        bin.ln.unshift(line.new(x1 = id.loc, x2 = time, y1 = id.avg, y2 = id.avg, color = color.new(id.css, 0), xloc = xloc.bar_time, style = line.style_dashed))
    if showmetric
        if i == math.min(oblast - 1, full.size() - 1)
            float tV = 0
            float[] dVArr = array.new<float>()
            int seq = math.min(oblast - 1, full.size() - 1)
            for j = 0 to seq
                cV = full.get(j)
                tV += cV.vol
                if j == seq
                    for y = 0 to seq
                        dVArr.push(math.floor((full.get(y).vol / tV) * 100))
                        ids = full.get(y)
                        bin.lb.unshift(label.new(bar_index - 1, ids.avg, textcolor = color.new(ids.css, 0), style = label.style_label_left, size = obtxt.txSz(), color = #ffffff00, text = str.tostring(math.round(full.get(y).vol, 3), format = format.volume) + " (" + str.tostring(dVArr.get(y)) + "%)"))

method dispFVG(FVG fvg, int i, bool bull) =>
    ext = fvgextend ? extend.right : extend.none
    if not fvg.isbb
        bin.bx.unshift(box.new(top = fvg.top, bottom = fvg.btm, left = fvg.loc, right = time, border_color = na, bgcolor = bull ? fvg_upcss : fvg_dncss, xloc = xloc.bar_time, extend = ext))
        if fvgline
            bin.ln.unshift(line.new(x1 = fvg.loc, x2 = time, y1 = math.avg(fvg.top, fvg.btm), y2 = math.avg(fvg.top, fvg.btm), xloc = xloc.bar_time, color = color.new(bull ? fvg_upcss : fvg_dncss, 0), extend = ext))
        if dispraid
            bin.ln.unshift(line.new(x1 = fvg.raidloc, x2 = fvg.raidx2, y1 = fvg.raidy, y2 = fvg.raidy, xloc = xloc.bar_time, color = fvg.raidcs))
            bin.lb.unshift(label.new(x = int(math.avg(fvg.raidloc, fvg.raidx2)), y = fvg.raidy, text = "x", xloc = xloc.bar_time, textcolor = fvg.raidcs, style = bull ? label.style_label_up : label.style_label_down, size = size.small, color = #ffffff00))
    else
        bin.bx.unshift(box.new(top = fvg.top, bottom = fvg.btm, left = fvg.loc, right = fvg.bbloc, border_color = na, bgcolor = bull ? fvg_upcss : fvg_dncss, xloc = xloc.bar_time))
        bin.bx.unshift(box.new(top = fvg.top, bottom = fvg.btm, left = fvg.bbloc, right = time, border_color = bull ? fvg_dncss : fvg_upcss, bgcolor = bull ? fvg_dncss : fvg_upcss, xloc = xloc.bar_time, extend = ext))
        if fvgline
            bin.ln.unshift(line.new(x1 = fvg.loc, x2 = fvg.bbloc, y1 = math.avg(fvg.top, fvg.btm), y2 = math.avg(fvg.top, fvg.btm), color = color.new(bull ? fvg_upcss : fvg_dncss, 0), xloc = xloc.bar_time))
            bin.ln.unshift(line.new(x1 = fvg.bbloc, x2 = time, y1 = math.avg(fvg.top, fvg.btm), y2 = math.avg(fvg.top, fvg.btm), color = color.new(bull ? fvg_dncss : fvg_upcss, 0), xloc = xloc.bar_time, extend = ext, style = line.style_dashed))

// ═══════════════════════════════════════════════════════════════════════════════
// ─── MAPPING, FVG, STRUCTURE ────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

mapping() =>
    var float up = na, var float dn = na, var float point = na
    var int trend = 0, var int idx = na, var int sum = na, var int project = na
    var chart.point[] charts = array.new<chart.point>()
    if na(up)
        up := high
        idx := bar_index
    if na(dn)
        dn := low
        idx := bar_index
    if high > up
        if trend == -1
            id = IDMIDX(false, idx)
            charts.unshift(chart.point.from_time(time[id], low[id]))
            idx := bar_index
            point := low[id]
            sum := time[id]
        up := high
        dn := low
        project := time
        trend := 1
    if low < dn
        if trend == 1
            id = IDMIDX(true, idx)
            charts.unshift(chart.point.from_time(time[id], high[id]))
            idx := bar_index
            point := high[id]
            sum := time[id]
        up := high
        dn := low
        project := time
        trend := -1
    if barstate.islast
        var line ln = na
        var polyline pl = na
        ln.delete()
        pl.delete()
        ln := line.new(x1 = sum, x2 = project, y1 = point, y2 = trend == 1 ? up : dn, xloc = xloc.bar_time, color = color.red)
        pl := polyline.new(charts, line_color = mappingcss, xloc = xloc.bar_time, line_style = mappingStyle.lstyle())

dFVG() =>
    [h2, l2, c1, o1, c, o, h, l, h1, l1, fvatr] = ghl()
    var FVG[] blFVG = array.new<FVG>()
    var FVG[] brFVG = array.new<FVG>()
    bool upfvg = false
    bool dnfvg = false
    float blth = l1 + (fvatr[1] * fvgthresh)
    float brth = h1 - (fvatr[1] * fvgthresh)
    cc = timeframe.change()
    switch
        what_fvg == "FVG" or what_fvg == "Breakers" =>
            if l > h2 and cc and c1 > blth
                upfvg := true
            if l2 > h and cc and c1 < brth
                dnfvg := true
    if upfvg[1]
        if blFVG.size() > 0
            fvg = blFVG.get(0)
            if fvg.israid == true and fvg.active == false
                fvg.active := true
                fvg.raidloc := na
                fvg.raidx2 := na
                fvg.raidy := na
                fvg.raidcs := #ffffff00
        blFVG.unshift(FVG.new(l[1], h2[1], time[3], false, na))
    if dnfvg[1]
        if brFVG.size() > 0
            fvg = brFVG.get(0)
            if fvg.israid == true and fvg.active == false
                fvg.active := true
                fvg.raidloc := na
                fvg.raidx2 := na
                fvg.raidy := na
                fvg.raidcs := #ffffff00
        brFVG.unshift(FVG.new(l2[1], h[1], time[3], false, na))
    if blFVG.size() > 0
        for [i, fvg] in blFVG
            if not fvg.isbb
                if (fvg_src == "Close" ? math.min(c, o) < fvg.btm : fvg_src == "Wick" ? l < fvg.btm : fvg_src == "Avg" ? l < math.avg(fvg.top, fvg.btm) : false)
                    fvg.isbb := true
                    fvg.bbloc := time
                    if what_fvg == "FVG"
                        blFVG.remove(i)
            else
                if (fvg_src == "Close" ? math.max(c, o) > fvg.top : fvg_src == "Wick" ? h > fvg.top : fvg_src == "Avg" ? h > math.avg(fvg.top, fvg.btm) : false) and what_fvg == "Breakers"
                    blFVG.remove(i)
    if brFVG.size() > 0
        for [i, fvg] in brFVG
            if not fvg.isbb
                if (fvg_src == "Close" ? math.max(c, o) > fvg.top : fvg_src == "Wick" ? h > fvg.top : fvg_src == "Avg" ? h > math.avg(fvg.top, fvg.btm) : false)
                    fvg.isbb := true
                    fvg.bbloc := time
                    if what_fvg == "FVG"
                        brFVG.remove(i)
            else
                if (fvg_src == "Close" ? math.min(c, o) < fvg.btm : fvg_src == "Wick" ? l < fvg.btm : fvg_src == "Avg" ? l < math.avg(fvg.top, fvg.btm) : false) and what_fvg == "Breakers"
                    brFVG.remove(i)
    if fvgoverlap
        overlapFVG(blFVG, brFVG)
    if dispraid
        for [i, fvg] in blFVG
            if not fvg.israid and not fvg.isbb
                if low < fvg.top and close > fvg.top
                    fvg.israid := true
                    fvg.raidloc := time
                    fvg.raidx2 := time
                    fvg.raidy := low
                    fvg.raidcs := chart.fg_color
            else
                if low <= fvg.raidy and fvg.active == false and not fvg.isbb
                    fvg.active := true
                    fvg.raidx2 := time
                else
                    if fvg.active == false and not fvg.isbb
                        fvg.raidx2 := time
        for [i, fvg] in brFVG
            if not fvg.israid and not fvg.isbb
                if high > fvg.btm and close < fvg.btm and not fvg.isbb
                    fvg.israid := true
                    fvg.raidloc := time
                    fvg.raidy := high
                    fvg.raidx2 := time
                    fvg.raidcs := chart.fg_color
            else
                if high >= fvg.raidy and fvg.active == false and not fvg.isbb
                    fvg.active := true
                    fvg.raidx2 := time
                else
                    if fvg.active == false and not fvg.isbb
                        fvg.raidx2 := time
    [blFVG, brFVG]

displayFVGs(FVG[] blFVG, FVG[] brFVG) =>
    if barstate.islast
        if blFVG.size() > 0 and fvg_num > 0
            for i = 0 to math.min(fvg_num - 1, blFVG.size() - 1)
                dispFVG(blFVG.get(i), i, true)
        if brFVG.size() > 0 and fvg_num > 0
            for i = 0 to math.min(fvg_num - 1, brFVG.size() - 1)
                dispFVG(brFVG.get(i), i, false)

// ═══════════════════════════════════════════════════════════════════════════════
// ─── CORE STRUCTURE (returns [ms, blob, brob]) ──────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

structure(color upcss, color dncss, bool draw, bool internal, int limit) =>
    var structure ms = structure.new(start = 0)
    var ob[] blob = array.new<ob>()
    var ob[] brob = array.new<ob>()
    var drawms[] bldw = array.new<drawms>()
    var drawms[] brdw = array.new<drawms>()
    var sellbuyside[] sellside = array.new<sellbuyside>()
    var sellbuyside[] buyside  = array.new<sellbuyside>()
    bool crossup = false
    bool crossdn = false
    var float up = na
    var float dn = na
    idbull = ms.find(false, false, true)
    idbear = ms.find(true, false, true)
    btmP = (obmode == "Length" ? (high[idbear] - 1 * atr[idbear]) < low[idbear] ? low[idbear] : (high[idbear] - 1 * atr[idbear]) : low[idbear])
    topP = (obmode == "Length" ? (low[idbull] + 1 * atr[idbull]) > high[idbull] ? high[idbull] : (low[idbull] + 1 * atr[idbull]) : high[idbull])
    atr = ta.atr(200)
    ph = ta.pivothigh(high, mslen, mslen)
    pl = ta.pivotlow(low, mslen, mslen)
    var int[] phn = array.new<int>(1, na)
    var int[] pln = array.new<int>(1, na)
    var float[] php = array.new<float>(1, na)
    var float[] plp = array.new<float>(1, na)
    if internal
        blob.clear()
        brob.clear()
    if not na(ph)
        phn.unshift(bar_index[mslen])
        php.unshift(high[mslen])
    if not na(pl)
        pln.unshift(bar_index[mslen])
        plp.unshift(low[mslen])
    if php.size() > 0
        if high > php.get(0)
            php.clear()
            phn.clear()
    if plp.size() > 0
        if low < plp.get(0)
            plp.clear()
            pln.clear()
    if na(up)
        up := high
    if na(dn)
        dn := low
    if high > up
        up := high
        dn := low
        crossup := true
    if low < dn
        up := high
        dn := low
        crossdn := true
    if ms.start == 0
        ms := structure.new(bar_index, na, high, low, bar_index, bar_index, 0, 1, na, bar_index)
        if draw
            bldw.unshift(drawms.new(time, time, high, "CHoCH", upcss, line.style_dashed))
            brdw.unshift(drawms.new(time, time, low, "CHoCH", dncss, line.style_dashed))
    ms.upsweep := false
    ms.dnsweep := false
    if ms.start == 1
        switch
            low <= ms.choch and close >= ms.choch and buildsweep =>
                ms.dnsweep := true
                ms.choch := low
                ms.xloc := bar_index
                if draw
                    dw = brdw.get(0)
                    dw.x2 := time
                    dw.style := line.style_dotted
                    dw.txt := "x"
                    brdw.unshift(drawms.new(time, time, low, "CHoCH", dncss, line.style_dashed))
            high >= ms.bos and close <= ms.bos and buildsweep =>
                ms.upsweep := true
                ms.bos := high
                ms.xloc := bar_index
                if draw
                    dw = bldw.get(0)
                    dw.x2 := time
                    dw.style := line.style_dotted
                    dw.txt := "x"
                    bldw.unshift(drawms.new(time, time, high, "CHoCH", upcss, line.style_dashed))
            close <= ms.choch =>
                ms.txt := "choch"
                lc.start := true
                lc.count := 0
                blob.fnOB(true, topP, idbull)
                ms.trend := -1
                ms.choch := ms.bos
                ms.bos := na
                ms.start := 2
                ms.loc := bar_index
                ms.main := low
                ms.temp := ms.loc
                ms.xloc := bar_index
                if draw
                    dw = brdw.get(0)
                    dw.x2 := time
                    dw.style := internal ? line.style_dashed : line.style_solid
            close >= ms.bos =>
                ms.txt := "choch"
                lc.start := true
                lc.count := 0
                brob.fnOB(false, btmP, idbear)
                ms.trend := 1
                ms.choch := ms.choch
                ms.bos := na
                ms.start := 2
                ms.loc := bar_index
                ms.main := high
                ms.temp := ms.loc
                ms.xloc := bar_index
                if draw
                    dw = bldw.get(0)
                    dw.x2 := time
                    dw.style := internal ? line.style_dashed : line.style_solid
    if ms.start == 2
        switch ms.trend
            -1 =>
                if low <= ms.main
                    ms.main := low
                    ms.temp := bar_index
                if bar_index % mslen * 2 == 0
                    if not na(ms.bos) and msmode == "Adjusted Points" and php.size() > 0
                        if php.get(0) < ms.choch
                            ms.choch := php.get(0)
                            ms.loc := phn.get(0)
                            ms.xloc := phn.get(0)
                            ms.temp := phn.get(0)
                            if draw
                                choch = bldw.get(0)
                                choch.x1 := time[bar_index - phn.get(0)]
                                choch.x2 := time
                                choch.y := php.get(0)
                if na(ms.bos)
                    if crossup and close > open and close[1] > open[1]
                        ms.bos := ms.main
                        ms.loc := ms.temp
                        ms.xloc := ms.loc
                        if draw
                            brdw.unshift(drawms.new(time[bar_index - ms.loc], time, low[bar_index - ms.loc], "BOS", dncss, line.style_dashed))
                if not na(ms.bos) and draw
                    dw = brdw.get(0)
                    dw.x2 := time
                if draw
                    choch = bldw.get(0)
                    choch.x2 := time
                switch
                    low <= ms.bos and close >= ms.bos and not na(ms.bos) and buildsweep =>
                        ms.dnsweep := true
                        ms.bos := low
                        if draw
                            dw = brdw.get(0)
                            dw.x2 := time
                            dw.style := line.style_dotted
                            dw.txt := "x"
                            brdw.unshift(drawms.new(time, time, low, "BOS", dncss, line.style_dashed))
                        ms.xloc := bar_index
                    close <= ms.bos and not na(ms.bos) =>
                        ms.txt := "bos"
                        ms.zz := ms.bos
                        ms.zn := bar_index
                        lc.start := true
                        lc.count := 0
                        brob.fnOB(false, btmP, idbear)
                        id = ms.find(true, false, false)
                        ms.xloc := bar_index
                        ms.bos := na
                        ms.choch := high[id]
                        ms.loc := bar_index[id]
                        if draw
                            dw = brdw.get(0)
                            dw.x2 := time
                            dw.style := internal ? line.style_dashed : line.style_solid
                            choch = bldw.get(0)
                            choch.x1 := time[id]
                            choch.x2 := time
                            choch.y := high[id]
                switch
                    high >= ms.choch and close <= ms.choch and buildsweep =>
                        ms.upsweep := true
                        ms.choch := high
                        ms.xloc := bar_index
                        if draw
                            dw = bldw.get(0)
                            dw.x2 := time
                            dw.style := line.style_dotted
                            dw.txt := "x"
                            bldw.unshift(drawms.new(time, time, high, "CHoCH", upcss, line.style_dashed))
                    close >= ms.choch =>
                        ms.txt := "choch"
                        ms.zz := ms.choch
                        ms.zn := bar_index
                        lc.start := true
                        lc.count := 0
                        blob.fnOB(true, topP, idbull)
                        id = ms.find(false, false, false)
                        switch
                            na(ms.bos) =>
                                ms.choch := low[id]
                                if draw
                                    brdw.unshift(drawms.new(time, time, low, "BOS", dncss, line.style_dashed))
                                    choch = brdw.get(0)
                                    choch.x1 := time[bar_index - ms.temp]
                            => ms.choch := ms.bos
                        ms.bos := na
                        ms.main := high
                        ms.trend := 1
                        ms.loc := bar_index
                        ms.xloc := bar_index
                        ms.temp := ms.loc
                        if draw
                            dw = bldw.get(0)
                            dw.x2 := time
                            dw.txt := "CHoCH"
                            dw.style := internal ? line.style_dashed : line.style_solid
                            choch = brdw.get(0)
                            choch.x2 := time
                            choch.y := ms.choch
                            choch.txt := "CHoCH"
                        ms.xloc := bar_index
                        blarea.normal := false
            1 =>
                if high >= ms.main
                    ms.main := high
                    ms.temp := bar_index
                if na(ms.bos)
                    if crossdn and close < open and close[1] < open[1]
                        ms.bos := ms.main
                        ms.loc := ms.temp
                        ms.xloc := ms.loc
                        if draw
                            bldw.unshift(drawms.new(time[bar_index - ms.loc], time, high[bar_index - ms.loc], "BOS", upcss, line.style_dashed))
                if bar_index % mslen * 2 == 0
                    if not na(ms.bos) and msmode == "Adjusted Points" and plp.size() > 0
                        if plp.get(0) > ms.choch
                            ms.choch := plp.get(0)
                            ms.loc := pln.get(0)
                            ms.xloc := pln.get(0)
                            ms.temp := pln.get(0)
                            if draw
                                choch = brdw.get(0)
                                choch.x1 := time[bar_index - pln.get(0)]
                                choch.x2 := time
                                choch.y := plp.get(0)
                if not na(ms.bos) and draw
                    dw = bldw.get(0)
                    dw.x2 := time
                if draw
                    choch = brdw.get(0)
                    choch.x2 := time
                switch
                    high >= ms.bos and close <= ms.bos and not na(ms.bos) and buildsweep =>
                        ms.upsweep := true
                        ms.bos := high
                        if draw
                            dw = bldw.get(0)
                            dw.x2 := time
                            dw.style := line.style_dotted
                            dw.txt := "x"
                            bldw.unshift(drawms.new(time, time, high, "BOS", upcss, line.style_dashed))
                        ms.xloc := bar_index
                    close >= ms.bos and not na(ms.bos) =>
                        ms.txt := "bos"
                        ms.zz := ms.bos
                        ms.zn := bar_index
                        lc.start := true
                        lc.count := 0
                        blob.fnOB(true, topP, idbull)
                        id = ms.find(false, false, false)
                        ms.xloc := bar_index
                        ms.bos := na
                        ms.choch := low[id]
                        ms.loc := bar_index[id]
                        if draw
                            dw = bldw.get(0)
                            dw.x2 := time
                            dw.style := internal ? line.style_dashed : line.style_solid
                            choch = brdw.get(0)
                            choch.x1 := time[id]
                            choch.x2 := time
                            choch.y := low[id]
                switch
                    low <= ms.choch and close >= ms.choch and buildsweep =>
                        ms.dnsweep := true
                        ms.choch := low
                        ms.xloc := bar_index
                        if draw
                            dw = brdw.get(0)
                            dw.x2 := time
                            dw.style := line.style_dotted
                            dw.txt := "x"
                            brdw.unshift(drawms.new(time, time, low, "CHoCH", dncss, line.style_dashed))
                    close <= ms.choch =>
                        ms.txt := "choch"
                        ms.zz := ms.choch
                        ms.zn := bar_index
                        lc.start := true
                        lc.count := 0
                        brob.fnOB(false, btmP, idbear)
                        id = ms.find(true, false, false)
                        switch
                            na(ms.bos) =>
                                ms.choch := high[id]
                                if draw
                                    bldw.unshift(drawms.new(time, time, high, "BOS", upcss, line.style_dashed))
                                    choch = bldw.get(0)
                                    choch.x1 := time[bar_index - ms.temp]
                            => ms.choch := ms.bos
                        ms.bos := na
                        ms.main := low
                        ms.trend := -1
                        ms.loc := bar_index
                        ms.temp := ms.loc
                        if draw
                            dw = brdw.get(0)
                            dw.x2 := time
                            dw.txt := "CHoCH"
                            dw.style := internal ? line.style_dashed : line.style_solid
                            choch = bldw.get(0)
                            choch.y := ms.choch
                            choch.x2 := time
                            choch.txt := "CHoCH"
                        ms.xloc := bar_index
    if blob.size() > 0
        ob_ref = blob.get(0)
        if not ob_ref.isbb
            if low < ob_ref.top
                if blobenter.normal == false
                    blobenter.normal := true
        else
            if high > ob_ref.btm
                if blobenter.breaker == false
                    blobenter.breaker := true
    if brob.size() > 0
        ob_ref = brob.get(0)
        if not ob_ref.isbb
            if high > ob_ref.btm
                if brobenter.normal == false
                    brobenter.normal := true
        else
            if low < ob_ref.top
                if brobenter.breaker == false
                    brobenter.breaker := true
    if obshow and oblast > 0
        if barstate.isconfirmed
            blob.mitigated()
            brob.mitigated()
            if overlap
                overlap(blob, brob)
        if blob.size() > 0
            for [i, metric] in blob
                metric.umt()
        if brob.size() > 0
            for [i, metric] in brob
                metric.umt()
        if barstate.islast
            if blob.size() > 0
                for i = 0 to math.min(oblast - 1, blob.size() - 1)
                    display(blob.get(i), blob, i)
            if brob.size() > 0
                for i = 0 to math.min(oblast - 1, brob.size() - 1)
                    display(brob.get(i), brob, i)
    if barstate.islast and draw and bldw.size() > 0 and brdw.size() > 0
        for i = 0 to bldw.size() - 1
            obj = bldw.get(i)
            if i <= limit
                bin.ln.unshift(line.new(x1 = obj.x1, x2 = obj.x2, y1 = obj.y, y2 = obj.y, color = obj.css, style = obj.style, xloc = xloc.bar_time))
                bin.lb.unshift(label.new(x = int(math.avg(bin.ln.get(0).get_x1(), bin.ln.get(0).get_x2())), y = obj.y, xloc = xloc.bar_time, color = #ffffff00, style = label.style_label_down, textcolor = obj.css, size = mstext.txSz(), text = obj.txt))
                if msbubble
                    bin.lb.unshift(label.new(x = obj.x1, y = obj.y, xloc = xloc.bar_time, color = color.new(obj.css, 80), style = label.style_circle, size = size.tiny))
        for i = 0 to brdw.size() - 1
            obj = brdw.get(i)
            if i <= limit
                bin.ln.unshift(line.new(x1 = obj.x1, x2 = obj.x2, y1 = obj.y, y2 = obj.y, color = obj.css, style = obj.style, xloc = xloc.bar_time))
                bin.lb.unshift(label.new(x = int(math.avg(bin.ln.get(0).get_x1(), bin.ln.get(0).get_x2())), y = obj.y, xloc = xloc.bar_time, color = #ffffff00, style = label.style_label_up, textcolor = obj.css, size = mstext.txSz(), text = obj.txt))
                if msbubble
                    bin.lb.unshift(label.new(x = obj.x1, y = obj.y, xloc = xloc.bar_time, color = color.new(obj.css, 80), style = label.style_circle, size = size.tiny))
    [ms, blob, brob]

// ═══════════════════════════════════════════════════════════════════════════════
// ─── MULTI-TIMEFRAME LOGIC ──────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

f_mtfTrend() =>
    var int htfTrend = 0
    var float htfSwingHigh = high
    var float htfSwingLow = low
    var float htfBos = na
    var float htfChoch = na
    var bool htfBullOB = false
    var bool htfBearOB = false
    htfPH = ta.pivothigh(high, mslen, mslen)
    htfPL = ta.pivotlow(low, mslen, mslen)
    if not na(htfPH)
        htfSwingHigh := math.max(htfSwingHigh, high[mslen])
    if not na(htfPL)
        htfSwingLow := math.min(htfSwingLow, low[mslen])
    if htfTrend >= 0
        if close > htfSwingHigh
            htfTrend := 1
            htfBos := htfSwingHigh
            htfBullOB := true
            htfSwingLow := low
        if close < htfSwingLow
            htfTrend := -1
            htfChoch := htfSwingLow
            htfBearOB := true
            htfSwingHigh := high
    else
        if close < htfSwingLow
            htfTrend := -1
            htfBos := htfSwingLow
            htfBearOB := true
            htfSwingHigh := high
        if close > htfSwingHigh
            htfTrend := 1
            htfChoch := htfSwingHigh
            htfBullOB := true
            htfSwingLow := low
    htfBullFVG = low > high[2] and close[1] > open[1]
    htfBearFVG = low[2] > high and close[1] < open[1]
    [htfTrend, htfBos, htfChoch, htfBullOB, htfBearOB, htfBullFVG, htfBearFVG]

[rawHTFTrend, rawHTFBos, rawHTFChoch, rawHTFBullOB, rawHTFBearOB, rawHTFBullFVG, rawHTFBearFVG] = request.security(syminfo.tickerid, mtfTimeframe, f_mtfTrend(), lookahead = barmerge.lookahead_off)

var MTFState mtfState = MTFState.new(0, na, na, false, false, false, false)
if useMTF
    mtfState.trend := rawHTFTrend
    mtfState.bosLevel := rawHTFBos
    mtfState.chochLevel := rawHTFChoch
    mtfState.hasBullOB := rawHTFBullOB
    mtfState.hasBearOB := rawHTFBearOB
    mtfState.hasBullFVG := rawHTFBullFVG
    mtfState.hasBearFVG := rawHTFBearFVG

// ═══════════════════════════════════════════════════════════════════════════════
// ─── MTF FVG SCANNER (for Opposite FVG Proximity Filter) ────────────────────
// ═══════════════════════════════════════════════════════════════════════════════
// Scans the most recent unmitigated FVG on each higher timeframe (1H/4H/1D).
// Returns 4 values per TF: [bullFVGtop, bullFVGbtm, bearFVGtop, bearFVGbtm].
// A value of na means no active FVG of that direction on that TF.
// IMPORTANT: Only higher-or-equal timeframes than the chart are used. If the
// chart is already on a higher TF than the scanner's TF, that scan is skipped
// (returns na) — we never pull FVG data from a LOWER TF.

// Helper: is the target TF higher-or-equal to the chart TF?
f_tfIsHigherOrEq(string tfCheck) =>
    int currMin  = timeframe.in_seconds(timeframe.period) / 60
    int checkMin = timeframe.in_seconds(tfCheck) / 60
    checkMin >= currMin

// Scanner function: finds the most recent active (non-mitigated) FVG of each
// direction within a rolling window. Runs inside request.security() per TF.
f_scanFVG() =>
    var float bullTop = na
    var float bullBtm = na
    var float bearTop = na
    var float bearBtm = na
    // Detect new FVG formation (same logic as dFVG but simplified, no raids)
    bool newBull = low > high[2] and close[1] > open[1]
    bool newBear = low[2] > high and close[1] < open[1]
    if newBull
        bullTop := low[0]
        bullBtm := high[2]
    if newBear
        bearTop := low[2]
        bearBtm := high[0]
    // Invalidate on mitigation (close through the gap)
    if not na(bullTop) and close < bullBtm
        bullTop := na
        bullBtm := na
    if not na(bearTop) and close > bearTop
        bearTop := na
        bearBtm := na
    [bullTop, bullBtm, bearTop, bearBtm]

// Run scanner per HTF only when that TF is higher-or-equal than chart
bool htf1H_ok = useFvgProx and fvgProxUseMTF and fvgProxUse1H and f_tfIsHigherOrEq("60")
bool htf4H_ok = useFvgProx and fvgProxUseMTF and fvgProxUse4H and f_tfIsHigherOrEq("240")
bool htf1D_ok = useFvgProx and fvgProxUseMTF and fvgProxUse1D and f_tfIsHigherOrEq("D")

// request.security() must always be called unconditionally (no ternary with tuples)
[raw1H_bullTop, raw1H_bullBtm, raw1H_bearTop, raw1H_bearBtm] = request.security(syminfo.tickerid, "60",  f_scanFVG(), lookahead = barmerge.lookahead_off)
[raw4H_bullTop, raw4H_bullBtm, raw4H_bearTop, raw4H_bearBtm] = request.security(syminfo.tickerid, "240", f_scanFVG(), lookahead = barmerge.lookahead_off)
[raw1D_bullTop, raw1D_bullBtm, raw1D_bearTop, raw1D_bearBtm] = request.security(syminfo.tickerid, "D",   f_scanFVG(), lookahead = barmerge.lookahead_off)

// Nullify values when the HTF is not enabled or not higher than chart TF
float fvg1H_bullTop = htf1H_ok ? raw1H_bullTop : na
float fvg1H_bullBtm = htf1H_ok ? raw1H_bullBtm : na
float fvg1H_bearTop = htf1H_ok ? raw1H_bearTop : na
float fvg1H_bearBtm = htf1H_ok ? raw1H_bearBtm : na
float fvg4H_bullTop = htf4H_ok ? raw4H_bullTop : na
float fvg4H_bullBtm = htf4H_ok ? raw4H_bullBtm : na
float fvg4H_bearTop = htf4H_ok ? raw4H_bearTop : na
float fvg4H_bearBtm = htf4H_ok ? raw4H_bearBtm : na
float fvg1D_bullTop = htf1D_ok ? raw1D_bullTop : na
float fvg1D_bullBtm = htf1D_ok ? raw1D_bullBtm : na
float fvg1D_bearTop = htf1D_ok ? raw1D_bearTop : na
float fvg1D_bearBtm = htf1D_ok ? raw1D_bearBtm : na

// ═══════════════════════════════════════════════════════════════════════════════
// ─── MTF OB SCANNER (for Opposite OB Proximity Filter) ──────────────────────
// ═══════════════════════════════════════════════════════════════════════════════
// Scans the most recent unmitigated Order Block on each higher timeframe (1H/4H/1D).
// Returns 4 values per TF: [bullOBtop, bullOBbtm, bearOBtop, bearOBbtm].
// A value of na means no active OB of that direction on that TF.

// Scanner function: detects Order Blocks (last down candle before bullish move,
// last up candle before bearish move) and invalidates them on mitigation.
f_scanOB() =>
    var float bullTop = na
    var float bullBtm = na
    var float bearTop = na
    var float bearBtm = na
    // Bullish OB: last bearish candle before a strong bullish move
    bool bullishOB = close[1] < open[1] and close > open and close > high[1] and (close - open) > (open[1] - close[1]) * 0.5
    // Bearish OB: last bullish candle before a strong bearish move
    bool bearishOB = close[1] > open[1] and close < open and close < low[1] and (open - close) > (close[1] - open[1]) * 0.5
    if bullishOB
        bullTop := high[1]
        bullBtm := low[1]
    if bearishOB
        bearTop := high[1]
        bearBtm := low[1]
    // Invalidate on mitigation (close through the OB zone)
    if not na(bullTop) and close < bullBtm
        bullTop := na
        bullBtm := na
    if not na(bearTop) and close > bearTop
        bearTop := na
        bearBtm := na
    [bullTop, bullBtm, bearTop, bearBtm]

// Run OB scanner per HTF only when that TF is higher-or-equal than chart
bool obHtf1H_ok = useObProx and obProxUseMTF and obProxUse1H and f_tfIsHigherOrEq("60")
bool obHtf4H_ok = useObProx and obProxUseMTF and obProxUse4H and f_tfIsHigherOrEq("240")
bool obHtf1D_ok = useObProx and obProxUseMTF and obProxUse1D and f_tfIsHigherOrEq("D")

// request.security() must always be called unconditionally (no ternary with tuples)
[rawOB1H_bullTop, rawOB1H_bullBtm, rawOB1H_bearTop, rawOB1H_bearBtm] = request.security(syminfo.tickerid, "60",  f_scanOB(), lookahead = barmerge.lookahead_off)
[rawOB4H_bullTop, rawOB4H_bullBtm, rawOB4H_bearTop, rawOB4H_bearBtm] = request.security(syminfo.tickerid, "240", f_scanOB(), lookahead = barmerge.lookahead_off)
[rawOB1D_bullTop, rawOB1D_bullBtm, rawOB1D_bearTop, rawOB1D_bearBtm] = request.security(syminfo.tickerid, "D",   f_scanOB(), lookahead = barmerge.lookahead_off)

// Nullify values when the HTF is not enabled or not higher than chart TF
float ob1H_bullTop = obHtf1H_ok ? rawOB1H_bullTop : na
float ob1H_bullBtm = obHtf1H_ok ? rawOB1H_bullBtm : na
float ob1H_bearTop = obHtf1H_ok ? rawOB1H_bearTop : na
float ob1H_bearBtm = obHtf1H_ok ? rawOB1H_bearBtm : na
float ob4H_bullTop = obHtf4H_ok ? rawOB4H_bullTop : na
float ob4H_bullBtm = obHtf4H_ok ? rawOB4H_bullBtm : na
float ob4H_bearTop = obHtf4H_ok ? rawOB4H_bearTop : na
float ob4H_bearBtm = obHtf4H_ok ? rawOB4H_bearBtm : na
float ob1D_bullTop = obHtf1D_ok ? rawOB1D_bullTop : na
float ob1D_bullBtm = obHtf1D_ok ? rawOB1D_bullBtm : na
float ob1D_bearTop = obHtf1D_ok ? rawOB1D_bearTop : na
float ob1D_bearBtm = obHtf1D_ok ? rawOB1D_bearBtm : na

// ═══════════════════════════════════════════════════════════════════════════════
// ─── QUANTITATIVE FILTERS (ported from Gaussian Trend IA Pro) ───────────────
// ═══════════════════════════════════════════════════════════════════════════════

float atrSL    = ta.atr(14)
float volSma20 = ta.sma(volume, 20)

// ═══════════════════════════════════════════════════════════════════════════════
// ─── OPPOSITE FVG PROXIMITY FILTER HELPER ───────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════
// Returns true when it's SAFE to open a signal (no opposite FVG too close),
// and false when an opposite-direction FVG is within the forbidden distance.
//
// For LONG signals: checks BEARISH FVGs ABOVE current price
// For SHORT signals: checks BULLISH FVGs BELOW current price
//
// Distance is measured from the closest edge of the FVG to the signal price.
// ═══════════════════════════════════════════════════════════════════════════════

f_minDistAllowed(float price) =>
    float minDist = 0.0
    if fvgProxMode == "Percent"
        minDist := price * (fvgProxPct / 100.0)
    else
        minDist := ta.atr(14) * fvgProxATR
    minDist

// Check proximity for LONG: reject if any bearish FVG above price is too close
// Returns true if safe, false if blocked
f_isLongSafeFvgProx(float price, FVG[] ctfBearFVGs) =>
    bool safe = true
    float minDist = f_minDistAllowed(price)
    // 1. Current TF bearish FVGs (above price)
    if fvgProxUseCTF and fvg_enable and not na(ctfBearFVGs) and ctfBearFVGs.size() > 0
        for [idx, fvg] in ctfBearFVGs
            if not fvg.isbb
                // Bear FVG is above price → check btm (lower edge)
                if fvg.btm >= price and (fvg.btm - price) < minDist
                    safe := false
                    break
    // 2. HTF bearish FVGs (above price)
    if safe and useFvgProx and fvgProxUseMTF
        if not na(fvg1H_bearBtm) and fvg1H_bearBtm >= price and (fvg1H_bearBtm - price) < minDist
            safe := false
        if safe and not na(fvg4H_bearBtm) and fvg4H_bearBtm >= price and (fvg4H_bearBtm - price) < minDist
            safe := false
        if safe and not na(fvg1D_bearBtm) and fvg1D_bearBtm >= price and (fvg1D_bearBtm - price) < minDist
            safe := false
    safe

// Check proximity for SHORT: reject if any bullish FVG below price is too close
f_isShortSafeFvgProx(float price, FVG[] ctfBullFVGs) =>
    bool safe = true
    float minDist = f_minDistAllowed(price)
    // 1. Current TF bullish FVGs (below price)
    if fvgProxUseCTF and fvg_enable and not na(ctfBullFVGs) and ctfBullFVGs.size() > 0
        for [idx, fvg] in ctfBullFVGs
            if not fvg.isbb
                // Bull FVG is below price → check top (upper edge)
                if fvg.top <= price and (price - fvg.top) < minDist
                    safe := false
                    break
    // 2. HTF bullish FVGs (below price)
    if safe and useFvgProx and fvgProxUseMTF
        if not na(fvg1H_bullTop) and fvg1H_bullTop <= price and (price - fvg1H_bullTop) < minDist
            safe := false
        if safe and not na(fvg4H_bullTop) and fvg4H_bullTop <= price and (price - fvg4H_bullTop) < minDist
            safe := false
        if safe and not na(fvg1D_bullTop) and fvg1D_bullTop <= price and (price - fvg1D_bullTop) < minDist
            safe := false
    safe

// ═══════════════════════════════════════════════════════════════════════════════
// ─── OPPOSITE OB PROXIMITY FILTER HELPER ────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════
// Returns true when it's SAFE to open a signal (no opposite OB too close),
// and false when an opposite-direction OB is within the forbidden distance.
//
// For LONG signals: checks BEARISH OBs ABOVE current price
// For SHORT signals: checks BULLISH OBs BELOW current price
// ═══════════════════════════════════════════════════════════════════════════════

f_obMinDistAllowed(float price) =>
    float minDist = 0.0
    if obProxMode == "Percent"
        minDist := price * (obProxPct / 100.0)
    else
        minDist := ta.atr(14) * obProxATR
    minDist

// Check proximity for LONG: reject if any bearish OB above price is too close
f_isLongSafeObProx(float price, ob[] ctfBearOBs) =>
    bool safe = true
    float minDist = f_obMinDistAllowed(price)
    // 1. Current TF bearish OBs (above price)
    if obProxUseCTF and not na(ctfBearOBs) and ctfBearOBs.size() > 0
        for [idx, blk] in ctfBearOBs
            if not blk.isbb
                // Bear OB is above price → check btm (lower edge)
                if blk.btm >= price and (blk.btm - price) < minDist
                    safe := false
                    break
    // 2. HTF bearish OBs (above price)
    if safe and useObProx and obProxUseMTF
        if not na(ob1H_bearBtm) and ob1H_bearBtm >= price and (ob1H_bearBtm - price) < minDist
            safe := false
        if safe and not na(ob4H_bearBtm) and ob4H_bearBtm >= price and (ob4H_bearBtm - price) < minDist
            safe := false
        if safe and not na(ob1D_bearBtm) and ob1D_bearBtm >= price and (ob1D_bearBtm - price) < minDist
            safe := false
    safe

// Check proximity for SHORT: reject if any bullish OB below price is too close
f_isShortSafeObProx(float price, ob[] ctfBullOBs) =>
    bool safe = true
    float minDist = f_obMinDistAllowed(price)
    // 1. Current TF bullish OBs (below price)
    if obProxUseCTF and not na(ctfBullOBs) and ctfBullOBs.size() > 0
        for [idx, blk] in ctfBullOBs
            if not blk.isbb
                // Bull OB is below price → check top (upper edge)
                if blk.top <= price and (price - blk.top) < minDist
                    safe := false
                    break
    // 2. HTF bullish OBs (below price)
    if safe and useObProx and obProxUseMTF
        if not na(ob1H_bullTop) and ob1H_bullTop <= price and (price - ob1H_bullTop) < minDist
            safe := false
        if safe and not na(ob4H_bullTop) and ob4H_bullTop <= price and (price - ob4H_bullTop) < minDist
            safe := false
        if safe and not na(ob1D_bullTop) and ob1D_bullTop <= price and (price - ob1D_bullTop) < minDist
            safe := false
    safe

// ═══════════════════════════════════════════════════════════════════════════════
// ─── COMBINED PROXIMITY WRAPPER (FVG + OB in one call) ──────────────────────
// ═══════════════════════════════════════════════════════════════════════════════
// Merges FVG and OB proximity checks into a single bool to reduce local scopes.

f_isLongSafeAllProx(float price, FVG[] ctfBearFVGs, ob[] ctfBearOBs) =>
    bool fvgOk = not useFvgProx or f_isLongSafeFvgProx(price, ctfBearFVGs)
    bool obOk  = not useObProx  or f_isLongSafeObProx(price, ctfBearOBs)
    fvgOk and obOk

f_isShortSafeAllProx(float price, FVG[] ctfBullFVGs, ob[] ctfBullOBs) =>
    bool fvgOk = not useFvgProx or f_isShortSafeFvgProx(price, ctfBullFVGs)
    bool obOk  = not useObProx  or f_isShortSafeObProx(price, ctfBullOBs)
    fvgOk and obOk

// ─── FISHER TRANSFORM ────────────────────────────────────────────────────────
f_fisher(src, period) =>
    float x = 0.0
    float y = 0.0
    float high_ = ta.highest(src, period)
    float low_  = ta.lowest(src, period)
    float rangeVal = high_ - low_
    float val = 2.0 * ((src - low_) / (rangeVal < 1e-10 ? 1e-10 : rangeVal)) - 1.0
    x := 0.33 * val + 0.67 * nz(x[1])
    float value = x > 0.99 ? 0.999 : x < -0.99 ? -0.999 : x
    y := 0.5 * math.log((1.0 + value) / (1.0 - value)) + 0.5 * nz(y[1])
    y

f_isExtremeZone(float fisher, float extreme) =>
    math.abs(fisher) >= extreme

f_isFisherCrossOver(float fisher, float signal) =>
    ta.crossover(fisher, signal)

f_isFisherCrossUnder(float fisher, float signal) =>
    ta.crossunder(fisher, signal)

// ─── MOMENTUM & DIVERGENCE ──────────────────────────────────────────────────
f_getMomentum(period) =>
    close - close[period]

f_bullishDiv() =>
    bool  div = false
    float p   = f_getMomentum(14)
    int   plb = 5
    int   prb = 5
    float ph  = ta.pivotlow(low, plb, prb)
    float pm  = ta.pivotlow(p, plb, prb)
    if not na(ph) and not na(pm)
        if low[prb] < ta.valuewhen(not na(ph), low[prb], 1) and p[prb] > ta.valuewhen(not na(pm), p[prb], 1)
            div := true
    div

f_bearishDiv() =>
    bool  div = false
    float p   = f_getMomentum(14)
    int   plb = 5
    int   prb = 5
    float ph  = ta.pivothigh(high, plb, prb)
    float pm  = ta.pivothigh(p, plb, prb)
    if not na(ph) and not na(pm)
        if high[prb] > ta.valuewhen(not na(ph), high[prb], 1) and p[prb] < ta.valuewhen(not na(pm), p[prb], 1)
            div := true
    div

// ─── FROST ENGINE ───────────────────────────────────────────────────────────
float frostSens = frostMode == "Scalping" ? 1.3 : frostMode == "Intraday" ? 3.5 : 4.2

f_smoothrng(float x, int t, float m) =>
    int wper = t * 2 - 1
    float avrng = ta.ema(math.abs(x - nz(x[1])), t)
    ta.ema(avrng, wper) * m

f_rngfilt(float x, float r) =>
    float rngfiltResult = x
    rngfiltResult := (x > nz(rngfiltResult[1]) ? (x - r < nz(rngfiltResult[1]) ? nz(rngfiltResult[1]) : x - r) : (x + r > nz(rngfiltResult[1]) ? nz(rngfiltResult[1]) : x + r))
    rngfiltResult

float frostSmrng1 = f_smoothrng(close, 27, 1.5)
float frostSmrng2 = f_smoothrng(close, 55, frostSens)
float frostSmrng  = (frostSmrng1 + frostSmrng2) / 2.0
float frostFilt   = f_rngfilt(close, frostSmrng)

float frost_up = 0.0
frost_up := (frostFilt > nz(frostFilt[1]) ? nz(frost_up[1]) + 1 : frostFilt < nz(frostFilt[1]) ? 0 : nz(frost_up[1]))
float frost_dn = 0.0
frost_dn := (frostFilt < nz(frostFilt[1]) ? nz(frost_dn[1]) + 1 : frostFilt > nz(frostFilt[1]) ? 0 : nz(frost_dn[1]))

// ADX for Frost confidence
float trFrost = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
float dmP     = math.max(high - high[1], 0)
float dmM     = math.max(low[1] - low, 0)
if dmP > dmM
    dmM := 0
else
    dmP := 0
float smTR  = ta.rma(trFrost, 14)
float smDMP = ta.rma(dmP, 14)
float smDMM = ta.rma(dmM, 14)
float diP   = smTR > 0 ? (smDMP / smTR) * 100 : 0
float diM   = smTR > 0 ? (smDMM / smTR) * 100 : 0
float dxDen = diP + diM
float dx    = dxDen > 0 ? math.abs(diP - diM) / dxDen * 100 : 0
float adxVal = ta.rma(dx, 14)

int frostConfLong = 0
if frost_up > 0
    frostConfLong += 1
    if close > frostFilt + atrSL * 0.5
        frostConfLong += 1
    if frost_up >= 3
        frostConfLong += 1
    if frostSmrng1 > frostSmrng2
        frostConfLong += 1
    if adxVal >= 20
        frostConfLong += 1
int frostConfShort = 0
if frost_dn > 0
    frostConfShort += 1
    if close < frostFilt - atrSL * 0.5
        frostConfShort += 1
    if frost_dn >= 3
        frostConfShort += 1
    if frostSmrng1 > frostSmrng2
        frostConfShort += 1
    if adxVal >= 20
        frostConfShort += 1

bool frostBullOK  = not useFrost or (frost_up > 0 and frostConfLong >= minFrostConf)
bool frostBearOK  = not useFrost or (frost_dn > 0 and frostConfShort >= minFrostConf)

// ─── WAE EXPLOSION ──────────────────────────────────────────────────────────
float waeMACD1    = ta.ema(close, waeFastLen) - ta.ema(close, waeSlowLen)
float waeMACD2    = ta.ema(close[1], waeFastLen) - ta.ema(close[1], waeSlowLen)
float waeTrend    = (waeMACD1 - waeMACD2) * waeSens
float waeBBBasis  = ta.sma(close, waeBBLen)
float waeBBDev    = waeBBMult * ta.stdev(close, waeBBLen)
float waeExplosion = (waeBBBasis + waeBBDev) - (waeBBBasis - waeBBDev)
float waeDeadLine  = ta.atr(100) * waeDeadZone

bool waeBullOK = not useWAE or (waeTrend > 0 and waeTrend > waeExplosion and waeTrend > waeDeadLine)
bool waeBearOK = not useWAE or (waeTrend < 0 and math.abs(waeTrend) > waeExplosion and math.abs(waeTrend) > waeDeadLine)

// ─── CHOPPINESS INDEX ───────────────────────────────────────────────────────
float chopATRSum = math.sum(ta.atr(1), chopLen)
float chopHL     = ta.highest(high, chopLen) - ta.lowest(low, chopLen)
float chopIndex  = chopHL > 0 ? 100.0 * math.log10(chopATRSum / chopHL) / math.log10(chopLen) : 50.0
bool  chopOK     = not useChop or chopIndex < chopThreshold

// ─── VOLUME ABSORPTION (scoring only — no visual labels) ───────────────────
float bodyRange = math.abs(close - open)
float upperWick = high - math.max(close, open)
float lowerWick = math.min(close, open) - low
float volRatio  = volSma20 > 0 ? volume / volSma20 : 1.0

bool bullishAbsorption = useAbsorption and lowerWick > bodyRange * 1.5 and close > open and volRatio > absThreshold and low == ta.lowest(low, 10)
bool bearishAbsorption = useAbsorption and upperWick > bodyRange * 1.5 and close < open and volRatio > absThreshold and high == ta.highest(high, 10)

// NOTE: Visual "ABS" labels removed per user request — absorption still
// contributes to Signal S scoring, just no on-chart marks.

// ═══════════════════════════════════════════════════════════════════════════════
// ─── EXECUTION ──────────────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

structure ms_result = na
ob[] g_blob = na
ob[] g_brob = na

if windowsis
    if bar_index > last_bar_index - mswindow
        [ms_out, blob_out, brob_out] = structure(swingcssup, swingcssdn, showSwing, false, swingLimit)
        ms_result := ms_out
        g_blob := blob_out
        g_brob := brob_out
if windowsis == false
    [ms_out, blob_out, brob_out] = structure(swingcssup, swingcssdn, showSwing, false, swingLimit)
    ms_result := ms_out
    g_blob := blob_out
    g_brob := brob_out

color css = na
if windowsis ? (bar_index > last_bar_index - mswindow) : true
    css := ms_result.trend == 1 ? swingcssup : swingcssdn
    css := ms_result.txt == "bos" ? css : css.darkcss(0.3)
barcolor(candlecss ? css : na)

var FVG[] g_blFVG = array.new<FVG>()
var FVG[] g_brFVG = array.new<FVG>()
if fvg_enable
    [blf, brf] = dFVG()
    g_blFVG := blf
    g_brFVG := brf
    displayFVGs(g_blFVG, g_brFVG)

if showMapping
    mapping()

// ─── FISHER / MOMENTUM CALCULATION ──────────────────────────────────────────
float hl2Val = math.avg(high, low)
float fisher = f_fisher(hl2Val, fisherPeriod)
float fisherEMA = ta.ema(fisher, 3) // Signal line (hardcoded small EMA)
float momentum = f_getMomentum(14)
float momEMA = ta.ema(momentum, 5)

// ═══════════════════════════════════════════════════════════════════════════════
// ─── CYBERCYCLE ENGINE (for Precision Entry) ─────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

// EMA helper (manual implementation for use with var-based state)
f_ccEma(float src, int len) =>
    float k = 2.0 / (len + 1)
    var float out = 0.0
    out := k * src + (1.0 - k) * nz(out[1])
    out

// ─── Kalman Filter (innovation-based adaptive alpha) ────────────────────────
float ccSrc = hl2Val

var float _cc_kx = 0.0
var float _cc_kP = 1.0
var float _cc_kInnovEma = 0.001

float _cc_kxPred = _cc_kx
float _cc_kPPred = _cc_kP + ccKalQ

float _cc_kInnov = ccSrc - _cc_kxPred
float _cc_kS     = _cc_kPPred + ccKalR
float _cc_kK     = _cc_kS > 1e-12 ? _cc_kPPred / _cc_kS : 0.5

_cc_kx := _cc_kxPred + _cc_kK * _cc_kInnov
_cc_kP := (1.0 - _cc_kK) * _cc_kPPred

float _cc_kAbsInnov = math.abs(_cc_kInnov)
_cc_kInnovEma := 0.05 * _cc_kAbsInnov + 0.95 * nz(_cc_kInnovEma[1], 0.001)

float _cc_kNormInnov = _cc_kInnovEma > 1e-12 ? _cc_kAbsInnov / _cc_kInnovEma : 1.0
float _cc_kRatio     = (_cc_kNormInnov - 1.0) * ccKalSens
float _cc_kSigmoid   = 1.0 / (1.0 + math.exp(-_cc_kRatio))
float _cc_kalAlpha   = ccKalSlow + (ccKalFast - ccKalSlow) * _cc_kSigmoid
_cc_kalAlpha := math.max(ccKalSlow, math.min(ccKalFast, _cc_kalAlpha))

// ─── Alpha dispatcher ───────────────────────────────────────────────────────
float ccAlpha = ccAlphaMethod == "Kalman" ? _cc_kalAlpha : ccManualAlpha

// ─── CyberCycle core (IIR bandpass) ─────────────────────────────────────────
var float _ccSmooth = 0.0
var float _ccCycle  = 0.0
_ccSmooth := (ccSrc + 2.0 * nz(ccSrc[1]) + 2.0 * nz(ccSrc[2]) + nz(ccSrc[3])) / 6.0
if bar_index < 7
    _ccCycle := (ccSrc - 2.0 * nz(ccSrc[1]) + nz(ccSrc[2])) / 4.0
else
    float _cc_a1 = (1.0 - 0.5 * ccAlpha) * (1.0 - 0.5 * ccAlpha)
    float _cc_a2 = 2.0 * (1.0 - ccAlpha)
    float _cc_a3 = (1.0 - ccAlpha) * (1.0 - ccAlpha)
    _ccCycle := _cc_a1 * (_ccSmooth - 2.0 * nz(_ccSmooth[1]) + nz(_ccSmooth[2])) + _cc_a2 * nz(_ccCycle[1]) - _cc_a3 * nz(_ccCycle[2])

float ccCycle   = _ccCycle
float ccTrigger = f_ccEma(ccCycle, ccTrigEma)

// ─── iTrend filter ──────────────────────────────────────────────────────────
var float _ccITrend = 0.0
float _itA = ccITrendAlpha
_ccITrend := (_itA - _itA * _itA / 4.0) * close + 0.5 * _itA * _itA * nz(close[1]) - (_itA - 0.75 * _itA * _itA) * nz(close[2]) + 2.0 * (1.0 - _itA) * nz(_ccITrend[1]) - (1.0 - _itA) * (1.0 - _itA) * nz(_ccITrend[2])
bool ccBullTrend = _ccITrend > nz(_ccITrend[2])
bool ccBearTrend = _ccITrend < nz(_ccITrend[2])

// ─── Volume filter ──────────────────────────────────────────────────────────
float ccVolSma   = ta.sma(volume, 20)
float ccVolRatio = ccVolSma > 0 ? volume / ccVolSma : 0.0
bool  ccVolumeOK = not ccUseVolume or ccVolRatio >= ccVolMult

// ─── HTF filter (4H) ────────────────────────────────────────────────────────
float ccHTFSrc = request.security(syminfo.tickerid, "240", hl2, lookahead = barmerge.lookahead_off)
float ccHTFEma = request.security(syminfo.tickerid, "240", ta.ema(close, 10), lookahead = barmerge.lookahead_off)
bool  ccHTFBull = not ccUseHTF or ccHTFSrc > ccHTFEma
bool  ccHTFBear = not ccUseHTF or ccHTFSrc < ccHTFEma

// ─── Unified precision oscillator variables ─────────────────────────────────
bool precIsExtreme  = false
bool precCrossLong  = false
bool precCrossShort = false
bool precFiltersLongOK  = true
bool precFiltersShortOK = true

if precOscillator == "Fisher Transform"
    precIsExtreme   := f_isExtremeZone(fisher, fisherExtreme)
    precCrossLong   := f_isFisherCrossOver(fisher, fisherEMA)
    precCrossShort  := f_isFisherCrossUnder(fisher, fisherEMA)

if precOscillator == "CyberCycle"
    precIsExtreme   := (ccCycle > ccOBLevel) or (ccCycle < ccOSLevel)
    precCrossLong   := ta.crossover(ccCycle, ccTrigger)
    precCrossShort  := ta.crossunder(ccCycle, ccTrigger)
    bool trendOK_L  = not ccUseTrend or ccBullTrend
    bool trendOK_S  = not ccUseTrend or ccBearTrend
    precFiltersLongOK  := trendOK_L and ccVolumeOK and ccHTFBull
    precFiltersShortOK := trendOK_S and ccVolumeOK and ccHTFBear

// ═══════════════════════════════════════════════════════════════════════════════
// ─── SIGNAL GENERATOR (S + Precision) ────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

var line slLine = na
var line tpLine = na
var label slLabel = na
var label tpLabel = na

if signalCooldown > 0
    signalCooldown := signalCooldown - 1
if signalSCooldown > 0
    signalSCooldown := signalSCooldown - 1

// Track Signal S activation for Watch state machine
var bool signalSLongThisBar = false
var bool signalSShortThisBar = false
var int scoreSLongGlobal = 0
signalSLongThisBar := false
signalSShortThisBar := false

if barstate.isconfirmed and not na(ms_result)

    // ─── Zone detection ─────────────────────────────────────────────────────
    bool isInBullOB  = false
    bool isInBearOB  = false
    bool isInBullFVG = false
    bool isInBearFVG = false
    float obEntryL   = na
    float obSL_L     = na
    float obEntryS   = na
    float obSL_S     = na
    float fvgEntryL  = na
    float fvgSL_L    = na
    float fvgEntryS  = na
    float fvgSL_S    = na

    if not na(g_blob) and g_blob.size() > 0
        for [idx, blk] in g_blob
            if not blk.isbb and low <= blk.top and close >= blk.btm
                isInBullOB := true
                obEntryL   := blk.avg
                obSL_L     := blk.btm - atrSL * 0.5
                break

    if not na(g_brob) and g_brob.size() > 0
        for [idx, blk] in g_brob
            if not blk.isbb and high >= blk.btm and close <= blk.top
                isInBearOB := true
                obEntryS   := blk.avg
                obSL_S     := blk.top + atrSL * 0.5
                break

    if g_blFVG.size() > 0
        for [idx, fvg] in g_blFVG
            if not fvg.isbb and low <= fvg.top and close >= fvg.btm
                isInBullFVG := true
                fvgEntryL   := math.avg(fvg.top, fvg.btm)
                fvgSL_L     := fvg.btm - atrSL * 0.5
                break

    if g_brFVG.size() > 0
        for [idx, fvg] in g_brFVG
            if not fvg.isbb and high >= fvg.btm and close <= fvg.top
                isInBearFVG := true
                fvgEntryS   := math.avg(fvg.top, fvg.btm)
                fvgSL_S     := fvg.top + atrSL * 0.5
                break

    // ─── MTF alignment ──────────────────────────────────────────────────────
    bool mtfBullish = not useMTF or not mtfTrendFilter or mtfState.trend == 1
    bool mtfBearish = not useMTF or not mtfTrendFilter or mtfState.trend == -1

    // ═══════════════════════════════════════════════════════════════════════════
    // ─── EVENT MEMORY UPDATE (shared by S and D) ───────────────────────────
    // ═══════════════════════════════════════════════════════════════════════════

    if ms_result.txt == "choch" and ms_result.trend == 1
        recentCHoCHBullBar := bar_index
    if ms_result.txt == "choch" and ms_result.trend == -1
        recentCHoCHBearBar := bar_index
    if ms_result.txt == "bos" and ms_result.trend == 1
        recentBOSBullBar := bar_index
    if ms_result.txt == "bos" and ms_result.trend == -1
        recentBOSBearBar := bar_index
    if ms_result.dnsweep
        recentSweepDnBar := bar_index
    if ms_result.upsweep
        recentSweepUpBar := bar_index

    // Freshness checks for S (wider lookback)
    bool freshCHoCHBull = not na(recentCHoCHBullBar) and (bar_index - recentCHoCHBullBar) <= sLookback
    bool freshCHoCHBear = not na(recentCHoCHBearBar) and (bar_index - recentCHoCHBearBar) <= sLookback
    bool freshSweepDn   = not na(recentSweepDnBar) and (bar_index - recentSweepDnBar) <= sLookback
    bool freshSweepUp   = not na(recentSweepUpBar) and (bar_index - recentSweepUpBar) <= sLookback
    bool freshBOSBull   = not na(recentBOSBullBar) and (bar_index - recentBOSBullBar) <= sLookback
    bool freshBOSBear   = not na(recentBOSBearBar) and (bar_index - recentBOSBearBar) <= sLookback

    bool structureBullOK = freshCHoCHBull or (not sRequireCHoCH and freshBOSBull)
    bool structureBearOK = freshCHoCHBear or (not sRequireCHoCH and freshBOSBear)

    bool inDemandZone = isInBullOB or isInBullFVG
    bool inSupplyZone = isInBearOB or isInBearFVG

    

    // ═══════════════════════════════════════════════════════════════════════════
    // ─── SIGNAL S: Full confluence (CHoCH + Sweep + OB/FVG + HTF + filters) ─
    // ═══════════════════════════════════════════════════════════════════════════

    bool pillarStructureLong = structureBullOK
    bool pillarSweepLong     = freshSweepDn
    bool pillarZoneLong      = inDemandZone
    bool pillarHTFLong       = mtfBullish
    bool pillarChopLong      = chopOK

    bool pillarStructureShort = structureBearOK
    bool pillarSweepShort     = freshSweepUp
    bool pillarZoneShort      = inSupplyZone
    bool pillarHTFShort       = mtfBearish
    bool pillarChopShort      = chopOK

    bool gateLong = true
    if sRequireCHoCH and not pillarStructureLong
        gateLong := false
    if sRequireSweep and not pillarSweepLong
        gateLong := false
    if sRequireZone and not pillarZoneLong
        gateLong := false
    if sRequireHTF and not pillarHTFLong
        gateLong := false
    if sRequireChop and not pillarChopLong
        gateLong := false

    bool gateShort = true
    if sRequireCHoCH and not pillarStructureShort
        gateShort := false
    if sRequireSweep and not pillarSweepShort
        gateShort := false
    if sRequireZone and not pillarZoneShort
        gateShort := false
    if sRequireHTF and not pillarHTFShort
        gateShort := false
    if sRequireChop and not pillarChopShort
        gateShort := false

    int scoreSLong = 0
    if pillarStructureLong
        scoreSLong += 2
    if pillarSweepLong
        scoreSLong += 2
    if isInBullOB
        scoreSLong += 2
    if isInBullFVG
        scoreSLong += 1
    if useMTF and mtfState.trend == 1
        scoreSLong += 1
    if useFrost and frostBullOK
        scoreSLong += 1
    if useWAE and waeBullOK
        scoreSLong += 1

    int scoreSShort = 0
    if pillarStructureShort
        scoreSShort += 2
    if pillarSweepShort
        scoreSShort += 2
    if isInBearOB
        scoreSShort += 2
    if isInBearFVG
        scoreSShort += 1
    if useMTF and mtfState.trend == -1
        scoreSShort += 1
    if useFrost and frostBearOK
        scoreSShort += 1
    if useWAE and waeBearOK
        scoreSShort += 1

    if bullishAbsorption
        scoreSLong += 1
    if bearishAbsorption
        scoreSShort += 1

    // Combined FVG + OB proximity filter for Signal S
    if (useFvgProx or useObProx) and gateLong
        if not f_isLongSafeAllProx(close, g_brFVG, g_brob)
            gateLong := false
    if (useFvgProx or useObProx) and gateShort
        if not f_isShortSafeAllProx(close, g_blFVG, g_blob)
            gateShort := false

    bool signalSLong  = showSignalS and gateLong and scoreSLong >= minScoreS and ms_result.trend == 1 and signalSCooldown == 0 and bar_index > lastSSignalBar + mslen
    bool signalSShort = showSignalS and gateShort and scoreSShort >= minScoreS and ms_result.trend == -1 and signalSCooldown == 0 and bar_index > lastSSignalBar + mslen

    string starsLong  = scoreSLong >= 10 ? "★★★★★" : scoreSLong >= 8 ? "★★★★" : scoreSLong >= 6 ? "★★★" : scoreSLong >= 4 ? "★★" : "★"
    string starsShort = scoreSShort >= 10 ? "★★★★★" : scoreSShort >= 8 ? "★★★★" : scoreSShort >= 6 ? "★★★" : scoreSShort >= 4 ? "★★" : "★"

    if signalSLong
        float entry = close
        float sl    = not na(obSL_L) ? obSL_L : not na(fvgSL_L) ? fvgSL_L : low - atrSL
        float risk  = math.abs(entry - sl)
        float tp    = entry + risk * riskReward

        lastSignalS     := TradeSignal.new(true, "S", entry, sl, tp, bar_index, scoreSLong, "S-LONG " + starsLong)
        signalSCooldown := mslen * 3
        lastSSignalBar  := bar_index

        label sLbl = label.new(bar_index, low, "◆ S-LONG " + starsLong + "\n" + str.tostring(scoreSLong) + "/10", color = color.new(sigSColor, 0), textcolor = color.rgb(0, 0, 0), style = label.style_label_up, size = size.small)
        f_pushSignalLabel(histSignalLabelsS, sLbl)

        if showSLTP
            if not na(slLine)
                line.delete(slLine)
            if not na(tpLine)
                line.delete(tpLine)
            if not na(slLabel)
                label.delete(slLabel)
            if not na(tpLabel)
                label.delete(tpLabel)
            slLine  := line.new(bar_index, sl, bar_index + 15, sl, color = color.new(#ff1744, 40), style = line.style_dashed, width = 2)
            tpLine  := line.new(bar_index, tp, bar_index + 15, tp, color = color.new(#00e676, 40), style = line.style_dashed, width = 2)
            slLabel := label.new(bar_index + 15, sl, "SL: " + str.tostring(sl, format.mintick), color = #ffffff00, textcolor = #ff1744, style = label.style_label_left, size = size.tiny)
            tpLabel := label.new(bar_index + 15, tp, "TP: " + str.tostring(tp, format.mintick), color = #ffffff00, textcolor = #00e676, style = label.style_label_left, size = size.tiny)

        if alertSignals
            alert("◆ SMC ELITE SIGNAL S — LONG | " + syminfo.ticker + " | Score: " + str.tostring(scoreSLong) + "/10 " + starsLong + " | Entry: " + str.tostring(entry, format.mintick) + " | SL: " + str.tostring(sl, format.mintick) + " | TP: " + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)

        signalSLongThisBar := true
        scoreSLongGlobal   := scoreSLong

    if signalSShort
        float entry = close
        float sl    = not na(obSL_S) ? obSL_S : not na(fvgSL_S) ? fvgSL_S : high + atrSL
        float risk  = math.abs(sl - entry)
        float tp    = entry - risk * riskReward

        lastSignalS     := TradeSignal.new(false, "S", entry, sl, tp, bar_index, scoreSShort, "S-SHORT " + starsShort)
        signalSCooldown := mslen * 3
        lastSSignalBar  := bar_index

        label sLbl = label.new(bar_index, high, "◆ S-SHORT " + starsShort + "\n" + str.tostring(scoreSShort) + "/10", color = color.new(sigSColor, 0), textcolor = color.rgb(0, 0, 0), style = label.style_label_down, size = size.small)
        f_pushSignalLabel(histSignalLabelsS, sLbl)

        if showSLTP
            if not na(slLine)
                line.delete(slLine)
            if not na(tpLine)
                line.delete(tpLine)
            if not na(slLabel)
                label.delete(slLabel)
            if not na(tpLabel)
                label.delete(tpLabel)
            slLine  := line.new(bar_index, sl, bar_index + 15, sl, color = color.new(#ff1744, 40), style = line.style_dashed, width = 2)
            tpLine  := line.new(bar_index, tp, bar_index + 15, tp, color = color.new(#00e676, 40), style = line.style_dashed, width = 2)
            slLabel := label.new(bar_index + 15, sl, "SL: " + str.tostring(sl, format.mintick), color = #ffffff00, textcolor = #ff1744, style = label.style_label_left, size = size.tiny)
            tpLabel := label.new(bar_index + 15, tp, "TP: " + str.tostring(tp, format.mintick), color = #ffffff00, textcolor = #00e676, style = label.style_label_left, size = size.tiny)

        if alertSignals
            alert("◆ SMC ELITE SIGNAL S — SHORT | " + syminfo.ticker + " | Score: " + str.tostring(scoreSShort) + "/10 " + starsShort + " | Entry: " + str.tostring(entry, format.mintick) + " | SL: " + str.tostring(sl, format.mintick) + " | TP: " + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)

        signalSShortThisBar := true
        scoreSLongGlobal    := scoreSShort

// ═══════════════════════════════════════════════════════════════════════════════
// ─── WATCH STATE MACHINE (Precision Entry) ──────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

var bool entryLongConfirmed = false
var bool entryShortConfirmed = false
entryLongConfirmed := false
entryShortConfirmed := false

if barstate.isconfirmed
    // IDLE -> WATCH: cuando Signal S se activa
    if signalSLongThisBar and not watchActive
        watchActive := true
        watchIsLong := true
        watchStartBar := bar_index
        watchSigEntry := close
        watchSigScore := scoreSLongGlobal
        precWasExtreme := false

    if signalSShortThisBar and not watchActive
        watchActive := true
        watchIsLong := false
        watchStartBar := bar_index
        watchSigEntry := close
        watchSigScore := scoreSLongGlobal
        precWasExtreme := false

    // WATCH: monitorear dentro de la ventana
    if watchActive
        int barsSinceWatch = bar_index - watchStartBar

        // Detectar si el oscilador llega a zona extrema
        if precIsExtreme
            precWasExtreme := true

        // WATCH -> ENTRY: confirmacion de entrada (unificado)
        bool crossOK   = (watchIsLong ? precCrossLong : precCrossShort)
        bool filtersOK = (watchIsLong ? precFiltersLongOK : precFiltersShortOK)
        bool hasDiv    = (requireDiv ? (watchIsLong ? f_bullishDiv() : f_bearishDiv()) : true)

        if precWasExtreme and crossOK and hasDiv and filtersOK
            // ENTRY confirmada
            float oscValue = (precOscillator == "Fisher Transform" ? fisher : ccCycle)
            lastEntry := EntrySignal.new(watchIsLong, true, watchStartBar, watchSigEntry, bar_index, oscValue, hasDiv, true)

            if watchIsLong
                entryLongConfirmed := true
            else
                entryShortConfirmed := true

            // Label de ENTRY
            if showEntry
                string entryTxt = (watchIsLong ? "◇ ENTRY ↑" : "◇ ENTRY ↓")
                color entryCol = (watchIsLong ? entryLongColor : entryShortColor)
                float entryYPos = (watchIsLong ? low : high)
                label entryLbl = label.new(bar_index, entryYPos, entryTxt, color=entryCol, textcolor=color.white, style=(watchIsLong ? label.style_label_up : label.style_label_down), size=size.small)
                array.push(entryLabels, entryLbl)

                if array.size(entryLabels) > 100
                    label.delete(array.shift(entryLabels))

            watchActive := false

        // WATCH -> EXPIRED
        if barsSinceWatch > watchWindow
            watchActive := false

// ─── GLOBAL VISUALIZATIONS ──────────────────────────────────────────────────
bgcolor(watchActive and showWindow ? color.new(windowColor, 90) : na)

// Precision Oscillator Panel Plots (Fisher or CyberCycle)
bool _isFisher = precOscillator == "Fisher Transform"
float plotOsc   = showPrecPanel ? (_isFisher ? fisher : ccCycle) : na
float plotSig   = showPrecPanel ? (_isFisher ? fisherEMA : ccTrigger) : na
float plotExtHi = showPrecPanel ? (_isFisher ? fisherExtreme : ccOBLevel) : na
float plotExtLo = showPrecPanel ? (_isFisher ? -fisherExtreme : ccOSLevel) : na

plot(plotOsc, title="Precision Oscillator", color=color.new(color.blue, 0), linewidth=2)
plot(plotSig, title="Precision Signal", color=color.new(color.red, 0), linewidth=1, style=plot.style_cross)
plot(plotExtHi, title="Zone +Extreme", color=color.new(color.green, 70), linewidth=1)
plot(plotExtLo, title="Zone -Extreme", color=color.new(color.red, 70), linewidth=1)
plot(showPrecPanel ? 0 : na, title="Zero Line", color=color.new(color.gray, 50), linewidth=1)

// Precision Extremes Background
color precBgCol = (showPrecPanel and precIsExtreme ? ((_isFisher ? fisher > 0 : ccCycle > 0) ? color.new(color.green, 85) : color.new(color.red, 85)) : na)
bgcolor(precBgCol)


// ═══════════════════════════════════════════════════════════════════════════════
// ─── DASHBOARD v3.1 ─────────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

if showDashboard and barstate.islast
    tblPos = switch dashPos
        "Top Left"     => position.top_left
        "Top Right"    => position.top_right
        "Bottom Left"  => position.bottom_left
        "Bottom Right" => position.bottom_right

    tblSize = switch dashSize
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal

    var table dash = table.new(tblPos, 2, 14, bgcolor = color.new(#1a1a2e, 10), border_color = color.new(#333355, 50), border_width = 1, frame_color = color.new(#333355, 30), frame_width = 2)

    color headerBg  = color.new(#16213e, 0)
    color headerTxt = color.new(#e0e0ff, 0)
    color cellBg    = color.new(#0f0f23, 10)
    color bullCol   = #00e676
    color bearCol   = #ff1744
    color neutCol   = #ffd54f
    color goldCol   = #FFD700
    color diamCol   = #00BFFF

    // Row 0: Title
    table.cell(dash, 0, 0, "SMC Elite v6 ◆S◇E", text_color = goldCol, bgcolor = headerBg, text_size = tblSize, text_halign = text.align_center)
    table.merge_cells(dash, 0, 0, 1, 0)

    // Row 1: CTF Trend
    string trendTxt = not na(ms_result) ? (ms_result.trend == 1 ? "BULLISH" : "BEARISH") : "N/A"
    color trendCol  = not na(ms_result) ? (ms_result.trend == 1 ? bullCol : bearCol) : neutCol
    table.cell(dash, 0, 1, "Trend (CTF)", text_color = headerTxt, bgcolor = headerBg, text_size = tblSize)
    table.cell(dash, 1, 1, trendTxt, text_color = trendCol, bgcolor = cellBg, text_size = tblSize)

    // Row 2: HTF Trend
    string htfTxt = useMTF ? (mtfState.trend == 1 ? "BULL" : mtfState.trend == -1 ? "BEAR" : "FLAT") : "OFF"
    color htfCol  = useMTF ? (mtfState.trend == 1 ? bullCol : mtfState.trend == -1 ? bearCol : neutCol) : color.gray
    table.cell(dash, 0, 2, "HTF " + mtfTimeframe, text_color = headerTxt, bgcolor = headerBg, text_size = tblSize)
    table.cell(dash, 1, 2, htfTxt, text_color = htfCol, bgcolor = cellBg, text_size = tblSize)

    // Row 3: Last MS Event
    string eventTxt = not na(ms_result) ? (ms_result.txt == "bos" ? "BOS" : ms_result.txt == "choch" ? "CHoCH" : "-") : "-"
    table.cell(dash, 0, 3, "Structure", text_color = headerTxt, bgcolor = headerBg, text_size = tblSize)
    table.cell(dash, 1, 3, eventTxt, text_color = not na(ms_result) ? (ms_result.trend == 1 ? bullCol : bearCol) : neutCol, bgcolor = cellBg, text_size = tblSize)

    // Row 4: OBs
    int bOB = not na(g_blob) ? g_blob.size() : 0
    int sOB = not na(g_brob) ? g_brob.size() : 0
    table.cell(dash, 0, 4, "OB", text_color = headerTxt, bgcolor = headerBg, text_size = tblSize)
    table.cell(dash, 1, 4, str.tostring(bOB) + "B | " + str.tostring(sOB) + "S", text_color = headerTxt, bgcolor = cellBg, text_size = tblSize)

    // Row 5: FVGs
    table.cell(dash, 0, 5, "FVG", text_color = headerTxt, bgcolor = headerBg, text_size = tblSize)
    table.cell(dash, 1, 5, str.tostring(g_blFVG.size()) + "B | " + str.tostring(g_brFVG.size()) + "S", text_color = headerTxt, bgcolor = cellBg, text_size = tblSize)

    // Row 6: Frost Engine status
    string frostTxt = not useFrost ? "OFF" : frost_up > 0 ? "BULL " + str.tostring(frostConfLong) : frost_dn > 0 ? "BEAR " + str.tostring(frostConfShort) : "FLAT"
    color frostCol  = not useFrost ? color.gray : frost_up > 0 ? bullCol : frost_dn > 0 ? bearCol : neutCol
    table.cell(dash, 0, 6, "Frost IA", text_color = headerTxt, bgcolor = headerBg, text_size = tblSize)
    table.cell(dash, 1, 6, frostTxt, text_color = frostCol, bgcolor = cellBg, text_size = tblSize)

    // Row 7: WAE + Chop status
    string waeTxt  = not useWAE ? "OFF" : waeBullOK ? "BULL" : waeBearOK ? "BEAR" : "DEAD"
    string chopTxt = not useChop ? "" : chopOK ? " | CI OK" : " | CHOP"
    color waeCol   = not useWAE ? color.gray : waeBullOK ? bullCol : waeBearOK ? bearCol : color.gray
    table.cell(dash, 0, 7, "WAE|Chop", text_color = headerTxt, bgcolor = headerBg, text_size = tblSize)
    table.cell(dash, 1, 7, waeTxt + chopTxt, text_color = chopOK ? waeCol : bearCol, bgcolor = cellBg, text_size = tblSize)

    // Row 8: Absorption (internal scoring only)
    string absTxt = not useAbsorption ? "OFF" : bullishAbsorption ? "BULL ABS" : bearishAbsorption ? "BEAR ABS" : "-"
    color absCol  = bullishAbsorption ? bullCol : bearishAbsorption ? bearCol : color.gray
    table.cell(dash, 0, 8, "Absorption", text_color = headerTxt, bgcolor = headerBg, text_size = tblSize)
    table.cell(dash, 1, 8, absTxt, text_color = absCol, bgcolor = cellBg, text_size = tblSize)

    // Row 9: Watch State
    string watchTxt = watchActive ? "WATCHING " + str.tostring(bar_index - watchStartBar) + "b" : "IDLE"
    color watchCol = watchActive ? color.yellow : color.gray
    table.cell(dash, 0, 9, "Watch", text_color = headerTxt, bgcolor = headerBg, text_size = tblSize)
    table.cell(dash, 1, 9, watchTxt, text_color = watchCol, bgcolor = cellBg, text_size = tblSize)

    // Row 10: Precision oscillator state
    string oscLabel = precOscillator == "Fisher Transform" ? "Fisher" : "CyberCC"
    float oscVal    = precOscillator == "Fisher Transform" ? fisher : ccCycle
    string oscTxt   = str.tostring(oscVal, "#.##") + (precIsExtreme ? " EXTREME" : "")
    color oscCol    = precIsExtreme ? (oscVal > 0 ? bullCol : bearCol) : neutCol
    table.cell(dash, 0, 10, oscLabel, text_color = headerTxt, bgcolor = headerBg, text_size = tblSize)
    table.cell(dash, 1, 10, oscTxt, text_color = oscCol, bgcolor = cellBg, text_size = tblSize)

    // Row 11: Live score
    int liveScoreL = 0
    int liveScoreS = 0
    if not na(ms_result)
        if ms_result.txt == "choch" and ms_result.trend == 1
            liveScoreL += 2
        if ms_result.dnsweep
            liveScoreL += 2
        if ms_result.txt == "choch" and ms_result.trend == -1
            liveScoreS += 2
        if ms_result.upsweep
            liveScoreS += 2
    if not na(g_blob) and g_blob.size() > 0
        liveScoreL += 2
    if g_blFVG.size() > 0
        liveScoreL += 1
    if not na(g_brob) and g_brob.size() > 0
        liveScoreS += 2
    if g_brFVG.size() > 0
        liveScoreS += 1
    if useMTF and mtfState.trend == 1
        liveScoreL += 1
    if useMTF and mtfState.trend == -1
        liveScoreS += 1
    if frostBullOK
        liveScoreL += 1
    if frostBearOK
        liveScoreS += 1
    if waeBullOK
        liveScoreL += 1
    if waeBearOK
        liveScoreS += 1
    int bestScore = math.max(liveScoreL, liveScoreS)
    string scoreSide = liveScoreL >= liveScoreS ? "L" : "S"
    color scoreCol = bestScore >= minScoreS ? goldCol : bestScore >= 5 ? neutCol : color.gray
    table.cell(dash, 0, 11, "Score", text_color = headerTxt, bgcolor = headerBg, text_size = tblSize)
    table.cell(dash, 1, 11, str.tostring(bestScore) + "/10 " + scoreSide, text_color = scoreCol, bgcolor = cellBg, text_size = tblSize)

    // Row 12: FVG Proximity Filter status
    string fvgProxTxt = "OFF"
    color fvgProxCol  = color.gray
    if useFvgProx
        // Build list of active TF scanners
        string tfList = ""
        if fvgProxUseCTF and fvg_enable
            tfList := "CTF"
        if htf1H_ok
            tfList := tfList == "" ? "1H" : tfList + "|1H"
        if htf4H_ok
            tfList := tfList == "" ? "4H" : tfList + "|4H"
        if htf1D_ok
            tfList := tfList == "" ? "1D" : tfList + "|1D"
        if tfList == ""
            tfList := "NONE"
        // Current proximity safety check for display only (using close as reference)
        bool curLongSafe  = f_isLongSafeFvgProx(close, not na(g_brFVG) ? g_brFVG : array.new<FVG>())
        bool curShortSafe = f_isShortSafeFvgProx(close, not na(g_blFVG) ? g_blFVG : array.new<FVG>())
        string safeTxt = (curLongSafe ? "L✓" : "L✗") + " " + (curShortSafe ? "S✓" : "S✗")
        fvgProxTxt := tfList + " " + safeTxt
        fvgProxCol := (curLongSafe and curShortSafe) ? bullCol : (not curLongSafe and not curShortSafe) ? bearCol : neutCol
    table.cell(dash, 0, 12, "FVG Prox", text_color = headerTxt, bgcolor = headerBg, text_size = tblSize)
    table.cell(dash, 1, 12, fvgProxTxt, text_color = fvgProxCol, bgcolor = cellBg, text_size = tblSize)

    // Row 13: OB Proximity Filter status
    string obProxTxt = "OFF"
    color obProxColDash = color.gray
    if useObProx
        string obTfList = ""
        if obProxUseCTF
            obTfList := "CTF"
        if obHtf1H_ok
            obTfList := obTfList == "" ? "1H" : obTfList + "|1H"
        if obHtf4H_ok
            obTfList := obTfList == "" ? "4H" : obTfList + "|4H"
        if obHtf1D_ok
            obTfList := obTfList == "" ? "1D" : obTfList + "|1D"
        if obTfList == ""
            obTfList := "NONE"
        bool obLongSafe  = f_isLongSafeObProx(close, not na(g_brob) ? g_brob : array.new<ob>())
        bool obShortSafe = f_isShortSafeObProx(close, not na(g_blob) ? g_blob : array.new<ob>())
        string obSafeTxt = (obLongSafe ? "L✓" : "L✗") + " " + (obShortSafe ? "S✓" : "S✗")
        obProxTxt := obTfList + " " + obSafeTxt
        obProxColDash := (obLongSafe and obShortSafe) ? bullCol : (not obLongSafe and not obShortSafe) ? bearCol : neutCol
    table.cell(dash, 0, 13, "OB Prox", text_color = headerTxt, bgcolor = headerBg, text_size = tblSize)
    table.cell(dash, 1, 13, obProxTxt, text_color = obProxColDash, bgcolor = cellBg, text_size = tblSize)

// ═══════════════════════════════════════════════════════════════════════════════
// ─── ZPHL INITIALIZATION ────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

var phl = Zphl.new(na, na, label.new(na, na, color = invcol, textcolor = swingcssdn, style = label.style_label_down, size = size.tiny, text = ""), label.new(na, na, color = invcol, textcolor = swingcssup, style = label.style_label_up, size = size.tiny, text = ""), true, true, true, true, "", "", 0, 0, 0, 0, high, low, 0, 0, 0, 0, 0, 0, na, na)

// ═══════════════════════════════════════════════════════════════════════════════
// ─── ALERT CONDITIONS ───────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

alertcondition(not na(ms_result) ? ms_result.txt == "bos" and ms_result.trend == 1 : false, title="Bullish BOS", message="BOS Alcista en {{ticker}} | TF: {{interval}}")
alertcondition(not na(ms_result) ? ms_result.txt == "bos" and ms_result.trend == -1 : false, title="Bearish BOS", message="BOS Bajista en {{ticker}} | TF: {{interval}}")
alertcondition(not na(ms_result) ? ms_result.txt == "choch" and ms_result.trend == 1 : false, title="Bullish CHoCH", message="CHoCH Alcista en {{ticker}} | TF: {{interval}}")
alertcondition(not na(ms_result) ? ms_result.txt == "choch" and ms_result.trend == -1 : false, title="Bearish CHoCH", message="CHoCH Bajista en {{ticker}} | TF: {{interval}}")
alertcondition(not na(ms_result) ? ms_result.dnsweep : false, title="Downside Sweep", message="Sweep bajista en {{ticker}} | TF: {{interval}}")
alertcondition(not na(ms_result) ? ms_result.upsweep : false, title="Upside Sweep", message="Sweep alcista en {{ticker}} | TF: {{interval}}")
alertcondition(signalSLongThisBar, title="Signal S LONG", message="SMC Elite: Signal S LONG | {{ticker}}")
alertcondition(signalSShortThisBar, title="Signal S SHORT", message="SMC Elite: Signal S SHORT | {{ticker}}")
alertcondition(entryLongConfirmed, title="ENTRY Long Confirmed", message="SMC Elite: ◇ ENTRY ↑ | {{ticker}}")
alertcondition(entryShortConfirmed, title="ENTRY Short Confirmed", message="SMC Elite: ◇ ENTRY ↓ | {{ticker}}")

// Dynamic alerts for Entry
if entryLongConfirmed
    alert("SMC Elite: ◇ ENTRY ↑ | " + syminfo.ticker + " | Price: " + str.tostring(close, format.mintick), alert.freq_once_per_bar)
if entryShortConfirmed
    alert("SMC Elite: ◇ ENTRY ↓ | " + syminfo.ticker + " | Price: " + str.tostring(close, format.mintick), alert.freq_once_per_bar)
// ─── END OF SCRIPT ────
