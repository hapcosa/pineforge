//@version=6
// ██████╗ ██╗   ██╗██████╗  █████╗ ██╗
// ██╔══██╗██║   ██║██╔══██╗██╔══██╗██║
// ██████╔╝██║   ██║██║  ██║███████║██║
// ██╔══██╗██║   ██║██║  ██║██╔══██║██║
// ██████╔╝╚██████╔╝██████╔╝██║  ██║██║
// ╚═════╝  ╚═════╝ ╚═════╝ ╚═╝  ╚═╝╚═╝
//         C R I P T O   ·   T R A D I N G   C A P I T A L
// ────────────────────────────────────────────────────────────────────────────
//  ICT NYC OSCILATOR  ·  COG (Ehlers) + Momentum + Money Flow SMC
//  Cruces BULL / BEAR · Fibo · complemento del ICT NYC SCALPER MODE
//  © BudAI Cripto — Pine v6
// ────────────────────────────────────────────────────────────────────────────
indicator("ICT NYC OSCILATOR", shorttitle="ICT OSC", overlay=false, max_labels_count=300, max_lines_count=100)

// ════════════════ MARCA DE AGUA ════════════════
G_WM   = "✦ Marca de agua"
showWM = input.bool(true, "Mostrar firma BudAI Cripto", group=G_WM)
wmPos  = input.string("Inferior Izquierda", "Posición", options=["Inferior Izquierda","Inferior Derecha","Superior Izquierda","Superior Derecha"], group=G_WM)
wmCol  = input.color(color.new(#b6f400, 35), "Color", group=G_WM)

// ════════════════ GRUPOS ════════════════
G_OSC = "① Núcleo"
G_MF  = "② Money Flow SMC"
G_SIG = "③ Cruces / Señales"
G_FIB = "④ Niveles Fibo"
G_VIS = "⑤ Estética"

// ════════════════ ① NÚCLEO ════════════════
cogLen  = input.int(9,  "COG (centro de gravedad)", minval=3, maxval=50, group=G_OSC, tooltip="Ciclo Ehlers. 9 ≈ scalping 1-5m.")
momLen  = input.int(10, "Momentum", minval=2, maxval=50, group=G_OSC)
normLen = input.int(34, "Ventana normalización", minval=10, maxval=200, group=G_OSC)
smooth  = input.int(2,  "Suavizado", minval=1, maxval=10, group=G_OSC)
maLen   = input.int(9,  "Media de señal", minval=2, maxval=50, group=G_OSC)
wCog    = input.float(0.4, "Peso COG",       minval=0, maxval=1, step=0.1, group=G_OSC, inline="w")
wMom    = input.float(0.3, "Peso Momentum",  minval=0, maxval=1, step=0.1, group=G_OSC, inline="w")
wMfi    = input.float(0.3, "Peso MoneyFlow", minval=0, maxval=1, step=0.1, group=G_OSC, inline="w")

// ════════════════ ② MONEY FLOW SMC ════════════════
mfLen   = input.int(14, "Money Flow len", minval=2, maxval=50, group=G_MF)
showMF  = input.bool(true, "Histograma Money Flow", group=G_MF)

// ════════════════ ③ CRUCES / SEÑALES ════════════════
showSig = input.bool(true, "Etiquetas BULL / BEAR en cruces", group=G_SIG)
reqFlow = input.bool(true, "Cruce válido solo con Money Flow a favor", group=G_SIG, tooltip="BULL si CMF>0; BEAR si CMF<0. Filtra cruces falsos.")
useDiv  = input.bool(true, "Marcar divergencias", group=G_SIG)
divLen  = input.int(5, "Pivote divergencia", minval=2, maxval=20, group=G_SIG)

// ════════════════ ④ FIBO ════════════════
showFib = input.bool(true, "Niveles Fibo en oscilador", group=G_FIB)

// ════════════════ ⑤ ESTÉTICA (paleta futurista) ════════════════
upCol   = input.color(#00e5ff, "Alcista (acumulación)", group=G_VIS, inline="c")
dnCol   = input.color(#ff1e6e, "Bajista (distribución)", group=G_VIS, inline="c")
glow    = input.bool(true, "Relleno degradado (glow)", group=G_VIS)
fibCol  = input.color(color.new(#9d6cff, 35), "Color Fibo", group=G_VIS)

// ════════════════════════════════════════════════════════════════════════════
//  CÁLCULO
// ════════════════════════════════════════════════════════════════════════════
float src = hlc3
float num = 0.0
float den = 0.0
for i = 0 to cogLen - 1
    float p = nz(src[i])
    num := num + (1 + i) * p
    den := den + p
float cogRaw = den != 0 ? -num / den + (cogLen + 1) / 2.0 : 0.0
float momRaw = close - close[momLen]

float mfi = ta.mfi(hlc3, mfLen)
float mfm = (high - low) != 0 ? ((close - low) - (high - close)) / (high - low) : 0.0
float vol = nz(volume) == 0 ? 1.0 : volume
float cmf = math.sum(mfm * vol, mfLen) / math.sum(vol, mfLen)

f_norm(float s, simple int len) =>
    float lo = ta.lowest(s, len)
    float hi = ta.highest(s, len)
    hi - lo != 0 ? 100.0 * (s - lo) / (hi - lo) : 50.0

float wN   = (wCog + wMom + wMfi) == 0 ? 1.0 : (wCog + wMom + wMfi)
float comp = (f_norm(cogRaw, normLen) * wCog + f_norm(momRaw, normLen) * wMom + mfi * wMfi) / wN
float osc  = ta.ema(comp, smooth)
float oscMA= ta.ema(osc, maLen)

// ════════════════════════════════════════════════════════════════════════════
//  PLOTS — estética LuxAlgo futurista
// ════════════════════════════════════════════════════════════════════════════
color oscCol = osc >= oscMA ? upCol : dnCol
pOsc = plot(osc,   "Oscilador", color=oscCol, linewidth=2)
pMA  = plot(oscMA, "Media",     color=color.new(color.gray, 35), linewidth=1)
pMid = plot(50, "Mid", color=color.new(color.gray, 80))
fill(pOsc, pMid, top_value=100, bottom_value=50, top_color=glow ? color.new(upCol, 60) : na, bottom_color=glow ? color.new(upCol, 97) : na, title="Glow up")
fill(pOsc, pMid, top_value=50, bottom_value=0,  top_color=glow ? color.new(dnCol, 97) : na, bottom_color=glow ? color.new(dnCol, 60) : na, title="Glow dn")

plot(showMF ? 50 + cmf * 50 : na, "Money Flow", color=cmf >= 0 ? color.new(upCol, 55) : color.new(dnCol, 55), style=plot.style_columns, histbase=50)

// ════════════════════════════════════════════════════════════════════════════
//  NIVELES FIBO
// ════════════════════════════════════════════════════════════════════════════
hline(showFib ? 100  : na, "100",   color=color.new(color.gray, 85), linestyle=hline.style_dotted)
hline(showFib ? 61.8 : na, "0.618", color=fibCol, linestyle=hline.style_dashed)
hline(showFib ? 50   : na, "0.5",   color=color.new(#9d6cff, 0), linestyle=hline.style_solid)
hline(showFib ? 38.2 : na, "0.382", color=fibCol, linestyle=hline.style_dashed)
hline(showFib ? 0    : na, "0",     color=color.new(color.gray, 85), linestyle=hline.style_dotted)

// ════════════════════════════════════════════════════════════════════════════
//  CRUCES BULL / BEAR  (oscilador vs su media · confirmados a cierre)
// ════════════════════════════════════════════════════════════════════════════
bool flowUp = not reqFlow or cmf > 0
bool flowDn = not reqFlow or cmf < 0
bool crossUp = ta.crossover(osc, oscMA)  and flowUp and barstate.isconfirmed
bool crossDn = ta.crossunder(osc, oscMA) and flowDn and barstate.isconfirmed

// divergencias
float dpl = ta.pivotlow(low,  divLen, divLen)
float dph = ta.pivothigh(high, divLen, divLen)
var float pLo1 = na
var float pLo2 = na
var float oLo1 = na
var float oLo2 = na
var float pHi1 = na
var float pHi2 = na
var float oHi1 = na
var float oHi2 = na
if not na(dpl)
    pLo2 := pLo1
    pLo1 := dpl
    oLo2 := oLo1
    oLo1 := osc[divLen]
if not na(dph)
    pHi2 := pHi1
    pHi1 := dph
    oHi2 := oHi1
    oHi1 := osc[divLen]
bool bullDiv = useDiv and not na(dpl) and not na(pLo2) and pLo1 < pLo2 and oLo1 > oLo2 and barstate.isconfirmed
bool bearDiv = useDiv and not na(dph) and not na(pHi2) and pHi1 > pHi2 and oHi1 < oHi2 and barstate.isconfirmed

// etiquetas BULL/BEAR pegadas a la línea (location.absolute usa el valor de osc)
plotshape(showSig and crossUp ? osc : na, title="BULL", style=shape.labelup,   location=location.absolute, color=upCol, text="BULL", textcolor=color.white, size=size.tiny)
plotshape(showSig and crossDn ? osc : na, title="BEAR", style=shape.labeldown, location=location.absolute, color=dnCol, text="BEAR", textcolor=color.white, size=size.tiny)
plotchar(bullDiv ? osc : na, title="Div+", char="▲", location=location.absolute, color=color.new(upCol, 0), size=size.tiny)
plotchar(bearDiv ? osc : na, title="Div−", char="▼", location=location.absolute, color=color.new(dnCol, 0), size=size.tiny)

// ════════════════════════════════════════════════════════════════════════════
//  VEREDICTO (panel compacto)
// ════════════════════════════════════════════════════════════════════════════
var table t = table.new(position.top_right, 2, 3, bgcolor=color.new(#0b0e16, 12), frame_color=color.new(upCol, 55), frame_width=1, border_color=color.new(color.gray, 70), border_width=1)
if barstate.islast
    string fibZone = osc >= 61.8 ? "≥ 0.618 PREMIUM" : osc >= 50 ? "0.5 – 0.618" : osc >= 38.2 ? "0.382 – 0.5" : "≤ 0.382 DESCUENTO"
    bool   acc = cmf > 0
    string verdict = crossUp ? "CRUCE BULL" : crossDn ? "CRUCE BEAR" : (osc >= oscMA and acc) ? "Sesgo alcista" : (osc < oscMA and not acc) ? "Sesgo bajista" : "Neutro"
    color  vCol = crossUp ? upCol : crossDn ? dnCol : (osc >= oscMA and acc) ? upCol : (osc < oscMA and not acc) ? dnCol : color.gray
    table.cell(t, 0, 0, "ICT NYC OSC", text_color=color.white, bgcolor=color.new(#1b2030, 0), text_size=size.small)
    table.cell(t, 1, 0, str.tostring(osc, "#"), text_color=oscCol, bgcolor=color.new(#1b2030, 0), text_size=size.small)
    table.cell(t, 0, 1, "Flujo", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 1, acc ? "ACUMULA" : "DISTRIB", text_color=acc ? upCol : dnCol, text_size=size.small)
    table.cell(t, 0, 2, fibZone, text_color=color.new(#9d6cff,0), text_size=size.small)
    table.cell(t, 1, 2, verdict, text_color=color.white, bgcolor=color.new(vCol, 45), text_size=size.small)

// ════════════════════════════════════════════════════════════════════════════
//  MARCA DE AGUA — firma BudAI Cripto
// ════════════════════════════════════════════════════════════════════════════
f_wmPos(s) => s == "Inferior Izquierda" ? position.bottom_left : s == "Inferior Derecha" ? position.bottom_right : s == "Superior Izquierda" ? position.top_left : position.top_right
var table wm = table.new(f_wmPos(wmPos), 1, 1, bgcolor=color.new(color.black, 100))
if showWM and barstate.islast
    table.cell(wm, 0, 0, "₿ BudAI Cripto", text_color=wmCol, text_size=size.small)

// ════════════════════════════════════════════════════════════════════════════
//  ALERTAS
// ════════════════════════════════════════════════════════════════════════════
alertcondition(crossUp, title="OSC BULL", message="ICT NYC OSC · cruce BULL {{ticker}}")
alertcondition(crossDn, title="OSC BEAR", message="ICT NYC OSC · cruce BEAR {{ticker}}")
